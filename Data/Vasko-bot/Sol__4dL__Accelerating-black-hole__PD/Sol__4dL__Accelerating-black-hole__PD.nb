         RowBox[{"r", "[", "]"}], ",", " ", 
         RowBox[{"x", "[", "]"}], ",", " ", 
         RowBox[{"\[Phi]", "[", "]"}]}], "}"}]}], ",", " ", 
      RowBox[{"ChartColor", " ", "->", " ", "Red"}]}], "|>"}], "}"}]}], 
  "]"}]], "Input",
