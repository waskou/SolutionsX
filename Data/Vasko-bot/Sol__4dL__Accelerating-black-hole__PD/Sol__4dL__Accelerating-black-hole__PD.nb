Cell["\<\
With rational components Map -> Simplify is cheap: the whole geometry chain \
runs in a few seconds. (For calibration: in the theta chart the Ricci \
apply-map alone took over a minute, and the Maxwell check below was out of \
reach at a 110 s budget.)\
\>", "Text",
 CellChangeTimes->{{3.996914718659225*^9, 
  3.996914719302003*^9}},ExpressionUUID->"b5c6c43e-9000-404d-b919-\
285af04dccd1"],

Cell[BoxData[
 RowBox[{
  RowBox[{"$Apply", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{"Map", " ", "->", " ", "Simplify"}], "}"}]}], ";"}]], "Input",
 CellLabel->"In[18]:=",ExpressionUUID->"36f637bb-7c7a-4b9a-acac-12fe0ad58ff0"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Compute", "@", 
     RowBox[{"sol", "[", 
      RowBox[{"$metric", ",", " ", "gg", ",", " ", "$auto", ",", " ", "#"}], 
      "]"}]}], " ", "&"}], " ", "/@", " ", 
   RowBox[{"{", 
    RowBox[{
    "gg", ",", " ", "Detgg", ",", " ", "Christoffelcd", ",", " ", "Riccicd", ",",
      " ", "RicciScalarcd"}], "}"}]}], ";"}]], "Input",
 CellLabel->"In[19]:=",ExpressionUUID->"5bc4fdbf-6e6a-4eaa-9e15-dd852aed2cd8"],

Cell[CellGroupData[{

Cell[BoxData[
 TemplateBox[{"\"Applied \"", 
   TemplateBox[{
     StyleBox[
     "Simplify", FontColor -> 
      RGBColor[0.4, 0.2666666666666667, 0.13333333333333336`], FontFamily -> 
      "Source Code Pro Semibold", StripOnInput -> False]}, "RowDefault"], 
   "\" to \"", 
   InterpretationBox[
    StyleBox[
     GridBox[{{"gg", 
        StyleBox[
         GridBox[{{" ", " "}, {
           "\!\(\*StyleBox[\"\[ScriptM]\",FontColor->RGBColor[1., 0., 0.]]\)",
             "\!\(\*StyleBox[\"\[ScriptN]\",FontColor->RGBColor[1., 0., \
0.]]\)"}}, RowSpacings -> 0, ColumnSpacings -> 0.05, 
          GridFrameMargins -> {{0, 0}, {0, 0}}], FontSize -> 
         Rational[39, 4]]}}, ColumnSpacings -> 0.05, RowAlignments -> Center],
      AutoSpacing -> False, ShowAutoStyles -> False], 
    $CellContext`gg[{-$CellContext`\[ScriptM], -$CellContext`pd}, \
{-$CellContext`\[ScriptN], -$CellContext`pd}], Editable -> False], "\" = \"", 
   
   TagBox[
    RowBox[{"MakeArray", "[", 
      RowBox[{
        RowBox[{"$self", "[", 
          RowBox[{"$metric", ",", "gg", ",", "Expression"}], "]"}], "/.", 
        "\[VeryThinSpace]", 
        RowBox[{"Gen", "[", 
