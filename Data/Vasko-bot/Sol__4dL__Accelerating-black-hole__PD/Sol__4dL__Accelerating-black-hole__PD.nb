Cell["\<\
The renormalised on-shell action comes from the induced entry, where the bulk \
antiderivative above met the boundary counterterms and the divergences \
cancelled; the conserved charges come from the conformal-boundary entry. \
Pulling both in here assembles section 3 of the paper in one place.\
\>", "Text",ExpressionUUID->"01f42a54-4f12-4057-82d4-20bccf3fb8c3"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"IncludeTo", "[", 
  RowBox[{
   RowBox[{"sol", "[", "$rule", "]"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"bdy", "[", 
      RowBox[{"$rule", ",", " ", "osaren"}], "]"}], ",", " ", 
     RowBox[{"cft", "[", 
      RowBox[{"$rule", ",", " ", "charges"}], "]"}]}], "}"}]}], "]"}], "\n", 
 RowBox[{"Keys", "@", 
  RowBox[{"sol", "[", "$rule", "]"}]}]}], "Input",
 CellLabel->"In[7]:=",ExpressionUUID->"7b16edc8-74be-4700-bde5-14762545b210"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
  "func", ",", "m2rp", ",", "Xidef", ",", "spindle", ",", "tensions", ",", 
   "uplift", ",", "x2\[Theta]", ",", "\[Theta]2x", ",", "potentials", ",", 
   "entropy", ",", "osabulk", ",", "osaren", ",", "charges"}], 
  "}"}]], "Output",
 CellChangeTimes->{3.996915552178976*^9},
 CellLabel->"Out[8]=",ExpressionUUID->"37b1dc29-f675-4959-aff1-1b1f86bbf497"]
}, Open  ]],

Cell["\<\
The quantum statistical relation, paper eq. (3.37): I = -S + beta(M - Omega J \
- Phi_e Q_e), with Omega = Omega_H - Omega_infinity. It holds exactly, with \
the AdS radius general, once the horizon rule m2rp is imposed. Note what has \
NOT been used: neither the regularity conditions of section 2.2 nor the \
supersymmetry conditions, exactly as the paper stresses.

With the corpus theta-term retained the relation acquires one extra term, \
beta (G4 CurlyTheta/pi) Phi_e Q_m. That is a statement about this corpus's \
theory entry rather than about the paper, and it is recorded as such.\
\>", "Text",ExpressionUUID->"19d2abfa-ac24-4883-98d8-85d8e7131895"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"qsr", " ", "=", " ", 
   RowBox[{"II", " ", "-", " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", "SS"}], " ", "+", " ", 
      RowBox[{"\[Beta]", " ", 
       RowBox[{"(", 
        RowBox[{"MM", " ", "-", " ", 
         RowBox[{"\[CapitalOmega]", " ", "JJ"}], " ", "-", " ", 
         RowBox[{"\[CapitalPhi]e", " ", "Qe"}]}], ")"}]}]}], ")"}]}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"qsrEx", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"qsr", " ", "/.", " ", 
         RowBox[{"Gen", "@", 
          RowBox[{"sol", "[", 
           RowBox[{"$rule", ",", " ", "osaren"}], "]"}]}]}], " ", "/.", " ", 
        RowBox[{"Gen", "@", 
         RowBox[{"sol", "[", 
          RowBox[{"$rule", ",", " ", "charges"}], "]"}]}]}], " ", "/.", " ", 
       RowBox[{"Gen", "@", 
        RowBox[{"sol", "[", 
         RowBox[{"$rule", ",", " ", "entropy"}], "]"}]}]}], " ", "/.", " ", 
      RowBox[{"Gen", "@", 
       RowBox[{"sol", "[", 
        RowBox[{"$rule", ",", " ", "potentials"}], "]"}]}]}], " ", "/.", " ", 
     
     RowBox[{"Gen", "@", 
      RowBox[{"sol", "[", 
       RowBox[{"$rule", ",", " ", "Xidef"}], "]"}]}]}], " ", "/.", " ", 
    RowBox[{"Gen", "@", 
     RowBox[{"sol", "[", 
      RowBox[{"$rule", ",", " ", "m2rp"}], "]"}]}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"chk0", " ", "=", " ", 
   RowBox[{"Simplify", "[", 
    RowBox[{"qsrEx", " ", "/.", " ", 
     RowBox[{"\[CurlyTheta]", " ", "->", " ", "0"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"chkTh", " ", "=", " ", 
   RowBox[{"Simplify", "[", 
    RowBox[{"qsrEx", " ", "-", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"\[Beta]", " ", 
           RowBox[{"(", 
            RowBox[{"G4", " ", 
             RowBox[{"\[CurlyTheta]", "/", "\[Pi]"}]}], ")"}], " ", 
           "\[CapitalPhi]e", " ", "Qm"}], " ", "/.", " ", 
          RowBox[{"Gen", "@", 
           RowBox[{"sol", "[", 
            RowBox[{"$rule", ",", " ", "charges"}], "]"}]}]}], " ", "/.", " ", 
         RowBox[{"Gen", "@", 
          RowBox[{"sol", "[", 
           RowBox[{"$rule", ",", " ", "potentials"}], "]"}]}]}], " ", "/.", 
        " ", 
        RowBox[{"Gen", "@", 
         RowBox[{"sol", "[", 
          RowBox[{"$rule", ",", " ", "Xidef"}], "]"}]}]}], " ", "/.", " ", 
       RowBox[{"Gen", "@", 
        RowBox[{"sol", "[", 
         RowBox[{"$rule", ",", " ", "m2rp"}], "]"}]}]}], ")"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{"chk0", ",", " ", "chkTh"}], "}"}]}], "Input",
 CellLabel->"In[9]:=",ExpressionUUID->"024a3b06-b57b-498e-b1fe-6038da9ae386"],

