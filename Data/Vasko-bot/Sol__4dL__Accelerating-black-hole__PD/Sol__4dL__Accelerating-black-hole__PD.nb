Cell["\<\
The surface gravity, and with it the temperature, paper eq. (3.32). The norm \
of the horizon generator has a DOUBLE root at r = rp, so neither Series nor a \
direct limit returns: the corpus lesson is to take the limit by polynomial \
arithmetic. Here lambda = -chi.chi vanishes linearly in Q and Q vanishes \
linearly at rp, so kappa_sg^2 = (d lambda/dr)(dQ/dr)/(4 Sigma) evaluated at \
the horizon -- pure differentiation and substitution, no limit process at \
all. The on-shell rule m2rp is applied FIRST, before any of this, without \
which the determinants never collapse.

Two checks: the result is x-independent (as a surface gravity must be), and \
it is the square of the paper's expression.\
\>", "Text",ExpressionUUID->"383c10b8-0631-41ce-b07e-1f9d1d738f86"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"lam", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"-", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"garr", "[", 
         RowBox[{"[", 
          RowBox[{"1", ",", " ", "1"}], "]"}], "]"}], " ", "+", " ", 
        RowBox[{"2", " ", "wH", " ", 
         RowBox[{"garr", "[", 
          RowBox[{"[", 
           RowBox[{"1", ",", " ", "4"}], "]"}], "]"}]}], " ", "+", " ", 
        RowBox[{
         SuperscriptBox["wH", "2"], " ", 
         RowBox[{"garr", "[", 
          RowBox[{"[", 
           RowBox[{"4", ",", " ", "4"}], "]"}], "]"}]}]}], ")"}]}], " ", "/.",
      " ", "funcrule"}], " ", "//", " ", "Together"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"lam1", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"D", "[", 
        RowBox[{"lam", ",", " ", 
         RowBox[{"r", "[", "]"}]}], "]"}], " ", "/.", " ", 
       RowBox[{
        RowBox[{"r", "[", "]"}], " ", "->", " ", "rp"}]}], ")"}], " ", "/.", 
     " ", "m2rpR"}], " ", "//", " ", "Simplify"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"SigH", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox[
        RowBox[{"r", "[", "]"}], "2"], " ", "+", " ", 
       RowBox[{
        SuperscriptBox["a", "2"], " ", 
        SuperscriptBox[
         RowBox[{"x", "[", "]"}], "2"]}]}], ")"}], "/", 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"1", " ", "+", " ", 
        RowBox[{"\[Alpha]", " ", 
         RowBox[{"r", "[", "]"}], " ", 
         RowBox[{"x", "[", "]"}]}]}], ")"}], "2"]}], " ", "/.", " ", 
    RowBox[{
     RowBox[{"r", "[", "]"}], " ", "->", " ", "rp"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Qp", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"D", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"sol", "[", 
           RowBox[{"$function", ",", " ", "Q", ",", " ", "Expression"}], 
           "]"}], " ", "/.", " ", "funcrule"}], ",", " ", 
         RowBox[{"r", "[", "]"}]}], "]"}], " ", "/.", " ", 
       RowBox[{
        RowBox[{"r", "[", "]"}], " ", "->", " ", "rp"}]}], ")"}], " ", "/.", 
     " ", "m2rpR"}], " ", "//", " ", "Simplify"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"ksg2", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"lam1", " ", 
      RowBox[{"Qp", "/", 
       RowBox[{"(", 
        RowBox[{"4", " ", "SigH"}], ")"}]}]}], " ", "/.", " ", "m2rpR"}], " ",
     "//", " ", "Simplify"}]}], ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Simplify", "[", 
    RowBox[{"D", "[", 
     RowBox[{"ksg2", ",", " ", 
      RowBox[{"x", "[", "]"}]}], "]"}], "]"}], ",", " ", 
   RowBox[{"Simplify", "[", 
    RowBox[{"ksg2", " ", "-", " ", 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"Qp", "/", 
        RowBox[{"(", 
         RowBox[{"2", " ", "\[Kappa]", " ", 
          RowBox[{"(", 
           RowBox[{
            SuperscriptBox["rp", "2"], " ", "+", " ", 
            SuperscriptBox["a", "2"]}], ")"}]}], ")"}]}], ")"}], "2"]}], 
    "]"}]}], "}"}]}], "Input",
 CellLabel->"In[79]:=",ExpressionUUID->"36d0cb60-f21f-4393-baf6-31019e29f7ff"],

