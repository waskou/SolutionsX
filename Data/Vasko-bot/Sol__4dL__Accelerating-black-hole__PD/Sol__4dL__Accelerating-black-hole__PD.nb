              RowBox[{"(", 
               RowBox[{"1", " ", "+", " ", 
                RowBox[{
                 SuperscriptBox["a", "2"], " ", 
                 SuperscriptBox["\[Alpha]", "2"]}]}], ")"}]}], ")"}]}]}]}]}], 
        ",", " ", 
        RowBox[{"\[CapitalPhi]e", " ", "->", " ", 
         RowBox[{"e", " ", 
          RowBox[{"rp", "/", 
           RowBox[{"(", 
            RowBox[{"\[Kappa]", " ", 
