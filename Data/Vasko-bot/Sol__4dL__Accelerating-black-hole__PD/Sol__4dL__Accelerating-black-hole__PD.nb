Cell["\<\
Conversion to and from the paper's theta coordinate. x2theta rewrites stored \
data in theta for display (theta is a plain symbol here, Diff[theta] stays \
inert -- do not compute with it); theta2x is the computational inverse (the \
sin-power rule covers all even powers, which appear once tensor products \
distribute). As verification, the paper's metric (2.2) and gauge field (2.4), \
typed verbatim in theta -- with P(theta) = P(-cos theta) in terms of the \
stored P -- land exactly on the stored Expressions.\
\>", "Text",ExpressionUUID->"3547c8c1-348b-4581-9d94-1d709a38d3dd"],

Cell[BoxData[{
 RowBox[{"IncludeTo", "[", 
  RowBox[{
   RowBox[{"sol", "[", "$rule", "]"}], ",", " ", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"Symbol", " ", "->", " ", "x2\[Theta]"}], ",", " ", 
     RowBox[{"Expression", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"x", "[", "]"}], " ", ":>", " ", 
         RowBox[{"-", 
          RowBox[{"Cos", "[", "\[Theta]", "]"}]}]}], ",", " ", 
        RowBox[{
         RowBox[{"Diff", "[", 
          RowBox[{"x", "[", "]"}], "]"}], " ", ":>", " ", 
         RowBox[{
          RowBox[{"Sin", "[", "\[Theta]", "]"}], " ", 
          RowBox[{"Diff", "[", "\[Theta]", "]"}]}]}]}], "}"}]}]}], "|>"}]}], 
  "]"}], "\n", 
 RowBox[{"IncludeTo", "[", 
  RowBox[{
   RowBox[{"sol", "[", "$rule", "]"}], ",", " ", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"Symbol", " ", "->", " ", "\[Theta]2x"}], ",", " ", 
     RowBox[{"Expression", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"Diff", "[", "\[Theta]", "]"}], "\[CircleTimes]", 
          RowBox[{"Diff", "[", "\[Theta]", "]"}]}], " ", "->", " ", 
         RowBox[{
          RowBox[{"Diff", "[", 
           RowBox[{"x", "[", "]"}], "]"}], "\[CircleTimes]", 
          RowBox[{
           RowBox[{"Diff", "[", 
            RowBox[{"x", "[", "]"}], "]"}], "/", 
           RowBox[{"(", 
            RowBox[{"1", " ", "-", " ", 
             SuperscriptBox[
              RowBox[{"x", "[", "]"}], "2"]}], ")"}]}]}]}], ",", " ", 
        RowBox[{
         RowBox[{
          SuperscriptBox[
           RowBox[{"Sin", "[", "\[Theta]", "]"}], "n_"], " ", "/;", " ", 
          RowBox[{"EvenQ", "[", "n", "]"}]}], " ", ":>", " ", 
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"1", " ", "-", " ", 
            SuperscriptBox[
             RowBox[{"x", "[", "]"}], "2"]}], ")"}], 
          RowBox[{"(", 
           RowBox[{"n", "/", "2"}], ")"}]]}], ",", " ", 
        RowBox[{
         RowBox[{"Cos", "[", "\[Theta]", "]"}], " ", "->", " ", 
         RowBox[{"-", 
          RowBox[{"x", "[", "]"}]}]}]}], "}"}]}]}], "|>"}]}], "]"}]}], "Input",\

 CellLabel->"In[64]:=",ExpressionUUID->"2a52e9a1-d4eb-4f01-895e-5c55f7c14116"],

