Cell["\<\
The bulk Lagrangian density on shell. The theory entry's TL carries a \
theta-term proportional to the corpus constant CurlyTheta, which the paper \
does not have; it is kept symbolic throughout and set to zero when comparing \
with the paper, so that the l4-general and theta-term-general statements are \
available as well.

What is stored is the radial ANTIDERIVATIVE of the density, not a definite \
integral: the outer limit is a cutoff surface which only makes sense together \
with the boundary counterterms, and those live in the induced entry. The \
antiderivative is a rational function -- no logarithms or arctangents appear \
-- which is again a consequence of working in x.\
\>", "Text",ExpressionUUID->"486ddb74-8578-4295-a195-28669d2b9bc9"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"osaInt", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"1", "/", 
      RowBox[{"(", 
       RowBox[{"16", " ", "\[Pi]", " ", "G4"}], ")"}]}], " ", 
     SqrtBox[
      RowBox[{"-", 
       RowBox[{"Detgg", "[", "]"}]}]], " ", 
     RowBox[{"T\[ScriptCapitalL]", "[", "]"}]}], " ", "/.", " ", 
    RowBox[{"epsilonToetaDown", "[", 
     RowBox[{"gg", ",", " ", "pd"}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"osaEx", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"ToArray", "[", "osaInt", "]"}], " ", "/.", " ", "funcrule"}], 
    " ", "//", " ", "Simplify"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Banti", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"Integrate", "[", 
      RowBox[{
       RowBox[{"osaEx", " ", "/.", " ", 
        RowBox[{
         RowBox[{"r", "[", "]"}], " ", "->", " ", "r"}]}], ",", " ", "r"}], 
      "]"}], " ", "/.", " ", 
     RowBox[{"r", " ", "->", " ", 
      RowBox[{"r", "[", "]"}]}]}], " ", "//", " ", "Simplify"}]}], ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"LeafCount", "[", "Banti", "]"}], ",", " ", 
   RowBox[{"Cases", "[", 
    RowBox[{"Banti", ",", " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"ArcTan", " ", "|", " ", "Log", " ", "|", " ", "PolyLog"}], 
       ")"}], "[", "___", "]"}], ",", " ", "Infinity"}], "]"}]}], 
  "}"}]}], "Input",
 CellLabel->
  "In[100]:=",ExpressionUUID->"b2d48cb0-c2f0-425c-b5a3-a634aae342f6"],

Cell[BoxData[
 RowBox[{"{", 
