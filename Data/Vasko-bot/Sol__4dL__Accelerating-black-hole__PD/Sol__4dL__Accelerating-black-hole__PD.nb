       RowBox[{"{", 
        RowBox[{"0", ",", " ", "1", ",", " ", "2", ",", " ", "3"}], "}"}]}], ",",
       " ", 
      RowBox[{"ScalarsOfChart", " ", "->", " ", 
       RowBox[{"{", 
        RowBox[{
