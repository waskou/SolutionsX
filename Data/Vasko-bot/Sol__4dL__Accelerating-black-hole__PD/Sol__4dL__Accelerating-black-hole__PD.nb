Cell["\<\
Einstein equations Egg = 0. With P, Q symbolic most components do NOT vanish \
-- the Einstein equations are precisely what fixes the quartic structure \
functions. The count below reads {number of independent components, how many \
happen to vanish already for arbitrary P, Q}.\
\>", "Text",ExpressionUUID->"01b4b949-1a41-442a-b080-7f9c7c3df857"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"eomgg", " ", "=", " ", 
   RowBox[{
    RowBox[{"\[ScriptCapitalE]gg", "[", 
     RowBox[{
      RowBox[{"-", "\[ScriptM]"}], ",", " ", 
      RowBox[{"-", "\[ScriptN]"}]}], "]"}], " ", "//", " ", 
    "CovDToChristoffel"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"earr", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"ToArray", "[", "eomgg", "]"}], " ", "//", " ", "Flatten"}], 
     " ", "//", " ", 
     RowBox[{"DeleteCases", "[", "0", "]"}]}], " ", "//", " ", 
    "DeleteDuplicates"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"einsteinSym", " ", "=", " ", 
   RowBox[{"Simplify", "[", "earr", "]"}]}], ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Length", "[", "earr", "]"}], ",", " ", 
   RowBox[{"Count", "[", 
    RowBox[{"einsteinSym", ",", " ", "0"}], "]"}]}], "}"}]}], "Input",
 CellLabel->"In[28]:=",ExpressionUUID->"cedcfc79-eee0-4c2f-a714-8dc4c5d06fb3"],

