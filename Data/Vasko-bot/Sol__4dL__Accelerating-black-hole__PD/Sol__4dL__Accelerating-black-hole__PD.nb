        RowBox[{"{", 
         RowBox[{"0", " ", "<", " ", 
          RowBox[{"\[Alpha]", " ", "rp"}], " ", "<", " ", "1"}], "}"}]}]}], 
      "]"}]}], " ", "//", " ", "Simplify"}]}], ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{"SBH", ",", " ", 
   RowBox[{"Simplify", "[", 
    RowBox[{"SBH", " ", "-", " ", 
