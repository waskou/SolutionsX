         RowBox[{
          SuperscriptBox["\[Alpha]", "2"], " ", 
          SuperscriptBox["rp", "2"]}]}], ")"}]}]}]}], "]"}]}], 
  "}"}]}], "Input",
 CellLabel->"In[94]:=",ExpressionUUID->"26eef063-5a2c-4259-8451-4d517db23449"],

