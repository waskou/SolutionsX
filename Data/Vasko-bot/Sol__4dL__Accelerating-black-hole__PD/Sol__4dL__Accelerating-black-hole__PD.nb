Cell["\<\
Structure functions, paper eq. (2.3) with cos theta = -x: P(x) is the paper's \
P(theta), Q(r) is verbatim (a^2/l^2 restored in the x^2 coefficient). H = 1 + \
alpha r x and Sigma = r^2 + a^2 x^2 are written inline in the metric. P and Q \
are kept SYMBOLIC through the Compute chains -- the stored components are \
then valid for arbitrary P(x), Q(r); the explicit quartics enter only at \
verification time, through the rule `func`. Parameters, eq. (2.5): m > 0 \
(mass), e (electric), g (magnetic), a (rotation), alpha (acceleration); kappa \
> 0 rescales time and is fixed only when the first law is discussed.\
\>", "Text",ExpressionUUID->"a3dd3860-f5e1-42ef-96e9-ccad3e092dc2"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"IncludeTo", "[", 
  RowBox[{
   RowBox[{"sol", "[", "$function", "]"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"Symbol", " ", "->", " ", 
        RowBox[{"P", "[", 
         RowBox[{"x", "[", "]"}], "]"}]}], ",", " ", 
       RowBox[{"Expression", " ", "->", " ", 
        RowBox[{"1", " ", "+", " ", 
         RowBox[{"2", " ", "\[Alpha]", " ", "m", " ", 
          RowBox[{"x", "[", "]"}]}], " ", "+", " ", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             SuperscriptBox["\[Alpha]", "2"], " ", 
             RowBox[{"(", 
              RowBox[{
               SuperscriptBox["a", "2"], " ", "+", " ", 
               SuperscriptBox["e", "2"], " ", "+", " ", 
               SuperscriptBox["g", "2"]}], ")"}]}], " ", "-", " ", 
            RowBox[{
             SuperscriptBox["a", "2"], "/", 
             SuperscriptBox["l4", "2"]}]}], ")"}], " ", 
          SuperscriptBox[
           RowBox[{"x", "[", "]"}], "2"]}]}]}]}], "|>"}], ",", " ", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"Symbol", " ", "->", " ", 
        RowBox[{"Q", "[", 
         RowBox[{"r", "[", "]"}], "]"}]}], ",", " ", 
       RowBox[{"Expression", " ", "->", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            SuperscriptBox[
             RowBox[{"r", "[", "]"}], "2"], " ", "-", " ", 
            RowBox[{"2", " ", "m", " ", 
             RowBox[{"r", "[", "]"}]}], " ", "+", " ", 
            SuperscriptBox["a", "2"], " ", "+", " ", 
            SuperscriptBox["e", "2"], " ", "+", " ", 
            SuperscriptBox["g", "2"]}], ")"}], " ", 
          RowBox[{"(", 
           RowBox[{"1", " ", "-", " ", 
            RowBox[{
             SuperscriptBox["\[Alpha]", "2"], " ", 
             SuperscriptBox[
              RowBox[{"r", "[", "]"}], "2"]}]}], ")"}]}], " ", "+", " ", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            SuperscriptBox[
             RowBox[{"r", "[", "]"}], "2"], " ", 
            RowBox[{"(", 
             RowBox[{
              SuperscriptBox["a", "2"], " ", "+", " ", 
              SuperscriptBox[
               RowBox[{"r", "[", "]"}], "2"]}], ")"}]}], ")"}], "/", 
          SuperscriptBox["l4", "2"]}]}]}]}], "|>"}]}], "}"}]}], "]"}], "\n", 
 RowBox[{"IncludeTo", "[", 
  RowBox[{
   RowBox[{"sol", "[", "$constant", "]"}], ",", " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{
      RowBox[{"<|", 
       RowBox[{"Symbol", " ", "->", " ", "#"}], "|>"}], " ", "&"}], " ", "/@",
      " ", 
     RowBox[{"{", 
      RowBox[{
      "m", ",", " ", "e", ",", " ", "g", ",", " ", "a", ",", " ", "\[Alpha]", 
       ",", " ", "\[Kappa]"}], "}"}]}], ")"}]}], "]"}]}], "Input",
 CellLabel->"In[7]:=",ExpressionUUID->"4c0427cf-0b7d-4687-be07-ce8a57d9e07f"],

