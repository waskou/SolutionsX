Cell["\<\
Uplift condition g = alpham, eq. (2.15): IMPOSED here, not derived -- it is \
not a statement of the 4d equations of motion. It is sufficient for the \
conical-singularity-free uplift to D=11 supergravity on regular \
Sasaki-Einstein Y7 (Ferrero:2020twa) and turns out to be required by \
supersymmetry (paper section 2.3). Stored as a rule to be applied on demand.\
\>", "Text",ExpressionUUID->"808c60a3-aded-4cb5-a651-f56b1dff39a0"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"IncludeTo", "[", 
  RowBox[{
   RowBox[{"sol", "[", "$rule", "]"}], ",", " ", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"Symbol", " ", "->", " ", "uplift"}], ",", " ", 
     RowBox[{"Expression", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"g", " ", "->", " ", 
        RowBox[{"\[Alpha]", " ", "m"}]}], "}"}]}]}], "|>"}]}], "]"}], "\n", 
 RowBox[{"SaveData", "@", "sol"}]}], "Input",
 CellLabel->"In[61]:=",ExpressionUUID->"ecc251b4-6e58-46e2-95d5-0acdefbcb74f"],

