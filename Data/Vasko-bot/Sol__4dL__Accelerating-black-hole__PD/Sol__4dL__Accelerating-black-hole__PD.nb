            RowBox[{"[", 
             RowBox[{"1", ",", " ", "4"}], "]"}], "]"}], "/", 
           RowBox[{"garr", "[", 
            RowBox[{"[", 
             RowBox[{"4", ",", " ", "4"}], "]"}], "]"}]}], ")"}], " ", "/.", 
         " ", "funcrule"}], " ", "/.", " ", 
        RowBox[{
         RowBox[{"r", "[", "]"}], " ", "->", " ", "rp"}]}], ")"}]}], " ", "/.",
      " ", "m2rpR"}], " ", "//", " ", "Simplify"}]}], ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{"wH", ",", " ", 
