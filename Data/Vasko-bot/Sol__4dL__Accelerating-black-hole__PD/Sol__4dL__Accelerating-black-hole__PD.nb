     RowBox[{"\[CapitalDelta]\[Phi]", "/", 
      RowBox[{"(", 
       RowBox[{"2", " ", "\[Pi]"}], ")"}]}], ")"}], " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"rp", " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          SuperscriptBox["rp", "2"], " ", "+", " ", 
          SuperscriptBox["a", "2"]}], ")"}], "/", 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"1", " ", "-", " ", 
           RowBox[{
            SuperscriptBox["\[Alpha]", "2"], " ", 
            SuperscriptBox["rp", "2"]}]}], ")"}], "2"]}]}], " ", "+", " ", 
      RowBox[{"m", " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           SuperscriptBox["a", "2"], " ", 
           RowBox[{"(", 
            RowBox[{"1", " ", "-", " ", 
             RowBox[{
              SuperscriptBox["\[Alpha]", "2"], " ", 
              SuperscriptBox["l4", "2"], " ", "\[CapitalXi]"}]}], ")"}]}], 
          " ", "+", " ", 
          RowBox[{
           SuperscriptBox["\[Alpha]", "2"], " ", 
           SuperscriptBox["l4", "4"], " ", "\[CapitalXi]", " ", 
           RowBox[{"(", 
            RowBox[{"\[CapitalXi]", " ", "+", " ", 
             RowBox[{
              SuperscriptBox["a", "2"], "/", 
              SuperscriptBox["l4", "2"]}]}], ")"}]}]}], ")"}], "/", 
        RowBox[{"(", 
         RowBox[{"\[CapitalXi]", " ", 
          RowBox[{"(", 
           RowBox[{"1", " ", "+", " ", 
            RowBox[{
             SuperscriptBox["a", "2"], " ", 
             SuperscriptBox["\[Alpha]", "2"]}]}], ")"}]}], ")"}]}]}]}], 
     ")"}]}]}], ";"}]}], "Input",
 CellLabel->"In[19]:=",ExpressionUUID->"27617d15-d6ac-4be7-98df-c91239f2011f"],

Cell["\<\
The Smarr relation, paper eq. (3.41), and the identity Phi_m Q_e = Phi_e Q_m. \
Here the explicit kappa may be substituted directly since no derivative acts \
on it.\
\>", "Text",ExpressionUUID->"30ecf94e-5585-4eac-8cf5-a14157733524"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"toEx", "[", "expr_", "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"expr", " ", "//.", " ", "subst"}], " ", "/.", " ", "XidE"}], 
     " ", "/.", " ", "m2rpE"}], " ", "/.", " ", 
    RowBox[{"\[Kappa]", " ", "->", " ", "kapEx"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{
    "Mv", ",", " ", "Sv", ",", " ", "Qev", ",", " ", "Qmv", ",", " ", "Jv", ",",
      " ", "Tv", ",", " ", "Ov", ",", " ", "Fev", ",", " ", "Fmv", ",", " ", 
     "mupv", ",", " ", "mumv"}], "}"}], " ", "=", " ", 
   RowBox[{"toEx", " ", "/@", " ", 
    RowBox[{"{", 
     RowBox[{
     "MM", ",", " ", "SS", ",", " ", "Qe", ",", " ", "Qm", ",", " ", "JJ", ",",
       " ", "TT", ",", " ", "\[CapitalOmega]", ",", " ", "\[CapitalPhi]e", ",",
       " ", "\[CapitalPhi]m", ",", " ", "\[Mu]p", ",", " ", "\[Mu]m"}], 
     "}"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"lamPv", ",", " ", "lamMv", ",", " ", "vVv"}], "}"}], " ", "=", 
   " ", 
   RowBox[{"toEx", " ", "/@", " ", 
    RowBox[{"{", 
     RowBox[{"lamP", ",", " ", "lamM", ",", " ", "vV"}], "}"}]}]}], ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Simplify", "[", 
    RowBox[{"Mv", " ", "-", " ", 
     RowBox[{"2", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"Tv", " ", "Sv"}], " ", "+", " ", 
        RowBox[{"Ov", " ", "Jv"}], " ", "-", " ", 
        RowBox[{"pP", " ", "vVv"}]}], ")"}]}], " ", "-", " ", 
     RowBox[{"Fev", " ", "Qev"}], " ", "-", " ", 
     RowBox[{"Fmv", " ", "Qmv"}]}], "]"}], ",", " ", 
   RowBox[{"Simplify", "[", 
    RowBox[{
     RowBox[{"Fmv", " ", "Qev"}], " ", "-", " ", 
     RowBox[{"Fev", " ", "Qmv"}]}], "]"}]}], "}"}]}], "Input",
 CellLabel->"In[23]:=",ExpressionUUID->"f19d0fd9-91d6-4498-8591-be4742339ef8"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"0", ",", "0"}], "}"}]], "Output",
 CellChangeTimes->{3.996915567587614*^9},
 CellLabel->"Out[26]=",ExpressionUUID->"37703c18-0e09-4922-9441-5f02aa6d36e3"]
}, Open  ]],

Cell["\<\
The first law itself, varying all seven parameters of the solution together \
with Newton's constant. Two things make this tractable.

First, kappa is NOT substituted before differentiating -- it is a function of \
the parameters, so it must be varied too. It is kept as a symbol and its \
variation supplied through kappa^2, which is rational: d kappa = \
d(kappa^2)/(2 kappa). That is the operator DT below.

Second, the residuals must not be handed to Simplify. They are rational in \
everything except a single overall kappa, and Simplify tries to rationalise \
the radical globally and returns 10^4-leaf expressions that are zero but do \
not look it. Instead the numerator is expanded, even powers of kappa are \
traded for the rational kappa^2, and Together finishes the job. All eight \
residuals then vanish identically in a few seconds.\
\>", "Text",ExpressionUUID->"1910d593-c0d4-42f4-8fc6-ed665bf3bb8b"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"toEx2", "[", "expr_", "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"expr", " ", "//.", " ", "subst"}], " ", "/.", " ", "XidE"}], 
    " ", "/.", " ", "m2rpE"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"K2ex", " ", "=", " ", 
   RowBox[{"Together", "[", 
    SuperscriptBox["kapEx", "2"], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"DT", "[", 
    RowBox[{"F_", ",", " ", "w_"}], "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"D", "[", 
     RowBox[{"F", ",", " ", "w"}], "]"}], " ", "+", " ", 
    RowBox[{
     RowBox[{"D", "[", 
      RowBox[{"F", ",", " ", "\[Kappa]"}], "]"}], " ", 
     RowBox[{
      RowBox[{"D", "[", 
       RowBox[{"K2ex", ",", " ", "w"}], "]"}], "/", 
      RowBox[{"(", 
       RowBox[{"2", " ", "\[Kappa]"}], ")"}]}]}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"red", "[", "expr_", "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"t", " ", "=", " ", 
        RowBox[{"Together", "[", "expr", "]"}]}], ",", " ", "n"}], "}"}], ",",
      " ", 
     RowBox[{
      RowBox[{"n", " ", "=", " ", 
       RowBox[{
        RowBox[{"Expand", "[", 
         RowBox[{"Numerator", "[", "t", "]"}], "]"}], " ", "/.", " ", 
        RowBox[{
         RowBox[{
          SuperscriptBox["\[Kappa]", "k_Integer"], " ", "/;", " ", 
          RowBox[{"k", " ", ">", " ", "1"}]}], " ", ":>", " ", 
         RowBox[{
          SuperscriptBox["\[Kappa]", 
           RowBox[{"Mod", "[", 
            RowBox[{"k", ",", " ", "2"}], "]"}]], " ", 
          SuperscriptBox["K2ex", 
           RowBox[{"Quotient", "[", 
            RowBox[{"k", ",", " ", "2"}], "]"}]]}]}]}]}], ";", " ", 
      RowBox[{"Together", "[", "n", "]"}]}]}], "]"}]}], ";"}]}], "Input",
 CellLabel->"In[27]:=",ExpressionUUID->"471dc16f-a6d4-4424-8235-9ca4f5293d4d"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{
    "Mv2", ",", " ", "Sv2", ",", " ", "Qev2", ",", " ", "Qmv2", ",", " ", 
     "Jv2", ",", " ", "Tv2", ",", " ", "Ov2", ",", " ", "Fev2", ",", " ", 
     "Fmv2", ",", " ", "mupv2", ",", " ", "mumv2"}], "}"}], " ", "=", " ", 
   RowBox[{"toEx2", " ", "/@", " ", 
    RowBox[{"{", 
     RowBox[{
     "MM", ",", " ", "SS", ",", " ", "Qe", ",", " ", "Qm", ",", " ", "JJ", ",",
       " ", "TT", ",", " ", "\[CapitalOmega]", ",", " ", "\[CapitalPhi]e", ",",
       " ", "\[CapitalPhi]m", ",", " ", "\[Mu]p", ",", " ", "\[Mu]m"}], 
     "}"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"lamPv2", ",", " ", "lamMv2", ",", " ", "vVv2"}], "}"}], " ", "=",
    " ", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"#", " ", "/.", " ", "XidE"}], " ", "/.", " ", "m2rpE"}], 
      ")"}], " ", "&"}], " ", "/@", " ", 
    RowBox[{"{", 
     RowBox[{"lamP", ",", " ", "lamM", ",", " ", "vV"}], "}"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"xiV2", " ", "=", " ", 
   RowBox[{"Mv2", " ", "-", " ", 
    RowBox[{"Tv2", " ", "Sv2"}], " ", "-", " ", 
    RowBox[{"Fev2", " ", "Qev2"}], " ", "-", " ", 
    RowBox[{"Fmv2", " ", "Qmv2"}], " ", "-", " ", 
    RowBox[{"Ov2", " ", "Jv2"}], " ", "+", " ", 
    RowBox[{"lamPv2", " ", "mupv2"}], " ", "+", " ", 
    RowBox[{"lamMv2", " ", "mumv2"}], " ", "-", " ", 
    RowBox[{"pP", " ", "vVv2"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"vars", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
    "rp", ",", " ", "a", ",", " ", "e", ",", " ", "g", ",", " ", "\[Alpha]", ",",
      " ", "\[CapitalDelta]\[Phi]", ",", " ", "l4", ",", " ", "G4"}], "}"}]}],
   ";"}], "\n", 
 RowBox[{
  RowBox[{"res2", " ", "=", " ", 
   RowBox[{"ParallelMap", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"red", "[", 
       RowBox[{
        RowBox[{"DT", "[", 
         RowBox[{"Mv2", ",", " ", "#"}], "]"}], " ", "-", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"Tv2", " ", 
           RowBox[{"DT", "[", 
            RowBox[{"Sv2", ",", " ", "#"}], "]"}]}], " ", "+", " ", 
          RowBox[{"Fev2", " ", 
           RowBox[{"DT", "[", 
            RowBox[{"Qev2", ",", " ", "#"}], "]"}]}], " ", "+", " ", 
          RowBox[{"Fmv2", " ", 
           RowBox[{"DT", "[", 
            RowBox[{"Qmv2", ",", " ", "#"}], "]"}]}], " ", "+", " ", 
          RowBox[{"Ov2", " ", 
           RowBox[{"DT", "[", 
            RowBox[{"Jv2", ",", " ", "#"}], "]"}]}], " ", "-", " ", 
          RowBox[{"lamPv2", " ", 
           RowBox[{"DT", "[", 
            RowBox[{"mupv2", ",", " ", "#"}], "]"}]}], " ", "-", " ", 
          RowBox[{"lamMv2", " ", 
           RowBox[{"DT", "[", 
            RowBox[{"mumv2", ",", " ", "#"}], "]"}]}], " ", "+", " ", 
          RowBox[{"vVv2", " ", 
           RowBox[{"DT", "[", 
            RowBox[{"pP", ",", " ", "#"}], "]"}]}], " ", "-", " ", 
          RowBox[{"xiV2", " ", 
           RowBox[{
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"#", " ", "===", " ", "G4"}], ",", " ", "1", ",", " ", 
              "0"}], "]"}], "/", "G4"}]}]}], ")"}]}], "]"}], " ", "&"}], ",", 
     " ", "vars"}], "]"}]}], ";"}], "\n", 
 RowBox[{"Union", "[", "res2", "]"}]}], "Input",
 CellLabel->"In[31]:=",ExpressionUUID->"8005bff7-7c06-4bbf-879a-480ff47e788a"],

Cell[BoxData[
 RowBox[{"{", "0", "}"}]], "Output",
 CellChangeTimes->{3.9969155849023027`*^9},
 CellLabel->"Out[36]=",ExpressionUUID->"8cfa6f62-f279-41a6-ab54-4a72de37e8bb"]
}, Open  ]],

Cell["\<\
Two companions, so that the vanishing above is not read as vacuous. Without \
the kappa of eq. (3.42) the first law FAILS -- the residual with respect to \
the rotation parameter is nonzero -- so the normalisation is necessary and \
not merely sufficient. And kappa reduces to one when the acceleration is \
switched off, which is the paper's remark that the role of kappa is \
intrinsically tied to acceleration.\
\>", "Text",ExpressionUUID->"1445e13b-ddcc-4933-82dc-d85eeaf05064"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"resNoFix", " ", "=", " ", 
   RowBox[{"red", "[", 
    RowBox[{
     RowBox[{"D", "[", 
      RowBox[{"Mv2", ",", " ", "a"}], "]"}], " ", "-", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"Tv2", " ", 
        RowBox[{"D", "[", 
         RowBox[{"Sv2", ",", " ", "a"}], "]"}]}], " ", "+", " ", 
       RowBox[{"Fev2", " ", 
        RowBox[{"D", "[", 
         RowBox[{"Qev2", ",", " ", "a"}], "]"}]}], " ", "+", " ", 
       RowBox[{"Fmv2", " ", 
        RowBox[{"D", "[", 
         RowBox[{"Qmv2", ",", " ", "a"}], "]"}]}], " ", "+", " ", 
       RowBox[{"Ov2", " ", 
        RowBox[{"D", "[", 
         RowBox[{"Jv2", ",", " ", "a"}], "]"}]}], " ", "-", " ", 
       RowBox[{"lamPv2", " ", 
        RowBox[{"D", "[", 
         RowBox[{"mupv2", ",", " ", "a"}], "]"}]}], " ", "-", " ", 
       RowBox[{"lamMv2", " ", 
        RowBox[{"D", "[", 
         RowBox[{"mumv2", ",", " ", "a"}], "]"}]}], " ", "+", " ", 
       RowBox[{"vVv2", " ", 
        RowBox[{"D", "[", 
         RowBox[{"pP", ",", " ", "a"}], "]"}]}]}], ")"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"resNoFix", " ", "=!=", " ", "0"}], ",", " ", 
   RowBox[{"Simplify", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"kapEx", " ", "/.", " ", 
       RowBox[{"\[Alpha]", " ", "->", " ", "0"}]}], " ", "/.", " ", 
      RowBox[{"l4", " ", "->", " ", "1"}]}], ",", " ", 
     RowBox[{"Assumptions", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"0", " ", "<", " ", "a", " ", "<", " ", "1"}], "}"}]}]}], 
    "]"}]}], "}"}]}], "Input",
 CellLabel->"In[37]:=",ExpressionUUID->"ac748ad7-4e9f-4663-87b3-dad4d882419e"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "1"}], "}"}]], "Output",
 CellChangeTimes->{3.996915585046938*^9},
 CellLabel->"Out[38]=",ExpressionUUID->"76790eb7-cedc-4026-b5c5-3795da92a38a"]
}, Open  ]],

