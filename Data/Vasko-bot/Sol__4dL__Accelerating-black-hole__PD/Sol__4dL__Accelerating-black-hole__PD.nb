Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"sqAng", " ", "=", " ", 
   RowBox[{"Simplify", "[", 
    RowBox[{
     SqrtBox["detAng"], ",", " ", 
     RowBox[{"Assumptions", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"rp", " ", ">", " ", "0"}], ",", " ", 
        RowBox[{
         RowBox[{"\[Alpha]", " ", "rp"}], " ", "<", " ", "1"}], ",", " ", 
        RowBox[{
         RowBox[{"-", "1"}], " ", "<", " ", 
         RowBox[{"x", "[", "]"}], " ", "<", " ", "1"}], ",", " ", 
        RowBox[{"a", " ", ">=", " ", "0"}], ",", " ", 
        RowBox[{
         RowBox[{"1", " ", "+", " ", 
          RowBox[{"\[Alpha]", " ", "rp", " ", 
           RowBox[{"x", "[", "]"}]}]}], " ", ">", " ", "0"}]}], "}"}]}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"SBH", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"\[CapitalDelta]\[Phi]", "/", 
      RowBox[{"(", 
       RowBox[{"4", " ", "G4"}], ")"}]}], " ", 
