            RowBox[{
             RowBox[{
              RowBox[{"fS", "[", 
               RowBox[{"\"\<at\>\"", ",", " ", "k"}], "]"}], "[", "xx", "]"}],
              " ", 
             SuperscriptBox["z", "k"]}], ",", " ", 
            RowBox[{"{", 
             RowBox[{"k", ",", " ", "0", ",", " ", "4"}], "}"}]}], "]"}]}], 
         "}"}]}], ")"}]}], ",", " ", 
     RowBox[{"ap", " ", "->", " ", 
      RowBox[{"(", 
       RowBox[{"Function", " ", "@@", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"z", ",", " ", "xx"}], "}"}], ",", " ", 
          RowBox[{"Sum", "[", 
