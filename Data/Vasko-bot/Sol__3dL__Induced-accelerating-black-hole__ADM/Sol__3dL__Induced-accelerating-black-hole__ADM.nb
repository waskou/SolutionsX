Cell["\<\
The finite part, integrated over the spindle direction. Multiplied by the \
Euclidean time period beta and the azimuthal range Delta phi it is the \
renormalised Euclidean on-shell action I, stored for the four-dimensional \
entry to use in the quantum statistical relation. The sign follows the Wick \
rotation of eq. (3.24), t = -i tau, I = -i S.\
\>", "Text",ExpressionUUID->"8a0fb258-de48-4f54-b2cc-dc62ad87df7f"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"i0R", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"Integrate", "[", 
      RowBox[{
       RowBox[{"SeriesCoefficient", "[", 
        RowBox[{"totSer", ",", " ", "0"}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"x", "[", "]"}], ",", " ", 
         RowBox[{"-", "1"}], ",", " ", "1"}], "}"}]}], "]"}], " ", "//", " ", 
     "Simplify"}], " ", "//", " ", 
    RowBox[{
     RowBox[{"Collect", "[", 
      RowBox[{"#", ",", " ", "\[CurlyTheta]", ",", " ", "Simplify"}], "]"}], 
     " ", "&"}]}]}], ";"}], "\n", 
 RowBox[{"IncludeTo", "[", 
  RowBox[{
   RowBox[{"sol", "[", "$rule", "]"}], ",", " ", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"Symbol", " ", "->", " ", "osaren"}], ",", " ", 
     RowBox[{"Expression", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"II", " ", "->", " ", 
        RowBox[{
         RowBox[{"-", "\[Beta]"}], " ", "\[CapitalDelta]\[Phi]", " ", 
         "i0R"}]}], "}"}]}]}], "|>"}]}], "]"}], "\n", 
 RowBox[{"Keys", "@", 
  RowBox[{"sol", "[", "$rule", "]"}]}]}], "Input",
 CellLabel->
  "In[120]:=",ExpressionUUID->"22128125-d78e-4676-9877-0b266baf755f"],

