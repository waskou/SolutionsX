Cell["\<\
The induced metric on a slice of constant z = zc, the gauge field pulled back \
to it, and F = dA computed rather than typed. The (t,x) and (x,phi) \
components of h vanish identically for this solution, and A has no x \
component -- both are inherited from the bulk and verified below.\
\>", "Text",ExpressionUUID->"ab4ca43e-c024-4a70-b9a1-2212d65df708"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"sol", "[", 
   RowBox[{"$metric", ",", " ", "gg", ",", " ", "Expression"}], "]"}], " ", "=",
   " ", 
  RowBox[{
   RowBox[{
    RowBox[{"htt", "[", 
     RowBox[{"zc", ",", " ", 
      RowBox[{"x", "[", "]"}]}], "]"}], " ", 
    RowBox[{
     RowBox[{"Diff", "[", 
      RowBox[{"t", "[", "]"}], "]"}], "\[CircleTimes]", 
     RowBox[{"Diff", "[", 
      RowBox[{"t", "[", "]"}], "]"}]}]}], " ", "+", " ", 
   RowBox[{
    RowBox[{"htp", "[", 
     RowBox[{"zc", ",", " ", 
      RowBox[{"x", "[", "]"}]}], "]"}], " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"Diff", "[", 
        RowBox[{"t", "[", "]"}], "]"}], "\[CircleTimes]", 
       RowBox[{"Diff", "[", 
        RowBox[{"\[Phi]", "[", "]"}], "]"}]}], " ", "+", " ", 
      RowBox[{
       RowBox[{"Diff", "[", 
