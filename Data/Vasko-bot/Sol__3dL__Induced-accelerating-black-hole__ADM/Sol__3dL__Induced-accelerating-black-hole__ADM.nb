              RowBox[{"k", ",", " ", "0", ",", " ", "5"}], "}"}]}], "]"}], "/", 
           SuperscriptBox["z", "2"]}]}], "}"}]}], ")"}]}], ",", " ", 
     RowBox[{"hpp", " ", "->", " ", 
      RowBox[{"(", 
