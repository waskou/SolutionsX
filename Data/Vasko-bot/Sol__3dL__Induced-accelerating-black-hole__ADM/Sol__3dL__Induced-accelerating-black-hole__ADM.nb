Cell["\<\
The extrinsic curvature, paper eq. (3.4): K_ij = -(1/2N)(d_z h_ij - D_i N_j - \
D_j N_i), with D the Levi-Civita connection of h_ij. The corpus template \
Sol__3dL__Induced-black-hole__FG uses the same formula with the shift dropped \
(Fefferman-Graham gauge); here N^x is nonzero and the two \
covariant-derivative terms must be carried. N_j = h_jx N^x is the shift with \
its index lowered; the Christoffel symbols are the ones just Computed. \
Symmetry of the resulting array is a genuine check on the construction and is \
asserted below.\
\>", "Text",ExpressionUUID->"8c0ce4dd-6674-47c1-a64c-a68172e37700"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"harr", " ", "=", " ", 
   RowBox[{"ToArray", "[", 
    RowBox[{"gg", "[", 
     RowBox[{
      RowBox[{"-", "\[ScriptM]"}], ",", " ", 
      RowBox[{"-", "\[ScriptN]"}]}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Ndn", " ", "=", " ", 
   RowBox[{
    RowBox[{"Nx", "[", 
     RowBox[{"zc", ",", " ", 
      RowBox[{"x", "[", "]"}]}], "]"}], " ", 
    RowBox[{"harr", "[", 
     RowBox[{"[", 
      RowBox[{"All", ",", " ", "2"}], "]"}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"\[CapitalGamma]arr", " ", "=", " ", 
   RowBox[{"ToArray", "[", 
    RowBox[{"Christoffelcd", "[", 
     RowBox[{"\[ScriptM]", ",", " ", 
      RowBox[{"-", "\[ScriptN]"}], ",", " ", 
      RowBox[{"-", "\[ScriptO]"}]}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"scalars", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"t", "[", "]"}], ",", " ", 
     RowBox[{"x", "[", "]"}], ",", " ", 
     RowBox[{"\[Phi]", "[", "]"}]}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"dNdn", " ", "=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"D", "[", 
      RowBox[{
       RowBox[{"Ndn", "[", 
        RowBox[{"[", "j", "]"}], "]"}], ",", " ", 
       RowBox[{"scalars", "[", 
        RowBox[{"[", "i", "]"}], "]"}]}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"i", ",", " ", "3"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"j", ",", " ", "3"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"covdN", " ", "=", " ", 
   RowBox[{"dNdn", " ", "-", " ", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"Sum", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"\[CapitalGamma]arr", "[", 
          RowBox[{"[", 
           RowBox[{"k", ",", " ", "i", ",", " ", "j"}], "]"}], "]"}], " ", 
         RowBox[{"Ndn", "[", 
          RowBox[{"[", "k", "]"}], "]"}]}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"k", ",", " ", "3"}], "}"}]}], "]"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"i", ",", " ", "3"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"j", ",", " ", "3"}], "}"}]}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"$array", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"-", 
      RowBox[{"(", 
       RowBox[{"1", "/", 
        RowBox[{"(", 
         RowBox[{"2", " ", 
          RowBox[{"NN", "[", 
           RowBox[{"zc", ",", " ", 
            RowBox[{"x", "[", "]"}]}], "]"}]}], ")"}]}], ")"}]}], " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"D", "[", 
        RowBox[{"harr", ",", " ", "zc"}], "]"}], " ", "-", " ", "covdN", " ", 
       "-", " ", 
       RowBox[{"Transpose", "[", "covdN", "]"}]}], ")"}]}], " ", "//", " ", 
    "Simplify"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Simplify", "[", 
   RowBox[{"$array", " ", "-", " ", 
    RowBox[{"Transpose", "[", "$array", "]"}]}], "]"}], " ", "===", " ", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"0", ",", " ", "0", ",", " ", "0"}], "}"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{"0", ",", " ", "0", ",", " ", "0"}], "}"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{"0", ",", " ", "0", ",", " ", "0"}], "}"}]}], "}"}]}]}], "Input",\

