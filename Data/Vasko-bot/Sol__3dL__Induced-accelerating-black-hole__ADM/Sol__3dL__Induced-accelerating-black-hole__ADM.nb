Cell["\<\
Stage two. The explicit coefficients of the exact slice data: one Series per \
function, coefficients Together-ed rather than Simplify-ed (Simplify pays a \
rationalisation cost per coefficient that Together does the needed work for). \
The lapse coefficients come from the peeled square root, whose zeroth \
coefficient is one -- asserted rather than assumed.\
\>", "Text",ExpressionUUID->"cf634f54-34ee-4696-8185-cc5833a3b0c7"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"serTab", " ", "=", " ", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"\"\<htt\>\"", " ", "->", " ", 
      RowBox[{"Map", "[", 
       RowBox[{"Together", ",", " ", 
        RowBox[{"Series", "[", 
         RowBox[{"httEx", ",", " ", 
          RowBox[{"{", 
           RowBox[{"z", ",", " ", "0", ",", " ", "3"}], "}"}]}], "]"}]}], 
       "]"}]}], ",", " ", 
     RowBox[{"\"\<htp\>\"", " ", "->", " ", 
      RowBox[{"Map", "[", 
       RowBox[{"Together", ",", " ", 
        RowBox[{"Series", "[", 
         RowBox[{"htpEx", ",", " ", 
          RowBox[{"{", 
           RowBox[{"z", ",", " ", "0", ",", " ", "3"}], "}"}]}], "]"}]}], 
       "]"}]}], ",", " ", 
     RowBox[{"\"\<hpp\>\"", " ", "->", " ", 
      RowBox[{"Map", "[", 
       RowBox[{"Together", ",", " ", 
        RowBox[{"Series", "[", 
         RowBox[{"hppEx", ",", " ", 
          RowBox[{"{", 
           RowBox[{"z", ",", " ", "0", ",", " ", "3"}], "}"}]}], "]"}]}], 
       "]"}]}], ",", " ", 
     RowBox[{"\"\<hxx\>\"", " ", "->", " ", 
      RowBox[{"Map", "[", 
       RowBox[{"Together", ",", " ", 
        RowBox[{"Series", "[", 
         RowBox[{"hxxEx", ",", " ", 
          RowBox[{"{", 
           RowBox[{"z", ",", " ", "0", ",", " ", "3"}], "}"}]}], "]"}]}], 
       "]"}]}], ",", " ", 
     RowBox[{"\"\<nx\>\"", " ", "->", " ", 
      RowBox[{"Map", "[", 
       RowBox[{"Together", ",", " ", 
        RowBox[{"Series", "[", 
         RowBox[{"NxEx", ",", " ", 
          RowBox[{"{", 
           RowBox[{"z", ",", " ", "0", ",", " ", "4"}], "}"}]}], "]"}]}], 
       "]"}]}], ",", " ", 
     RowBox[{"\"\<at\>\"", " ", "->", " ", 
      RowBox[{"Map", "[", 
       RowBox[{"Together", ",", " ", 
        RowBox[{"Series", "[", 
         RowBox[{"atEx", ",", " ", 
          RowBox[{"{", 
           RowBox[{"z", ",", " ", "0", ",", " ", "4"}], "}"}]}], "]"}]}], 
       "]"}]}], ",", " ", 
     RowBox[{"\"\<ap\>\"", " ", "->", " ", 
      RowBox[{"Map", "[", 
       RowBox[{"Together", ",", " ", 
        RowBox[{"Series", "[", 
         RowBox[{"apEx", ",", " ", 
          RowBox[{"{", 
           RowBox[{"z", ",", " ", "0", ",", " ", "4"}], "}"}]}], "]"}]}], 
       "]"}]}], ",", " ", 
     RowBox[{"\"\<nn\>\"", " ", "->", " ", 
      RowBox[{"Map", "[", 
       RowBox[{"Together", ",", " ", 
        RowBox[{"Series", "[", 
         RowBox[{
          SqrtBox[
           RowBox[{
            SuperscriptBox["z", "2"], " ", 
            RowBox[{"N2Ex", "/", 
             SuperscriptBox["l4", "2"]}]}]], ",", " ", 
          RowBox[{"{", 
           RowBox[{"z", ",", " ", "0", ",", " ", "5"}], "}"}]}], "]"}]}], 
       "]"}]}]}], "|>"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"coefOf", "[", 
    RowBox[{"b_", ",", " ", "k_"}], "]"}], " ", ":=", " ", 
   RowBox[{"SeriesCoefficient", "[", 
    RowBox[{
     RowBox[{"serTab", "[", "b", "]"}], ",", " ", 
     RowBox[{"k", " ", "-", " ", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"MemberQ", "[", 
         RowBox[{
          RowBox[{"{", 
           
           RowBox[{"\"\<htt\>\"", ",", " ", "\"\<htp\>\"", ",", 
            " ", "\"\<hpp\>\"", ",", " ", "\"\<hxx\>\""}], "}"}], ",", " ", 
          "b"}], "]"}], ",", " ", "2", ",", " ", "0"}], "]"}]}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"coefSub", " ", "=", " ", 
   RowBox[{"Flatten", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"fS", "[", 
          RowBox[{"b", ",", " ", "k"}], "]"}], " ", "->", " ", 
         RowBox[{"(", 
          RowBox[{"Function", " ", "@@", " ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", "xx", "}"}], ",", " ", 
