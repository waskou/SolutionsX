Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"bdyDens", " ", "=", " ", 
   RowBox[{"Ibdydens", " ", "/.", " ", 
    RowBox[{"Gen", "@", 
     RowBox[{"sol", "[", 
      RowBox[{"$rule", ",", " ", "osabdy"}], "]"}]}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"BantiR", " ", "=", " ", 
   RowBox[{"Ibulkdens", " ", "/.", " ", 
    RowBox[{"Gen", "@", 
     RowBox[{"full", "[", 
      RowBox[{"$rule", ",", " ", "osabulk"}], "]"}]}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"bulkEval", " ", "=", " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"BantiR", " ", "/.", " ", 
      RowBox[{
       RowBox[{"r", "[", "]"}], " ", "->", " ", 
       RowBox[{"1", "/", 
        RowBox[{"(", 
         RowBox[{"zc", " ", "-", " ", 
          RowBox[{"\[Alpha]", " ", 
           RowBox[{"x", "[", "]"}]}]}], ")"}]}]}]}], ")"}], " ", "-", " ", 
    RowBox[{"(", 
     RowBox[{"BantiR", " ", "/.", " ", 
      RowBox[{
       RowBox[{"r", "[", "]"}], " ", "->", " ", "rp"}]}], ")"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"totSer", " ", "=", " ", 
   RowBox[{"Map", "[", 
    RowBox[{"Together", ",", " ", 
     RowBox[{"Series", "[", 
      RowBox[{
       RowBox[{"bulkEval", " ", "+", " ", "bdyDens"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"zc", ",", " ", "0", ",", " ", "0"}], "}"}]}], "]"}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{
    RowBox[{"Integrate", "[", 
     RowBox[{
      RowBox[{"SeriesCoefficient", "[", 
       RowBox[{"totSer", ",", " ", 
        RowBox[{"-", "2"}]}], "]"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"x", "[", "]"}], ",", " ", 
        RowBox[{"-", "1"}], ",", " ", "1"}], "}"}]}], "]"}], " ", "//", " ", 
    "Simplify"}], ",", " ", 
   RowBox[{
    RowBox[{"Integrate", "[", 
     RowBox[{
      RowBox[{"SeriesCoefficient", "[", 
       RowBox[{"totSer", ",", " ", 
        RowBox[{"-", "1"}]}], "]"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"x", "[", "]"}], ",", " ", 
        RowBox[{"-", "1"}], ",", " ", "1"}], "}"}]}], "]"}], " ", "//", " ", 
    "Simplify"}]}], "}"}]}], "Input",
 CellLabel->
