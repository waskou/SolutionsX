              RowBox[{"coefOf", "[", 
               RowBox[{"b", ",", " ", "k"}], "]"}], " ", "/.", " ", 
              RowBox[{
               RowBox[{"x", "[", "]"}], " ", "->", " ", "xx"}]}]}], "}"}]}], 
          ")"}]}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"b", ",", " ", 
          RowBox[{"{", 
           
           RowBox[{"\"\<htt\>\"", ",", " ", "\"\<htp\>\"", ",", 
            " ", "\"\<hpp\>\"", ",", " ", "\"\<hxx\>\""}], "}"}]}], "}"}], ",",
         " ", 
        RowBox[{"{", 
         RowBox[{"k", ",", " ", "0", ",", " ", "5"}], "}"}]}], "]"}], ",", 
      " ", 
      RowBox[{"Table", "[", 
       RowBox[{
