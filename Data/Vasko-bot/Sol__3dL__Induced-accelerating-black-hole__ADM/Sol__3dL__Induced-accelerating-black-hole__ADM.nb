Cell["\<\
The exact ADM data, read off the bulk entry. Writing the bulk line element as \
a quadratic form in the coordinate differentials (CircleTimes -> Times), with \
Diff[r[]] traded for the z and x differentials by r = 1/(z - alpha x), lets \
every ADM component be picked out as a coefficient derivative: h_ij and G_zz, \
G_zx, from which N^x = G_zx/h_xx and N^2 = G_zz - G_zx^2/h_xx. This is \
cheaper and less error-prone than inverting a 4x4 matrix.\
\>", "Text",ExpressionUUID->"b2338834-45d3-4254-9504-722247d39f63"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"funcrule", " ", "=", " ", 
   RowBox[{"Gen", "@", 
    RowBox[{"full", "[", 
     RowBox[{"$rule", ",", " ", "func"}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"rr", " ", "=", " ", 
   RowBox[{"1", "/", 
    RowBox[{"(", 
     RowBox[{"z", " ", "-", " ", 
      RowBox[{"\[Alpha]", " ", 
       RowBox[{"x", "[", "]"}]}]}], ")"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"quad", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"full", "[", 
           RowBox[{"$metric", ",", " ", "gg", ",", " ", "Expression"}], "]"}],
           " ", "/.", " ", "funcrule"}], ")"}], " ", "/.", " ", 
        RowBox[{"CircleTimes", " ", "->", " ", "Times"}]}], ")"}], " ", "/.", 
      " ", 
      RowBox[{
       RowBox[{"Diff", "[", 
        RowBox[{"r", "[", "]"}], "]"}], " ", "->", " ", 
       RowBox[{
        RowBox[{"-", 
         SuperscriptBox["rr", "2"]}], " ", 
        RowBox[{"(", 
         RowBox[{"dzS", " ", "-", " ", 
          RowBox[{"\[Alpha]", " ", 
           RowBox[{"Diff", "[", 
            RowBox[{"x", "[", "]"}], "]"}]}]}], ")"}]}]}]}], " ", "/.", " ", 
     RowBox[{
      RowBox[{"r", "[", "]"}], " ", "->", " ", "rr"}]}], " ", "/.", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"Diff", "[", 
        RowBox[{"t", "[", "]"}], "]"}], " ", "->", " ", "dtS"}], ",", " ", 
      RowBox[{
       RowBox[{"Diff", "[", 
        RowBox[{"x", "[", "]"}], "]"}], " ", "->", " ", "dxS"}], ",", " ", 
      RowBox[{
       RowBox[{"Diff", "[", 
        RowBox[{"\[Phi]", "[", "]"}], "]"}], " ", "->", " ", "dpS"}]}], 
     "}"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"httEx", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"D", "[", 
      RowBox[{"quad", ",", " ", 
       RowBox[{"{", 
        RowBox[{"dtS", ",", " ", "2"}], "}"}]}], "]"}], "/", "2"}], " ", "//",
     " ", "Together"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"htpEx", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"D", "[", 
      RowBox[{
       RowBox[{"D", "[", 
        RowBox[{"quad", ",", " ", "dtS"}], "]"}], ",", " ", "dpS"}], "]"}], "/",
      "2"}], " ", "//", " ", "Together"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"hppEx", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"D", "[", 
      RowBox[{"quad", ",", " ", 
       RowBox[{"{", 
        RowBox[{"dpS", ",", " ", "2"}], "}"}]}], "]"}], "/", "2"}], " ", "//",
     " ", "Together"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"hxxEx", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"D", "[", 
      RowBox[{"quad", ",", " ", 
       RowBox[{"{", 
        RowBox[{"dxS", ",", " ", "2"}], "}"}]}], "]"}], "/", "2"}], " ", "//",
     " ", "Together"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"GzzEx", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"D", "[", 
      RowBox[{"quad", ",", " ", 
       RowBox[{"{", 
        RowBox[{"dzS", ",", " ", "2"}], "}"}]}], "]"}], "/", "2"}], " ", "//",
     " ", "Together"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"GzxEx", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"D", "[", 
      RowBox[{
       RowBox[{"D", "[", 
        RowBox[{"quad", ",", " ", "dzS"}], "]"}], ",", " ", "dxS"}], "]"}], "/",
      "2"}], " ", "//", " ", "Together"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"NxEx", " ", "=", " ", 
   RowBox[{
    RowBox[{"GzxEx", "/", "hxxEx"}], " ", "//", " ", "Together"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"N2Ex", " ", "=", " ", 
   RowBox[{
    RowBox[{"GzzEx", " ", "-", " ", 
     RowBox[{
      SuperscriptBox["GzxEx", "2"], "/", "hxxEx"}]}], " ", "//", " ", 
    "Together"}]}], ";"}]}], "Input",
 CellLabel->"In[36]:=",ExpressionUUID->"824182ea-3be4-433b-bf44-68ef0ee62613"],

