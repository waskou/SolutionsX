        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"z", ",", " ", "xx"}], "}"}], ",", " ", 
          RowBox[{
           RowBox[{"Sum", "[", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"fS", "[", 
                RowBox[{"\"\<hpp\>\"", ",", " ", "k"}], "]"}], "[", "xx", 
               "]"}], " ", 
              SuperscriptBox["z", "k"]}], ",", " ", 
             RowBox[{"{", 
              RowBox[{"k", ",", " ", "0", ",", " ", "5"}], "}"}]}], "]"}], "/", 
           SuperscriptBox["z", "2"]}]}], "}"}]}], ")"}]}], ",", " ", 
     RowBox[{"hxx", " ", "->", " ", 
      RowBox[{"(", 
       RowBox[{"Function", " ", "@@", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"z", ",", " ", "xx"}], "}"}], ",", " ", 
          RowBox[{
           RowBox[{"Sum", "[", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"fS", "[", 
                RowBox[{"\"\<hxx\>\"", ",", " ", "k"}], "]"}], "[", "xx", 
               "]"}], " ", 
              SuperscriptBox["z", "k"]}], ",", " ", 
             RowBox[{"{", 
              RowBox[{"k", ",", " ", "0", ",", " ", "5"}], "}"}]}], "]"}], "/", 
           SuperscriptBox["z", "2"]}]}], "}"}]}], ")"}]}], ",", " ", 
     RowBox[{"NN", " ", "->", " ", 
      RowBox[{"(", 
       RowBox[{"Function", " ", "@@", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"z", ",", " ", "xx"}], "}"}], ",", " ", 
          RowBox[{
           RowBox[{"l4", "/", "z"}], " ", 
           RowBox[{"(", 
            RowBox[{"1", " ", "+", " ", 
             RowBox[{"Sum", "[", 
