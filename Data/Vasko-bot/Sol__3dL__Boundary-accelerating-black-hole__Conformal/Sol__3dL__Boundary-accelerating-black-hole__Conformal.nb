Cell["\<\
The boundary metric and gauge field, taken from the induced entry rather than \
retyped: gbdy is the zeroth coefficient of eps^2 h_ij and Abdy0 the zeroth \
coefficient of the pulled-back gauge field. In the paper these are eqs. (3.7) \
and (3.10), written there in the polar angle; here they are already \
polynomial in the chart scalar x[] (cos theta = -x).\
\>", "Text",ExpressionUUID->"80e12dac-4edb-4df2-9dd7-53a24d602047"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"b0", " ", "=", " ", 
   RowBox[{"gbdy", " ", "/.", " ", 
    RowBox[{"Gen", "@", 
     RowBox[{"bdy", "[", 
      RowBox[{"$rule", ",", " ", "bdyg"}], "]"}]}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"A0", " ", "=", " ", 
   RowBox[{"Abdy0", " ", "/.", " ", 
    RowBox[{"Gen", "@", 
     RowBox[{"bdy", "[", 
      RowBox[{"$rule", ",", " ", "Abdy"}], "]"}]}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"scal", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"t", "[", "]"}], ",", " ", 
     RowBox[{"x", "[", "]"}], ",", " ", 
     RowBox[{"\[Phi]", "[", "]"}]}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"sol", "[", 
   RowBox[{"$metric", ",", " ", "gg", ",", " ", "Expression"}], "]"}], " ", "=",
   " ", 
  RowBox[{
   RowBox[{"Sum", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"b0", "[", 
       RowBox[{"[", 
        RowBox[{"i", ",", " ", "j"}], "]"}], "]"}], " ", 
      RowBox[{
       RowBox[{"Diff", "[", 
        RowBox[{"scal", "[", 
         RowBox[{"[", "i", "]"}], "]"}], "]"}], "\[CircleTimes]", 
       RowBox[{"Diff", "[", 
        RowBox[{"scal", "[", 
         RowBox[{"[", "j", "]"}], "]"}], "]"}]}]}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"i", ",", " ", "3"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"j", ",", " ", "3"}], "}"}]}], "]"}], " ", "//", " ", 
   "Simplify"}]}], "\n", 
 RowBox[{
  RowBox[{"sol", "[", 
   RowBox[{"$form", ",", " ", "A", ",", " ", "Expression"}], "]"}], " ", "=", 
  " ", 
  RowBox[{
   RowBox[{
    RowBox[{"A0", "[", 
     RowBox[{"[", "1", "]"}], "]"}], " ", 
    RowBox[{"Diff", "[", 
     RowBox[{"t", "[", "]"}], "]"}]}], " ", "+", " ", 
   RowBox[{
    RowBox[{"A0", "[", 
     RowBox[{"[", "3", "]"}], "]"}], " ", 
    RowBox[{"Diff", "[", 
     RowBox[{"\[Phi]", "[", "]"}], "]"}]}]}]}], "\n", 
 RowBox[{
  RowBox[{"sol", "[", 
   RowBox[{"$form", ",", " ", "F", ",", " ", "Expression"}], "]"}], " ", "=", 
  " ", 
  RowBox[{"Diff", "[", 
   RowBox[{"sol", "[", 
    RowBox[{"$form", ",", " ", "A", ",", " ", "Expression"}], "]"}], 
   "]"}]}]}], "Input",
 CellLabel->"In[10]:=",ExpressionUUID->"f0cf171b-358d-47b0-9f1f-e26cde089c1f"],

