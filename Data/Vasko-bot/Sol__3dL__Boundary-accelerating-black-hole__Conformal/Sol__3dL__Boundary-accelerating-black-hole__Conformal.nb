Cell["\<\
Here the components are explicit rationals in x[] and the seven parameters, \
not abstract functions, so the apply-map recipe changes: a cheap sequential \
Together followed by a parallel Simplify. On this geometry that is the \
fastest of the recipes tried -- Simplify alone in the sequential slot pays \
the rationalisation cost twice.\
\>", "Text",ExpressionUUID->"e107217c-2d34-414b-a70d-70531ba69f09"],

Cell[BoxData[
 RowBox[{
  RowBox[{"$Apply", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Map", " ", "->", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"Together", "[", "#", "]"}], " ", "&"}], ")"}]}], ",", " ", 
     RowBox[{"ParallelMap", " ", "->", " ", "Simplify"}]}], "}"}]}], 
  ";"}]], "Input",
 CellLabel->"In[21]:=",ExpressionUUID->"a99ff315-9078-45b2-9362-f502f7c5f513"],

