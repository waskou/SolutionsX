Cell[CellGroupData[{

Cell["Conformal flatness", "Section",ExpressionUUID->"9e93f4bd-bd07-4249-9ba1-360dd6ea192e"],

Cell["\<\
The paper emphasises that the boundary is generically NOT conformally flat, \
in contrast with the non-accelerating case. In three dimensions the \
obstruction is the Cotton tensor, the curl of the Schouten tensor S_ij = R_ij \
- (1/4) R h_ij. It is built here by hand from the stored Ricci and \
Christoffel arrays (note that Cot is a protected built-in symbol, hence the \
name cotT).

Generically it does not vanish. It does vanish in the two special cases the \
paper names: zero acceleration, and vanishing m, e, g. The nonvanishing is \
asserted on a random rational point rather than by eye.\
\>", "Text",ExpressionUUID->"9ce03135-60a7-4442-b24e-33421dd135d2"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ricb", " ", "=", " ", 
   RowBox[{"ToArray", "[", 
    RowBox[{"Riccicd", "[", 
     RowBox[{
      RowBox[{"-", "\[ScriptM]"}], ",", " ", 
      RowBox[{"-", "\[ScriptN]"}]}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"rsb", " ", "=", " ", 
   RowBox[{"ToArray", "[", 
    RowBox[{"RicciScalarcd", "[", "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Gamb", " ", "=", " ", 
   RowBox[{"ToArray", "[", 
    RowBox[{"Christoffelcd", "[", 
     RowBox[{"\[ScriptM]", ",", " ", 
      RowBox[{"-", "\[ScriptN]"}], ",", " ", 
      RowBox[{"-", "\[ScriptO]"}]}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Sch", " ", "=", " ", 
   RowBox[{"ricb", " ", "-", " ", 
    RowBox[{
     RowBox[{"1", "/", "4"}], " ", "rsb", " ", "b0dn"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"covS", " ", "=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"D", "[", 
       RowBox[{
        RowBox[{"Sch", "[", 
         RowBox[{"[", 
          RowBox[{"i", ",", " ", "j"}], "]"}], "]"}], ",", " ", 
        RowBox[{"scal", "[", 
         RowBox[{"[", "k", "]"}], "]"}]}], "]"}], " ", "-", " ", 
      RowBox[{"Sum", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"Gamb", "[", 
           RowBox[{"[", 
            RowBox[{"l", ",", " ", "k", ",", " ", "i"}], "]"}], "]"}], " ", 
          RowBox[{"Sch", "[", 
           RowBox[{"[", 
            RowBox[{"l", ",", " ", "j"}], "]"}], "]"}]}], " ", "+", " ", 
         RowBox[{
          RowBox[{"Gamb", "[", 
           RowBox[{"[", 
            RowBox[{"l", ",", " ", "k", ",", " ", "j"}], "]"}], "]"}], " ", 
          RowBox[{"Sch", "[", 
           RowBox[{"[", 
            RowBox[{"i", ",", " ", "l"}], "]"}], "]"}]}]}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"l", ",", " ", "3"}], "}"}]}], "]"}]}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"i", ",", " ", "3"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"j", ",", " ", "3"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"k", ",", " ", "3"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"cotT", " ", "=", " ", 
   RowBox[{"Table", "[", 
