      RowBox[{"r", "[", "]"}], "]"}]], 
    RowBox[{
     RowBox[{"Diff", "[", 
      RowBox[{"r", "[", "]"}], "]"}], "\[CircleTimes]", 
     RowBox[{"Diff", "[", 
      RowBox[{"r", "[", "]"}], "]"}]}]}], "+", 
   RowBox[{
    SuperscriptBox[
     RowBox[{"r", "[", "]"}], "2"], 
