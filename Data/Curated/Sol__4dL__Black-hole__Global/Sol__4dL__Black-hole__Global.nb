 RowBox[{
  RowBox[{"sol", "[", 
   RowBox[{"$metric", ",", "gg", ",", "Expression"}], "]"}], "=", 
  RowBox[{
   RowBox[{
    RowBox[{"-", 
     RowBox[{"U", "[", 
      RowBox[{"r", "[", "]"}], "]"}]}], 
