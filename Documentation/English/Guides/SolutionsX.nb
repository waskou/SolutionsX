Cell[CellGroupData[{

Cell["Building a solution", "GuideFunctionsSubsection",
 CellID->1307,ExpressionUUID->"8c2b1e31-a978-4573-853b-506a0f2afe9a"],

Cell["\<\
A solution is an association over eighteen object types. Each entry records \
the arguments of an xAct definition, so that it can be stored and replayed.\
\>", "GuideText",
 CellID->1308,ExpressionUUID->"8404c87d-5b4b-42a0-bf05-9d3fd986fdfd"],

