Cell[CellGroupData[{

Cell["SolutionsX", "GuideTitle",
 CellID->1278,ExpressionUUID->"1d124c37-aae3-456d-98e4-96b5784be9f5"],

Cell["Storing, verifying and reusing supergravity solutions.", "GuideAbstract",
 CellID->1279,ExpressionUUID->"51f51266-aafa-4bd3-b4ac-3eba1022eb3d"],

Cell["\<\
xAct defines geometric objects by mutating global kernel state, which cannot \
be saved. SolutionsX keeps, instead, an association recording the arguments \
of every definition you would have made, and replays it on demand. The \
association is ordinary data, so it compresses to a file; replaying it \
reconstructs the same xAct state, together with the components already \
computed and the recipes that produced them.\
\>", "GuideAbstract",
 CellID->1280,ExpressionUUID->"8b557060-5599-49b8-bdc8-bfa20bde3a34"],

Cell["\t", "GuideDelimiterSubsection",
 CellID->1281,ExpressionUUID->"488d47a1-d7b5-4a08-bd10-7eb00cd84e00"],

