Cell[BoxData[
 RowBox[{"Compute", "[", 
  RowBox[{
   RowBox[{"sol", "[", 
    RowBox[{"$tensor", ",", " ", "VV", ",", " ", "$auto", ",", " ", "VV"}], 
    "]"}], ",", " ", 
   RowBox[{"Chain", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"HoldForm", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"1", "/", "3"}], ",", " ", 
         RowBox[{"1", "/", "3"}], ",", " ", 
         RowBox[{"1", "/", "3"}]}], "}"}], "]"}], " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"{", 
        RowBox[{"-", "1"}], "}"}], "}"}]}], "}"}]}], ",", " ", 
   RowBox[{"Apply", " ", "->", " ", 
