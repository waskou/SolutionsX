Cell[TextData[{
 "We now use ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Compute"]], "paclet:VasilDimitrov/SolutionsX/ref/Compute", 
    "VasilDimitrov Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "98e63fb5-eb94-4827-8ebe-c4cc8a7da64d"],
 " to assign rules to the components of XX. Compute takes as arguments: the \
target sol[$tensor, XX, $auto, XX], and optionally a Chain and an Apply. \
Chain points to a list of rules. On the LHS\[CloseCurlyQuote]s we have arrays \
wrapped in ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["HoldForm"]], "paclet:ref/HoldForm"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "dda50c7a-88c8-4671-9d53-070e41cb8c4e"],
 " and on the RHS\[CloseCurlyQuote]s we have the desired slot this array \
fills up. Presently, the slots are: {1} to represent the upper component, and \
{-1} to represent the lower component. These are further wrapped into {} for \
reasons that will become clear below. Apply is the function that will be \
applied when computing each component. At present this is the trivial \
function Identity."
}], "Text",
 CellID->1561,ExpressionUUID->"57f3fc2e-10c2-4104-985d-6fd4eb6f3864"],

Cell[BoxData[
 RowBox[{"Compute", "[", 
  RowBox[{
   RowBox[{"sol", "[", 
    RowBox[{"$tensor", ",", " ", "XX", ",", " ", "$auto", ",", " ", "XX"}], 
    "]"}], ",", " ", 
   RowBox[{"Chain", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"HoldForm", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"XX", "[", 
           RowBox[{"{", 
            RowBox[{"1", ",", " ", "internal"}], "}"}], "]"}], ",", " ", 
          RowBox[{"XX", "[", 
           RowBox[{"{", 
            RowBox[{"2", ",", " ", "internal"}], "}"}], "]"}], ",", " ", 
          RowBox[{"1", "/", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"XX", "[", 
              RowBox[{"{", 
               RowBox[{"1", ",", " ", "internal"}], "}"}], "]"}], " ", 
             RowBox[{"XX", "[", 
              RowBox[{"{", 
               RowBox[{"2", ",", " ", "internal"}], "}"}], "]"}]}], ")"}]}]}],
          "}"}], "]"}], " ", "->", " ", 
       RowBox[{"{", 
        RowBox[{"{", "1", "}"}], "}"}]}], ",", " ", 
      RowBox[{
       RowBox[{"HoldForm", "[", 
        RowBox[{
         RowBox[{"1", "/", "3"}], " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"XX", "[", 
             RowBox[{"{", 
              RowBox[{"1", ",", " ", "internal"}], "}"}], "]"}], "^", 
            RowBox[{"-", "1"}]}], ",", " ", 
           RowBox[{
            RowBox[{"XX", "[", 
             RowBox[{"{", 
              RowBox[{"2", ",", " ", "internal"}], "}"}], "]"}], "^", 
            RowBox[{"-", "1"}]}], ",", " ", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"1", "/", 
              RowBox[{"(", 
               RowBox[{
