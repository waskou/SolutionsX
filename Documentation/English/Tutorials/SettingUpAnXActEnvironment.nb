Cell[CellGroupData[{

Cell["Setting up an xAct environment", "Title",
 CellID->1456,ExpressionUUID->"65cffe26-d24a-4c9d-9594-fde3f92a13a2"],

Cell["\<\
In this Tech Note we will build up the xAct environment corresponding to the \
5d gauged supergravity coupled to two vector multiplets, otherwise known as \
the STU model.\
\>", "Text",
 CellID->1457,ExpressionUUID->"1f3f6de5-9a03-4e4f-ba9c-a90298b8a342"],

Cell["Load the package:", "MathCaption",
 CellID->1458,ExpressionUUID->"a95a7cf6-034a-4401-9480-5f378624917e"],

Cell[BoxData[
 RowBox[{"<<", " ", "VasilDimitrov`SolutionsX`"}]], "Input",
 CellLabel->"In[1]:=",
 CellID->1459,ExpressionUUID->"a2d437ac-aad7-47f7-b6a8-29dce1cb64d0"],

Cell[TextData[{
 "The very first thing we do is pick up a free symbol and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Instantiate"]], 
    "paclet:VasilDimitrov/SolutionsX/ref/Instantiate", 
    "VasilDimitrov Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "90fb2b90-7122-42d1-b38a-de5a4a0e5d04"],
 " it."
}], "Text",
 CellID->1460,ExpressionUUID->"a396e333-d0e7-456f-b019-0b57a7446e3b"],

Cell[BoxData[
 RowBox[{"Instantiate", "[", "sol", "]"}]], "Input",
 CellLabel->"In[2]:=",
 CellID->1461,ExpressionUUID->"317ceae4-ac9e-4f03-96e0-4f01c857ec3a"],

Cell["\<\
At this point sol is given the value of an \[OpenCurlyDoubleQuote]empty\
\[CloseCurlyDoubleQuote] association, and the following functions can act on \
it:\
\>", "Text",
 CellID->1462,ExpressionUUID->"6660b8de-a61f-4ec3-9b47-b6e30d22914e"],

Cell[CellGroupData[{

Cell[BoxData["sol"], "Input",
 CellLabel->"In[3]:=",
 CellID->1463,ExpressionUUID->"58984b6e-b4b0-4b5a-b31f-3312e0e220ef"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"$manifold", "\[Rule]", 
    RowBox[{"\[LeftAssociation]", "\[RightAssociation]"}]}], ",", 
   RowBox[{"$parameter", "\[Rule]", 
    RowBox[{"\[LeftAssociation]", "\[RightAssociation]"}]}], ",", 
   RowBox[{"$metric", "\[Rule]", 
    RowBox[{"\[LeftAssociation]", "\[RightAssociation]"}]}], ",", 
   RowBox[{"$frame", "\[Rule]", 
    RowBox[{"\[LeftAssociation]", "\[RightAssociation]"}]}], ",", 
   RowBox[{"$spinStructure", "\[Rule]", 
    RowBox[{"\[LeftAssociation]", "\[RightAssociation]"}]}], ",", 
   RowBox[{"$spinConnection", "\[Rule]", 
    RowBox[{"\[LeftAssociation]", "\[RightAssociation]"}]}], ",", 
   RowBox[{"$bundle", "\[Rule]", 
    RowBox[{"\[LeftAssociation]", "\[RightAssociation]"}]}], ",", 
   RowBox[{"$covd", "\[Rule]", 
    RowBox[{"\[LeftAssociation]", "\[RightAssociation]"}]}], ",", 
   RowBox[{"$chart", "\[Rule]", 
    RowBox[{"\[LeftAssociation]", "\[RightAssociation]"}]}], ",", 
   RowBox[{"$basis", "\[Rule]", 
    RowBox[{"\[LeftAssociation]", "\[RightAssociation]"}]}], ",", 
   RowBox[{"$form", "\[Rule]", 
    RowBox[{"\[LeftAssociation]", "\[RightAssociation]"}]}], ",", 
   RowBox[{"$tensor", "\[Rule]", 
    RowBox[{"\[LeftAssociation]", "\[RightAssociation]"}]}], ",", 
   RowBox[{"$spinor", "\[Rule]", 
    RowBox[{"\[LeftAssociation]", "\[RightAssociation]"}]}], ",", 
   RowBox[{"$function", "\[Rule]", 
    RowBox[{"\[LeftAssociation]", "\[RightAssociation]"}]}], ",", 
   RowBox[{"$constant", "\[Rule]", 
    RowBox[{"\[LeftAssociation]", "\[RightAssociation]"}]}], ",", 
   RowBox[{"$assumption", "\[Rule]", 
    RowBox[{"\[LeftAssociation]", "\[RightAssociation]"}]}], ",", 
   RowBox[{"$rule", "\[Rule]", 
    RowBox[{"\[LeftAssociation]", "\[RightAssociation]"}]}], ",", 
   RowBox[{"$set", "\[Rule]", 
    RowBox[{"\[LeftAssociation]", "\[RightAssociation]"}]}]}], 
  "\[RightAssociation]"}]], "Output",
 CellLabel->"Out[3]=",
 CellID->1464,ExpressionUUID->"6d37f24b-030c-4985-b88a-23e523b93caa"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"UpValues", "[", "sol", "]"}], "[", 
   RowBox[{"[", 
