Cell["\<\
In the STU model only 2 of the 3 scalars are independent. It is standard \
practice to express some expressions in terms of these independent scalars. \
We use SolutionsX\[CloseCurlyQuote]s rule system to include the following:\
\>", "Text",
 CellID->1781,ExpressionUUID->"6df3e3a6-ab3f-4f0f-9a87-3b1b2b9e9c5d"],

Cell[BoxData[
 RowBox[{"IncludeTo", "[", 
  RowBox[{
   RowBox[{"sol", "[", "$rule", "]"}], ",", " ", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"Symbol", " ", "->", " ", "XX2\[Phi]"}], ",", " ", 
     RowBox[{"Expression", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"XX", "[", 
          RowBox[{"{", 
           RowBox[{"1", ",", " ", "internal"}], "}"}], "]"}], " ", "->", " ", 
         
         RowBox[{"E", "^", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"-", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"\[Phi]1", "[", "]"}], "/", 
               RowBox[{"Sqrt", "[", "6", "]"}]}], ")"}]}], " ", "-", " ", 
            RowBox[{
             RowBox[{"\[Phi]2", "[", "]"}], "/", 
             RowBox[{"Sqrt", "[", "2", "]"}]}]}], ")"}]}]}], ",", " ", 
        RowBox[{
         RowBox[{"XX", "[", 
          RowBox[{"{", 
           RowBox[{"2", ",", " ", "internal"}], "}"}], "]"}], " ", "->", " ", 
         
         RowBox[{"E", "^", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"-", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"\[Phi]1", "[", "]"}], "/", 
               RowBox[{"Sqrt", "[", "6", "]"}]}], ")"}]}], " ", "+", " ", 
            RowBox[{
             RowBox[{"\[Phi]2", "[", "]"}], "/", 
             RowBox[{"Sqrt", "[", "2", "]"}]}]}], ")"}]}]}], ",", " ", 
        RowBox[{
         RowBox[{"XX", "[", 
          RowBox[{"{", 
           RowBox[{"3", ",", " ", "internal"}], "}"}], "]"}], " ", "->", " ", 
         
         RowBox[{"E", "^", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"2", "/", 
             RowBox[{"Sqrt", "[", "6", "]"}]}], " ", 
            RowBox[{"\[Phi]1", "[", "]"}]}], ")"}]}]}]}], "}"}]}]}], "|>"}]}],
   "]"}]], "Input",
