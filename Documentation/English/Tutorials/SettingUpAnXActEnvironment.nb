}, Open  ]],

Cell["Manifold and metric", "Section",
 CellID->1636,ExpressionUUID->"9b27136c-accc-4344-812b-592ca8ce977c"],

Cell[TextData[{
 "We don\[CloseCurlyQuote]t simply append to sol using Mathematica\
\[CloseCurlyQuote]s built-in functions. Instead we have to use SolutionsX\
\[CloseCurlyQuote]s ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["IncludeTo"]], "paclet:VasilDimitrov/SolutionsX/ref/IncludeTo", 
    "VasilDimitrov Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "111ab5f7-0238-4da3-94d7-90591b876249"],
 ". First we will include a ",
 Cell[BoxData["$manifold"], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "1c1871af-0a5e-4e95-a1d0-950ab5bc431a"],
 " object \[LongDash] the object system is the subject of ",
 ButtonBox["Objects in SolutionsX",
  BaseStyle->"Link",
  ButtonData->
   "paclet:VasilDimitrov/SolutionsX/tutorial/ObjectsInSolutionsX"],
 ". The first argument of IncludeTo is ",
 Cell[BoxData[
  RowBox[{"sol", "[", "$object", "]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "679ba68f-66a2-431c-ab2a-56766143b58f"],
 " and the second argument is the object we are including."
}], "Text",
 CellID->1637,ExpressionUUID->"d7215002-835b-4ca3-ab23-d49c443d90a3"],

Cell[BoxData[
 RowBox[{"IncludeTo", "[", 
  RowBox[{
   RowBox[{"sol", "[", "$manifold", "]"}], ",", " ", 
   RowBox[{"$manifold", "[", 
    RowBox[{
     RowBox[{"Symbol", " ", "->", " ", "\[ScriptCapitalM]"}], ",", " ", 
     RowBox[{"Dimension", " ", "->", " ", "5"}], ",", " ", 
     RowBox[{"Index", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
       "\[ScriptM]", ",", " ", "\[ScriptN]", ",", " ", "\[ScriptO]", ",", " ",
         "\[ScriptP]", ",", " ", "\[ScriptQ]", ",", " ", "\[ScriptR]", ",", 
        " ", "\[ScriptS]"}], "}"}]}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[5]:=",
 CellID->1638,ExpressionUUID->"bd2a28a3-df37-46a8-aa5d-c1bb818aa8d5"],

Cell["\<\
Under the hood IncludeTo does two things: 1) it includes the object \
association into the appropriate slot in sol, 2) it loads the xAct object \
corresponding to it. In a live session IncludeTo prints a panel of everything \
xAct defined \[LongDash] blue clickable symbols which expand the information \
about each entity. In the present example it defined the manifold \
\[ScriptCapitalM], its tangent bundle Tangent\[ScriptCapitalM], and the \
indices that we specified: \[ScriptM],\[ScriptN],\[Ellipsis]; query them with \
?\[ScriptCapitalM], ?Tangent\[ScriptCapitalM], ?\[ScriptM].\
\>", "Text",
 CellID->1639,ExpressionUUID->"c8c14ad6-28d9-4238-804c-ae7ef2ca2b42"],

Cell["\<\
At this point the $manifold slot of sol is an association whose key is \
created from the Symbol key of whatever we included, and the value is the \
association corresponding to the manifold object:\
\>", "Text",
 CellID->1640,ExpressionUUID->"26ee161c-82ad-41da-9444-f4217560ccd4"],

Cell[CellGroupData[{

Cell[BoxData["sol"], "Input",
 CellLabel->"In[6]:=",
 CellID->1641,ExpressionUUID->"278226ed-1350-4916-be7b-d7fe276a22f4"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"$manifold", "\[Rule]", 
    RowBox[{"\[LeftAssociation]", 
     RowBox[{"\[ScriptCapitalM]", "\[Rule]", 
      RowBox[{"\[LeftAssociation]", 
       RowBox[{
        RowBox[{"Symbol", "\[Rule]", "\[ScriptCapitalM]"}], ",", 
        RowBox[{"Dimension", "\[Rule]", "5"}], ",", 
        RowBox[{"Index", "\[Rule]", 
         RowBox[{"{", 
          RowBox[{
          "\[ScriptM]", ",", "\[ScriptN]", ",", "\[ScriptO]", ",", 
           "\[ScriptP]", ",", "\[ScriptQ]", ",", "\[ScriptR]", ",", 
           "\[ScriptS]"}], "}"}]}], ",", 
        RowBox[{"Name", "\[Rule]", "name"}], ",", 
        RowBox[{"Master", "\[Rule]", "Null"}], ",", 
        RowBox[{"PrintAs", "\[Rule]", "Identity"}], ",", 
        RowBox[{"ProtectNewSymbol", "\[RuleDelayed]", 
         RowBox[{"ScreenDollarIndices", "[", "$ProtectNewSymbols", "]"}]}], 
        ",", 
        RowBox[{"DefInfo", "\[Rule]", 
         RowBox[{"{", 
          RowBox[{"\<\"manifold\"\>", ",", "\<\"\"\>"}], "}"}]}]}], 
       "\[RightAssociation]"}]}], "\[RightAssociation]"}]}], ",", 
   RowBox[{"$parameter", "\[Rule]", 
    RowBox[{"\[LeftAssociation]", "\[RightAssociation]"}]}], ",", 
   RowBox[{"$metric", "\[Rule]", 
    RowBox[{"\[LeftAssociation]", "\[RightAssociation]"}]}], ",", 
   RowBox[{"$frame", "\[Rule]", 
    RowBox[{"\[LeftAssociation]", "\[RightAssociation]"}]}], ",", 
   RowBox[{"$spinStructure", "\[Rule]", 
    RowBox[{"\[LeftAssociation]", "\[RightAssociation]"}]}], ",", 
   RowBox[{"$spinConnection", "\[Rule]", 
    RowBox[{"\[LeftAssociation]", "\[RightAssociation]"}]}], ",", 
   RowBox[{"$bundle", "\[Rule]", 
    RowBox[{"\[LeftAssociation]", "\[RightAssociation]"}]}], ",", 
   RowBox[{"$covd", "\[Rule]", 
    RowBox[{"\[LeftAssociation]", "\[RightAssociation]"}]}], ",", 
   RowBox[{"$chart", "\[Rule]", 
    RowBox[{"\[LeftAssociation]", "\[RightAssociation]"}]}], ",", 
   RowBox[{"$basis", "\[Rule]", 
    RowBox[{"\[LeftAssociation]", "\[RightAssociation]"}]}], ",", 
   RowBox[{"$form", "\[Rule]", 
    RowBox[{"\[LeftAssociation]", "\[RightAssociation]"}]}], ",", 
   RowBox[{"$tensor", "\[Rule]", 
    RowBox[{"\[LeftAssociation]", "\[RightAssociation]"}]}], ",", 
   RowBox[{"$spinor", "\[Rule]", 
    RowBox[{"\[LeftAssociation]", "\[RightAssociation]"}]}], ",", 
   RowBox[{"$function", "\[Rule]", 
    RowBox[{"\[LeftAssociation]", "\[RightAssociation]"}]}], ",", 
   RowBox[{"$constant", "\[Rule]", 
    RowBox[{"\[LeftAssociation]", "\[RightAssociation]"}]}], ",", 
   RowBox[{"$assumption", "\[Rule]", 
    RowBox[{"\[LeftAssociation]", "\[RightAssociation]"}]}], ",", 
   RowBox[{"$rule", "\[Rule]", 
    RowBox[{"\[LeftAssociation]", "\[RightAssociation]"}]}], ",", 
   RowBox[{"$set", "\[Rule]", 
    RowBox[{"\[LeftAssociation]", "\[RightAssociation]"}]}]}], 
  "\[RightAssociation]"}]], "Output",
 CellLabel->"Out[6]=",
 CellID->1642,ExpressionUUID->"ff483a13-0ad8-48ff-9653-e1cc9ebcce8c"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"sol", "[", 
  RowBox[{"$manifold", ",", " ", "\[ScriptCapitalM]"}], "]"}]], "Input",
 CellLabel->"In[7]:=",
 CellID->1643,ExpressionUUID->"1e6e4e9c-9975-4c31-9b49-028556392093"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"Symbol", "\[Rule]", "\[ScriptCapitalM]"}], ",", 
   RowBox[{"Dimension", "\[Rule]", "5"}], ",", 
   RowBox[{"Index", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
     "\[ScriptM]", ",", "\[ScriptN]", ",", "\[ScriptO]", ",", "\[ScriptP]", 
      ",", "\[ScriptQ]", ",", "\[ScriptR]", ",", "\[ScriptS]"}], "}"}]}], ",", 
   RowBox[{"Name", "\[Rule]", "name"}], ",", 
   RowBox[{"Master", "\[Rule]", "Null"}], ",", 
   RowBox[{"PrintAs", "\[Rule]", "Identity"}], ",", 
   RowBox[{"ProtectNewSymbol", "\[RuleDelayed]", 
    RowBox[{"ScreenDollarIndices", "[", "$ProtectNewSymbols", "]"}]}], ",", 
   RowBox[{"DefInfo", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"\<\"manifold\"\>", ",", "\<\"\"\>"}], "}"}]}]}], 
  "\[RightAssociation]"}]], "Output",
 CellLabel->"Out[7]=",
 CellID->1644,ExpressionUUID->"a618b7cd-bf9c-4830-82a0-acf55dab177b"]
}, Open  ]],

Cell[TextData[{
 "SolutionsX has another syntax for including objects. To demonstrate, we \
first drop the object with ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DropFrom"]], "paclet:VasilDimitrov/SolutionsX/ref/DropFrom", 
    "VasilDimitrov Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "a8a1bcc3-ebda-41d3-81e7-b5829b1f1d2f"],
 " and include it again with the alternative syntax (and with more indices in \
the list)."
}], "Text",
 CellID->1645,ExpressionUUID->"506de142-734e-4590-ba14-05ab03b74521"],

Cell[BoxData[
 RowBox[{"DropFrom", "[", 
  RowBox[{
   RowBox[{"sol", "[", "$manifold", "]"}], ",", " ", "\[ScriptCapitalM]"}], 
  "]"}]], "Input",
 CellLabel->"In[8]:=",
 CellID->1646,ExpressionUUID->"57b0f236-b5a3-4604-b6ba-f930a63dad33"],

Cell[BoxData[
 RowBox[{"IncludeTo", "[", 
  RowBox[{
   RowBox[{"sol", "[", "$manifold", "]"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"Symbol", " ", "->", " ", "\[ScriptCapitalM]"}], ",", " ", 
      RowBox[{"Dimension", " ", "->", " ", "5"}], ",", " ", 
      RowBox[{"Index", " ", "->", " ", 
       RowBox[{"{", 
        RowBox[{
        "\[ScriptM]", ",", " ", "\[ScriptN]", ",", " ", "\[ScriptO]", ",", 
         " ", "\[ScriptP]", ",", " ", "\[ScriptQ]", ",", " ", "\[ScriptR]", 
         ",", " ", "\[ScriptS]", ",", " ", "\[ScriptT]", ",", " ", 
         "\[ScriptU]", ",", " ", "\[ScriptV]", ",", " ", "\[ScriptW]", ",", 
         " ", "\[ScriptX]", ",", " ", "\[ScriptY]", ",", " ", "\[ScriptZ]"}], 
        "}"}]}]}], "|>"}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[9]:=",
 CellID->1647,ExpressionUUID->"ec8390b6-5d69-47c9-a7ab-7185bd06a61a"],

Cell["Next we include a metric:", "MathCaption",
 CellID->1648,ExpressionUUID->"14a80e5e-80fd-42b3-a6f2-c92af4e52edd"],

Cell[BoxData[
 RowBox[{"IncludeTo", "[", 
  RowBox[{
   RowBox[{"sol", "[", "$metric", "]"}], ",", " ", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"Signature", " ", "->", " ", 
      RowBox[{"-", "1"}]}], ",", " ", 
     RowBox[{"Symbol", " ", "->", " ", 
      RowBox[{"gg", "[", 
       RowBox[{
        RowBox[{"-", "\[ScriptM]"}], ",", " ", 
        RowBox[{"-", "\[ScriptN]"}]}], "]"}]}], ",", " ", 
     RowBox[{"CovD", " ", "->", " ", "cd"}], ",", " ", 
     RowBox[{"SymbolOfCovD", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<;\>\"", ",", " ", "\"\<\[Del]\>\""}], "}"}]}]}], "|>"}]}],
   "]"}]], "Input",
 CellLabel->"In[10]:=",
 CellID->1649,ExpressionUUID->"34695bf6-b8fc-45ff-b371-35fbe1fb4ddd"],

Cell[TextData[{
 "We see that aside from the metric gg and the covariant derivative cd, which \
we explicitly specified, xAct includes a large number of metric-associated \
tensors (see ",
 ButtonBox["DefMetric",
  BaseStyle->"Link",
  Appearance->None,
  Evaluator->Automatic,
  ButtonFunction:>NotebookOpen[
    FindFile["xAct/Documentation/English/" <> "xTensorDoc.nb"]]],
 " in the xTensor documentation). At this point we have the full xAct \
capabilities on these abstract tensors, for example:"
}], "Text",
 CellID->1650,ExpressionUUID->"9902bf4d-07d0-4ded-b5b4-dc706efd637c"],

Cell[CellGroupData[{

