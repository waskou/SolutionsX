Cell[CellGroupData[{

Cell["Setting up an xAct environment", "Title",
 CellID->1625,ExpressionUUID->"4741b539-62e5-42aa-b7a0-b712419d7c19"],

Cell["\<\
In this Tech Note we will build up the xAct environment corresponding to the \
5d gauged supergravity coupled to two vector multiplets, otherwise known as \
the STU model.\
\>", "Text",
 CellID->1626,ExpressionUUID->"66dfacda-9aa2-407f-a274-6ed0cbfc5584"],

Cell["Load the package:", "MathCaption",
 CellID->1627,ExpressionUUID->"69aaf8ec-bf28-468b-b106-61cc5286ad9e"],

Cell[BoxData[
 RowBox[{"<<", " ", "VasilDimitrov`SolutionsX`"}]], "Input",
 CellLabel->"In[1]:=",
 CellID->1628,ExpressionUUID->"60ec360f-b799-4058-830f-804e831613f2"],

Cell[TextData[{
 "The very first thing we do is pick up a free symbol and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Instantiate"]], 
    "paclet:VasilDimitrov/SolutionsX/ref/Instantiate", 
    "VasilDimitrov Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "31dc5f96-6cfc-4112-a4ae-404c4b65f919"],
 " it."
}], "Text",
 CellID->1629,ExpressionUUID->"34ddc409-c17f-4ac5-9987-bda478bdc02c"],

Cell[BoxData[
 RowBox[{"Instantiate", "[", "sol", "]"}]], "Input",
 CellLabel->"In[2]:=",
 CellID->1630,ExpressionUUID->"dd866c69-c4f3-46f3-ad21-7cb32a61fbe4"],

Cell["\<\
At this point sol is given the value of an \[OpenCurlyDoubleQuote]empty\
\[CloseCurlyDoubleQuote] association, and the following functions can act on \
it:\
\>", "Text",
 CellID->1631,ExpressionUUID->"c356cf95-52bf-4785-b733-39acec3dc112"],

Cell[CellGroupData[{

Cell[BoxData["sol"], "Input",
 CellLabel->"In[3]:=",
 CellID->1632,ExpressionUUID->"130ac87a-8c71-4d43-b818-f426f5f32d4e"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"$manifold", "\[Rule]", 
    RowBox[{"\[LeftAssociation]", "\[RightAssociation]"}]}], ",", 
   RowBox[{"$parameter", "\[Rule]", 
    RowBox[{"\[LeftAssociation]", "\[RightAssociation]"}]}], ",", 
   RowBox[{"$metric", "\[Rule]", 
    RowBox[{"\[LeftAssociation]", "\[RightAssociation]"}]}], ",", 
   RowBox[{"$frame", "\[Rule]", 
    RowBox[{"\[LeftAssociation]", "\[RightAssociation]"}]}], ",", 
   RowBox[{"$spinStructure", "\[Rule]", 
    RowBox[{"\[LeftAssociation]", "\[RightAssociation]"}]}], ",", 
   RowBox[{"$spinConnection", "\[Rule]", 
    RowBox[{"\[LeftAssociation]", "\[RightAssociation]"}]}], ",", 
   RowBox[{"$bundle", "\[Rule]", 
    RowBox[{"\[LeftAssociation]", "\[RightAssociation]"}]}], ",", 
   RowBox[{"$covd", "\[Rule]", 
    RowBox[{"\[LeftAssociation]", "\[RightAssociation]"}]}], ",", 
   RowBox[{"$chart", "\[Rule]", 
    RowBox[{"\[LeftAssociation]", "\[RightAssociation]"}]}], ",", 
   RowBox[{"$basis", "\[Rule]", 
    RowBox[{"\[LeftAssociation]", "\[RightAssociation]"}]}], ",", 
   RowBox[{"$form", "\[Rule]", 
    RowBox[{"\[LeftAssociation]", "\[RightAssociation]"}]}], ",", 
   RowBox[{"$tensor", "\[Rule]", 
    RowBox[{"\[LeftAssociation]", "\[RightAssociation]"}]}], ",", 
   RowBox[{"$spinor", "\[Rule]", 
    RowBox[{"\[LeftAssociation]", "\[RightAssociation]"}]}], ",", 
   RowBox[{"$function", "\[Rule]", 
    RowBox[{"\[LeftAssociation]", "\[RightAssociation]"}]}], ",", 
   RowBox[{"$constant", "\[Rule]", 
    RowBox[{"\[LeftAssociation]", "\[RightAssociation]"}]}], ",", 
   RowBox[{"$assumption", "\[Rule]", 
    RowBox[{"\[LeftAssociation]", "\[RightAssociation]"}]}], ",", 
   RowBox[{"$rule", "\[Rule]", 
    RowBox[{"\[LeftAssociation]", "\[RightAssociation]"}]}], ",", 
   RowBox[{"$set", "\[Rule]", 
    RowBox[{"\[LeftAssociation]", "\[RightAssociation]"}]}]}], 
  "\[RightAssociation]"}]], "Output",
 CellLabel->"Out[3]=",
 CellID->1633,ExpressionUUID->"0022e114-45cc-4f6b-b35e-fb1d20509db7"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"UpValues", "[", "sol", "]"}], "[", 
   RowBox[{"[", 
    RowBox[{"All", ",", " ", "1", ",", " ", "1", ",", " ", "0"}], "]"}], 
   "]"}], " ", "//", " ", "DeleteDuplicates"}]], "Input",
 CellLabel->"In[4]:=",
 CellID->1634,ExpressionUUID->"30533f92-deb1-4b44-9015-9bd04cc107fb"],

