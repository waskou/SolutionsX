Cell[TextData[{
 "To derive the Maxwell equations we can use either xTensor or xTerior. The \
special symbol \[RightTeeArrow], typed as \\[RightTeeArrow], is xAct\
\[CloseCurlyQuote]s ",
 ButtonBox["IndexRule",
  BaseStyle->"Link",
  Appearance->None,
  Evaluator->Automatic,
  ButtonFunction:>NotebookOpen[
    FindFile["xAct/Documentation/English/" <> "xTensorDoc.nb"]]],
