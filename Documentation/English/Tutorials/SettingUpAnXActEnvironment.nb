Cell["Manifold and metric", "Section",
 CellID->1467,ExpressionUUID->"0eccbd74-9d23-4450-aa3b-326591405c1b"],

Cell[TextData[{
 "We don\[CloseCurlyQuote]t simply append to sol using Mathematica\
\[CloseCurlyQuote]s built-in functions. Instead we have to use SolutionsX\
\[CloseCurlyQuote]s ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["IncludeTo"]], "paclet:VasilDimitrov/SolutionsX/ref/IncludeTo", 
    "VasilDimitrov Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "54754263-27e1-40c4-a7c7-a594a7087b1b"],
 ". First we will include a ",
 Cell[BoxData["$manifold"], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "eda8633a-ee96-4a7f-942e-f4c5dec8d38f"],
 " object \[LongDash] the object system is the subject of ",
 ButtonBox["Objects in SolutionsX",
  BaseStyle->"Link",
  ButtonData->
   "paclet:VasilDimitrov/SolutionsX/tutorial/ObjectsInSolutionsX"],
 ". The first argument of IncludeTo is ",
 Cell[BoxData[
  RowBox[{"sol", "[", "$object", "]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "0642ea2b-60af-4226-ae38-c6176b89db5a"],
 " and the second argument is the object we are including."
}], "Text",
 CellID->1468,ExpressionUUID->"0c279da7-d530-4811-9565-bb467afb065c"],

Cell[BoxData[
 RowBox[{"IncludeTo", "[", 
  RowBox[{
   RowBox[{"sol", "[", "$manifold", "]"}], ",", " ", 
   RowBox[{"$manifold", "[", 
    RowBox[{
     RowBox[{"Symbol", " ", "->", " ", "\[ScriptCapitalM]"}], ",", " ", 
     RowBox[{"Dimension", " ", "->", " ", "5"}], ",", " ", 
     RowBox[{"Index", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
       "\[ScriptM]", ",", " ", "\[ScriptN]", ",", " ", "\[ScriptO]", ",", " ",
         "\[ScriptP]", ",", " ", "\[ScriptQ]", ",", " ", "\[ScriptR]", ",", 
        " ", "\[ScriptS]"}], "}"}]}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[5]:=",
 CellID->1469,ExpressionUUID->"f53b941e-5219-4ac9-94de-636c1b76bb20"],

Cell["\<\
Under the hood IncludeTo does two things: 1) it includes the object \
association into the appropriate slot in sol, 2) it loads the xAct object \
corresponding to it. In a live session IncludeTo prints a panel of everything \
xAct defined \[LongDash] blue clickable symbols which expand the information \
about each entity. In the present example it defined the manifold \
\[ScriptCapitalM], its tangent bundle Tangent\[ScriptCapitalM], and the \
indices that we specified: \[ScriptM],\[ScriptN],\[Ellipsis]; query them with \
?\[ScriptCapitalM], ?Tangent\[ScriptCapitalM], ?\[ScriptM].\
\>", "Text",
 CellID->1470,ExpressionUUID->"b092c02c-8c36-4ba8-9475-233093bffa69"],

Cell["\<\
At this point the $manifold slot of sol is an association whose key is \
created from the Symbol key of whatever we included, and the value is the \
association corresponding to the manifold object:\
\>", "Text",
 CellID->1471,ExpressionUUID->"d113381b-64a1-416c-9b8f-002a09601a4c"],

Cell[CellGroupData[{

Cell[BoxData["sol"], "Input",
 CellLabel->"In[6]:=",
 CellID->1472,ExpressionUUID->"fd513d6a-071c-44f2-9662-481a8b3c271c"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"$manifold", "\[Rule]", 
    RowBox[{"\[LeftAssociation]", 
     RowBox[{"\[ScriptCapitalM]", "\[Rule]", 
      RowBox[{"\[LeftAssociation]", 
       RowBox[{
        RowBox[{"Symbol", "\[Rule]", "\[ScriptCapitalM]"}], ",", 
        RowBox[{"Dimension", "\[Rule]", "5"}], ",", 
        RowBox[{"Index", "\[Rule]", 
         RowBox[{"{", 
          RowBox[{
          "\[ScriptM]", ",", "\[ScriptN]", ",", "\[ScriptO]", ",", 
           "\[ScriptP]", ",", "\[ScriptQ]", ",", "\[ScriptR]", ",", 
           "\[ScriptS]"}], "}"}]}], ",", 
        RowBox[{"Name", "\[Rule]", "name"}], ",", 
        RowBox[{"Master", "\[Rule]", "Null"}], ",", 
        RowBox[{"PrintAs", "\[Rule]", "Identity"}], ",", 
        RowBox[{"ProtectNewSymbol", "\[RuleDelayed]", 
         RowBox[{"ScreenDollarIndices", "[", "$ProtectNewSymbols", "]"}]}], 
        ",", 
        RowBox[{"DefInfo", "\[Rule]", 
         RowBox[{"{", 
          RowBox[{"\<\"manifold\"\>", ",", "\<\"\"\>"}], "}"}]}]}], 
       "\[RightAssociation]"}]}], "\[RightAssociation]"}]}], ",", 
   RowBox[{"$parameter", "\[Rule]", 
    RowBox[{"\[LeftAssociation]", "\[RightAssociation]"}]}], ",", 
   RowBox[{"$metric", "\[Rule]", 
    RowBox[{"\[LeftAssociation]", "\[RightAssociation]"}]}], ",", 
   RowBox[{"$frame", "\[Rule]", 
    RowBox[{"\[LeftAssociation]", "\[RightAssociation]"}]}], ",", 
   RowBox[{"$spinStructure", "\[Rule]", 
    RowBox[{"\[LeftAssociation]", "\[RightAssociation]"}]}], ",", 
   RowBox[{"$spinConnection", "\[Rule]", 
    RowBox[{"\[LeftAssociation]", "\[RightAssociation]"}]}], ",", 
   RowBox[{"$bundle", "\[Rule]", 
    RowBox[{"\[LeftAssociation]", "\[RightAssociation]"}]}], ",", 
   RowBox[{"$covd", "\[Rule]", 
    RowBox[{"\[LeftAssociation]", "\[RightAssociation]"}]}], ",", 
   RowBox[{"$chart", "\[Rule]", 
    RowBox[{"\[LeftAssociation]", "\[RightAssociation]"}]}], ",", 
   RowBox[{"$basis", "\[Rule]", 
    RowBox[{"\[LeftAssociation]", "\[RightAssociation]"}]}], ",", 
   RowBox[{"$form", "\[Rule]", 
    RowBox[{"\[LeftAssociation]", "\[RightAssociation]"}]}], ",", 
   RowBox[{"$tensor", "\[Rule]", 
    RowBox[{"\[LeftAssociation]", "\[RightAssociation]"}]}], ",", 
   RowBox[{"$spinor", "\[Rule]", 
    RowBox[{"\[LeftAssociation]", "\[RightAssociation]"}]}], ",", 
   RowBox[{"$function", "\[Rule]", 
    RowBox[{"\[LeftAssociation]", "\[RightAssociation]"}]}], ",", 
   RowBox[{"$constant", "\[Rule]", 
    RowBox[{"\[LeftAssociation]", "\[RightAssociation]"}]}], ",", 
   RowBox[{"$assumption", "\[Rule]", 
    RowBox[{"\[LeftAssociation]", "\[RightAssociation]"}]}], ",", 
   RowBox[{"$rule", "\[Rule]", 
    RowBox[{"\[LeftAssociation]", "\[RightAssociation]"}]}], ",", 
   RowBox[{"$set", "\[Rule]", 
    RowBox[{"\[LeftAssociation]", "\[RightAssociation]"}]}]}], 
  "\[RightAssociation]"}]], "Output",
 CellLabel->"Out[6]=",
 CellID->1473,ExpressionUUID->"6296ade2-59e8-43ce-a390-5d973dcf3f15"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"sol", "[", 
  RowBox[{"$manifold", ",", " ", "\[ScriptCapitalM]"}], "]"}]], "Input",
 CellLabel->"In[7]:=",
 CellID->1474,ExpressionUUID->"51d4cd71-de35-4df5-afe6-57fddb389c05"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"Symbol", "\[Rule]", "\[ScriptCapitalM]"}], ",", 
   RowBox[{"Dimension", "\[Rule]", "5"}], ",", 
   RowBox[{"Index", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
     "\[ScriptM]", ",", "\[ScriptN]", ",", "\[ScriptO]", ",", "\[ScriptP]", 
      ",", "\[ScriptQ]", ",", "\[ScriptR]", ",", "\[ScriptS]"}], "}"}]}], ",", 
   RowBox[{"Name", "\[Rule]", "name"}], ",", 
   RowBox[{"Master", "\[Rule]", "Null"}], ",", 
   RowBox[{"PrintAs", "\[Rule]", "Identity"}], ",", 
   RowBox[{"ProtectNewSymbol", "\[RuleDelayed]", 
    RowBox[{"ScreenDollarIndices", "[", "$ProtectNewSymbols", "]"}]}], ",", 
   RowBox[{"DefInfo", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"\<\"manifold\"\>", ",", "\<\"\"\>"}], "}"}]}]}], 
