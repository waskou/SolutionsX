 CellLabel->"Out[7]=",
 CellID->1475,ExpressionUUID->"b73980ad-072f-4ad3-8104-110eb9e42c15"]
}, Open  ]],

Cell[TextData[{
 "SolutionsX has another syntax for including objects. To demonstrate, we \
first drop the object with ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DropFrom"]], "paclet:VasilDimitrov/SolutionsX/ref/DropFrom", 
    "VasilDimitrov Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "17e041f4-15be-4181-88f8-af9650d3ca39"],
 " and include it again with the alternative syntax (and with more indices in \
the list)."
}], "Text",
 CellID->1476,ExpressionUUID->"53a366b5-6cf7-424c-8579-d278c0b53672"],

Cell[BoxData[
 RowBox[{"DropFrom", "[", 
  RowBox[{
   RowBox[{"sol", "[", "$manifold", "]"}], ",", " ", "\[ScriptCapitalM]"}], 
  "]"}]], "Input",
 CellLabel->"In[8]:=",
 CellID->1477,ExpressionUUID->"2c231e1d-2869-4811-8899-ee8cca001f6e"],

Cell[BoxData[
 RowBox[{"IncludeTo", "[", 
  RowBox[{
   RowBox[{"sol", "[", "$manifold", "]"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"Symbol", " ", "->", " ", "\[ScriptCapitalM]"}], ",", " ", 
      RowBox[{"Dimension", " ", "->", " ", "5"}], ",", " ", 
      RowBox[{"Index", " ", "->", " ", 
       RowBox[{"{", 
        RowBox[{
        "\[ScriptM]", ",", " ", "\[ScriptN]", ",", " ", "\[ScriptO]", ",", 
         " ", "\[ScriptP]", ",", " ", "\[ScriptQ]", ",", " ", "\[ScriptR]", 
         ",", " ", "\[ScriptS]", ",", " ", "\[ScriptT]", ",", " ", 
         "\[ScriptU]", ",", " ", "\[ScriptV]", ",", " ", "\[ScriptW]", ",", 
         " ", "\[ScriptX]", ",", " ", "\[ScriptY]", ",", " ", "\[ScriptZ]"}], 
        "}"}]}]}], "|>"}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[9]:=",
 CellID->1478,ExpressionUUID->"c9af4601-2c99-4fc2-a2fd-ce2c74fc10f2"],

Cell["Next we include a metric:", "MathCaption",
 CellID->1479,ExpressionUUID->"1def4565-878d-4de4-a8a1-4cc8a35d278f"],

Cell[BoxData[
 RowBox[{"IncludeTo", "[", 
  RowBox[{
   RowBox[{"sol", "[", "$metric", "]"}], ",", " ", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"Signature", " ", "->", " ", 
      RowBox[{"-", "1"}]}], ",", " ", 
     RowBox[{"Symbol", " ", "->", " ", 
      RowBox[{"gg", "[", 
       RowBox[{
        RowBox[{"-", "\[ScriptM]"}], ",", " ", 
        RowBox[{"-", "\[ScriptN]"}]}], "]"}]}], ",", " ", 
     RowBox[{"CovD", " ", "->", " ", "cd"}], ",", " ", 
     RowBox[{"SymbolOfCovD", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<;\>\"", ",", " ", "\"\<\[Del]\>\""}], "}"}]}]}], "|>"}]}],
   "]"}]], "Input",
 CellLabel->"In[10]:=",
 CellID->1480,ExpressionUUID->"2a052652-bc77-4344-97e6-9b41f1f2cb02"],

Cell[TextData[{
 "We see that aside from the metric gg and the covariant derivative cd, which \
we explicitly specified, xAct includes a large number of metric-associated \
tensors (see ",
 ButtonBox["DefMetric",
  BaseStyle->"Link",
  Appearance->None,
  Evaluator->Automatic,
  ButtonFunction:>NotebookOpen[
    FindFile["xAct/Documentation/English/" <> "xTensorDoc.nb"]]],
 " in the xTensor documentation). At this point we have the full xAct \
capabilities on these abstract tensors, for example:"
}], "Text",
 CellID->1481,ExpressionUUID->"b4bbf86f-5479-47d5-b259-bb80553339dd"],

