Cell[TextData[{
 "We want to include the Lagrangian in tensor form. To produce it we use xAct\
\[CloseCurlyQuote]s built-in functions. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["WedgeCoeff"]], 
    "paclet:VasilDimitrov/SolutionsX/ref/WedgeCoeff", 
    "VasilDimitrov Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "b5a29005-33f4-4c24-ac99-b59c2059add2"],
 " is SolutionsX\[CloseCurlyQuote]s way of extracting the tensorial \
expression which is the correctly antisymmetrized \
\[OpenCurlyDoubleQuote]coefficient\[CloseCurlyDoubleQuote] of a Wedge of dx[\
\[ScriptCapitalM]]\[CloseCurlyQuote]s:"
}], "Text",
 CellID->1654,ExpressionUUID->"d3566d95-6159-4049-94d1-b261ab59d719"],

