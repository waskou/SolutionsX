Cell["\<\
The minimal setup to include them is the following, where we specify the \
vielbein ee, the flat metric \[Eta]\[Eta] and a set of flat indices \
\[GothicA],\[GothicB],\[Ellipsis]; a set of spinor indices \
\[DoubleStruckCapitalA],\[DoubleStruckCapitalB],\[Ellipsis]; and the spin \
connection \[Omega]\[Omega]. Explore everything that xAct defined by clicking \
on the blue links in a live session and reading the FieldsX documentation \
(its paper, arXiv:2008.12422).\
\>", "Text",
 CellID->1498,ExpressionUUID->"20b0bd7d-cec7-4190-a3ef-8423ea2dcf91"],

Cell[BoxData[
 RowBox[{"IncludeTo", "[", 
  RowBox[{
   RowBox[{"sol", "[", "$frame", "]"}], ",", " ", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"Symbol", " ", "->", " ", 
      RowBox[{"ee", "[", 
       RowBox[{
        RowBox[{"-", "\[ScriptM]"}], ",", " ", "\[GothicA]"}], "]"}]}], ",", 
     " ", 
     RowBox[{"Metric", " ", "->", " ", 
      RowBox[{"\[Eta]\[Eta]", "[", 
       RowBox[{
        RowBox[{"-", "\[GothicA]"}], ",", " ", 
        RowBox[{"-", "\[GothicB]"}]}], "]"}]}], ",", " ", 
     RowBox[{"Index", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
       "\[GothicA]", ",", " ", "\[GothicB]", ",", " ", "\[GothicC]", ",", " ",
         "\[GothicD]", ",", " ", "\[GothicE]", ",", " ", "\[GothicF]", ",", 
        " ", "\[GothicG]", ",", " ", "\[GothicH]", ",", " ", "\[GothicI]", 
        ",", " ", "\[GothicJ]", ",", " ", "\[GothicK]", ",", " ", 
        "\[GothicL]"}], "}"}]}]}], "|>"}]}], "]"}]], "Input",
 CellLabel->"In[18]:=",
 CellID->1499,ExpressionUUID->"74812f62-80c7-4c21-8981-d1beb8587f7e"],

Cell[BoxData[
 RowBox[{"IncludeTo", "[", 
  RowBox[{
   RowBox[{"sol", "[", "$spinStructure", "]"}], ",", " ", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"Metric", " ", "->", " ", "gg"}], ",", " ", 
     RowBox[{"Index", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
       "\[DoubleStruckCapitalA]", ",", " ", "\[DoubleStruckCapitalB]", ",", 
        " ", "\[DoubleStruckCapitalC]", ",", " ", "\[DoubleStruckCapitalD]", 
        ",", " ", "\[DoubleStruckCapitalE]", ",", " ", 
        "\[DoubleStruckCapitalF]", ",", " ", "\[DoubleStruckCapitalG]", ",", 
        " ", "\[DoubleStruckCapitalH]", ",", " ", "\[DoubleStruckCapitalI]", 
        ",", " ", "\[DoubleStruckCapitalJ]", ",", " ", 
        "\[DoubleStruckCapitalK]", ",", " ", "\[DoubleStruckCapitalL]"}], 
       "}"}]}]}], "|>"}]}], "]"}]], "Input",
 CellLabel->"In[19]:=",
 CellID->1500,ExpressionUUID->"5b0c76cc-3db6-43e3-8fa8-042315f89909"],

Cell[BoxData[
 RowBox[{"IncludeTo", "[", 
  RowBox[{
   RowBox[{"sol", "[", "$spinConnection", "]"}], ",", " ", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"Symbol", " ", "->", " ", 
      RowBox[{"\[Omega]\[Omega]", "[", 
       RowBox[{
        RowBox[{"-", "\[ScriptM]"}], ",", " ", 
        RowBox[{"-", "\[GothicA]"}], ",", " ", 
        RowBox[{"-", "\[GothicB]"}]}], "]"}]}], ",", " ", 
     RowBox[{"CovD", " ", "->", " ", "cd"}]}], "|>"}]}], "]"}]], "Input",
 CellLabel->"In[20]:=",
 CellID->1501,ExpressionUUID->"40c663a6-3fcf-4129-91f9-0745bece8c32"],

Cell["We now have the spinor capabilities provided by FieldsX:", "MathCaption",
 CellID->1502,ExpressionUUID->"4c1ad37c-f2f7-4c39-9817-e35c2bd95932"],

