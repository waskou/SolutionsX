Cell["Forms", "Section",
 CellID->1700,ExpressionUUID->"b7852592-d14e-47b2-890a-f64088282a8c"],

Cell["\<\
Differential forms in SolutionsX leverage xAct\[CloseCurlyQuote]s xTerior \
package. We include two differential forms of degree one and two, which carry \
a single internal index: the gauge field A and its field strength F.\
\>", "Text",
 CellID->1701,ExpressionUUID->"57a215cf-fe9d-46a0-a56e-4e2b338dcafa"],

Cell[BoxData[
 RowBox[{"IncludeTo", "[", 
  RowBox[{
   RowBox[{"sol", "[", "$form", "]"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"Symbol", " ", "->", " ", 
        RowBox[{"A", "[", "\[GothicCapitalI]", "]"}]}], ",", " ", 
       RowBox[{"Manifold", " ", "->", " ", "\[ScriptCapitalM]"}], ",", " ", 
       RowBox[{"Deg", " ", "->", " ", "1"}], ",", " ", 
       RowBox[{"Symmetry", " ", "->", " ", "None"}]}], "|>"}], ",", " ", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"Symbol", " ", "->", " ", 
        RowBox[{"F", "[", "\[GothicCapitalI]", "]"}]}], ",", " ", 
       RowBox[{"Manifold", " ", "->", " ", "\[ScriptCapitalM]"}], ",", " ", 
       RowBox[{"Deg", " ", "->", " ", "2"}], ",", " ", 
       RowBox[{"Symmetry", " ", "->", " ", "None"}]}], "|>"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[33]:=",
 CellID->1702,ExpressionUUID->"1f94bcc9-431f-466c-a2b5-2182e85db24b"],

