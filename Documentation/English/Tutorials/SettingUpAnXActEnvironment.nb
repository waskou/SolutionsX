Cell["\<\
The minimal setup to include them is the following, where we specify the \
vielbein ee, the flat metric \[Eta]\[Eta] and a set of flat indices \
\[GothicA],\[GothicB],\[Ellipsis]; a set of spinor indices \
\[DoubleStruckCapitalA],\[DoubleStruckCapitalB],\[Ellipsis]; and the spin \
connection \[Omega]\[Omega]. Explore everything that xAct defined by clicking \
on the blue links in a live session and reading the FieldsX documentation \
(its paper, arXiv:2008.12422).\
\>", "Text",
 CellID->1667,ExpressionUUID->"a7bc73f7-515a-453c-a5c7-13dec0057477"],

Cell[BoxData[
 RowBox[{"IncludeTo", "[", 
  RowBox[{
   RowBox[{"sol", "[", "$frame", "]"}], ",", " ", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"Symbol", " ", "->", " ", 
      RowBox[{"ee", "[", 
       RowBox[{
        RowBox[{"-", "\[ScriptM]"}], ",", " ", "\[GothicA]"}], "]"}]}], ",", 
     " ", 
     RowBox[{"Metric", " ", "->", " ", 
      RowBox[{"\[Eta]\[Eta]", "[", 
       RowBox[{
        RowBox[{"-", "\[GothicA]"}], ",", " ", 
        RowBox[{"-", "\[GothicB]"}]}], "]"}]}], ",", " ", 
     RowBox[{"Index", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
       "\[GothicA]", ",", " ", "\[GothicB]", ",", " ", "\[GothicC]", ",", " ",
         "\[GothicD]", ",", " ", "\[GothicE]", ",", " ", "\[GothicF]", ",", 
        " ", "\[GothicG]", ",", " ", "\[GothicH]", ",", " ", "\[GothicI]", 
        ",", " ", "\[GothicJ]", ",", " ", "\[GothicK]", ",", " ", 
        "\[GothicL]"}], "}"}]}]}], "|>"}]}], "]"}]], "Input",
 CellLabel->"In[18]:=",
 CellID->1668,ExpressionUUID->"83e59905-f669-4b62-919f-024f1dc6c914"],

Cell[BoxData[
 RowBox[{"IncludeTo", "[", 
  RowBox[{
   RowBox[{"sol", "[", "$spinStructure", "]"}], ",", " ", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"Metric", " ", "->", " ", "gg"}], ",", " ", 
     RowBox[{"Index", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
       "\[DoubleStruckCapitalA]", ",", " ", "\[DoubleStruckCapitalB]", ",", 
        " ", "\[DoubleStruckCapitalC]", ",", " ", "\[DoubleStruckCapitalD]", 
        ",", " ", "\[DoubleStruckCapitalE]", ",", " ", 
        "\[DoubleStruckCapitalF]", ",", " ", "\[DoubleStruckCapitalG]", ",", 
        " ", "\[DoubleStruckCapitalH]", ",", " ", "\[DoubleStruckCapitalI]", 
        ",", " ", "\[DoubleStruckCapitalJ]", ",", " ", 
        "\[DoubleStruckCapitalK]", ",", " ", "\[DoubleStruckCapitalL]"}], 
       "}"}]}]}], "|>"}]}], "]"}]], "Input",
 CellLabel->"In[19]:=",
 CellID->1669,ExpressionUUID->"bebad0d3-180c-4424-b014-1a72fb773aeb"],

Cell[BoxData[
 RowBox[{"IncludeTo", "[", 
  RowBox[{
   RowBox[{"sol", "[", "$spinConnection", "]"}], ",", " ", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"Symbol", " ", "->", " ", 
      RowBox[{"\[Omega]\[Omega]", "[", 
       RowBox[{
        RowBox[{"-", "\[ScriptM]"}], ",", " ", 
        RowBox[{"-", "\[GothicA]"}], ",", " ", 
        RowBox[{"-", "\[GothicB]"}]}], "]"}]}], ",", " ", 
     RowBox[{"CovD", " ", "->", " ", "cd"}]}], "|>"}]}], "]"}]], "Input",
 CellLabel->"In[20]:=",
 CellID->1670,ExpressionUUID->"f59add24-3093-4576-81c1-9f920f63d4bc"],

Cell["We now have the spinor capabilities provided by FieldsX:", "MathCaption",
 CellID->1671,ExpressionUUID->"cc5511f9-4d28-45f9-ba85-45c87ae26d83"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Gammagg", "[", 
  RowBox[{"\[ScriptM]", ",", " ", "\[ScriptN]", ",", " ", 
   RowBox[{"-", "\[DoubleStruckCapitalA]"}], ",", " ", 
   "\[DoubleStruckCapitalB]"}], "]"}]], "Input",
 CellLabel->"In[21]:=",
 CellID->1672,ExpressionUUID->"6727612b-a700-4806-bf67-cc23388065d6"],

Cell[BoxData[
 InterpretationBox[
  StyleBox[GridBox[{
