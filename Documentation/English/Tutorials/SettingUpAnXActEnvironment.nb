Cell[BoxData[
 RowBox[{"Gammagg", "[", 
  RowBox[{"\[ScriptM]", ",", " ", "\[ScriptN]", ",", " ", 
   RowBox[{"-", "\[DoubleStruckCapitalA]"}], ",", " ", 
   "\[DoubleStruckCapitalB]"}], "]"}]], "Input",
 CellLabel->"In[21]:=",
 CellID->1503,ExpressionUUID->"dbc72db1-1724-43bc-ad5f-ea7fa69f750f"],

