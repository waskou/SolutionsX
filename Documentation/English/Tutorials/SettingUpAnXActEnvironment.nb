Cell["\<\
For the time being we include bases for everything except the tangent space. \
Notice that IncludeTo also accepts a list of associations for simultaneously \
including a few objects of the same type:\
\>", "Text",
 CellID->1693,ExpressionUUID->"2e90af42-2d66-47b4-b0f6-af02033cb3e0"],

Cell[BoxData[
 RowBox[{"IncludeTo", "[", 
  RowBox[{
   RowBox[{"sol", "[", "$basis", "]"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"Symbol", " ", "->", " ", "flat"}], ",", " ", 
       RowBox[{"VBundle", " ", "->", " ", "Frame\[ScriptCapitalM]"}], ",", 
       " ", 
       RowBox[{"CNumbersOf", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{
         "0", ",", " ", "1", ",", " ", "2", ",", " ", "3", ",", " ", "4"}], 
         "}"}]}], ",", " ", 
       RowBox[{"BasisColor", " ", "->", " ", "Blue"}]}], "|>"}], ",", " ", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"Symbol", " ", "->", " ", "spin"}], ",", " ", 
       RowBox[{"VBundle", " ", "->", " ", "Spin\[ScriptCapitalM]"}], ",", " ", 
       RowBox[{"CNumbersOf", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "2", ",", " ", "3", ",", " ", "4"}], "}"}]}], 
       ",", " ", 
       RowBox[{"BasisColor", " ", "->", " ", 
        RowBox[{"RGBColor", "[", 
         RowBox[{"0", ",", " ", 
          RowBox[{"2", "/", "3"}], ",", " ", "0"}], "]"}]}]}], "|>"}], ",", 
     " ", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"Symbol", " ", "->", " ", "internal"}], ",", " ", 
       RowBox[{"VBundle", " ", "->", " ", "Internal\[ScriptCapitalM]"}], ",", 
       " ", 
       RowBox[{"CNumbersOf", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "2", ",", " ", "3"}], "}"}]}], ",", " ", 
       RowBox[{"BasisColor", " ", "->", " ", "Brown"}]}], "|>"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[30]:=",
 CellID->1694,ExpressionUUID->"011f5701-8842-48f7-9ed8-a3748e194e2e"],

