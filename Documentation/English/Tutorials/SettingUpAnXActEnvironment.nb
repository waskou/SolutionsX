Cell["Forms", "Section",
 CellID->1531,ExpressionUUID->"e3dc32b4-1ad1-4bcc-b264-5967abbbc716"],

Cell["\<\
Differential forms in SolutionsX leverage xAct\[CloseCurlyQuote]s xTerior \
package. We include two differential forms of degree one and two, which carry \
a single internal index: the gauge field A and its field strength F.\
\>", "Text",
 CellID->1532,ExpressionUUID->"3c5150f9-03c4-4f50-a067-340147bf2f29"],

Cell[BoxData[
 RowBox[{"IncludeTo", "[", 
  RowBox[{
   RowBox[{"sol", "[", "$form", "]"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"Symbol", " ", "->", " ", 
        RowBox[{"A", "[", "\[GothicCapitalI]", "]"}]}], ",", " ", 
       RowBox[{"Manifold", " ", "->", " ", "\[ScriptCapitalM]"}], ",", " ", 
       RowBox[{"Deg", " ", "->", " ", "1"}], ",", " ", 
       RowBox[{"Symmetry", " ", "->", " ", "None"}]}], "|>"}], ",", " ", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"Symbol", " ", "->", " ", 
        RowBox[{"F", "[", "\[GothicCapitalI]", "]"}]}], ",", " ", 
       RowBox[{"Manifold", " ", "->", " ", "\[ScriptCapitalM]"}], ",", " ", 
       RowBox[{"Deg", " ", "->", " ", "2"}], ",", " ", 
       RowBox[{"Symmetry", " ", "->", " ", "None"}]}], "|>"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[33]:=",
 CellID->1533,ExpressionUUID->"d596e0df-9224-4c57-b41c-df3e63b11d08"],

