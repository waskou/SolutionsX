Cell["\<\
For the time being we include bases for everything except the tangent space. \
Notice that IncludeTo also accepts a list of associations for simultaneously \
including a few objects of the same type:\
\>", "Text",
 CellID->1524,ExpressionUUID->"c0b1b36e-d57b-4da8-a9f3-046553d4555b"],

Cell[BoxData[
 RowBox[{"IncludeTo", "[", 
  RowBox[{
   RowBox[{"sol", "[", "$basis", "]"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"Symbol", " ", "->", " ", "flat"}], ",", " ", 
       RowBox[{"VBundle", " ", "->", " ", "Frame\[ScriptCapitalM]"}], ",", 
       " ", 
       RowBox[{"CNumbersOf", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{
         "0", ",", " ", "1", ",", " ", "2", ",", " ", "3", ",", " ", "4"}], 
         "}"}]}], ",", " ", 
       RowBox[{"BasisColor", " ", "->", " ", "Blue"}]}], "|>"}], ",", " ", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"Symbol", " ", "->", " ", "spin"}], ",", " ", 
       RowBox[{"VBundle", " ", "->", " ", "Spin\[ScriptCapitalM]"}], ",", " ", 
       RowBox[{"CNumbersOf", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "2", ",", " ", "3", ",", " ", "4"}], "}"}]}], 
       ",", " ", 
       RowBox[{"BasisColor", " ", "->", " ", 
        RowBox[{"RGBColor", "[", 
         RowBox[{"0", ",", " ", 
          RowBox[{"2", "/", "3"}], ",", " ", "0"}], "]"}]}]}], "|>"}], ",", 
     " ", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"Symbol", " ", "->", " ", "internal"}], ",", " ", 
       RowBox[{"VBundle", " ", "->", " ", "Internal\[ScriptCapitalM]"}], ",", 
       " ", 
       RowBox[{"CNumbersOf", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "2", ",", " ", "3"}], "}"}]}], ",", " ", 
       RowBox[{"BasisColor", " ", "->", " ", "Brown"}]}], "|>"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[30]:=",
 CellID->1525,ExpressionUUID->"eb29cb10-1dbe-4796-a3f8-97a515012899"],

