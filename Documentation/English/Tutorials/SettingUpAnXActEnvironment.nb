          RowBox[{"-", "\[GothicCapitalJ]"}], ",", " ", 
          RowBox[{"-", "\[GothicCapitalK]"}]}], "]"}]}], ",", " ", 
       RowBox[{"Manifold", " ", "->", " ", "\[ScriptCapitalM]"}], ",", " ", 
