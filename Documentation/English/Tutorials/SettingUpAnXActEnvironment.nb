Cell[TextData[{
 "The above cell is not the standard way one usually calls the computed \
tensor values in xAct. Aside from the ",
 ButtonBox["TensorValues",
  BaseStyle->"Link",
  Appearance->None,
  Evaluator->Automatic,
  ButtonFunction:>NotebookOpen[
    FindFile["xAct/Documentation/English/" <> "xCobaDoc.nb"]]],
 " being stored in sol, they are directly hooked to the symbol XX at \
runtime:"
}], "Text",
