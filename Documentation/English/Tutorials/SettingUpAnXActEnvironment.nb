Cell["Lagrangian and equations of motion", "Section",
 CellID->1643,ExpressionUUID->"740f4142-9592-4740-bb3e-312077b3b79d"],

Cell[TextData[{
 "The Lagrangian of the STU model is the following. We include it as \
SolutionsX\[CloseCurlyQuote]s ",
 Cell[BoxData["$set"], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "3104cedd-035d-4ea0-ae15-fd045a62e301"],
 " object, by making use of xAct\[CloseCurlyQuote]s ",
 ButtonBox["IndexSet",
  BaseStyle->"Link",
  Appearance->None,
  Evaluator->Automatic,
  ButtonFunction:>NotebookOpen[
    FindFile["xAct/Documentation/English/" <> "xTensorDoc.nb"]]],
 ", and the Expression has to be wrapped in ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["HoldForm"]], "paclet:ref/HoldForm"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "a2559291-050a-4f25-b2bb-40865b648fe6"],
 " \[LongDash] the ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Evaluate"]], "paclet:ref/Evaluate"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "326621a6-c46d-4ec5-9efe-2e3a1415fa8b"],
 " marker is honoured at include time, so the record stores the actual \
computed expression rather than a reference to it."
}], "Text",
 CellID->1644,ExpressionUUID->"80517e2d-0ea6-4cb3-bb5a-ef6d3121dcd4"],

