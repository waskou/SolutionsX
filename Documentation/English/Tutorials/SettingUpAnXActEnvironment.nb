Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["ExpandForms"]], 
    "paclet:VasilDimitrov/SolutionsX/ref/ExpandForms", 
    "VasilDimitrov Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "d1ee2ac9-be1a-4afd-96f8-6274344f3757"],
 " is SolutionsX\[CloseCurlyQuote]s way of auto-expanding all form \
expressions into the basis dx[\[ScriptCapitalM]]. It needs information from \
the entire association, so it is used as a curried operator: ExpandForms[sol] \
is the operator, which then applies to the expression:"
}], "Text",
 CellID->1651,ExpressionUUID->"243d793b-70c9-498c-bb23-2e37f6d3dcde"],

