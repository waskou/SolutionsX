Cell[TextData[{
 "In the present example we don\[CloseCurlyQuote]t want to keep functions \
around but expand them all. Prior to calling ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Compute"]], "paclet:VasilDimitrov/SolutionsX/ref/Compute", 
    "VasilDimitrov Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "df34e203-56ac-44e9-b806-a3b0acd847dd"],
 " let us observe the state of the association ",
 Cell[BoxData[
  StyleBox["sol", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "209815a3-aa53-4e94-aa27-db3ff05d079a"],
 " and of the ",
 ButtonBox["TensorValues",
  BaseStyle->"Link",
  Appearance->None,
  Evaluator->Automatic,
  ButtonFunction:>NotebookOpen[
    FindFile["xAct/Documentation/English/" <> "xCobaDoc.nb"]]],
 " of the symbol gg:"
}], "MathCaption",
 CellID->1976,ExpressionUUID->"28ed3954-0ec4-4316-b3d3-5248268e0cb0"],

