Cell["\<\
Other index configurations will be obtained through raising and lowering with \
the metric:\
\>", "MathCaption",
 CellID->1997,ExpressionUUID->"f8dd8b6c-05f2-4023-9c9a-ad1504f89437"],

Cell[BoxData[
 RowBox[{"Compute", "[", 
  RowBox[{
   RowBox[{"sol", "[", 
    RowBox[{
    "$metric", ",", " ", "gg", ",", " ", "$auto", ",", "  ", 
     "Christoffelcd"}], "]"}], ",", "\n", 
   RowBox[{"Chain", " ", "->", " ", 
    RowBox[{"{", "\n", 
     RowBox[{
      RowBox[{
       RowBox[{"HoldForm", "[", " ", 
        RowBox[{"ToArray", "@", 
         RowBox[{"ChristoffelToGradMetric", "@", " ", 
          RowBox[{"Christoffelcd", "[", 
           RowBox[{
            RowBox[{"-", "\[ScriptM]"}], ",", " ", 
            RowBox[{"-", "\[ScriptN]"}], ",", " ", 
            RowBox[{"-", "\[ScriptP]"}]}], "]"}]}]}], "]"}], " ", "->", "  ", 
       
       RowBox[{"Permutations", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "1"}], ",", " ", 
          RowBox[{"-", "1"}], ",", " ", 
          RowBox[{"-", "1"}]}], "}"}], "]"}]}], ",", "\n", 
      RowBox[{
       RowBox[{"Permutations", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "1"}], ",", " ", 
          RowBox[{"-", "1"}], ",", " ", 
          RowBox[{"-", "1"}]}], "}"}], "]"}], " ", "->", "  ", 
       RowBox[{"Permutations", "[", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", 
          RowBox[{"-", "1"}], ",", " ", 
          RowBox[{"-", "1"}]}], "}"}], "]"}]}], ",", "\n", 
      RowBox[{
       RowBox[{"Permutations", "[", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", 
          RowBox[{"-", "1"}], ",", " ", 
          RowBox[{"-", "1"}]}], "}"}], "]"}], " ", "->", "  ", 
       RowBox[{"Permutations", "[", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "1", ",", " ", 
          RowBox[{"-", "1"}]}], "}"}], "]"}]}], ",", "\n", 
      RowBox[{
       RowBox[{"Permutations", "[", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "1", ",", " ", 
          RowBox[{"-", "1"}]}], "}"}], "]"}], " ", "->", "  ", 
       RowBox[{"Permutations", "[", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "1", ",", "  ", "1"}], "}"}], "]"}]}]}], "\n",
      "}"}]}], ",", "\n", 
   RowBox[{"Apply", " ", "->", " ", 
    RowBox[{"{", "\n", 
     RowBox[{
      RowBox[{"Map", " ", "->", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"Together", "[", 
          RowBox[{
           RowBox[{"#", " ", "/.", " ", 
            RowBox[{"Gen", "@", 
             RowBox[{"sol", "[", 
              RowBox[{"$rule", ",", " ", "func"}], "]"}]}]}], " ", "/.", " ", 
           
           RowBox[{"Gen", "@", 
            RowBox[{"sol", "[", 
             RowBox[{"$rule", ",", " ", "const"}], "]"}]}]}], "]"}], " ", 
         "&"}], ")"}]}], ",", "\n", 
      RowBox[{"ParallelMap", " ", "->", " ", "Simplify"}]}], "\n", "}"}]}]}], 
  "\n", "]"}]], "Input",
 CellLabel->"In[16]:=",
 CellID->1998,ExpressionUUID->"be34d7f1-f2fb-427a-bfef-79958d854b96"],

Cell["\<\
The usage of gg to raise and lower is automatically determined by the nature \
of the indices \[ScriptM],\[ScriptN],.... Tensor symmetries are automatically \
determined for each raising. Parallel simplification is then applied only \
after the tensor symmetries have been taken into account. By convention we \
feed everything computed by the \[OpenCurlyDoubleQuote]previous line\
\[CloseCurlyDoubleQuote] (its right-hand side) as the left-hand side of the \
\[OpenCurlyDoubleQuote]next line\[CloseCurlyDoubleQuote]; for example we feed:\
\>", "MathCaption",
 CellID->1999,ExpressionUUID->"1ae7ff27-a5d6-44a8-b82c-995e622e9c7d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Permutations", "[", 
  RowBox[{"{", 
   RowBox[{"1", ",", " ", 
    RowBox[{"-", "1"}], ",", " ", 
    RowBox[{"-", "1"}]}], "}"}], "]"}]], "Input",
 CellLabel->"In[17]:=",
 CellID->2000,ExpressionUUID->"61b91038-79a8-44fe-842f-5dbae4058a06"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"1", ",", 
     RowBox[{"-", "1"}], ",", 
     RowBox[{"-", "1"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"-", "1"}], ",", "1", ",", 
     RowBox[{"-", "1"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"-", "1"}], ",", 
     RowBox[{"-", "1"}], ",", "1"}], "}"}]}], "}"}]], "Output",
 CellLabel->"Out[17]=",
 CellID->2001,ExpressionUUID->"73a90c2a-e5ae-47d9-a9db-f7d542d3ad81"]
}, Open  ]],

