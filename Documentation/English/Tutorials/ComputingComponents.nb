Cell[TextData[{
 "The first is SolutionsX\[CloseCurlyQuote]s record of the ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Compute"]], "paclet:VasilDimitrov/SolutionsX/ref/Compute", 
    "VasilDimitrov Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "35089882-d611-4541-a4ef-d9226056bf74"],
 " prescription, together with the computed values (can be made persistent \
across sessions). The second is xAct\[CloseCurlyQuote]s hook of the ",
 ButtonBox["TensorValues",
  BaseStyle->"Link",
  Appearance->None,
  Evaluator->Automatic,
  ButtonFunction:>NotebookOpen[
    FindFile["xAct/Documentation/English/" <> "xCobaDoc.nb"]]],
 " associated to the metric gg (cannot be made persistent across sessions). \
Now let\[CloseCurlyQuote]s compute."
}], "Text",
 CellID->1979,ExpressionUUID->"8f6b518f-72ef-4281-a94f-d2a6b82cfd0c"],

Cell[BoxData[
 RowBox[{"Compute", "[", 
  RowBox[{
   RowBox[{"sol", "[", 
    RowBox[{"$metric", ",", " ", "gg", ",", " ", "$auto", ",", "  ", "gg"}], 
    "]"}], ",", "\n", 
   RowBox[{"Chain", " ", "->", " ", 
    RowBox[{"{", "\n", 
     RowBox[{
      RowBox[{
       RowBox[{"HoldForm", "[", " ", 
        RowBox[{"MakeArray", "[", 
         RowBox[{"$self", "[", 
          RowBox[{"$metric", ",", " ", "gg", ",", " ", "Expression"}], "]"}], 
         "]"}], "]"}], " ", "->", " ", 
       RowBox[{"{", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "1"}], ",", " ", 
          RowBox[{"-", "1"}]}], "}"}], "}"}]}], ",", "\n", 
      RowBox[{
       RowBox[{"HoldForm", "[", " ", 
        RowBox[{"Inverse", "@", 
         RowBox[{"ToArray", "@", 
          RowBox[{"gg", "[", 
           RowBox[{
            RowBox[{"-", "\[ScriptM]"}], ",", " ", 
            RowBox[{"-", "\[ScriptN]"}]}], "]"}]}]}], "]"}], " ", "->", " ", 
       RowBox[{"{", 
        RowBox[{"{", 
         RowBox[{"1", ",", "  ", "1"}], "}"}], "}"}]}]}], "\n", "}"}]}], ",", 
   "\n", 
   RowBox[{"Apply", " ", "->", " ", 
    RowBox[{"{", "\n", 
     RowBox[{
      RowBox[{"Map", " ", "->", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"Together", "[", 
          RowBox[{
           RowBox[{"#", " ", "/.", " ", 
            RowBox[{"Gen", "@", 
             RowBox[{"sol", "[", 
              RowBox[{"$rule", ",", " ", "func"}], "]"}]}]}], " ", "/.", " ", 
           
           RowBox[{"Gen", "@", 
            RowBox[{"sol", "[", 
             RowBox[{"$rule", ",", " ", "const"}], "]"}]}]}], "]"}], " ", 
         "&"}], ")"}]}], ",", "\n", 
      RowBox[{"ParallelMap", " ", "->", " ", "Simplify"}]}], "\n", "}"}]}]}], 
  "\n", "]"}]], "Input",
 CellLabel->"In[12]:=",
 CellID->1980,ExpressionUUID->"4a589592-8efa-480c-8fe0-a37f88884de3"],

