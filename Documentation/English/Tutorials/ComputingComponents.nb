Cell["\<\
even though technically speaking the {1,-1,-1} is enough to inform the \
{1,1,-1} component. The reason we do that is because depending on the tensor \
symmetries it might be \[OpenCurlyDoubleQuote]cheaper\[CloseCurlyDoubleQuote] \
to use one configuration or another when raising. With everything supplied \
SolutionsX takes care of such \[OpenCurlyDoubleQuote]simplifications\
\[CloseCurlyDoubleQuote] whenever possible.\
\>", "Text",
 CellID->2005,ExpressionUUID->"26ef613a-23e6-4caf-96a5-dde043dc3e10"],

Cell["Storing the recipe", "Section",
 CellID->2006,ExpressionUUID->"ce127985-89ac-4f5c-b1db-b44d1a6d1f72"],

Cell["\<\
In order to not have our hands fall off from typing one can pre-supply the \
entire computation prescription in advance:\
\>", "MathCaption",
 CellID->2007,ExpressionUUID->"b6f8c2a1-5cfc-4873-b20c-b882b982ae7c"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"sol", "[", 
   RowBox[{
   "$metric", ",", " ", "gg", ",", " ", "$auto", ",", " ", "gg", ",", " ", 
    "Routine", ",", "  ", "Chain"}], "]"}], " ", "=", " ", 
  RowBox[{"{", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"HoldForm", "[", " ", 
      RowBox[{"MakeArray", "[", 
       RowBox[{
        RowBox[{"$self", "[", 
         RowBox[{"$metric", ",", " ", "gg", ",", " ", "Expression"}], "]"}], 
        " ", "/.", "  ", 
        RowBox[{"Gen", "@", 
         RowBox[{"$self", "[", 
          RowBox[{"$rule", ",", " ", "$form"}], "]"}]}]}], "]"}], "]"}], " ", 
     "->", " ", 
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "1"}], ",", " ", 
        RowBox[{"-", "1"}]}], "}"}], "}"}]}], ",", "\n", 
    RowBox[{
     RowBox[{"HoldForm", "[", " ", 
      RowBox[{"Inverse", "@", 
       RowBox[{"ToArray", "@", 
        RowBox[{"gg", "[", 
         RowBox[{
          RowBox[{"-", "\[ScriptM]"}], ",", " ", 
          RowBox[{"-", "\[ScriptN]"}]}], "]"}]}]}], "]"}], " ", "->", " ", 
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{"1", ",", "  ", "1"}], "}"}], "}"}]}]}], "\n", "}"}]}], "\n", 
 RowBox[{
  RowBox[{"sol", "[", 
   RowBox[{
   "$metric", ",", " ", "gg", ",", " ", "$auto", ",", " ", "Christoffelcd", 
    ",", " ", "Routine", ",", " ", "Chain"}], "]"}], " ", "=", "  ", 
  RowBox[{"RulesToChain", "[", "\n", 
   RowBox[{
    RowBox[{"HoldForm", "[", " ", 
     RowBox[{"ToArray", "@", 
      RowBox[{"ChristoffelToGradMetric", "@", " ", 
       RowBox[{"Christoffelcd", "[", 
        RowBox[{
         RowBox[{"-", "\[ScriptM]"}], ",", " ", 
         RowBox[{"-", "\[ScriptN]"}], ",", " ", 
         RowBox[{"-", "\[ScriptO]"}]}], "]"}]}]}], "]"}], " ", "->", "  ", 
    RowBox[{
     RowBox[{"Permutations", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "1"}], ",", " ", 
        RowBox[{"-", "1"}], ",", " ", 
        RowBox[{"-", "1"}]}], "}"}], "]"}], " ", "->", "  ", 
     RowBox[{
      RowBox[{"Permutations", "[", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", 
         RowBox[{"-", "1"}], ",", " ", 
         RowBox[{"-", "1"}]}], "}"}], "]"}], " ", "->", "  ", 
      RowBox[{
       RowBox[{"Permutations", "[", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "1", ",", " ", 
          RowBox[{"-", "1"}]}], "}"}], "]"}], " ", "->", " ", 
       RowBox[{"Permutations", "[", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "1", ",", " ", "1"}], "}"}], "]"}]}]}]}]}], 
   "\n", "]"}]}], "\n", 
 RowBox[{
  RowBox[{"sol", "[", 
   RowBox[{
   "$metric", ",", " ", "gg", ",", " ", "$auto", ",", " ", "Riccicd", ",", 
    " ", "Routine", ",", " ", "Chain"}], "]"}], " ", "=", "  ", 
  RowBox[{"RulesToChain", "[", "\n", 
   RowBox[{
    RowBox[{"HoldForm", "[", " ", 
     RowBox[{"ToArray", "@", 
      RowBox[{"RiemannToChristoffel", "@", 
       RowBox[{"Riccicd", "[", 
        RowBox[{
         RowBox[{"-", "\[ScriptM]"}], ",", " ", 
         RowBox[{"-", "\[ScriptN]"}]}], "]"}]}]}], "]"}], " ", "->", " ", 
    RowBox[{
     RowBox[{"Permutations", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "1"}], ",", " ", 
        RowBox[{"-", "1"}]}], "}"}], "]"}], " ", "->", "  ", 
     RowBox[{
      RowBox[{"Permutations", "[", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", 
         RowBox[{"-", "1"}]}], "}"}], "]"}], " ", "->", " ", 
      RowBox[{"Permutations", "[", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "1"}], "}"}], "]"}]}]}]}], "\n", "]"}]}], "\n", 
 RowBox[{
  RowBox[{"sol", "[", 
   RowBox[{
   "$metric", ",", " ", "gg", ",", " ", "$auto", ",", " ", "RicciScalarcd", 
    ",", " ", "Routine", ",", "  ", "Chain"}], "]"}], " ", "=", " ", 
  RowBox[{"{", "\n", 
   RowBox[{
    RowBox[{"HoldForm", "[", " ", 
     RowBox[{"Tr", "@", 
      RowBox[{"ToArray", "@", 
       RowBox[{"Riccicd", "[", 
        RowBox[{"\[ScriptM]", ",", " ", 
         RowBox[{"-", "\[ScriptN]"}]}], "]"}]}]}], "]"}], " ", "->", " ", 
    RowBox[{"{", "}"}]}], "\n", "}"}]}], "\n", 
 RowBox[{
  RowBox[{"sol", "[", 
   RowBox[{
   "$metric", ",", " ", "gg", ",", " ", "$auto", ",", " ", "Riemanncd", ",", 
    " ", "Routine", ",", " ", "Chain"}], "]"}], " ", "=", "  ", 
  RowBox[{"RulesToChain", "[", "\n", 
   RowBox[{
    RowBox[{"HoldForm", "[", " ", 
     RowBox[{"ToArray", "@", 
      RowBox[{"ContractMetric", "@", " ", 
       RowBox[{"RiemannToChristoffel", "@", " ", 
        RowBox[{"Riemanncd", "[", 
         RowBox[{
          RowBox[{"-", "\[ScriptM]"}], ",", " ", 
          RowBox[{"-", "\[ScriptN]"}], ",", " ", 
          RowBox[{"-", "\[ScriptO]"}], ",", " ", 
          RowBox[{"-", "\[ScriptP]"}]}], "]"}]}]}]}], "]"}], " ", "->", " ", 
    RowBox[{
     RowBox[{"Permutations", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "1"}], ",", " ", 
        RowBox[{"-", "1"}], ",", " ", 
        RowBox[{"-", "1"}], ",", " ", 
        RowBox[{"-", "1"}]}], "}"}], "]"}], " ", "->", "  ", 
     RowBox[{"Permutations", "[", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", 
        RowBox[{"-", "1"}], ",", " ", 
        RowBox[{"-", "1"}], ",", " ", 
        RowBox[{"-", "1"}]}], "}"}], "]"}]}]}], "\n", "]"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"sol", "[", 
    RowBox[{
    "$metric", ",", " ", "gg", ",", " ", "$auto", ",", " ", "Detgg", ",", " ",
      "Routine", ",", "  ", "Chain"}], "]"}], " ", "=", " ", 
   RowBox[{"{", "\n", 
    RowBox[{
     RowBox[{"HoldForm", "[", " ", 
      RowBox[{"Det", "@", 
       RowBox[{"ToArray", "@", 
        RowBox[{"gg", "[", 
         RowBox[{
          RowBox[{"-", "\[ScriptM]"}], ",", " ", 
          RowBox[{"-", "\[ScriptN]"}]}], "]"}]}]}], "]"}], " ", "->", " ", 
     RowBox[{"{", "}"}]}], "\n", "}"}]}], ";"}]}], "Input",
 CellLabel->"In[19]:=",
 CellID->2008,ExpressionUUID->"adee6de6-bcab-46a9-b76c-180d229e477e"],

