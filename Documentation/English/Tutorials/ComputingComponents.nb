Cell[TextData[{
 "If on the left-hand side we have something wrapped in ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["HoldForm"]], "paclet:ref/HoldForm"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "25aa8dc2-4bf4-4018-abb5-658a78e11b0a"],
 " it means that this eventually provides the literal array that has to enter \
the particular component configuration. If on the left-hand side we have a \
list of components it means that the right-hand side will be obtained from it \
by raising or lowering with a metric."
}], "Text",
 CellID->1963,ExpressionUUID->"c121e3d8-331f-40d0-9c3e-c9504cb15c3f"],

