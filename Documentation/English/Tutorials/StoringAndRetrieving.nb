Cell["Storing and deleting data entries", "Section",
 CellID->1798,ExpressionUUID->"562fd8d3-713b-42c0-8a81-c9e94ae8363f"],

Cell["Let us prepare a simple data entry:", "MathCaption",
 CellID->1799,ExpressionUUID->"53a66b1f-15cb-4252-9e4c-c774267582aa"],

Cell[BoxData[
 RowBox[{"Instantiate", "[", "test", "]"}]], "Input",
 CellLabel->"In[10]:=",
 CellID->1800,ExpressionUUID->"5d3d99db-9993-405e-9146-aa6c61670732"],

Cell[BoxData[
 RowBox[{"IncludeTo", "[", 
  RowBox[{
   RowBox[{"test", "[", "$manifold", "]"}], ",", " ", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"Symbol", " ", "->", " ", "\[ScriptCapitalM]"}], ",", " ", 
     RowBox[{"Dimension", " ", "->", " ", "4"}], ",", " ", 
     RowBox[{"Index", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"a", ",", " ", "b", ",", " ", "c"}], "}"}]}]}], "|>"}]}], 
  "]"}]], "Input",
 CellLabel->"In[11]:=",
 CellID->1801,ExpressionUUID->"53f29858-36c2-4b4d-b4d6-0ec93806b634"],

Cell[TextData[{
 "To save it with ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["SaveData"]], "paclet:VasilDimitrov/SolutionsX/ref/SaveData", 
    "VasilDimitrov Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "19530b88-485f-458f-9076-2d6ca7de7ee6"],
 ", as a minimum one needs to supply the ",
 Cell[BoxData[
  StyleBox["Name", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "a37de480-2f08-41a3-ba96-1dc999a3e67d"],
 " key of the first manifold appearing under test[$manifold]:"
}], "MathCaption",
 CellID->1802,ExpressionUUID->"055fa692-9778-47bb-97c3-d9ccb77c61a9"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"test", "[", 
    RowBox[{"$manifold", ",", " ", "\[ScriptCapitalM]", ",", " ", "Name"}], 
    "]"}], " ", "=", " ", "\"\<Test\>\""}], ";"}], "\n", 
 RowBox[{"SaveData", "@", "test"}]}], "Input",
 CellLabel->"In[12]:=",
 CellID->1803,ExpressionUUID->"108c8839-aa6e-4167-a77c-78bddca8f55f"],

Cell["\<\
The entry gets an automatically computed name \[LongDash] SaveData takes no \
name argument. The name is assembled from the record, segment by segment, \
double-underscore separated. The entry just saved:\
\>", "Text",
 CellID->1804,ExpressionUUID->"8df12fe7-a0ce-4775-8ec4-1b09d4f82fef"],

Cell[BoxData[
 RowBox[{
  UnderscriptBox[
   StyleBox["\<\"Thr\"\>",
    ShowStringCharacters->False,
    FontFamily->"Source Code Pro",
    FontSize->16,
    FontWeight->"Bold"], 
   StyleBox["\<\"  kind: a theory  \"\>",
    ShowStringCharacters->False,
