 CellLabel->"In[2]:=",
 CellID->1779,ExpressionUUID->"54de8f1e-cbf3-4c83-a157-69601ac84321"],

Cell[BoxData["\<\"/Users/vasko/000/SolutionsX/Data\"\>"], "Output",
