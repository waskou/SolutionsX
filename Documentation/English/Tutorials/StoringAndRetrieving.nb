Cell["Storing and deleting data entries", "Section",
 CellID->2071,ExpressionUUID->"21643f89-d913-4c84-8785-7135ce3d7c2f"],

Cell["Let us prepare a simple data entry:", "MathCaption",
 CellID->2072,ExpressionUUID->"491dcfff-f7ff-4cfb-adba-8ca43e39b3f9"],

Cell[BoxData[
 RowBox[{"Instantiate", "[", "test", "]"}]], "Input",
 CellLabel->"In[10]:=",
 CellID->2073,ExpressionUUID->"2835fab7-c00f-4325-8ec8-8a080a2e787d"],

Cell[BoxData[
 RowBox[{"IncludeTo", "[", 
  RowBox[{
   RowBox[{"test", "[", "$manifold", "]"}], ",", " ", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"Symbol", " ", "->", " ", "\[ScriptCapitalM]"}], ",", " ", 
     RowBox[{"Dimension", " ", "->", " ", "4"}], ",", " ", 
     RowBox[{"Index", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"a", ",", " ", "b", ",", " ", "c"}], "}"}]}]}], "|>"}]}], 
  "]"}]], "Input",
 CellLabel->"In[11]:=",
 CellID->2074,ExpressionUUID->"acbe3085-c33a-495e-b33d-4a38ad6e3259"],

Cell[TextData[{
 "To save it with ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["SaveData"]], "paclet:VasilDimitrov/SolutionsX/ref/SaveData", 
    "VasilDimitrov Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "c80e4980-03d2-4211-acd8-4881dbdb3c3d"],
 ", as a minimum one needs to supply the ",
 Cell[BoxData[
  StyleBox["Name", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "31cd50fe-dec8-4ec2-804a-e108dedca2e9"],
 " key of the first manifold appearing under test[$manifold]:"
}], "MathCaption",
 CellID->2075,ExpressionUUID->"69501282-92a2-4d59-a1dd-ba77a70113f1"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"test", "[", 
    RowBox[{"$manifold", ",", " ", "\[ScriptCapitalM]", ",", " ", "Name"}], 
    "]"}], " ", "=", " ", "\"\<Test\>\""}], ";"}], "\n", 
 RowBox[{"SaveData", "@", "test"}]}], "Input",
 CellLabel->"In[12]:=",
 CellID->2076,ExpressionUUID->"a955d7c9-6927-46d2-adee-d381f804c9d3"],

Cell["\<\
The entry gets an automatically computed name \[LongDash] SaveData takes no \
name argument. The name is assembled from the record, segment by segment, \
double-underscore separated. The entry just saved:\
\>", "Text",
 CellID->2077,ExpressionUUID->"e19fd711-7235-4ec8-90c2-af1c6be7da2a"],

Cell[BoxData[
 RowBox[{
  UnderscriptBox[
   StyleBox["\<\"Thr\"\>",
    ShowStringCharacters->False,
    FontFamily->"Source Code Pro",
    FontSize->16,
    FontWeight->"Bold"], 
   StyleBox["\<\"  kind: a theory  \"\>",
    ShowStringCharacters->False,
    FontFamily->"Source Sans Pro",
    FontSize->9.5,
    FontSlant->"Italic",
    FontColor->GrayLevel[0.45]]], 
