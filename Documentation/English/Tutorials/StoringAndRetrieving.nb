 CellID->1805,ExpressionUUID->"848701cd-3c2b-44a6-b7e5-3cd10c8d1038"],

Cell["and the black hole used later in this note:", "Text",
 CellID->1806,ExpressionUUID->"1eefd067-943e-43f9-9bd3-5ee4446b12fe"],

Cell[BoxData[
 RowBox[{
  UnderscriptBox[
   StyleBox["\<\"Sol\"\>",
    ShowStringCharacters->False,
