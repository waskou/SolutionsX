Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["SaveData"]], "paclet:VasilDimitrov/SolutionsX/ref/SaveData", 
    "VasilDimitrov Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "39ee7fe3-d46e-44e8-af98-44b214c21145"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DeleteData"]], 
    "paclet:VasilDimitrov/SolutionsX/ref/DeleteData", 
    "VasilDimitrov Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "6f8c9db5-849f-4c78-bc3d-459879eea41d"],
 " operate only within the configured alias. The idea: say you copied the \
data entries from the folder Curated, and a friend gave you their data which \
you stored under FriendName. You are not the person to be saving into and \
deleting from those two folders \[LongDash] but you are the person to be \
saving into and deleting from your own."
}], "Text",
 CellID->2088,ExpressionUUID->"6ca09e91-7b31-4807-baf8-61294b8b1515"],

