    FontColor->GrayLevel[0.45]]]}]], "DefinitionBox",
 CellID->2078,ExpressionUUID->"e44ac3d4-2508-4fcd-8880-ab219c24af7b"],

Cell["and the black hole used later in this note:", "Text",
 CellID->2079,ExpressionUUID->"2fa37767-9d92-416d-9898-0ce2959bdc30"],

Cell[BoxData[
 RowBox[{
  UnderscriptBox[
   StyleBox["\<\"Sol\"\>",
    ShowStringCharacters->False,
    FontFamily->"Source Code Pro",
    FontSize->16,
    FontWeight->"Bold"], 
