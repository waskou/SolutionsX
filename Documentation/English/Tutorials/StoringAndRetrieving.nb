 TemplateBox[{
  "DeleteData", "missingname", 
   "\"name(Name) is missing from the names: \
{\\\"Sol__3dL__Induced-black-hole__FG\\\", \\\"Sol__4dL__Black-hole__FG\\\", \
\\\"Sol__4dL__Black-hole__Global\\\", \
\\\"Sol__5dL__CCLP-susy__Orthotoric\\\", \
\\\"Thr__3dL__Boundary-minimal-gauged\\\", \\\"Thr__4dL__Minimal-gauged\\\", \
\\\"Thr__4d__Test\\\", \\\"Thr__5dL__Minimal-gauged\\\", \
\\\"Thr__5dL__STU-gauged\\\"}, found under alias: Vasko\"", 2, 1, 1, 0, 
   "Local"},
  "MessageTemplate"]], "Message", "MSG",
 CellLabel->"During evaluation of In[1]:=",
 CellID->1814,ExpressionUUID->"876addfb-dc25-4ae2-8fdc-0239f5649f06"]
