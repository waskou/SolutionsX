Cell[TextData[{
 "These are controlled with the functions ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["SetDataDirectory"]], 
    "paclet:VasilDimitrov/SolutionsX/ref/SetDataDirectory", 
    "VasilDimitrov Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "076b4a5d-f039-44da-896a-ded34ed5a145"],
 ", ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["SetAlias"]], "paclet:VasilDimitrov/SolutionsX/ref/SetAlias", 
    "VasilDimitrov Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "21ce329c-5fd1-4209-a735-85aab1be9b24"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["SetCurator"]], 
    "paclet:VasilDimitrov/SolutionsX/ref/SetCurator", 
    "VasilDimitrov Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "868ab9a9-6f01-4aaf-b2b0-f0c0939a853b"],
 ". Each records the change in the configuration permanently by default; with \
",
 Cell[BoxData[
  StyleBox["Permanent", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "cb54ddb5-5179-4573-b30d-d84a79474b41"],
 " -> False it lasts for the session only."
}], "Text",
 CellID->2058,ExpressionUUID->"17a06b2a-3c97-4468-a947-e1659582fbc8"],

