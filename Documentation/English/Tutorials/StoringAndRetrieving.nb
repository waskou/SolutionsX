  FontFamily->"Source Sans Pro",ExpressionUUID->
  "e0fdba6f-268f-4aba-9ae0-5c1a11c9273b"],
 ":"
}], "MathCaption",
 CellID->1796,ExpressionUUID->"e165e0f5-79dd-4418-917d-bfad98cadb4c"],

