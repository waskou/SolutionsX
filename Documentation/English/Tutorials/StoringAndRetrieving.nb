WindowTitle->"Storing and retrieving",
TaggingRules-><|
 "Metadata" -> <|
   "title" -> "Storing and retrieving", "summary" -> 
    "Every solution lives on disk as an entry: a folder holding the record (a \
compressed association in a .m file) and the notebook that produced it. This \
note walks the full life of an entry: where it lives, how it is named and \
saved, how it is read back, loaded, resumed, shared and published.", 
    "context" -> "VasilDimitrov`SolutionsX`", "paclet" -> 
    "VasilDimitrov/SolutionsX", "type" -> "Tech Note", "language" -> "en", 
