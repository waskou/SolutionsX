Cell[BoxData["\<\"/Users/vasko/000/SolutionsX/Data/Vasko\"\>"], "Output",
 CellLabel->"Out[8]=",
 CellID->1794,ExpressionUUID->"b5da4f06-8da6-40fb-862d-5c52908fcde2"]
}, Open  ]],

Cell["\<\
The curator flag is reserved for power users who wish to contribute their \
data entries to the public repository. Contact vasildimi@gmail.com if you \
wish to become a curator.\
\>", "Text",
 CellID->1795,ExpressionUUID->"5bd25122-41c8-4c19-b03a-eaea8f0b4d5f"],

