Cell["An object stores:", "Text",
 CellID->1400,ExpressionUUID->"e4117dfd-1980-4d6c-821c-2f91bd6db36e"],

Cell[TextData[{
 "instructions for xAct on how it will be loaded, mimicking xAct\
\[CloseCurlyQuote]s ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Options"]], "paclet:ref/Options"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "2b121aaa-1014-4388-b4bf-a79bc5c446e1"]
}], "Item",
 CellID->1401,ExpressionUUID->"6538ebe3-d605-43dd-b34a-b606be799802"],

Cell[TextData[{
 "placeholders for whatever children objects xAct creates, under the special \
key ",
 Cell[BoxData["$auto"], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "fe4b201e-b908-48ca-ad6b-a403af306f6b"]
}], "Item",
 CellID->1402,ExpressionUUID->"28505403-1912-49ad-82f9-5b269f26cb68"],

Cell[TextData[{
 "if the object is of tensorial form: placeholders for the instructions on \
how to compute its components, and for the computed ",
 ButtonBox["TensorValues",
  BaseStyle->"Link",
  Appearance->None,
  Evaluator->Automatic,
  ButtonFunction:>NotebookOpen[
    FindFile["xAct/Documentation/English/" <> "xCobaDoc.nb"]]]
}], "Item",
 CellID->1403,ExpressionUUID->"8350d029-321e-4ce9-b7bc-cf471a07edd2"],

Cell["The following functions can act on SolutionsX\[CloseCurlyQuote]s \
objects:", "MathCaption",
 CellID->1404,ExpressionUUID->"07223713-630c-4d20-86f3-eae2c0d29578"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"UpValues", "[", "$manifold", "]"}], "[", 
  RowBox[{"[", 
   RowBox[{"All", ",", " ", "1", ",", " ", "1", ",", " ", "0"}], "]"}], 
  "]"}]], "Input",
 CellLabel->"In[8]:=",
 CellID->1405,ExpressionUUID->"9adf4ce9-0e05-48b6-88e4-7249dea161a2"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
  "DefOf", ",", "KeysOf", ",", "makeKey", ",", "ModKeysOf", ",", "OptKeysOf", 
   ",", "PropKeysOf", ",", "UndefOf"}], "}"}]], "Output",
 CellLabel->"Out[8]=",
 CellID->1406,ExpressionUUID->"32315abd-422f-44b9-97cf-f72400bbfaea"]
}, Open  ]],

Cell[TextData[{
 Cell[BoxData["DefOf"], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "165edfe0-58c2-41af-9004-1edeff57836b"],
 " spells out the function used at definition time (usually an xAct Def \
function). ",
 Cell[BoxData["KeysOf"], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "859ec72d-7b2c-4b63-979f-1b645b9c43fb"],
 " spells out all the keys of the object. ",
 Cell[BoxData["ModKeysOf"], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "51b9b860-3387-4986-91c4-3b4f02147bcc"],
 " spells out the keys whose values are expected to be modified at run time. ",
 Cell[BoxData["OptKeysOf"], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "a7cd5eb4-b731-48cc-bf40-fe7060523d0a"],
 " specifies which among the keys are xAct ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Options"]], "paclet:ref/Options"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "636e14cf-a04f-4a72-a7be-0e080601a2e9"],
 ", and ",
 Cell[BoxData["PropKeysOf"], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "952f37f2-2246-44f3-99b1-472f0d6e49d9"],
 " the keys that must be supplied for the object to be defined in the first \
place. Finally, ",
 Cell[BoxData["UndefOf"], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "d6af6a16-678b-4eca-bc31-83d8d33a4f7e"],
 " spells out the function used for undefining (usually an xAct Undef \
function)."
}], "Text",
 CellID->1407,ExpressionUUID->"8475b8f0-6fd6-45a5-8e96-62a47a42b0f6"],

