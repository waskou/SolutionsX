Cell[CellGroupData[{

Cell["Objects in SolutionsX", "Title",
 CellID->1396,ExpressionUUID->"9a3fafa7-7868-4732-abd6-956d02da056f"],

Cell["\<\
A solution is an association over eighteen object types. Each entry records \
the arguments of one xAct definition, so that the definition can be validated \
before it is made, stored after it is made, and replayed on demand. This note \
walks through the object system.\
\>", "Text",
 CellID->1397,ExpressionUUID->"bd55bf4c-0d7b-418a-a023-47dcc894c984"],

Cell["Load the package:", "MathCaption",
 CellID->1398,ExpressionUUID->"8656b066-93ff-46a5-b2a0-9ab101c89dff"],

Cell[BoxData[
 RowBox[{"<<", " ", "VasilDimitrov`SolutionsX`"}]], "Input",
 CellLabel->"In[1]:=",
 CellID->1399,ExpressionUUID->"1965e2b7-a389-41b2-8d20-f8015c6ec63e"],

Cell["\<\
Out of the box SolutionsX comes with the following \
\[OpenCurlyDoubleQuote]objects\[CloseCurlyDoubleQuote]:\
\>", "MathCaption",
 CellID->1400,ExpressionUUID->"58b4320a-7e50-496d-b374-219430ed73d6"],

Cell[CellGroupData[{

Cell[BoxData["$Objects"], "Input",
 CellLabel->"In[2]:=",
 CellID->1401,ExpressionUUID->"07da03f3-ac3b-4fe2-b935-496dc1bd3e7e"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
  "$manifold", ",", "$parameter", ",", "$metric", ",", "$frame", ",", 
   "$spinStructure", ",", "$spinConnection", ",", "$bundle", ",", "$covd", 
   ",", "$chart", ",", "$basis", ",", "$form", ",", "$tensor", ",", "$spinor",
    ",", "$function", ",", "$constant", ",", "$assumption", ",", "$rule", ",",
    "$set"}], "}"}]], "Output",
 CellLabel->"Out[2]=",
 CellID->1402,ExpressionUUID->"c7f0c226-f87b-4a85-bc85-2f36a9f537d3"]
}, Open  ]],

Cell[TextData[{
 "Each of them comes with a \[OpenCurlyDoubleQuote]constructor\
\[CloseCurlyDoubleQuote], which can be called empty or with a sequence of \
key-value pairs. Called empty, it spells out an ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Association"]], "paclet:ref/Association"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "89fdb6ef-2466-467b-9640-eb117c7d30b6"],
 " whose values are the expected ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Pattern"]], "paclet:ref/Pattern"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "80bd95cf-aa21-467d-a301-102cc0d67004"],
 "s. Called filled up (correctly), the unspecified values fill up to their \
defaults:"
}], "Text",
 CellID->1403,ExpressionUUID->"06ab4910-0538-47d6-a389-073c5eba1c57"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"$manifold", "[", "]"}]], "Input",
 CellLabel->"In[3]:=",
 CellID->1404,ExpressionUUID->"dafcd934-7993-4fb7-bc25-5d5cefaa0a45"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"Symbol", "\[Rule]", "_Symbol"}], ",", 
   RowBox[{"Dimension", "\[Rule]", 
    RowBox[{
     RowBox[{"_Integer", "?", "Positive"}], "|", 
     InterpretationBox[
      StyleBox["d",
       ShowAutoStyles->False,
       AutoSpacing->False],
      xAct`Invar`dim,
      Editable->False]}]}], ",", 
   RowBox[{"Index", "\[Rule]", 
    RowBox[{"{", "__Symbol", "}"}]}], ",", 
   RowBox[{"Name", "\[Rule]", 
    RowBox[{"_String", "|", "name"}]}], ",", 
   RowBox[{"Master", "\[Rule]", "_Symbol"}], ",", 
   RowBox[{"PrintAs", "\[Rule]", 
    RowBox[{"_String", "|", "Identity"}]}], ",", 
   RowBox[{"ProtectNewSymbol", "\[RuleDelayed]", 
    RowBox[{"ScreenDollarIndices", "[", 
     RowBox[{"True", "|", "False"}], "]"}]}], ",", 
   RowBox[{"DefInfo", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"_String", ",", "_String"}], "}"}]}]}], 
  "\[RightAssociation]"}]], "Output",
 CellLabel->"Out[3]=",
 CellID->1405,ExpressionUUID->"7921bc58-fc22-4ee1-a669-84b7852b5db1"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"$manifold", "[", 
  RowBox[{
   RowBox[{"Symbol", " ", "->", " ", "\[ScriptCapitalM]"}], ",", " ", 
   RowBox[{"Dimension", " ", "->", " ", "6"}], ",", " ", 
   RowBox[{"Index", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
     "\[ScriptM]", ",", " ", "\[ScriptN]", ",", " ", "\[ScriptO]", ",", " ", 
      "\[ScriptP]", ",", " ", "\[ScriptQ]", ",", " ", "\[ScriptR]", ",", " ", 
      "\[ScriptS]"}], "}"}]}]}], "]"}]], "Input",
 CellLabel->"In[4]:=",
 CellID->1406,ExpressionUUID->"9a2cf533-0f73-4fad-84e0-18f6efe1dd6f"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"Symbol", "\[Rule]", "\[ScriptCapitalM]"}], ",", 
   RowBox[{"Dimension", "\[Rule]", "6"}], ",", 
   RowBox[{"Index", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
     "\[ScriptM]", ",", "\[ScriptN]", ",", "\[ScriptO]", ",", "\[ScriptP]", 
      ",", "\[ScriptQ]", ",", "\[ScriptR]", ",", "\[ScriptS]"}], "}"}]}], ",", 
   RowBox[{"Name", "\[Rule]", "name"}], ",", 
   RowBox[{"Master", "\[Rule]", "Null"}], ",", 
   RowBox[{"PrintAs", "\[Rule]", "Identity"}], ",", 
   RowBox[{"ProtectNewSymbol", "\[RuleDelayed]", 
    RowBox[{"ScreenDollarIndices", "[", "$ProtectNewSymbols", "]"}]}], ",", 
   RowBox[{"DefInfo", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"\<\"manifold\"\>", ",", "\<\"\"\>"}], "}"}]}]}], 
  "\[RightAssociation]"}]], "Output",
 CellLabel->"Out[4]=",
 CellID->1407,ExpressionUUID->"bfd265a9-0f44-4d01-b5e0-3925f04ab833"]
}, Open  ]],

Cell["\<\
It is immaterial in which order the key-value pairs are given; the final \
result is canonically ordered:\
\>", "MathCaption",
 CellID->1408,ExpressionUUID->"9a72a848-905b-4811-8493-0ab2f1ca89d3"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"$manifold", "[", 
  RowBox[{
   RowBox[{"Index", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
     "\[ScriptM]", ",", " ", "\[ScriptN]", ",", " ", "\[ScriptO]", ",", " ", 
      "\[ScriptP]", ",", " ", "\[ScriptQ]", ",", " ", "\[ScriptR]", ",", " ", 
      "\[ScriptS]"}], "}"}]}], ",", " ", 
   RowBox[{"Symbol", " ", "->", " ", "\[ScriptCapitalM]"}], ",", " ", 
