Cell[CellGroupData[{

Cell["Objects in SolutionsX", "Title",
 CellID->1380,ExpressionUUID->"d43107ca-f548-43c4-9331-754413f0529f"],

Cell["\<\
A solution is an association over eighteen object types. Each entry records \
the arguments of one xAct definition, so that the definition can be validated \
before it is made, stored after it is made, and replayed on demand. This note \
walks through the object system.\
\>", "Text",
 CellID->1381,ExpressionUUID->"eb0392b5-8fea-467a-882e-a4d82cbef487"],

Cell["Load the package:", "MathCaption",
 CellID->1382,ExpressionUUID->"5975fd23-74a3-4653-afc0-e00426ddd139"],

Cell[BoxData[
 RowBox[{"<<", " ", "VasilDimitrov`SolutionsX`"}]], "Input",
 CellLabel->"In[1]:=",
 CellID->1383,ExpressionUUID->"5c31430b-3d70-4fc4-ab16-fc02d70e52a0"],

Cell["\<\
Out of the box SolutionsX comes with the following \
\[OpenCurlyDoubleQuote]objects\[CloseCurlyDoubleQuote]:\
\>", "MathCaption",
 CellID->1384,ExpressionUUID->"d4f5a695-615f-4bec-b6b1-a99c7816d711"],

Cell[CellGroupData[{

Cell[BoxData["$Objects"], "Input",
 CellLabel->"In[2]:=",
 CellID->1385,ExpressionUUID->"6e35d2a6-7a9d-423f-92ea-07c434a7664c"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
  "$manifold", ",", "$parameter", ",", "$metric", ",", "$frame", ",", 
   "$spinStructure", ",", "$spinConnection", ",", "$bundle", ",", "$covd", 
   ",", "$chart", ",", "$basis", ",", "$form", ",", "$tensor", ",", "$spinor",
    ",", "$function", ",", "$constant", ",", "$assumption", ",", "$rule", ",",
    "$set"}], "}"}]], "Output",
 CellLabel->"Out[2]=",
 CellID->1386,ExpressionUUID->"628a9830-9d5b-4af5-b0b1-9b8d5ad0f8ed"]
}, Open  ]],

Cell[TextData[{
 "Each of them comes with a \[OpenCurlyDoubleQuote]constructor\
\[CloseCurlyDoubleQuote], which can be called empty or with a sequence of \
key-value pairs. Called empty, it spells out an ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Association"]], "paclet:ref/Association"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "331be9ce-d74e-4222-9410-246d737fae12"],
 " whose values are the expected ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Pattern"]], "paclet:ref/Pattern"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "d083f657-f59d-475b-a66b-52a6ba6df2bf"],
 "s. Called filled up (correctly), the unspecified values fill up to their \
defaults:"
}], "Text",
 CellID->1387,ExpressionUUID->"68cfdd56-4ac3-4fae-b8d9-e2633a31812c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"$manifold", "[", "]"}]], "Input",
 CellLabel->"In[3]:=",
 CellID->1388,ExpressionUUID->"06e560ac-92a1-4f8f-aafb-a29d0964ef30"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"Symbol", "\[Rule]", "_Symbol"}], ",", 
   RowBox[{"Dimension", "\[Rule]", 
    RowBox[{
     RowBox[{"_Integer", "?", "Positive"}], "|", 
     InterpretationBox[
      StyleBox["d",
       ShowAutoStyles->False,
       AutoSpacing->False],
      xAct`Invar`dim,
      Editable->False]}]}], ",", 
   RowBox[{"Index", "\[Rule]", 
    RowBox[{"{", "__Symbol", "}"}]}], ",", 
   RowBox[{"Name", "\[Rule]", 
    RowBox[{"_String", "|", "name"}]}], ",", 
   RowBox[{"Master", "\[Rule]", "_Symbol"}], ",", 
   RowBox[{"PrintAs", "\[Rule]", 
    RowBox[{"_String", "|", "Identity"}]}], ",", 
   RowBox[{"ProtectNewSymbol", "\[RuleDelayed]", 
    RowBox[{"ScreenDollarIndices", "[", 
     RowBox[{"True", "|", "False"}], "]"}]}], ",", 
   RowBox[{"DefInfo", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"_String", ",", "_String"}], "}"}]}]}], 
  "\[RightAssociation]"}]], "Output",
 CellLabel->"Out[3]=",
 CellID->1389,ExpressionUUID->"79b0595f-551f-49e1-9348-63e5fe7e04d9"]
}, Open  ]],

Cell[CellGroupData[{

