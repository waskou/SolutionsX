Cell["\<\
SolutionsX introduces three objects which do not have xAct analogues:\
\>", "Text",
 CellID->1436,ExpressionUUID->"c2f28afb-256b-403e-b229-a9c33e07b32c"],

Cell[TextData[{
 Cell[BoxData["$assumption"], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "ebf7c586-f85d-4d34-901a-8006ab3002f2"],
 ": a place to store global assumptions that are to be reused in the next \
session"
}], "Item",
 CellID->1437,ExpressionUUID->"5da1e8a1-661e-4176-80c5-86eefc777041"],

Cell[TextData[{
 Cell[BoxData["$rule"], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "bc644cbb-b439-40bb-83fc-747b944f9c13"],
 ": a place to store custom rules, often used to store \
\[OpenCurlyDoubleQuote]results\[CloseCurlyDoubleQuote] that a different \
notebook might need"
}], "Item",
 CellID->1438,ExpressionUUID->"0ae65d96-c8f6-4e8b-8fa3-46c0c943d3dd"],

Cell[TextData[{
 Cell[BoxData["$set"], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "a4878540-eafa-45f0-b479-feacf21c47e1"],
 ": a place to store tensorial equations which will be reused in later \
sessions"
}], "Item",
 CellID->1439,ExpressionUUID->"6dc7ecb2-27e2-444c-b452-a9f96f6097ad"],

Cell[TextData[{
 "As such, these objects have no ",
 Cell[BoxData["DefOf"], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "ff4a7ed5-5525-40b4-9e97-6958989d7990"],
 " and ",
 Cell[BoxData["UndefOf"], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "cef881d2-583c-409d-95a8-864880f88693"],
 ":"
}], "MathCaption",
 CellID->1440,ExpressionUUID->"f324668a-699c-4d48-814f-c60feca2c052"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"UpValues", "[", "$set", "]"}], "[", 
  RowBox[{"[", 
   RowBox[{"All", ",", " ", "1", ",", " ", "1", ",", " ", "0"}], "]"}], 
