 CellLabel->"Out[4]=",
 CellID->1391,ExpressionUUID->"ea2add4c-1803-44d1-bf8b-151e5b0a110a"]
}, Open  ]],

Cell["\<\
It is immaterial in which order the key-value pairs are given; the final \
result is canonically ordered:\
\>", "MathCaption",
 CellID->1392,ExpressionUUID->"0425ec9e-9f0c-4026-99b1-df62efb07831"],

