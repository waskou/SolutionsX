 RowBox[{"$manifold", "[", 
  RowBox[{
   RowBox[{"Symbol", " ", "->", " ", "\[ScriptCapitalM]"}], ",", " ", 
   RowBox[{"Dimension", " ", "->", " ", "6"}], ",", " ", 
   RowBox[{"Index", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
     "\[ScriptM]", ",", " ", "\[ScriptN]", ",", " ", "\[ScriptO]", ",", " ", 
