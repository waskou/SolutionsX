 CellID->1410,ExpressionUUID->"65871b5d-e3e5-41ef-b0b4-658d8b706b37"]
}, Open  ]],

Cell[TextData[{
 "The constructor automatically calls ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["ValidateObject"]], 
    "paclet:VasilDimitrov/SolutionsX/ref/ValidateObject", 
    "VasilDimitrov Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "f90596de-0475-4a45-bc49-a341e304e03e"],
 ", and it will complain if the input is not of the expected type, or if \
\[OpenCurlyDoubleQuote]essential info\[CloseCurlyDoubleQuote] is missing:"
}], "Text",
 CellID->1411,ExpressionUUID->"665b1e14-1198-4ff2-b165-3ec04e4fcc2b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"$manifold", "[", 
  RowBox[{
   RowBox[{"Symbol", " ", "->", " ", "\[ScriptCapitalM]"}], ",", " ", 
   RowBox[{"Dimension", " ", "->", " ", "6"}], ",", " ", 
   RowBox[{"Index", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
     "5", ",", " ", "\"\<silly string\>\"", ",", " ", "\[ScriptO]", ",", " ", 
      "\[ScriptP]", ",", " ", "\[ScriptQ]", ",", " ", "\[ScriptR]", ",", " ", 
      "\[ScriptS]"}], "}"}]}]}], "]"}]], "Input",
 CellLabel->"In[6]:=",
 CellID->1412,ExpressionUUID->"462c4fc8-9709-4c79-a813-dbb553f09895"],

Cell[BoxData[
 TemplateBox[{
  "ValidateObject", "badval", 
   "\"The value for key Index ({5, \\\"silly string\\\", \[ScriptO], \
\[ScriptP], \[ScriptQ], \[ScriptR], \[ScriptS]}) does not match the expected \
pattern: {__Symbol}.\"", 2, 1, 1, 0, "Local"},
  "MessageTemplate"]], "Message", "MSG",
 CellLabel->"During evaluation of In[1]:=",
 CellID->1413,ExpressionUUID->"bca4694e-0fa7-40c1-8485-efcbb80ae274"]
}, Open  ]],

