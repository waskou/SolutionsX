Cell[TextData[{
 "A simpler example is the following rule. Say that you introduced a symbol \
",
 Cell[BoxData[
  StyleBox["a", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "5f3bed50-404d-4e38-97c9-aa3f3d2f71c2"],
 " and deduced that it is equal to 5. You might want to store this \
information for later, under the name ",
 Cell[BoxData["my\[UnderBracket]custom\[UnderBracket]rule"], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "a9120167-d918-4118-874d-2b507db3c6bd"],
 ":"
}], "Text",
 CellID->1434,ExpressionUUID->"0310e695-1daa-466c-b688-1cd4a36dc0a4"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"$rule", "[", 
  RowBox[{
   RowBox[{
   "Symbol", " ", "->", " ", "my\[UnderBracket]custom\[UnderBracket]rule"}], 
   ",", " ", 
   RowBox[{"Expression", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"a", " ", "->", " ", "5"}], "}"}]}]}], "]"}]], "Input",
 CellLabel->"In[18]:=",
 CellID->1435,ExpressionUUID->"f12db1c9-611e-464a-a7b0-1002e437a6be"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{
   "Symbol", "\[Rule]", "my\[UnderBracket]custom\[UnderBracket]rule"}], ",", 
   RowBox[{"Expression", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"a", "\[Rule]", "5"}], "}"}]}]}], 
  "\[RightAssociation]"}]], "Output",
 CellLabel->"Out[18]=",
 CellID->1436,ExpressionUUID->"d66d613c-1d68-4894-9546-5e2448f36117"]
}, Open  ]],

