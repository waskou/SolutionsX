Cell[TextData[{
 "The constructor automatically calls ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["ValidateObject"]], 
    "paclet:VasilDimitrov/SolutionsX/ref/ValidateObject", 
    "VasilDimitrov Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "cda5195e-a2d4-4fd1-a3ec-b9069a2ed819"],
 ", and it will complain if the input is not of the expected type, or if \
\[OpenCurlyDoubleQuote]essential info\[CloseCurlyDoubleQuote] is missing:"
}], "Text",
 CellID->1395,ExpressionUUID->"b12f136b-e3bc-456f-9590-981e8b55206e"],

