Cell["\<\
SolutionsX introduces three objects which do not have xAct analogues:\
\>", "Text",
 CellID->1420,ExpressionUUID->"c4773db9-7128-43a7-9b1e-00ca2b66bab4"],

Cell[TextData[{
 Cell[BoxData["$assumption"], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "54af0a89-db83-4a4b-b0d7-56081e94355b"],
 ": a place to store global assumptions that are to be reused in the next \
session"
}], "Item",
 CellID->1421,ExpressionUUID->"f6189325-f659-4990-9245-003394a885ff"],

Cell[TextData[{
 Cell[BoxData["$rule"], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "ce7e74b0-4b13-49ba-b6d7-2162afe9e195"],
 ": a place to store custom rules, often used to store \
\[OpenCurlyDoubleQuote]results\[CloseCurlyDoubleQuote] that a different \
notebook might need"
}], "Item",
 CellID->1422,ExpressionUUID->"2223dfc9-f73b-4009-8bb2-123d7268adef"],

Cell[TextData[{
 Cell[BoxData["$set"], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "b0d3da88-67aa-4dde-97ab-13ba7d98672f"],
 ": a place to store tensorial equations which will be reused in later \
sessions"
}], "Item",
 CellID->1423,ExpressionUUID->"654e4601-ae5f-4dd5-b7a7-e306476d66cd"],

Cell[TextData[{
 "As such, these objects have no ",
 Cell[BoxData["DefOf"], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "158e1508-3599-4391-9b54-167c35fa57c7"],
 " and ",
 Cell[BoxData["UndefOf"], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "cfef16a7-475b-48da-9dac-911dec6f1141"],
 ":"
}], "MathCaption",
 CellID->1424,ExpressionUUID->"1897b827-48d4-4869-b98a-2c51d6499384"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"UpValues", "[", "$set", "]"}], "[", 
  RowBox[{"[", 
   RowBox[{"All", ",", " ", "1", ",", " ", "1", ",", " ", "0"}], "]"}], 
