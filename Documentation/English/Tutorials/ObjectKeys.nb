                 RowBox[{"Map", "|", "ParallelMap"}], "\[Rule]", "_"}], ")"}],
                "..."}], "}"}]}]}], "\[RightAssociation]"}]}], ",", 
         RowBox[{"Value", "\[Rule]", "_"}]}], "\[RightAssociation]"}], 
       "..."}]}], "\[RightAssociation]"}]}], ",", 
   RowBox[{"Dagger", "\[Rule]", 
    RowBox[{"Real", "|", "Complex"}]}], ",", 
   RowBox[{"Master", "\[Rule]", "_Symbol"}], ",", 
   RowBox[{"PrintAs", "\[Rule]", 
    RowBox[{"_String", "|", "Identity"}]}], ",", 
   RowBox[{"ProtectNewSymbol", "\[RuleDelayed]", 
    RowBox[{"ScreenDollarIndices", "[", 
     RowBox[{"True", "|", "False"}], "]"}]}], ",", 
   RowBox[{"DefInfo", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"_String", ",", "_String"}], "}"}]}]}], 
  "\[RightAssociation]"}]], "Output",
 CellLabel->"Out[8]=",
 CellID->1527,ExpressionUUID->"fce3797f-ad6c-49c6-96b6-29ac9f6e8bda"]
}, Open  ]],

Cell["The keys of $bundle, by class:", "Caption",
 CellID->1528,ExpressionUUID->"20793559-6f7e-46dd-9c1d-2f8e57d0acbb"],

Cell[BoxData[GridBox[{
   {Cell["key", "TableHeader",ExpressionUUID->
     "a0beaef5-866a-453e-a70d-c98f71dc1925"], Cell[
    "class", "TableHeader",ExpressionUUID->
     "54e61230-8dcf-46fd-a100-f5f2f9faf1e8"], " "},
   {"Symbol", 
    StyleBox["essential", "TI"], Cell["\<\
the symbol xAct defines, with its index slots where it has any; its bare head \
is the name the object is stored and retrieved under\
\>", "TableText",ExpressionUUID->"b633ce16-b514-43e9-9c93-b926d598a05b"]},
   {"Manifold", 
    StyleBox["essential", "TI"], Cell["\<\
the base manifold (or list of manifolds) the object lives on; the Def \
command's manifold argument\
\>", "TableText",ExpressionUUID->"7e20d580-e78f-41c3-b09e-bf3a6026feb6"]},
   {"Dimension", 
    StyleBox["essential", "TI"], Cell[
    "the dimension, a positive integer", "TableText",ExpressionUUID->
     "c3661905-a0f6-4662-b853-43f2cd779e76"]},
   {"Index", 
    StyleBox["essential", "TI"], Cell[
    "the abstract indices to register, as a list of symbols", "TableText",
     ExpressionUUID->"3e9dbca6-c98a-4c04-8f4a-6a1e7371f51f"]},
   {"Metric", 
    StyleBox["essential", "TI"], Cell["\<\
the metric the construction builds on: the frame's flat metric, the spin \
structure's base metric, or the bundle's fiber metric\
\>", "TableText",ExpressionUUID->"b9ddd350-972d-4ef2-953a-b21e8e37837c"]},
   {"InvariantTraceTensor", 
    StyleBox["runtime", "TI"], Cell["\<\
the inner bundle's invariant trace tensor (FieldsX), recorded when computed\
\>", "TableText",ExpressionUUID->"d8490b97-d6fe-493c-8a36-94540f22ba64"]},
   {"$auto", 
    StyleBox["runtime", "TI"], Cell[TextData[{
     "slots for the symbols xAct creates alongside the definition; each \
carries a ",
     Cell[BoxData["Routine"], "InlineFormula",
      FontFamily->"Source Sans Pro",ExpressionUUID->
      "87f1465a-9aed-4f5c-bf50-c4b41fb870e6"],
     " (the ",
     Cell[BoxData["Chain"], "InlineFormula",
      FontFamily->"Source Sans Pro",ExpressionUUID->
      "8ca32769-45b2-4cbe-9c60-4aff74ff4dc8"],
     " recipe that ",
     Cell[BoxData[
      TemplateBox[{
        Cell[
         TextData["Compute"]], "paclet:VasilDimitrov/SolutionsX/ref/Compute", 
        "VasilDimitrov Package Symbol"},
       "PackageLink",
       BaseStyle->"InlineFormula"]], "InlineFormula",
      FontFamily->"Source Sans Pro",ExpressionUUID->
      "f30c2858-3de8-44d9-9680-6c6e0c613174"],
     " follows) and its computed ",
     Cell[BoxData["Value"], "InlineFormula",
      FontFamily->"Source Sans Pro",ExpressionUUID->
      "721fd695-5e20-448e-ac5f-037e2f063257"]
    }], "TableText",ExpressionUUID->"8f77fa38-b828-484f-8b7b-e0c676cf6a25"]},
   {"Dagger", 
    StyleBox["option", "TI"], Cell[TextData[{
     "xAct option: ",
     Cell[BoxData[
      TemplateBox[{
        Cell[
         TextData["Real"]], "paclet:ref/Real"},
       "RefLink",
       BaseStyle->{"InlineFormula"}]], "InlineFormula",
      FontFamily->"Source Sans Pro",ExpressionUUID->
      "c677388f-424c-4b85-bc8d-676f4c353f95"],
     " or ",
     Cell[BoxData[
      TemplateBox[{
        Cell[
         TextData["Complex"]], "paclet:ref/Complex"},
       "RefLink",
       BaseStyle->{"InlineFormula"}]], "InlineFormula",
      FontFamily->"Source Sans Pro",ExpressionUUID->
      "4f430e59-8a73-4bba-8f90-16cfa2b9997f"],
     " behaviour under complex conjugation"
    }], "TableText",ExpressionUUID->"e1e0a29a-9286-4f33-adc2-040d1e94b6e5"]},
   {"Master", 
    StyleBox["option", "TI"], Cell["\<\
xAct option: the master symbol the definition is tied to; undefining the \
master removes this object too\
\>", "TableText",ExpressionUUID->"de55cd03-5465-4b0d-bcbc-57372b86642f"]},
   {"PrintAs", 
    StyleBox["option", "TI"], Cell[
    "xAct option: the glyph the symbol typesets as", "TableText",
     ExpressionUUID->"f86e9afe-d5eb-4ff4-9f85-90ef97097225"]},
   {"ProtectNewSymbol", 
    StyleBox["option", "TI"], Cell["\<\
xAct option: whether the new symbol is protected after definition\
\>", "TableText",ExpressionUUID->"f82c6834-4f69-40c7-be02-608d956cc95e"]},
   {"DefInfo", 
    StyleBox["option", "TI"], Cell["\<\
xAct option: the informational message printed at definition time\
\>", "TableText",ExpressionUUID->"a122337b-e257-4ef4-a299-5c2391bfffde"]}
  }]], "DefinitionBox3Col",
 CellID->1529,ExpressionUUID->"1f773919-f47b-4585-9ade-00fe9ee2e75b"],

