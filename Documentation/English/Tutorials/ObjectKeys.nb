Cell["\<\
Called empty, the constructor spells out every key and the pattern its value \
must match:\
\>", "MathCaption",
 CellID->1957,ExpressionUUID->"e713024e-efd4-4a61-80c8-48709477c53b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"$form", "[", "]"}]], "Input",
 CellLabel->"In[12]:=",
 CellID->1958,ExpressionUUID->"c72d318c-09b1-4eed-91eb-b3d063a72f8c"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"Symbol", "\[Rule]", 
    RowBox[{"_Symbol", "[", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"_Symbol", "|", 
        RowBox[{"-", "_Symbol"}]}], ")"}], "..."}], "]"}]}], ",", 
   RowBox[{"Manifold", "\[Rule]", 
    RowBox[{
     RowBox[{"{", "__Symbol", "}"}], "|", "_Symbol"}]}], ",", 
   RowBox[{"Deg", "\[Rule]", 
    RowBox[{"_Integer", "?", "Positive"}]}], ",", 
   RowBox[{"Symmetry", "\[Rule]", 
    RowBox[{
     RowBox[{"Symmetric", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"__Symbol", ",", "__"}], "}"}], "|", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "__Symbol"}], ",", "__"}], "}"}]}], "]"}], "|", 
     RowBox[{"Antisymmetric", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"__Symbol", ",", "__"}], "}"}], "|", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "__Symbol"}], ",", "__"}], "}"}]}], "]"}], "|", 
     RowBox[{"GenSet", "[", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         InterpretationBox[
          StyleBox[
           RowBox[{"(", 
            RowBox[{
             RowBox[{"__Integer", "?", "Positive"}], "|", "__Symbol"}], ",", 
            "__", ")"}],
           ShowAutoStyles->False,
           AutoSpacing->False],
          xAct`xPerm`Cycles[{
            Alternatives[
             PatternTest[
              BlankSequence[Integer], Positive], 
             BlankSequence[Symbol]], 
            BlankSequence[]}],
          Editable->False], "|", 
         InterpretationBox[
          StyleBox[
           RowBox[{"-", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"__Integer", "?", "Positive"}], "|", "__Symbol"}], ",", 
             "__", ")"}]}],
           ShowAutoStyles->False,
           AutoSpacing->False],
          -xAct`xPerm`Cycles[{
             Alternatives[
              PatternTest[
               BlankSequence[Integer], Positive], 
              BlankSequence[Symbol]], 
             BlankSequence[]}],
          Editable->False]}], ")"}], "..."}], "]"}], "|", "None"}]}], ",", 
   RowBox[{"Expression", "\[Rule]", "_"}], ",", 
   RowBox[{"$auto", "\[Rule]", 
    RowBox[{"\[LeftAssociation]", 
     RowBox[{"_Symbol", "\[Rule]", 
      RowBox[{
       RowBox[{"\[LeftAssociation]", 
        RowBox[{
         RowBox[{"Routine", "\[Rule]", 
          RowBox[{"\[LeftAssociation]", 
           RowBox[{
            RowBox[{"Chain", "\[Rule]", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{"_", "\[Rule]", 
                 RowBox[{"{", "___List", "}"}]}], ")"}], "..."}], "}"}]}], 
            ",", 
            RowBox[{"Apply", "\[Rule]", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"Map", "|", "ParallelMap"}], "\[Rule]", "_"}], ")"}],
                "..."}], "}"}]}]}], "\[RightAssociation]"}]}], ",", 
         RowBox[{"Value", "\[Rule]", "_"}]}], "\[RightAssociation]"}], 
       "..."}]}], "\[RightAssociation]"}]}], ",", 
   RowBox[{"Dagger", "\[Rule]", 
    RowBox[{"Real", "|", "Complex"}]}], ",", 
   RowBox[{"Master", "\[Rule]", "_Symbol"}], ",", 
   RowBox[{"PrintAs", "\[Rule]", 
    RowBox[{"_String", "|", "Identity"}]}], ",", 
   RowBox[{"VanishingQ", "\[Rule]", 
    RowBox[{"True", "|", "False"}]}], ",", 
   RowBox[{"ForceSymmetries", "\[Rule]", 
    RowBox[{"True", "|", "False"}]}], ",", 
   RowBox[{"WeightOfTensor", "\[Rule]", 
    RowBox[{
     RowBox[{"_Integer", " ", "_Symbol"}], "|", "0"}]}], ",", 
   RowBox[{"GradeOfTensor", "\[Rule]", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"_Symbol", "\[Rule]", 
         RowBox[{"_Integer", "?", "Positive"}]}], ")"}], ".."}], "}"}], "|", 
     "0"}]}], ",", 
   RowBox[{"FrobeniusQ", "\[Rule]", 
    RowBox[{"True", "|", "False"}]}], ",", 
   RowBox[{"OrthogonalTo", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"_Symbol", "[", 
       RowBox[{"_Symbol", "|", 
        RowBox[{"-", "_Symbol"}]}], "]"}], "..."}], "}"}]}], ",", 
   RowBox[{"ProjectedWith", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"_Symbol", "[", 
       RowBox[{
        RowBox[{"_Symbol", "|", 
         RowBox[{"-", "_Symbol"}]}], ",", 
        RowBox[{"_Symbol", "|", 
         RowBox[{"-", "_Symbol"}]}]}], "]"}], "..."}], "}"}]}], ",", 
   RowBox[{"ProtectNewSymbol", "\[RuleDelayed]", 
    RowBox[{"ScreenDollarIndices", "[", 
     RowBox[{"True", "|", "False"}], "]"}]}], ",", 
   RowBox[{"DefInfo", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"_String", ",", "_String"}], "}"}]}], ",", 
   RowBox[{"TensorID", "\[Rule]", "_"}], ",", 
   RowBox[{"KillingVectorOf", "\[Rule]", "_Symbol"}]}], 
  "\[RightAssociation]"}]], "Output",
 CellLabel->"Out[12]=",
 CellID->1959,ExpressionUUID->"211d5822-83ed-479d-b77f-8be4280df859"]
}, Open  ]],

Cell["The keys of $form, by class:", "Caption",
 CellID->1960,ExpressionUUID->"74673406-6549-49de-b950-2d62ebedbd60"],

Cell[BoxData[GridBox[{
   {Cell["key", "TableHeader",ExpressionUUID->
     "ca3afa8e-d417-46b6-b5e1-118acac1a801"], Cell[
    "class", "TableHeader",ExpressionUUID->
     "fab2bcc0-8fca-4efa-8ca7-ae0e5cf10bc3"], " "},
   {"Symbol", 
    StyleBox["essential", "TI"], Cell["\<\
the symbol xAct defines, with its index slots where it has any; its bare head \
is the name the object is stored and retrieved under\
\>", "TableText",ExpressionUUID->"49ebd495-e003-4622-94b7-232926ec141f"]},
   {"Manifold", 
    StyleBox["essential", "TI"], Cell["\<\
the base manifold (or list of manifolds) the object lives on; the Def \
command's manifold argument\
\>", "TableText",ExpressionUUID->"dda4e754-5225-406b-b4a4-8499510f9c0f"]},
   {"Deg", 
    StyleBox["essential", "TI"], Cell[TextData[{
     "the degree of the form; ",
     ButtonBox["DefDiffForm",
      BaseStyle->"Link",
      Appearance->None,
      Evaluator->Automatic,
      ButtonFunction:>NotebookOpen[
        FindFile["xAct/Documentation/English/" <> "xTeriorDoc.nb"]]],
     "'s degree argument"
    }], "TableText",ExpressionUUID->"212ea0a6-6632-4806-8c4c-5b888b2c1f5a"]},
   {"Symmetry", 
    StyleBox["essential", "TI"], Cell[TextData[{
     "the index symmetry \[LongDash] ",
     Cell[BoxData[
      TemplateBox[{
        Cell[
         TextData["Symmetric"]], "paclet:ref/Symmetric"},
       "RefLink",
       BaseStyle->{"InlineFormula"}]], "InlineFormula",
      FontFamily->"Source Sans Pro",ExpressionUUID->
      "27a0e00c-2e57-4e19-ae3f-e08e8c2394b9"],
     ", ",
     Cell[BoxData[
      TemplateBox[{
        Cell[
         TextData["Antisymmetric"]], "paclet:ref/Antisymmetric"},
       "RefLink",
       BaseStyle->{"InlineFormula"}]], "InlineFormula",
      FontFamily->"Source Sans Pro",ExpressionUUID->
      "1a684575-c433-4626-be8f-f118f49c7b64"],
     ", a ",
     ButtonBox["GenSet",
      BaseStyle->"Link",
      Appearance->None,
      Evaluator->Automatic,
      ButtonFunction:>NotebookOpen[
        FindFile["xAct/Documentation/English/" <> "xPermDoc.nb"]]],
     ", or ",
     Cell[BoxData[
      TemplateBox[{
        Cell[
         TextData["None"]], "paclet:ref/None"},
       "RefLink",
       BaseStyle->{"InlineFormula"}]], "InlineFormula",
      FontFamily->"Source Sans Pro",ExpressionUUID->
      "c2662f78-df67-48ae-b933-ed852fa5b361"],
     "; the Def command's symmetry argument"
    }], "TableText",ExpressionUUID->"fd51d67c-6bf5-4308-99d8-a27bade10469"]},
   {"Expression", 
    StyleBox["runtime", "TI"], Cell["\<\
the stored expression \[LongDash] the physically relevant data, replayed when \
the object is loaded\
\>", "TableText",ExpressionUUID->"6c5e3c61-91ed-4083-8507-cc213e9f999a"]},
   {"$auto", 
    StyleBox["runtime", "TI"], Cell[TextData[{
     "slots for the symbols xAct creates alongside the definition; each \
carries a ",
     Cell[BoxData["Routine"], "InlineFormula",
      FontFamily->"Source Sans Pro",ExpressionUUID->
      "eba4933c-e3a6-4480-901f-a266bc1fe702"],
     " (the ",
     Cell[BoxData["Chain"], "InlineFormula",
      FontFamily->"Source Sans Pro",ExpressionUUID->
      "06b688d6-efa9-4470-8460-b29eab392407"],
     " recipe that ",
     Cell[BoxData[
      TemplateBox[{
        Cell[
         TextData["Compute"]], "paclet:VasilDimitrov/SolutionsX/ref/Compute", 
        "VasilDimitrov Package Symbol"},
       "PackageLink",
       BaseStyle->"InlineFormula"]], "InlineFormula",
      FontFamily->"Source Sans Pro",ExpressionUUID->
      "7ea1a5ca-53d2-4eb4-992f-32e28d6ef93e"],
     " follows) and its computed ",
     Cell[BoxData["Value"], "InlineFormula",
      FontFamily->"Source Sans Pro",ExpressionUUID->
      "d57094ea-f081-4362-b7e8-942e45e0426f"]
    }], "TableText",ExpressionUUID->"0fa12a95-25db-4cd9-a98d-8849c4b82d60"]},
   {"Dagger", 
    StyleBox["option", "TI"], Cell[TextData[{
     "xAct option: ",
     Cell[BoxData[
      TemplateBox[{
        Cell[
         TextData["Real"]], "paclet:ref/Real"},
       "RefLink",
       BaseStyle->{"InlineFormula"}]], "InlineFormula",
      FontFamily->"Source Sans Pro",ExpressionUUID->
      "fcf34e6e-7c68-4c45-b9e3-bc9be471aa2b"],
     " or ",
     Cell[BoxData[
      TemplateBox[{
        Cell[
         TextData["Complex"]], "paclet:ref/Complex"},
       "RefLink",
       BaseStyle->{"InlineFormula"}]], "InlineFormula",
      FontFamily->"Source Sans Pro",ExpressionUUID->
      "92fc6c56-4b57-48ba-b1d3-581b43c0e236"],
     " behaviour under complex conjugation"
    }], "TableText",ExpressionUUID->"f3a65f15-a79d-4ccc-b8ef-c84bdaaf868e"]},
   {"Master", 
    StyleBox["option", "TI"], Cell["\<\
xAct option: the master symbol the definition is tied to; undefining the \
master removes this object too\
\>", "TableText",ExpressionUUID->"8b05f8a2-e9b2-4a56-9c7e-4982a25c3fc8"]},
   {"PrintAs", 
    StyleBox["option", "TI"], Cell[
    "xAct option: the glyph the symbol typesets as", "TableText",
     ExpressionUUID->"0b0c7773-caed-4a4f-86ee-e5387a1607c5"]},
   {"VanishingQ", 
    StyleBox["option", "TI"], Cell[
    "xAct option: define the tensor as identically zero", "TableText",
     ExpressionUUID->"86da2b09-795c-4602-9526-433300f16ace"]},
   {"ForceSymmetries", 
    StyleBox["option", "TI"], Cell["\<\
xAct option: register the symmetry even when the index characters do not match\
\>", "TableText",ExpressionUUID->"d3633153-1256-48a5-a27b-8065007b99ab"]},
   {"WeightOfTensor", 
    StyleBox["option", "TI"], Cell["\<\
xAct option: the density weight, a linear combination of basis names\
\>", "TableText",ExpressionUUID->"499043f5-8ea5-4bfd-8e2b-df3971be6c46"]},
   {"GradeOfTensor", 
    StyleBox["option", "TI"], Cell[
    "xAct option: the grade of the symbol in graded products", "TableText",
     ExpressionUUID->"7025202a-9f2f-4299-b801-19484175fac5"]},
   {"FrobeniusQ", 
    StyleBox["option", "TI"], Cell["\<\
xAct option: the defined vector obeys the Frobenius condition\
\>", "TableText",ExpressionUUID->"ed283c7f-1028-4ac1-99dc-227aee051a88"]},
   {"OrthogonalTo", 
    StyleBox["option", "TI"], Cell["\<\
xAct option: vectors the defined tensor is orthogonal to, one per index\
\>", "TableText",ExpressionUUID->"0786970e-c208-4c5d-bd6f-0fba16ccf80d"]},
   {"ProjectedWith", 
    StyleBox["option", "TI"], Cell["\<\
xAct option: projectors that map the defined tensor into itself, one per index\
\>", "TableText",ExpressionUUID->"49395e3a-31e0-41f2-b180-e6ebd8b07c22"]},
   {"ProtectNewSymbol", 
    StyleBox["option", "TI"], Cell["\<\
xAct option: whether the new symbol is protected after definition\
\>", "TableText",ExpressionUUID->"cc75c355-7cca-4844-839c-116190e09527"]},
   {"DefInfo", 
    StyleBox["option", "TI"], Cell["\<\
xAct option: the informational message printed at definition time\
\>", "TableText",ExpressionUUID->"fb4be1f3-fe20-464b-834a-e0110d4360d1"]},
   {"TensorID", 
    StyleBox["option", "TI"], Cell["\<\
xAct option: xCoba's bookkeeping for how the components are computed\
\>", "TableText",ExpressionUUID->"3e2fbed6-754b-4d16-8ab2-64935e7460af"]},
   {"KillingVectorOf", 
    StyleBox["option", "TI"], Cell["\<\
xAct option (xTras): declare the defined tensor a Killing vector of a metric\
\>", "TableText",ExpressionUUID->"2007c3b3-6f7a-4a56-a0f0-687704eb1cb4"]}
  }]], "DefinitionBox3Col",
 CellID->1961,ExpressionUUID->"a95c0f17-6c3a-4034-b225-4b814a980205"],

