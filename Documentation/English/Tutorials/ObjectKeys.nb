   {"ChartColor", 
    StyleBox["option", "TI"], Cell["\<\
xAct option: the display colour of the chart's indices and objects\
\>", "TableText",ExpressionUUID->"c7bf4918-e00f-4071-9642-0e2b1f78a0b4"]},
   {"FormatBasis", 
