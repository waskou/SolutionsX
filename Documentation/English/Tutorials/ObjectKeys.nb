Cell["\<\
Called empty, the constructor spells out every key and the pattern its value \
must match:\
\>", "MathCaption",
 CellID->1532,ExpressionUUID->"f28effe5-ac5a-429d-8ee2-fec7d6449f48"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"$covd", "[", "]"}]], "Input",
 CellLabel->"In[9]:=",
 CellID->1533,ExpressionUUID->"f537981f-6622-4a0a-a703-5fa1e6e4177c"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"Symbol", "\[Rule]", 
    RowBox[{"_Symbol", "[", 
     RowBox[{"_Symbol", "|", 
      RowBox[{"-", "_Symbol"}]}], "]"}]}], ",", 
   RowBox[{"VBundle", "\[Rule]", 
    RowBox[{"{", "___Symbol", "}"}]}], ",", 
   RowBox[{"SymbolOfCovD", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"_String", ",", "_String"}], "}"}]}], ",", 
   RowBox[{"$auto", "\[Rule]", 
    RowBox[{"\[LeftAssociation]", 
     RowBox[{"_Symbol", "\[Rule]", 
      RowBox[{
       RowBox[{"\[LeftAssociation]", 
        RowBox[{
         RowBox[{"Routine", "\[Rule]", 
          RowBox[{"\[LeftAssociation]", 
           RowBox[{
            RowBox[{"Chain", "\[Rule]", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{"_", "\[Rule]", 
                 RowBox[{"{", "___List", "}"}]}], ")"}], "..."}], "}"}]}], 
            ",", 
            RowBox[{"Apply", "\[Rule]", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"Map", "|", "ParallelMap"}], "\[Rule]", "_"}], ")"}],
                "..."}], "}"}]}]}], "\[RightAssociation]"}]}], ",", 
         RowBox[{"Value", "\[Rule]", "_"}]}], "\[RightAssociation]"}], 
       "..."}]}], "\[RightAssociation]"}]}], ",", 
   RowBox[{"Torsion", "\[Rule]", 
    RowBox[{"True", "|", "False"}]}], ",", 
   RowBox[{"Curvature", "\[Rule]", 
    RowBox[{"True", "|", "False"}]}], ",", 
   RowBox[{"FromMetric", "\[Rule]", "_Symbol"}], ",", 
   RowBox[{"CurvatureRelations", "\[Rule]", 
    RowBox[{"True", "|", "False"}]}], ",", 
   RowBox[{"ExtendedFrom", "\[Rule]", "_Symbol"}], ",", 
   RowBox[{"OtherDependencies", "\[Rule]", 
    RowBox[{"{", "___Symbol", "}"}]}], ",", 
   RowBox[{"OrthogonalTo", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"_Symbol", "[", 
       RowBox[{"_Symbol", "|", 
        RowBox[{"-", "_Symbol"}]}], "]"}], "..."}], "}"}]}], ",", 
   RowBox[{"ProjectedWith", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"_Symbol", "[", 
       RowBox[{
        RowBox[{"_Symbol", "|", 
         RowBox[{"-", "_Symbol"}]}], ",", 
        RowBox[{"_Symbol", "|", 
         RowBox[{"-", "_Symbol"}]}]}], "]"}], "..."}], "}"}]}], ",", 
   RowBox[{"WeightedWithBasis", "\[Rule]", 
    RowBox[{"_Symbol", "|", "Null"}]}], ",", 
   RowBox[{"ProtectNewSymbol", "\[RuleDelayed]", 
    RowBox[{"ScreenDollarIndices", "[", 
     RowBox[{"True", "|", "False"}], "]"}]}], ",", 
   RowBox[{"Master", "\[Rule]", "_Symbol"}], ",", 
   RowBox[{"DefInfo", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"_String", ",", "_String"}], "}"}]}], ",", 
   RowBox[{"SymCovDQ", "\[Rule]", 
    RowBox[{"True", "|", "False"}]}]}], "\[RightAssociation]"}]], "Output",
 CellLabel->"Out[9]=",
 CellID->1534,ExpressionUUID->"7b1bc521-fc39-4938-aef2-8d0c749a9106"]
}, Open  ]],

Cell["The keys of $covd, by class:", "Caption",
 CellID->1535,ExpressionUUID->"2b7a8cce-c8eb-4799-ba07-44e4d9a86ce7"],

Cell[BoxData[GridBox[{
   {Cell["key", "TableHeader",ExpressionUUID->
     "6c269d61-09a8-4b51-8b64-5043e4e42a97"], Cell[
    "class", "TableHeader",ExpressionUUID->
     "e4827481-3ddf-4ed2-b669-a942d4f0d6ee"], " "},
   {"Symbol", 
    StyleBox["essential", "TI"], Cell["\<\
the symbol xAct defines, with its index slots where it has any; its bare head \
is the name the object is stored and retrieved under\
\>", "TableText",ExpressionUUID->"ad4d4699-f1f9-4266-b680-ff773f65faa4"]},
   {"VBundle", 
    StyleBox["essential", "TI"], Cell["\<\
the vector bundle the derivative or basis acts on; the Def command's bundle \
argument\
\>", "TableText",ExpressionUUID->"7d176b29-6dc5-4d6e-b1d8-efbc8425da56"]},
   {"SymbolOfCovD", 
    StyleBox["essential", "TI"], Cell["\<\
the pair of display strings for the covariant derivative, like {\";\", \"\
\[Del]\"}\
\>", "TableText",ExpressionUUID->"74cb7795-9429-4ed5-916d-39ca04074e69"]},
   {"$auto", 
    StyleBox["runtime", "TI"], Cell[TextData[{
     "slots for the symbols xAct creates alongside the definition; each \
carries a ",
     Cell[BoxData["Routine"], "InlineFormula",
      FontFamily->"Source Sans Pro",ExpressionUUID->
      "c4ee3f1c-9a59-45ab-a4cc-f6b9213bd7c3"],
     " (the ",
     Cell[BoxData["Chain"], "InlineFormula",
      FontFamily->"Source Sans Pro",ExpressionUUID->
      "20617090-14eb-4695-a6f6-0bfe742883b5"],
     " recipe that ",
     Cell[BoxData[
      TemplateBox[{
        Cell[
         TextData["Compute"]], "paclet:VasilDimitrov/SolutionsX/ref/Compute", 
        "VasilDimitrov Package Symbol"},
       "PackageLink",
       BaseStyle->"InlineFormula"]], "InlineFormula",
      FontFamily->"Source Sans Pro",ExpressionUUID->
      "98d8eb24-422b-43a2-bd3d-c2de0fed31b0"],
     " follows) and its computed ",
     Cell[BoxData["Value"], "InlineFormula",
      FontFamily->"Source Sans Pro",ExpressionUUID->
      "0b76e69a-283a-4b87-8b79-4ca8f3c22c95"]
    }], "TableText",ExpressionUUID->"ff8b0668-522c-4069-a695-346c7ae797db"]},
   {"Torsion", 
    StyleBox["option", "TI"], Cell["\<\
xAct option: whether the covariant derivative carries torsion\
\>", "TableText",ExpressionUUID->"a9544f93-ebcb-4b97-9343-d2614a663ab6"]},
   {"Curvature", 
    StyleBox["option", "TI"], Cell["\<\
xAct option: whether, and on which bundles, the derivative has curvature\
\>", "TableText",ExpressionUUID->"5ba0b6ee-97cc-42e6-b6c8-4d26f2f77e0c"]},
   {"FromMetric", 
    StyleBox["option", "TI"], Cell[
    "xAct option: the metric the derivative descends from", "TableText",
     ExpressionUUID->"23725ba8-61b1-4238-bd58-972fb8561cb1"]},
   {"CurvatureRelations", 
    StyleBox["option", "TI"], Cell["\<\
xAct option: install the automatic rules relating the curvature tensors\
\>", "TableText",ExpressionUUID->"02e3eb5e-b65f-4d57-90c2-3897368dd1cc"]},
   {"ExtendedFrom", 
    StyleBox["option", "TI"], Cell["\<\
xAct option: share the curvature and torsion tensors with an existing \
derivative\
\>", "TableText",ExpressionUUID->"1e85b406-ca26-4011-8736-e0ee88550f80"]},
   {"OtherDependencies", 
    StyleBox["option", "TI"], Cell["\<\
xAct option: extra manifolds and parameters everything defined here depends on\
\>", "TableText",ExpressionUUID->"881aa1de-22c2-467a-a8d4-70c676e8e2ad"]},
   {"OrthogonalTo", 
    StyleBox["option", "TI"], Cell["\<\
xAct option: vectors the defined tensor is orthogonal to, one per index\
\>", "TableText",ExpressionUUID->"217da349-9ef0-486b-857e-8950fdbc9244"]},
   {"ProjectedWith", 
    StyleBox["option", "TI"], Cell["\<\
xAct option: projectors that map the defined tensor into itself, one per index\
\>", "TableText",ExpressionUUID->"9c16db24-16ac-4d97-8055-0fe2e76f2190"]},
   {"WeightedWithBasis", 
    StyleBox["option", "TI"], Cell["\<\
xAct option: extend the Levi-Civita connection to densities of the given basis\
\>", "TableText",ExpressionUUID->"63076dd4-3dc6-4080-aaae-91ee6395e761"]},
   {"ProtectNewSymbol", 
    StyleBox["option", "TI"], Cell["\<\
xAct option: whether the new symbol is protected after definition\
\>", "TableText",ExpressionUUID->"8b439f85-17f7-4544-85dd-f83cdf5c3a85"]},
   {"Master", 
    StyleBox["option", "TI"], Cell["\<\
xAct option: the master symbol the definition is tied to; undefining the \
master removes this object too\
\>", "TableText",ExpressionUUID->"5d0bea45-1680-43b9-8be5-c7e41fcfe8cc"]},
   {"DefInfo", 
    StyleBox["option", "TI"], Cell["\<\
xAct option: the informational message printed at definition time\
\>", "TableText",ExpressionUUID->"ef1834d0-4931-4319-a2de-bcdb37b048a0"]},
   {"SymCovDQ", 
    StyleBox["option", "TI"], Cell["\<\
xAct option (xTras): register the derivative as symmetrizable\
\>", "TableText",ExpressionUUID->"5b8b2f45-3368-46d5-8894-fab8f32920e8"]}
  }]], "DefinitionBox3Col",
 CellID->1536,ExpressionUUID->"690a35c0-cf1b-4662-8530-676d833b4666"],

