  FontFamily->"Source Sans Pro",ExpressionUUID->
  "66705467-0d83-4ad7-bc97-febdd1d03562"],
 ")"
}], "Item",
 CellID->1884,ExpressionUUID->"7a94f9f6-ec37-41f2-9350-93c6670dd98c"],

Cell["$manifold", "Section",
 CellID->1885,ExpressionUUID->"e46e494f-f9c0-4881-8b64-204265659299"],

Cell[TextData[{
 "Records a ",
 ButtonBox["DefManifold",
  BaseStyle->"Link",
  Appearance->None,
  Evaluator->Automatic,
  ButtonFunction:>NotebookOpen[
    FindFile["xAct/Documentation/English/" <> "xTensorDoc.nb"]]],
 " call: the manifold symbol, its dimension, and the abstract indices to \
register on its tangent bundle. Undefined through ",
 ButtonBox["UndefManifold",
  BaseStyle->"Link",
  Appearance->None,
  Evaluator->Automatic,
  ButtonFunction:>NotebookOpen[
    FindFile["xAct/Documentation/English/" <> "xTensorDoc.nb"]]],
 ", after first undefining every visitor of the manifold."
}], "Text",
 CellID->1886,ExpressionUUID->"ad661eb6-0150-45c3-aa1a-820c0a22856d"],

Cell["\<\
Called empty, the constructor spells out every key and the pattern its value \
must match:\
\>", "MathCaption",
 CellID->1887,ExpressionUUID->"0837cf5e-975c-4b2a-bb36-723faf5352a7"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"$manifold", "[", "]"}]], "Input",
 CellLabel->"In[2]:=",
 CellID->1888,ExpressionUUID->"71b37676-1f6c-4a0e-b9c3-4414517ecae4"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"Symbol", "\[Rule]", "_Symbol"}], ",", 
   RowBox[{"Dimension", "\[Rule]", 
    RowBox[{
     RowBox[{"_Integer", "?", "Positive"}], "|", 
     InterpretationBox[
      StyleBox["d",
       ShowAutoStyles->False,
       AutoSpacing->False],
      xAct`Invar`dim,
      Editable->False]}]}], ",", 
   RowBox[{"Index", "\[Rule]", 
    RowBox[{"{", "__Symbol", "}"}]}], ",", 
   RowBox[{"Name", "\[Rule]", 
    RowBox[{"_String", "|", "name"}]}], ",", 
   RowBox[{"Master", "\[Rule]", "_Symbol"}], ",", 
   RowBox[{"PrintAs", "\[Rule]", 
    RowBox[{"_String", "|", "Identity"}]}], ",", 
   RowBox[{"ProtectNewSymbol", "\[RuleDelayed]", 
    RowBox[{"ScreenDollarIndices", "[", 
     RowBox[{"True", "|", "False"}], "]"}]}], ",", 
   RowBox[{"DefInfo", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"_String", ",", "_String"}], "}"}]}]}], 
  "\[RightAssociation]"}]], "Output",
 CellLabel->"Out[2]=",
 CellID->1889,ExpressionUUID->"b42ee244-e82c-4107-a3d2-c67577951e75"]
}, Open  ]],

Cell["The keys of $manifold, by class:", "Caption",
 CellID->1890,ExpressionUUID->"573efb2a-1ae5-4cca-a22d-f48846967d8e"],

