Cell[BoxData[
 RowBox[{"$basis", "[", "]"}]], "Input",
 CellLabel->"In[11]:=",
 CellID->1951,ExpressionUUID->"5fb40353-770a-4413-80be-3441cbc90621"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"Symbol", "\[Rule]", "_Symbol"}], ",", 
   RowBox[{"VBundle", "\[Rule]", "_Symbol"}], ",", 
   RowBox[{"CNumbersOf", "\[Rule]", 
    RowBox[{"{", "__Integer", "}"}]}], ",", 
   RowBox[{"BasisColor", "\[Rule]", "_RGBColor"}], ",", 
   RowBox[{"FormatBasis", "\[Rule]", "Automatic"}], ",", 
   RowBox[{"ProtectNewSymbol", "\[RuleDelayed]", 
