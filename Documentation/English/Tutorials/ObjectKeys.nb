Cell[BoxData[GridBox[{
   {Cell["key", "TableHeader",ExpressionUUID->
     "aa338954-cf77-4453-8652-6f60fd37ed93"], Cell[
    "class", "TableHeader",ExpressionUUID->
     "b00621db-9b83-46ef-ab58-29ff6a0607bc"], " "},
   {"Symbol", 
    StyleBox["essential", "TI"], Cell["\<\
the symbol xAct defines, with its index slots where it has any; its bare head \
is the name the object is stored and retrieved under\
\>", "TableText",ExpressionUUID->"c3432058-f66f-4dd7-94cc-743af1bc912f"]},
   {"VBundle", 
    StyleBox["essential", "TI"], Cell["\<\
the vector bundle the derivative or basis acts on; the Def command's bundle \
argument\
\>", "TableText",ExpressionUUID->"0f62c037-6594-4cbe-9a9f-ef7e1087257a"]},
   {"CNumbersOf", 
    StyleBox["essential", "TI"], Cell["\<\
the coordinate numbers of the chart or basis, as a list of integers\
\>", "TableText",ExpressionUUID->"496e213f-1581-4f18-ba08-b3275ec005c2"]},
   {"BasisColor", 
    StyleBox["option", "TI"], Cell["\<\
xAct option: the display colour of the basis' indices and objects\
\>", "TableText",ExpressionUUID->"781f00e3-c45e-4cca-82c5-7ab94a661ffa"]},
   {"FormatBasis", 
    StyleBox["option", "TI"], Cell["\<\
xAct option: display formats for the basis vectors and covectors\
\>", "TableText",ExpressionUUID->"689417c9-b795-4a54-8575-7c016baca749"]},
   {"ProtectNewSymbol", 
    StyleBox["option", "TI"], Cell["\<\
xAct option: whether the new symbol is protected after definition\
\>", "TableText",ExpressionUUID->"85015b54-7244-4b0d-bf08-9d11b7c76fe4"]},
   {"Dagger", 
    StyleBox["option", "TI"], Cell[TextData[{
     "xAct option: ",
     Cell[BoxData[
      TemplateBox[{
        Cell[
         TextData["Real"]], "paclet:ref/Real"},
       "RefLink",
       BaseStyle->{"InlineFormula"}]], "InlineFormula",
      FontFamily->"Source Sans Pro",ExpressionUUID->
      "f72fc710-5376-4dad-a419-80ba71940d80"],
     " or ",
     Cell[BoxData[
      TemplateBox[{
        Cell[
         TextData["Complex"]], "paclet:ref/Complex"},
       "RefLink",
