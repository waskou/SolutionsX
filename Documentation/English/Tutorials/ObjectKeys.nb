Cell[CellGroupData[{

Cell["Object Keys", "Title",
 CellID->1473,ExpressionUUID->"8b6ca877-b12b-465a-9307-f90a4120baef"],

Cell["\<\
Each object type carries a fixed set of keys: the arguments and options of \
one xAct definition, plus SolutionsX's own bookkeeping. This note is the \
reference table for the keys of every object type.\
\>", "Text",
 CellID->1474,ExpressionUUID->"994cca8e-f50c-494b-8593-fe6cfe8f7569"],

Cell["Load the package:", "MathCaption",
 CellID->1475,ExpressionUUID->"4bd5dbdc-7820-4797-81d9-10d8d29d265a"],

Cell[BoxData[
 RowBox[{"<<", " ", "VasilDimitrov`SolutionsX`"}]], "Input",
 CellLabel->"In[1]:=",
 CellID->1476,ExpressionUUID->"430f46c1-24ff-4b4a-b4b5-ae54043f2026"],

Cell[TextData[{
 "An object enters a solution as an association of key \[Rule] value pairs \
(see ",
 ButtonBox["Objects in SolutionsX",
  BaseStyle->"Link",
  ButtonData->
   "paclet:VasilDimitrov/SolutionsX/tutorial/ObjectsInSolutionsX"],
 "). This note is the reference for the keys: what each key of each object \
type stands for. Keys come in three classes:"
}], "Text",
 CellID->1477,ExpressionUUID->"d26b8412-9982-42bb-9bb0-b4671445331f"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["essential", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "219b9319-0daa-454c-ab85-06c36302cbe7"],
 " \[LongDash] must be supplied for the object to validate (",
 Cell[BoxData["PropKeysOf"], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "99a061f9-4afb-424b-ac5c-fc0c1f3277d1"],
 ")"
}], "Item",
 CellID->1478,ExpressionUUID->"c07de4e2-e2c5-4951-b469-ca9e848051ef"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["runtime", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "20b920eb-2bd8-4597-9fa1-0e416c5f4922"],
 " \[LongDash] filled in or modified by SolutionsX as you work (",
 Cell[BoxData["ModKeysOf"], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "dfb71c17-ea80-4ced-993c-02f3f1b04131"],
 ")"
}], "Item",
 CellID->1479,ExpressionUUID->"475fbfcf-5991-4ae4-bc7a-f1267fe9e09a"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["option", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "ab2189bb-73ce-497b-aeb3-23be143300d1"],
 " \[LongDash] an option of the underlying xAct Def command, passed through \
to it (",
 Cell[BoxData["OptKeysOf"], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "08ced74c-a335-463d-9d26-8e0f4c2cd4e2"],
 ")"
}], "Item",
 CellID->1480,ExpressionUUID->"321b0f43-5d4a-4a63-a37a-ba8946fe98a9"],

Cell["$manifold", "Section",
 CellID->1481,ExpressionUUID->"8485d5ab-c5f8-46c9-879d-e04672dc93a9"],

Cell[TextData[{
 "Records a ",
 ButtonBox["DefManifold",
  BaseStyle->"Link",
  Appearance->None,
  Evaluator->Automatic,
  ButtonFunction:>NotebookOpen[
    FindFile["xAct/Documentation/English/" <> "xTensorDoc.nb"]]],
 " call: the manifold symbol, its dimension, and the abstract indices to \
register on its tangent bundle. Undefined through ",
 ButtonBox["UndefManifold",
  BaseStyle->"Link",
  Appearance->None,
  Evaluator->Automatic,
  ButtonFunction:>NotebookOpen[
    FindFile["xAct/Documentation/English/" <> "xTensorDoc.nb"]]],
 ", after first undefining every visitor of the manifold."
}], "Text",
 CellID->1482,ExpressionUUID->"0171878c-b3c8-4156-9c4d-1939d461ffb9"],

Cell["\<\
Called empty, the constructor spells out every key and the pattern its value \
must match:\
\>", "MathCaption",
 CellID->1483,ExpressionUUID->"bd1585ee-3197-4dd4-a5ba-120c827c3537"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"$manifold", "[", "]"}]], "Input",
 CellLabel->"In[2]:=",
 CellID->1484,ExpressionUUID->"ff514149-7694-4e24-8215-c8363229be2c"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"Symbol", "\[Rule]", "_Symbol"}], ",", 
   RowBox[{"Dimension", "\[Rule]", 
    RowBox[{
     RowBox[{"_Integer", "?", "Positive"}], "|", 
     InterpretationBox[
      StyleBox["d",
       ShowAutoStyles->False,
       AutoSpacing->False],
      xAct`Invar`dim,
      Editable->False]}]}], ",", 
   RowBox[{"Index", "\[Rule]", 
    RowBox[{"{", "__Symbol", "}"}]}], ",", 
   RowBox[{"Name", "\[Rule]", 
    RowBox[{"_String", "|", "name"}]}], ",", 
   RowBox[{"Master", "\[Rule]", "_Symbol"}], ",", 
   RowBox[{"PrintAs", "\[Rule]", 
    RowBox[{"_String", "|", "Identity"}]}], ",", 
   RowBox[{"ProtectNewSymbol", "\[RuleDelayed]", 
    RowBox[{"ScreenDollarIndices", "[", 
     RowBox[{"True", "|", "False"}], "]"}]}], ",", 
   RowBox[{"DefInfo", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"_String", ",", "_String"}], "}"}]}]}], 
  "\[RightAssociation]"}]], "Output",
 CellLabel->"Out[2]=",
 CellID->1485,ExpressionUUID->"00b01fae-72a1-40bf-bdc0-76b73a2def6c"]
}, Open  ]],

Cell["The keys of $manifold, by class:", "Caption",
 CellID->1486,ExpressionUUID->"156370c1-f8b6-476e-80ab-d2379715f3a8"],

