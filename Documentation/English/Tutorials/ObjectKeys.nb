   {"Symmetry", 
    StyleBox["essential", "TI"], Cell[TextData[{
     "the index symmetry \[LongDash] ",
     Cell[BoxData[
      TemplateBox[{
        Cell[
         TextData["Symmetric"]], "paclet:ref/Symmetric"},
       "RefLink",
       BaseStyle->{"InlineFormula"}]], "InlineFormula",
      FontFamily->"Source Sans Pro",ExpressionUUID->
      "1f260415-943d-4d44-a02a-c743e8cc1a8d"],
     ", ",
     Cell[BoxData[
      TemplateBox[{
        Cell[
         TextData["Antisymmetric"]], "paclet:ref/Antisymmetric"},
       "RefLink",
       BaseStyle->{"InlineFormula"}]], "InlineFormula",
      FontFamily->"Source Sans Pro",ExpressionUUID->
      "26e92e32-4829-44cc-b2ee-25c32bb93587"],
     ", a ",
     ButtonBox["GenSet",
      BaseStyle->"Link",
      Appearance->None,
      Evaluator->Automatic,
      ButtonFunction:>NotebookOpen[
        FindFile["xAct/Documentation/English/" <> "xPermDoc.nb"]]],
     ", or ",
     Cell[BoxData[
      TemplateBox[{
        Cell[
         TextData["None"]], "paclet:ref/None"},
       "RefLink",
       BaseStyle->{"InlineFormula"}]], "InlineFormula",
      FontFamily->"Source Sans Pro",ExpressionUUID->
      "56526bd4-1f81-462b-9967-b83f9b8a86fc"],
     "; the Def command's symmetry argument"
    }], "TableText",ExpressionUUID->"3e7003f5-1095-43fd-b074-35fb21e86cdb"]},
   {"Expression", 
    StyleBox["runtime", "TI"], Cell["\<\
the stored expression \[LongDash] the physically relevant data, replayed when \
the object is loaded\
\>", "TableText",ExpressionUUID->"968c517f-4f71-4349-a401-abd6d331a9f8"]},
   {"$auto", 
    StyleBox["runtime", "TI"], Cell[TextData[{
     "slots for the symbols xAct creates alongside the definition; each \
carries a ",
     Cell[BoxData["Routine"], "InlineFormula",
      FontFamily->"Source Sans Pro",ExpressionUUID->
      "e5dc5a15-907f-4be8-9565-aa2015defa70"],
     " (the ",
     Cell[BoxData["Chain"], "InlineFormula",
      FontFamily->"Source Sans Pro",ExpressionUUID->
      "677ddb5d-d339-4b89-a89b-888866493051"],
     " recipe that ",
     Cell[BoxData[
      TemplateBox[{
        Cell[
         TextData["Compute"]], "paclet:VasilDimitrov/SolutionsX/ref/Compute", 
        "VasilDimitrov Package Symbol"},
       "PackageLink",
       BaseStyle->"InlineFormula"]], "InlineFormula",
      FontFamily->"Source Sans Pro",ExpressionUUID->
      "f416dba0-045c-455d-960d-953793e2a04e"],
     " follows) and its computed ",
     Cell[BoxData["Value"], "InlineFormula",
      FontFamily->"Source Sans Pro",ExpressionUUID->
      "3533af47-640a-4550-b16f-81ece423140d"]
    }], "TableText",ExpressionUUID->"ad9c7562-f817-47f3-a330-407345ff9fc5"]},
   {"Dagger", 
    StyleBox["option", "TI"], Cell[TextData[{
     "xAct option: ",
     Cell[BoxData[
      TemplateBox[{
        Cell[
         TextData["Real"]], "paclet:ref/Real"},
       "RefLink",
       BaseStyle->{"InlineFormula"}]], "InlineFormula",
      FontFamily->"Source Sans Pro",ExpressionUUID->
      "d0b56863-db2a-4a1b-9914-01df542b3e07"],
     " or ",
     Cell[BoxData[
      TemplateBox[{
        Cell[
         TextData["Complex"]], "paclet:ref/Complex"},
       "RefLink",
       BaseStyle->{"InlineFormula"}]], "InlineFormula",
      FontFamily->"Source Sans Pro",ExpressionUUID->
      "f4b5a97c-2835-4215-8afe-26fa0d6fb81d"],
     " behaviour under complex conjugation"
    }], "TableText",ExpressionUUID->"cc0e84d1-0cae-4d41-93db-cd6243a781ab"]},
   {"Master", 
    StyleBox["option", "TI"], Cell["\<\
xAct option: the master symbol the definition is tied to; undefining the \
master removes this object too\
\>", "TableText",ExpressionUUID->"433bf7c7-6d2a-4a0f-a1e5-769beb67597c"]},
   {"PrintAs", 
