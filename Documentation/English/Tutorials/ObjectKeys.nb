Cell[CellGroupData[{

Cell["Object Keys", "Title",
 CellID->1877,ExpressionUUID->"1d3c3a47-4411-4745-8252-0717bfafd8c3"],

Cell["\<\
Each object type carries a fixed set of keys: the arguments and options of \
one xAct definition, plus SolutionsX's own bookkeeping. This note is the \
reference table for the keys of every object type.\
\>", "Text",
 CellID->1878,ExpressionUUID->"0cdaa6d0-0a90-4279-8f11-3571caf07309"],

Cell["Load the package:", "MathCaption",
 CellID->1879,ExpressionUUID->"d32bda85-6387-4de0-baea-2f992761f8fb"],

Cell[BoxData[
 RowBox[{"<<", " ", "VasilDimitrov`SolutionsX`"}]], "Input",
 CellLabel->"In[1]:=",
 CellID->1880,ExpressionUUID->"6438902a-05a1-45fa-92e2-e08c12df6a47"],

Cell[TextData[{
 "An object enters a solution as an association of key \[Rule] value pairs \
(see ",
 ButtonBox["Objects in SolutionsX",
  BaseStyle->"Link",
  ButtonData->
   "paclet:VasilDimitrov/SolutionsX/tutorial/ObjectsInSolutionsX"],
 "). This note is the reference for the keys: what each key of each object \
type stands for. Keys come in three classes:"
}], "Text",
 CellID->1881,ExpressionUUID->"01b5decf-6bc4-47d0-bdc1-89a1d80a1cbc"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["essential", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "2aa086dc-9203-4a4b-9b01-fe2198b2d9a1"],
 " \[LongDash] must be supplied for the object to validate (",
 Cell[BoxData["PropKeysOf"], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "d48bc9ba-dc2e-4d78-89e4-fd7a6ce54de6"],
 ")"
}], "Item",
 CellID->1882,ExpressionUUID->"6ff479b5-e7b9-49ae-a0e1-f98f868873e0"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["runtime", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "2ceb4e8e-f2ee-4a96-a134-7a9c50095a58"],
 " \[LongDash] filled in or modified by SolutionsX as you work (",
 Cell[BoxData["ModKeysOf"], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "f942108d-59f9-4c99-9c11-821ec4abb06c"],
 ")"
}], "Item",
 CellID->1883,ExpressionUUID->"c3ffce3b-b8bb-4484-bccf-a5b57f7d205b"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["option", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "08dded48-95e1-4b23-8c8c-ca110151f6df"],
 " \[LongDash] an option of the underlying xAct Def command, passed through \
