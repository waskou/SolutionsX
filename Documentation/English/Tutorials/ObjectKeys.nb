   {"ProtectNewSymbol", 
    StyleBox["option", "TI"], Cell["\<\
xAct option: whether the new symbol is protected after definition\
\>", "TableText",ExpressionUUID->"c6b5f995-2fce-49f3-8c57-5674b4efcf23"]},
   {"DefInfo", 
    StyleBox["option", "TI"], Cell["\<\
xAct option: the informational message printed at definition time\
\>", "TableText",ExpressionUUID->"89a6b95a-40ce-47e1-a17f-b9e25ed3c663"]}
  }]], "DefinitionBox3Col",
 CellID->1891,ExpressionUUID->"a30b922c-b5ea-44b8-9b1d-608c3e18695f"],

