Cell["\<\
Called empty, the constructor spells out every key and the pattern its value \
must match:\
\>", "MathCaption",
 CellID->1497,ExpressionUUID->"e6df0468-617e-4103-a40a-11586d26be7e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"$metric", "[", "]"}]], "Input",
 CellLabel->"In[4]:=",
 CellID->1498,ExpressionUUID->"9e3cdd46-e20c-4771-aa9d-f0dfbda9f59d"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"Signature", "\[Rule]", 
    RowBox[{
     RowBox[{"-", "1"}], "|", "1"}]}], ",", 
   RowBox[{"Symbol", "\[Rule]", 
    RowBox[{"_Symbol", "[", 
     RowBox[{
      RowBox[{"_Symbol", "|", 
       RowBox[{"-", "_Symbol"}]}], ",", 
      RowBox[{"_Symbol", "|", 
       RowBox[{"-", "_Symbol"}]}]}], "]"}]}], ",", 
   RowBox[{"CovD", "\[Rule]", "_Symbol"}], ",", 
   RowBox[{"SymbolOfCovD", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"_String", ",", "_String"}], "}"}]}], ",", 
   RowBox[{"Expression", "\[Rule]", "_"}], ",", 
   RowBox[{"$auto", "\[Rule]", 
    RowBox[{"\[LeftAssociation]", 
     RowBox[{"_Symbol", "\[Rule]", 
      RowBox[{
       RowBox[{"\[LeftAssociation]", 
        RowBox[{
         RowBox[{"Routine", "\[Rule]", 
          RowBox[{"\[LeftAssociation]", 
           RowBox[{
            RowBox[{"Chain", "\[Rule]", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{"_", "\[Rule]", 
                 RowBox[{"{", "___List", "}"}]}], ")"}], "..."}], "}"}]}], 
            ",", 
            RowBox[{"Apply", "\[Rule]", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"Map", "|", "ParallelMap"}], "\[Rule]", "_"}], ")"}],
                "..."}], "}"}]}]}], "\[RightAssociation]"}]}], ",", 
         RowBox[{"Value", "\[Rule]", "_"}]}], "\[RightAssociation]"}], 
       "..."}]}], "\[RightAssociation]"}]}], ",", 
   RowBox[{"PrintAs", "\[Rule]", 
    RowBox[{"_String", "|", "Identity"}]}], ",", 
   RowBox[{"FlatMetric", "\[Rule]", 
    RowBox[{"True", "|", "False"}]}], ",", 
   RowBox[{"InducedFrom", "\[Rule]", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"_Symbol", ",", "_Symbol"}], "}"}], "|", "Null"}]}], ",", 
   RowBox[{"ConformalTo", "\[Rule]", 
    RowBox[{"_", "|", "Null"}]}], ",", 
   RowBox[{"OtherDependencies", "\[Rule]", 
    RowBox[{"{", "___Symbol", "}"}]}], ",", 
   RowBox[{"WeightedWithBasis", "\[Rule]", 
    RowBox[{"_Symbol", "|", "Null"}]}], ",", 
   RowBox[{"epsilonOrientationInBasis", "\[RuleDelayed]", 
    RowBox[{"ScreenDollarIndices", "[", 
     RowBox[{"{", 
      RowBox[{"_Symbol", ",", 
       RowBox[{"1", "|", 
        RowBox[{"-", "1"}]}]}], "}"}], "]"}]}], ",", 
   RowBox[{"Master", "\[Rule]", "_Symbol"}], ",", 
   RowBox[{"ProtectNewSymbol", "\[RuleDelayed]", 
    RowBox[{"ScreenDollarIndices", "[", 
     RowBox[{"True", "|", "False"}], "]"}]}], ",", 
   RowBox[{"DefInfo", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"_String", ",", "_String"}], "}"}]}], ",", 
   RowBox[{"DefMetricPerturbation", "\[Rule]", 
    RowBox[{"True", "|", "False"}]}], ",", 
   RowBox[{"Torsion", "\[Rule]", 
    RowBox[{"True", "|", "False"}]}], ",", 
   RowBox[{"Curvature", "\[Rule]", 
    RowBox[{"True", "|", "False"}]}], ",", 
   RowBox[{"SymCovDQ", "\[Rule]", 
    RowBox[{"True", "|", "False"}]}]}], "\[RightAssociation]"}]], "Output",
 CellLabel->"Out[4]=",
 CellID->1499,ExpressionUUID->"8c8ce589-e230-4d66-aca5-9cd848428120"]
}, Open  ]],

Cell["The keys of $metric, by class:", "Caption",
 CellID->1500,ExpressionUUID->"0ec6c031-b699-4048-8e13-62ce2f3c3c0a"],

Cell[BoxData[GridBox[{
   {Cell["key", "TableHeader",ExpressionUUID->
     "4eb16a1d-067a-4260-98b2-89e4fd3901aa"], Cell[
    "class", "TableHeader",ExpressionUUID->
     "6bd4ee09-57a3-4321-86fa-f559bc53dd01"], " "},
   {"Signature", 
    StyleBox["essential", "TI"], Cell[TextData[{
     "the sign of the metric determinant; ",
     ButtonBox["DefMetric",
      BaseStyle->"Link",
      Appearance->None,
      Evaluator->Automatic,
      ButtonFunction:>NotebookOpen[
        FindFile["xAct/Documentation/English/" <> "xTensorDoc.nb"]]],
     "'s first argument (-1 Lorentzian, +1 Euclidean)"
    }], "TableText",ExpressionUUID->"d6bc0971-9b08-4dc9-a18a-6ef22e2e4e15"]},
   {"Symbol", 
    StyleBox["essential", "TI"], Cell["\<\
the symbol xAct defines, with its index slots where it has any; its bare head \
is the name the object is stored and retrieved under\
\>", "TableText",ExpressionUUID->"177d58b8-0688-4e31-8f4a-5a54a159f244"]},
   {"CovD", 
    StyleBox["essential", "TI"], Cell["\<\
the symbol of the associated covariant derivative: defined alongside a \
$metric, built from for a $spinConnection\
\>", "TableText",ExpressionUUID->"ab76c7ad-028d-4a3c-b383-74c394d45b71"]},
   {"SymbolOfCovD", 
    StyleBox["essential", "TI"], Cell["\<\
the pair of display strings for the covariant derivative, like {\";\", \"\
\[Del]\"}\
\>", "TableText",ExpressionUUID->"39ab0821-2668-4357-9b9d-9a3f91a1ba57"]},
   {"Expression", 
    StyleBox["runtime", "TI"], Cell["\<\
the stored expression \[LongDash] the physically relevant data, replayed when \
the object is loaded\
\>", "TableText",ExpressionUUID->"e6318792-e729-4384-9e76-b1379ea87bf2"]},
   {"$auto", 
    StyleBox["runtime", "TI"], Cell[TextData[{
     "slots for the symbols xAct creates alongside the definition; each \
carries a ",
     Cell[BoxData["Routine"], "InlineFormula",
      FontFamily->"Source Sans Pro",ExpressionUUID->
      "22daf136-68a1-4dc5-90b6-2fbc203addb2"],
     " (the ",
     Cell[BoxData["Chain"], "InlineFormula",
      FontFamily->"Source Sans Pro",ExpressionUUID->
      "57ee9fd5-35d2-4a83-ae7d-c743c96ca280"],
     " recipe that ",
     Cell[BoxData[
      TemplateBox[{
        Cell[
         TextData["Compute"]], "paclet:VasilDimitrov/SolutionsX/ref/Compute", 
        "VasilDimitrov Package Symbol"},
       "PackageLink",
       BaseStyle->"InlineFormula"]], "InlineFormula",
      FontFamily->"Source Sans Pro",ExpressionUUID->
      "8b788a1d-459d-4940-96ac-aabf52d7f990"],
     " follows) and its computed ",
     Cell[BoxData["Value"], "InlineFormula",
      FontFamily->"Source Sans Pro",ExpressionUUID->
      "a2f2289d-122d-413a-879b-0a5f6a286a56"]
    }], "TableText",ExpressionUUID->"47eabf9f-b66e-481f-8bf1-954fbab9b091"]},
   {"PrintAs", 
    StyleBox["option", "TI"], Cell[
    "xAct option: the glyph the symbol typesets as", "TableText",
     ExpressionUUID->"c9e371b1-f56b-49dc-91dd-256350325870"]},
   {"FlatMetric", 
    StyleBox["option", "TI"], Cell[
    "xAct option: whether the defined metric is flat", "TableText",
     ExpressionUUID->"8ed5e141-8fa4-4665-8a73-95dae9cd9401"]},
   {"InducedFrom", 
    StyleBox["option", "TI"], Cell["\<\
xAct option: define the metric as induced on a hypersurface, as {metric, \
normal vector}\
\>", "TableText",ExpressionUUID->"75bfba4c-ba5f-4852-b716-71bccbd71030"]},
   {"ConformalTo", 
    StyleBox["option", "TI"], Cell["\<\
xAct option: define the metric as conformal to another, as {metric, conformal \
factor}\
\>", "TableText",ExpressionUUID->"d8f40b31-6642-4856-857d-959c34dc7541"]},
   {"OtherDependencies", 
    StyleBox["option", "TI"], Cell["\<\
xAct option: extra manifolds and parameters everything defined here depends on\
\>", "TableText",ExpressionUUID->"fd001a1d-0505-4b99-ad4a-f249ae6c15c8"]},
   {"WeightedWithBasis", 
    StyleBox["option", "TI"], Cell["\<\
xAct option: extend the Levi-Civita connection to densities of the given basis\
\>", "TableText",ExpressionUUID->"92f870c1-3ac1-42c5-b43f-62287dae85b5"]},
   {"epsilonOrientationInBasis", 
    StyleBox["option", "TI"], Cell["\<\
xAct option: {basis, sign} fixing the orientation factor between the metric's \
epsilon and the basis' eta tensors\
\>", "TableText",ExpressionUUID->"6c0c72c9-8542-48bc-9140-c3b32fbda746"]},
   {"Master", 
    StyleBox["option", "TI"], Cell["\<\
xAct option: the master symbol the definition is tied to; undefining the \
master removes this object too\
\>", "TableText",ExpressionUUID->"92c3ef12-d72b-428e-ba30-1fee9687b83b"]},
   {"ProtectNewSymbol", 
    StyleBox["option", "TI"], Cell["\<\
xAct option: whether the new symbol is protected after definition\
\>", "TableText",ExpressionUUID->"5434e3a6-0b30-41dd-9253-0414988cbc87"]},
   {"DefInfo", 
    StyleBox["option", "TI"], Cell["\<\
xAct option: the informational message printed at definition time\
\>", "TableText",ExpressionUUID->"fed892ab-636a-45c7-8883-e47ac31fb797"]},
   {"DefMetricPerturbation", 
    StyleBox["option", "TI"], Cell["\<\
xAct option (xTras): also define the metric's perturbation and its expansion \
parameter\
\>", "TableText",ExpressionUUID->"ab4d4308-6b0b-440b-a029-d1dfb66ebff2"]},
   {"Torsion", 
    StyleBox["option", "TI"], Cell["\<\
xAct option: whether the covariant derivative carries torsion\
\>", "TableText",ExpressionUUID->"965f191a-937b-4b4d-8840-a036ebee0e6f"]},
   {"Curvature", 
    StyleBox["option", "TI"], Cell["\<\
xAct option: whether, and on which bundles, the derivative has curvature\
\>", "TableText",ExpressionUUID->"b7f21a7f-1c54-4be2-ad1a-4e4a7e6d4401"]},
   {"SymCovDQ", 
    StyleBox["option", "TI"], Cell["\<\
xAct option (xTras): register the derivative as symmetrizable\
\>", "TableText",ExpressionUUID->"8d4dc297-e26f-46e8-aead-4fc51be3c1f4"]}
  }]], "DefinitionBox3Col",
