              RowBox[{
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"Map", "|", "ParallelMap"}], "\[Rule]", "_"}], ")"}],
                "..."}], "}"}]}]}], "\[RightAssociation]"}]}], ",", 
         RowBox[{"Value", "\[Rule]", "_"}]}], "\[RightAssociation]"}], 
       "..."}]}], "\[RightAssociation]"}]}], ",", 
   RowBox[{"Dagger", "\[Rule]", 
    RowBox[{"Real", "|", "Complex"}]}], ",", 
   RowBox[{"Master", "\[Rule]", "_Symbol"}], ",", 
   RowBox[{"PrintAs", "\[Rule]", 
    RowBox[{"_String", "|", "Identity"}]}], ",", 
   RowBox[{"ProtectNewSymbol", "\[RuleDelayed]", 
    RowBox[{"ScreenDollarIndices", "[", 
     RowBox[{"True", "|", "False"}], "]"}]}], ",", 
   RowBox[{"DefInfo", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"_String", ",", "_String"}], "}"}]}]}], 
  "\[RightAssociation]"}]], "Output",
 CellLabel->"Out[8]=",
 CellID->1931,ExpressionUUID->"2a5b7d3d-04b1-4bb1-917d-771ffbf1227e"]
}, Open  ]],

Cell["The keys of $bundle, by class:", "Caption",
 CellID->1932,ExpressionUUID->"0d253bfe-def5-4155-a865-e64a81bca7bf"],

Cell[BoxData[GridBox[{
   {Cell["key", "TableHeader",ExpressionUUID->
     "4e268fa6-56f0-4d2b-a3bd-bdac577a138e"], Cell[
    "class", "TableHeader",ExpressionUUID->
     "5077d5a3-8319-41a2-bc79-f0eb8b480943"], " "},
   {"Symbol", 
    StyleBox["essential", "TI"], Cell["\<\
the symbol xAct defines, with its index slots where it has any; its bare head \
is the name the object is stored and retrieved under\
\>", "TableText",ExpressionUUID->"d2b3dde8-a919-4b85-b197-46aaa70a6537"]},
   {"Manifold", 
    StyleBox["essential", "TI"], Cell["\<\
the base manifold (or list of manifolds) the object lives on; the Def \
command's manifold argument\
\>", "TableText",ExpressionUUID->"6a700597-cf10-4d40-b90a-2f22f1024dbb"]},
   {"Dimension", 
    StyleBox["essential", "TI"], Cell[
    "the dimension, a positive integer", "TableText",ExpressionUUID->
     "4e8a12c2-9e12-45a1-a779-58bbce797feb"]},
   {"Index", 
    StyleBox["essential", "TI"], Cell[
    "the abstract indices to register, as a list of symbols", "TableText",
     ExpressionUUID->"6f1fa80d-4fe0-4819-9887-cb1be8bdc55b"]},
   {"Metric", 
    StyleBox["essential", "TI"], Cell["\<\
the metric the construction builds on: the frame's flat metric, the spin \
structure's base metric, or the bundle's fiber metric\
\>", "TableText",ExpressionUUID->"9d46d53c-a3bb-4e0e-b013-4181997abcb2"]},
   {"InvariantTraceTensor", 
    StyleBox["runtime", "TI"], Cell["\<\
the inner bundle's invariant trace tensor (FieldsX), recorded when computed\
\>", "TableText",ExpressionUUID->"732275a2-db96-47bd-9e08-c690289d2132"]},
   {"$auto", 
    StyleBox["runtime", "TI"], Cell[TextData[{
     "slots for the symbols xAct creates alongside the definition; each \
carries a ",
     Cell[BoxData["Routine"], "InlineFormula",
      FontFamily->"Source Sans Pro",ExpressionUUID->
      "2964f695-cbac-4fd4-b9c0-1279a15ee85b"],
     " (the ",
     Cell[BoxData["Chain"], "InlineFormula",
      FontFamily->"Source Sans Pro",ExpressionUUID->
      "dbcb2b6a-e223-4148-a215-ddf6d8c0018b"],
     " recipe that ",
     Cell[BoxData[
      TemplateBox[{
        Cell[
         TextData["Compute"]], "paclet:VasilDimitrov/SolutionsX/ref/Compute", 
        "VasilDimitrov Package Symbol"},
       "PackageLink",
       BaseStyle->"InlineFormula"]], "InlineFormula",
      FontFamily->"Source Sans Pro",ExpressionUUID->
      "4323e66d-cb9e-4d98-bd7d-82d6748378b4"],
     " follows) and its computed ",
     Cell[BoxData["Value"], "InlineFormula",
      FontFamily->"Source Sans Pro",ExpressionUUID->
      "ed4f197e-0106-4e75-bade-31e1525a7580"]
    }], "TableText",ExpressionUUID->"c6afe939-5d32-43a2-9877-0a1cefff2efb"]},
   {"Dagger", 
    StyleBox["option", "TI"], Cell[TextData[{
     "xAct option: ",
     Cell[BoxData[
      TemplateBox[{
        Cell[
         TextData["Real"]], "paclet:ref/Real"},
       "RefLink",
       BaseStyle->{"InlineFormula"}]], "InlineFormula",
      FontFamily->"Source Sans Pro",ExpressionUUID->
      "87e38b01-4e18-4ebb-bd36-8ed1f2546fdc"],
     " or ",
     Cell[BoxData[
      TemplateBox[{
        Cell[
         TextData["Complex"]], "paclet:ref/Complex"},
       "RefLink",
       BaseStyle->{"InlineFormula"}]], "InlineFormula",
      FontFamily->"Source Sans Pro",ExpressionUUID->
      "78f32653-86ff-4c06-8cbc-8aa812fc5b8f"],
     " behaviour under complex conjugation"
    }], "TableText",ExpressionUUID->"d44a78b9-09f7-4642-9e04-6459a032b7a4"]},
   {"Master", 
    StyleBox["option", "TI"], Cell["\<\
xAct option: the master symbol the definition is tied to; undefining the \
master removes this object too\
\>", "TableText",ExpressionUUID->"c6539a63-abc9-4177-b1c8-31a80fc2330f"]},
   {"PrintAs", 
    StyleBox["option", "TI"], Cell[
    "xAct option: the glyph the symbol typesets as", "TableText",
     ExpressionUUID->"ff677c56-cf93-4487-9c4d-98a8c8bdce2f"]},
   {"ProtectNewSymbol", 
    StyleBox["option", "TI"], Cell["\<\
xAct option: whether the new symbol is protected after definition\
\>", "TableText",ExpressionUUID->"14dd613e-350b-4696-9591-bff043babf01"]},
   {"DefInfo", 
    StyleBox["option", "TI"], Cell["\<\
xAct option: the informational message printed at definition time\
\>", "TableText",ExpressionUUID->"6d6d9517-b8d5-40ae-a214-da3c25ac5e19"]}
  }]], "DefinitionBox3Col",
 CellID->1933,ExpressionUUID->"23930a59-41f9-4b60-94f5-126b52eabc76"],

