      RowBox[{"_Symbol", ",", 
       RowBox[{"1", "|", 
        RowBox[{"-", "1"}]}]}], "}"}], "]"}]}], ",", 
   RowBox[{"DependenciesOfBasis", "\[Rule]", 
    RowBox[{"{", "___Symbol", "}"}]}], ",", 
   RowBox[{"DefInfo", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"_String", ",", "_String"}], "}"}]}], ",", 
   RowBox[{"Master", "\[Rule]", "_Symbol"}]}], 
