\>", "TableText",ExpressionUUID->"348c7e70-b206-488f-8b0c-5c9817bcd218"]},
   {"DependenciesOfBasis", 
    StyleBox["option", "TI"], Cell["\<\
xAct option: the manifolds and parameters the basis depends on\
\>", "TableText",ExpressionUUID->"9493cac2-f678-4af4-803e-d978dfa06fad"]},
   {"DefInfo", 
    StyleBox["option", "TI"], Cell["\<\
xAct option: the informational message printed at definition time\
\>", "TableText",ExpressionUUID->"23371c78-20bf-43ac-90ff-d04bb6f196aa"]},
   {"Master", 
    StyleBox["option", "TI"], Cell["\<\
xAct option: the master symbol the definition is tied to; undefining the \
master removes this object too\
\>", "TableText",ExpressionUUID->"b74468eb-1a2d-4d98-bf5e-8ab08852c904"]}
  }]], "DefinitionBox3Col",
