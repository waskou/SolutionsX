 CellLabel->"In[17]:=",
 CellID->1993,ExpressionUUID->"13b0c45b-e98a-42dc-a49d-5a74bb660f21"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"Symbol", "\[Rule]", "_Symbol"}], ",", 
   RowBox[{"Expression", "\[Rule]", 
    RowBox[{
    "_Equal", "|", "_Unequal", "|", "_Less", "|", "_LessEqual", "|", 
     "_Greater", "|", "_GreaterEqual", "|", "_And", "|", "_Or", "|", "_Not", 
     "|", "_Element", "|", "_Exists", "|", "_ForAll", "|", "_Inequality", "|",
      "_Implies", "|", "_Equivalent", "|", 
     RowBox[{"_List", "?", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"AllTrue", "[", 
         RowBox[{"#1", ",", 
          RowBox[{
           RowBox[{"MatchQ", "[", 
            RowBox[{"#1", ",", 
             RowBox[{
             "_Equal", "|", "_Unequal", "|", "_Less", "|", "_LessEqual", "|", 
              "_Greater", "|", "_GreaterEqual", "|", "_And", "|", "_Or", "|", 
              "_Not", "|", "_Element", "|", "_Exists", "|", "_ForAll", "|", 
              "_Inequality", "|", "_Implies", "|", "_Equivalent", "|", 
              RowBox[{"_List", "?", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"AllTrue", "[", 
                  RowBox[{"#1", ",", 
                   RowBox[{
                    RowBox[{"MatchQ", "[", 
                    RowBox[{"#1", ",", "#1"}], "]"}], "&"}]}], "]"}], "&"}], 
                ")"}]}]}]}], "]"}], "&"}]}], "]"}], "&"}], ")"}]}]}]}]}], 
  "\[RightAssociation]"}]], "Output",
 CellLabel->"Out[17]=",
 CellID->1994,ExpressionUUID->"425de484-f1ff-47f2-82ea-e3a0e8b1ccd0"]
}, Open  ]],

