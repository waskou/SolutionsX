   {"ProtectNewSymbol", 
    StyleBox["option", "TI"], Cell["\<\
xAct option: whether the new symbol is protected after definition\
\>", "TableText",ExpressionUUID->"7b98d316-87fe-4b7b-8a73-ffa2410f3016"]},
   {"DefInfo", 
    StyleBox["option", "TI"], Cell["\<\
xAct option: the informational message printed at definition time\
\>", "TableText",ExpressionUUID->"11b28b37-4a8e-410d-a4b6-70f62a5f5a5f"]}
  }]], "DefinitionBox3Col",
 CellID->1487,ExpressionUUID->"e4c2fbf6-2291-4d41-9ca8-e490b8cde2af"],

