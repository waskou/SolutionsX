Cell["The keys of $chart, by class:", "Caption",
 CellID->1946,ExpressionUUID->"e6dbbb61-3a95-4803-aea1-a83e26f9f5d7"],

Cell[BoxData[GridBox[{
   {Cell["key", "TableHeader",ExpressionUUID->
     "a10173f9-9481-4c9f-b47e-e2da0cac2e95"], Cell[
    "class", "TableHeader",ExpressionUUID->
     "277274f4-c090-4688-8ae6-15d8a6711245"], " "},
   {"Symbol", 
    StyleBox["essential", "TI"], Cell["\<\
the symbol xAct defines, with its index slots where it has any; its bare head \
is the name the object is stored and retrieved under\
\>", "TableText",ExpressionUUID->"31cd5019-3ce9-407a-98f4-25b6ec39bcb5"]},
   {"Manifold", 
    StyleBox["essential", "TI"], Cell["\<\
the base manifold (or list of manifolds) the object lives on; the Def \
command's manifold argument\
\>", "TableText",ExpressionUUID->"8df70888-941a-40ff-86cb-5447e5a03d3f"]},
   {"CNumbersOf", 
    StyleBox["essential", "TI"], Cell["\<\
the coordinate numbers of the chart or basis, as a list of integers\
\>", "TableText",ExpressionUUID->"9962d70c-085c-483a-ad34-8f492987b16a"]},
   {"ScalarsOfChart", 
    StyleBox["essential", "TI"], Cell["\<\
the coordinate scalar fields of the chart, in coordinate-number order\
\>", "TableText",ExpressionUUID->"8d76bc56-4a1b-483c-a7b8-972850569cb7"]},
   {"Name", 
    StyleBox["runtime", "TI"], Cell[TextData[{
     "a string; ",
     Cell[BoxData[
      TemplateBox[{
        Cell[
         TextData["SaveData"]], 
        "paclet:VasilDimitrov/SolutionsX/ref/SaveData", 
        "VasilDimitrov Package Symbol"},
       "PackageLink",
       BaseStyle->"InlineFormula"]], "InlineFormula",
      FontFamily->"Source Sans Pro",ExpressionUUID->
      "560dae37-baa5-4d19-8e8f-6f97c7501a9f"],
     " builds the entry name from the first manifold's Name and Dimension, \
the first metric's Signature and the first chart's Name"
    }], "TableText",ExpressionUUID->"b0e99acd-996f-4be7-b9cf-50b0c1db9159"]},
   {"ChartColor", 
    StyleBox["option", "TI"], Cell["\<\
xAct option: the display colour of the chart's indices and objects\
\>", "TableText",ExpressionUUID->"9e51c622-606c-4d91-a07f-5451e913c04a"]},
   {"FormatBasis", 
    StyleBox["option", "TI"], Cell["\<\
xAct option: display formats for the basis vectors and covectors\
\>", "TableText",ExpressionUUID->"5da34ce3-9328-4e99-b7c2-9637ea35662c"]},
   {"ProtectNewSymbol", 
    StyleBox["option", "TI"], Cell["\<\
xAct option: whether the new symbol is protected after definition\
\>", "TableText",ExpressionUUID->"8e35eee2-ca93-45cf-9f9b-445a0f9ea772"]},
   {"Dagger", 
    StyleBox["option", "TI"], Cell[TextData[{
     "xAct option: ",
     Cell[BoxData[
      TemplateBox[{
        Cell[
         TextData["Real"]], "paclet:ref/Real"},
       "RefLink",
       BaseStyle->{"InlineFormula"}]], "InlineFormula",
      FontFamily->"Source Sans Pro",ExpressionUUID->
      "db07d154-f90a-45a6-b6bb-48521558ea8a"],
     " or ",
     Cell[BoxData[
      TemplateBox[{
        Cell[
         TextData["Complex"]], "paclet:ref/Complex"},
       "RefLink",
       BaseStyle->{"InlineFormula"}]], "InlineFormula",
      FontFamily->"Source Sans Pro",ExpressionUUID->
      "4d29e4c0-a26d-41d4-b314-88126cd7f640"],
     " behaviour under complex conjugation"
    }], "TableText",ExpressionUUID->"c551c0da-c23a-49b2-a84c-a56ad487b476"]},
   {"MetricInBasis", 
    StyleBox["option", "TI"], Cell["\<\
xAct option: component values of a metric in this chart or basis, given at \
definition time\
\>", "TableText",ExpressionUUID->"07f098e2-c09c-4891-838f-2f987d04a921"]},
   {"epsilonOrientationOfMetric", 
    StyleBox["option", "TI"], Cell["\<\
xAct option: {metric, sign} fixing the orientation factor between the \
metric's epsilon and the basis' eta tensors\
\>", "TableText",ExpressionUUID->"e81f49de-2163-42aa-a37c-c7b7518c2ca2"]},
   {"ExtendedCoordinateDerivatives", 
    StyleBox["option", "TI"], Cell[TextData[{
     "xAct option: convert covariant derivatives of the coordinate scalars \
into ",
