\>", "MathCaption",
 CellID->1553,ExpressionUUID->"d3f37520-de98-4a89-88e5-272ee210a9b1"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"$form", "[", "]"}]], "Input",
 CellLabel->"In[12]:=",
 CellID->1554,ExpressionUUID->"aa9bd4f5-5a58-4f44-9f7f-8d4d1dc3c93a"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"Symbol", "\[Rule]", 
    RowBox[{"_Symbol", "[", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"_Symbol", "|", 
        RowBox[{"-", "_Symbol"}]}], ")"}], "..."}], "]"}]}], ",", 
   RowBox[{"Manifold", "\[Rule]", 
    RowBox[{
     RowBox[{"{", "__Symbol", "}"}], "|", "_Symbol"}]}], ",", 
   RowBox[{"Deg", "\[Rule]", 
    RowBox[{"_Integer", "?", "Positive"}]}], ",", 
   RowBox[{"Symmetry", "\[Rule]", 
    RowBox[{
     RowBox[{"Symmetric", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"__Symbol", ",", "__"}], "}"}], "|", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "__Symbol"}], ",", "__"}], "}"}]}], "]"}], "|", 
     RowBox[{"Antisymmetric", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"__Symbol", ",", "__"}], "}"}], "|", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "__Symbol"}], ",", "__"}], "}"}]}], "]"}], "|", 
     RowBox[{"GenSet", "[", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         InterpretationBox[
          StyleBox[
           RowBox[{"(", 
            RowBox[{
             RowBox[{"__Integer", "?", "Positive"}], "|", "__Symbol"}], ",", 
            "__", ")"}],
           ShowAutoStyles->False,
           AutoSpacing->False],
          xAct`xPerm`Cycles[{
            Alternatives[
             PatternTest[
              BlankSequence[Integer], Positive], 
             BlankSequence[Symbol]], 
            BlankSequence[]}],
          Editable->False], "|", 
         InterpretationBox[
          StyleBox[
           RowBox[{"-", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"__Integer", "?", "Positive"}], "|", "__Symbol"}], ",", 
             "__", ")"}]}],
           ShowAutoStyles->False,
           AutoSpacing->False],
          -xAct`xPerm`Cycles[{
             Alternatives[
              PatternTest[
               BlankSequence[Integer], Positive], 
              BlankSequence[Symbol]], 
             BlankSequence[]}],
          Editable->False]}], ")"}], "..."}], "]"}], "|", "None"}]}], ",", 
   RowBox[{"Expression", "\[Rule]", "_"}], ",", 
   RowBox[{"$auto", "\[Rule]", 
    RowBox[{"\[LeftAssociation]", 
     RowBox[{"_Symbol", "\[Rule]", 
      RowBox[{
       RowBox[{"\[LeftAssociation]", 
        RowBox[{
         RowBox[{"Routine", "\[Rule]", 
          RowBox[{"\[LeftAssociation]", 
           RowBox[{
            RowBox[{"Chain", "\[Rule]", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{"_", "\[Rule]", 
                 RowBox[{"{", "___List", "}"}]}], ")"}], "..."}], "}"}]}], 
            ",", 
            RowBox[{"Apply", "\[Rule]", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"Map", "|", "ParallelMap"}], "\[Rule]", "_"}], ")"}],
                "..."}], "}"}]}]}], "\[RightAssociation]"}]}], ",", 
         RowBox[{"Value", "\[Rule]", "_"}]}], "\[RightAssociation]"}], 
       "..."}]}], "\[RightAssociation]"}]}], ",", 
   RowBox[{"Dagger", "\[Rule]", 
    RowBox[{"Real", "|", "Complex"}]}], ",", 
   RowBox[{"Master", "\[Rule]", "_Symbol"}], ",", 
   RowBox[{"PrintAs", "\[Rule]", 
    RowBox[{"_String", "|", "Identity"}]}], ",", 
   RowBox[{"VanishingQ", "\[Rule]", 
    RowBox[{"True", "|", "False"}]}], ",", 
   RowBox[{"ForceSymmetries", "\[Rule]", 
    RowBox[{"True", "|", "False"}]}], ",", 
   RowBox[{"WeightOfTensor", "\[Rule]", 
    RowBox[{
     RowBox[{"_Integer", " ", "_Symbol"}], "|", "0"}]}], ",", 
   RowBox[{"GradeOfTensor", "\[Rule]", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"_Symbol", "\[Rule]", 
         RowBox[{"_Integer", "?", "Positive"}]}], ")"}], ".."}], "}"}], "|", 
     "0"}]}], ",", 
   RowBox[{"FrobeniusQ", "\[Rule]", 
    RowBox[{"True", "|", "False"}]}], ",", 
   RowBox[{"OrthogonalTo", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"_Symbol", "[", 
       RowBox[{"_Symbol", "|", 
        RowBox[{"-", "_Symbol"}]}], "]"}], "..."}], "}"}]}], ",", 
   RowBox[{"ProjectedWith", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"_Symbol", "[", 
       RowBox[{
        RowBox[{"_Symbol", "|", 
         RowBox[{"-", "_Symbol"}]}], ",", 
        RowBox[{"_Symbol", "|", 
         RowBox[{"-", "_Symbol"}]}]}], "]"}], "..."}], "}"}]}], ",", 
   RowBox[{"ProtectNewSymbol", "\[RuleDelayed]", 
    RowBox[{"ScreenDollarIndices", "[", 
     RowBox[{"True", "|", "False"}], "]"}]}], ",", 
   RowBox[{"DefInfo", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"_String", ",", "_String"}], "}"}]}], ",", 
   RowBox[{"TensorID", "\[Rule]", "_"}], ",", 
   RowBox[{"KillingVectorOf", "\[Rule]", "_Symbol"}]}], 
  "\[RightAssociation]"}]], "Output",
 CellLabel->"Out[12]=",
 CellID->1555,ExpressionUUID->"cfa3c72f-7d3c-4114-b474-a509fcc83df8"]
}, Open  ]],

