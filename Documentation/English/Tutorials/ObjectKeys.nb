Cell["\<\
Called empty, the constructor spells out every key and the pattern its value \
must match:\
\>", "MathCaption",
 CellID->1936,ExpressionUUID->"ae7dd45f-abfd-4feb-a019-cd49e207d3c8"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"$covd", "[", "]"}]], "Input",
 CellLabel->"In[9]:=",
 CellID->1937,ExpressionUUID->"d8834a2a-9014-46f7-b51c-bccdfd2decdf"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"Symbol", "\[Rule]", 
    RowBox[{"_Symbol", "[", 
     RowBox[{"_Symbol", "|", 
      RowBox[{"-", "_Symbol"}]}], "]"}]}], ",", 
   RowBox[{"VBundle", "\[Rule]", 
    RowBox[{"{", "___Symbol", "}"}]}], ",", 
   RowBox[{"SymbolOfCovD", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"_String", ",", "_String"}], "}"}]}], ",", 
   RowBox[{"$auto", "\[Rule]", 
    RowBox[{"\[LeftAssociation]", 
     RowBox[{"_Symbol", "\[Rule]", 
      RowBox[{
       RowBox[{"\[LeftAssociation]", 
        RowBox[{
         RowBox[{"Routine", "\[Rule]", 
          RowBox[{"\[LeftAssociation]", 
           RowBox[{
            RowBox[{"Chain", "\[Rule]", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{"_", "\[Rule]", 
                 RowBox[{"{", "___List", "}"}]}], ")"}], "..."}], "}"}]}], 
            ",", 
            RowBox[{"Apply", "\[Rule]", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"Map", "|", "ParallelMap"}], "\[Rule]", "_"}], ")"}],
                "..."}], "}"}]}]}], "\[RightAssociation]"}]}], ",", 
         RowBox[{"Value", "\[Rule]", "_"}]}], "\[RightAssociation]"}], 
       "..."}]}], "\[RightAssociation]"}]}], ",", 
   RowBox[{"Torsion", "\[Rule]", 
    RowBox[{"True", "|", "False"}]}], ",", 
   RowBox[{"Curvature", "\[Rule]", 
    RowBox[{"True", "|", "False"}]}], ",", 
   RowBox[{"FromMetric", "\[Rule]", "_Symbol"}], ",", 
   RowBox[{"CurvatureRelations", "\[Rule]", 
    RowBox[{"True", "|", "False"}]}], ",", 
   RowBox[{"ExtendedFrom", "\[Rule]", "_Symbol"}], ",", 
   RowBox[{"OtherDependencies", "\[Rule]", 
    RowBox[{"{", "___Symbol", "}"}]}], ",", 
   RowBox[{"OrthogonalTo", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"_Symbol", "[", 
       RowBox[{"_Symbol", "|", 
        RowBox[{"-", "_Symbol"}]}], "]"}], "..."}], "}"}]}], ",", 
   RowBox[{"ProjectedWith", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"_Symbol", "[", 
       RowBox[{
        RowBox[{"_Symbol", "|", 
         RowBox[{"-", "_Symbol"}]}], ",", 
        RowBox[{"_Symbol", "|", 
         RowBox[{"-", "_Symbol"}]}]}], "]"}], "..."}], "}"}]}], ",", 
   RowBox[{"WeightedWithBasis", "\[Rule]", 
    RowBox[{"_Symbol", "|", "Null"}]}], ",", 
   RowBox[{"ProtectNewSymbol", "\[RuleDelayed]", 
    RowBox[{"ScreenDollarIndices", "[", 
     RowBox[{"True", "|", "False"}], "]"}]}], ",", 
   RowBox[{"Master", "\[Rule]", "_Symbol"}], ",", 
   RowBox[{"DefInfo", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"_String", ",", "_String"}], "}"}]}], ",", 
   RowBox[{"SymCovDQ", "\[Rule]", 
    RowBox[{"True", "|", "False"}]}]}], "\[RightAssociation]"}]], "Output",
 CellLabel->"Out[9]=",
 CellID->1938,ExpressionUUID->"c46f541d-aa00-49d9-85ac-0c6ef9d43bad"]
}, Open  ]],

Cell["The keys of $covd, by class:", "Caption",
 CellID->1939,ExpressionUUID->"4ac871b6-c79f-44f3-af4d-5e09ef1f2c54"],

Cell[BoxData[GridBox[{
   {Cell["key", "TableHeader",ExpressionUUID->
     "764a3212-f091-454a-b7b1-661c5c5f62a9"], Cell[
    "class", "TableHeader",ExpressionUUID->
     "97eaa6c8-3c9a-4192-9ceb-8f64e26608f3"], " "},
   {"Symbol", 
    StyleBox["essential", "TI"], Cell["\<\
the symbol xAct defines, with its index slots where it has any; its bare head \
is the name the object is stored and retrieved under\
\>", "TableText",ExpressionUUID->"42305091-ca9c-4da5-be8d-a03d5d5fda21"]},
   {"VBundle", 
    StyleBox["essential", "TI"], Cell["\<\
the vector bundle the derivative or basis acts on; the Def command's bundle \
argument\
\>", "TableText",ExpressionUUID->"e0ea33db-ac8d-47da-9861-13aa5ed4737a"]},
   {"SymbolOfCovD", 
    StyleBox["essential", "TI"], Cell["\<\
the pair of display strings for the covariant derivative, like {\";\", \"\
\[Del]\"}\
\>", "TableText",ExpressionUUID->"576ce461-6640-48b7-bd11-72f6d1d6a256"]},
   {"$auto", 
    StyleBox["runtime", "TI"], Cell[TextData[{
     "slots for the symbols xAct creates alongside the definition; each \
carries a ",
     Cell[BoxData["Routine"], "InlineFormula",
      FontFamily->"Source Sans Pro",ExpressionUUID->
      "2ebd9315-be74-40c0-959c-7c3c95f08832"],
     " (the ",
     Cell[BoxData["Chain"], "InlineFormula",
      FontFamily->"Source Sans Pro",ExpressionUUID->
      "ea6ec25e-cc58-438b-b5c5-25a8c8a59aca"],
     " recipe that ",
     Cell[BoxData[
      TemplateBox[{
        Cell[
         TextData["Compute"]], "paclet:VasilDimitrov/SolutionsX/ref/Compute", 
        "VasilDimitrov Package Symbol"},
       "PackageLink",
       BaseStyle->"InlineFormula"]], "InlineFormula",
      FontFamily->"Source Sans Pro",ExpressionUUID->
      "0705f2ff-a8ad-4dd0-be19-90c2f9e0dc42"],
     " follows) and its computed ",
     Cell[BoxData["Value"], "InlineFormula",
      FontFamily->"Source Sans Pro",ExpressionUUID->
      "34e0affb-18af-4a37-a911-3ec1de502265"]
    }], "TableText",ExpressionUUID->"7c687f60-4284-492c-9fa4-05e9210d118a"]},
   {"Torsion", 
    StyleBox["option", "TI"], Cell["\<\
xAct option: whether the covariant derivative carries torsion\
\>", "TableText",ExpressionUUID->"e3200337-24f7-440d-9409-89234c71320d"]},
   {"Curvature", 
    StyleBox["option", "TI"], Cell["\<\
xAct option: whether, and on which bundles, the derivative has curvature\
\>", "TableText",ExpressionUUID->"0a0e0d78-4c3e-48be-bf85-2f3b6c63ae3e"]},
   {"FromMetric", 
    StyleBox["option", "TI"], Cell[
    "xAct option: the metric the derivative descends from", "TableText",
     ExpressionUUID->"00e52e19-1967-4329-8063-21d4017d7223"]},
   {"CurvatureRelations", 
    StyleBox["option", "TI"], Cell["\<\
xAct option: install the automatic rules relating the curvature tensors\
\>", "TableText",ExpressionUUID->"1dc83047-02b0-4b69-ba0e-6c0c1186a755"]},
   {"ExtendedFrom", 
    StyleBox["option", "TI"], Cell["\<\
xAct option: share the curvature and torsion tensors with an existing \
derivative\
\>", "TableText",ExpressionUUID->"424c6360-c91d-4987-bb78-eb1c7ddb52cd"]},
   {"OtherDependencies", 
    StyleBox["option", "TI"], Cell["\<\
xAct option: extra manifolds and parameters everything defined here depends on\
\>", "TableText",ExpressionUUID->"8af4201a-59d9-4da2-9a67-5c72b45fb70a"]},
   {"OrthogonalTo", 
    StyleBox["option", "TI"], Cell["\<\
xAct option: vectors the defined tensor is orthogonal to, one per index\
\>", "TableText",ExpressionUUID->"eb898310-44d0-4f57-ba4b-3bf35bae3d8c"]},
   {"ProjectedWith", 
    StyleBox["option", "TI"], Cell["\<\
xAct option: projectors that map the defined tensor into itself, one per index\
\>", "TableText",ExpressionUUID->"ae983709-5697-4cf7-9412-641f2c31f601"]},
   {"WeightedWithBasis", 
    StyleBox["option", "TI"], Cell["\<\
xAct option: extend the Levi-Civita connection to densities of the given basis\
\>", "TableText",ExpressionUUID->"0e74e1d8-4425-498c-8c76-d022d3b2cd61"]},
   {"ProtectNewSymbol", 
    StyleBox["option", "TI"], Cell["\<\
xAct option: whether the new symbol is protected after definition\
\>", "TableText",ExpressionUUID->"ec19c26b-c6ad-4be3-bfd0-f3d999bba0d4"]},
   {"Master", 
    StyleBox["option", "TI"], Cell["\<\
xAct option: the master symbol the definition is tied to; undefining the \
master removes this object too\
\>", "TableText",ExpressionUUID->"34f00cb0-dd85-4e39-aea2-3547ab06f796"]},
   {"DefInfo", 
    StyleBox["option", "TI"], Cell["\<\
xAct option: the informational message printed at definition time\
\>", "TableText",ExpressionUUID->"e9030630-8609-4e27-a684-395fb571d9f9"]},
   {"SymCovDQ", 
    StyleBox["option", "TI"], Cell["\<\
xAct option (xTras): register the derivative as symmetrizable\
\>", "TableText",ExpressionUUID->"ffa28af9-1634-4c8f-b3aa-c13dd844f526"]}
  }]], "DefinitionBox3Col",
 CellID->1940,ExpressionUUID->"cd1dbcd9-14af-4edc-bbd8-2027feff185a"],

