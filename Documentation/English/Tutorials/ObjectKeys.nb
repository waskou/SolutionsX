   RowBox[{"Symbol", "\[Rule]", "_Symbol"}], ",", 
   RowBox[{"Manifold", "\[Rule]", "_Symbol"}], ",", 
   RowBox[{"CNumbersOf", "\[Rule]", 
    RowBox[{"{", "__Integer", "}"}]}], ",", 
