     RowBox[{"True", "|", "False"}], "]"}]}], ",", 
   RowBox[{"Dagger", "\[Rule]", 
    RowBox[{"Real", "|", "Complex"}]}], ",", 
   RowBox[{"ExtendedFrom", "\[Rule]", "Null"}], ",", 
