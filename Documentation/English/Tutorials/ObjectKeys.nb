Cell["\<\
Called empty, the constructor spells out every key and the pattern its value \
must match:\
\>", "MathCaption",
 CellID->1943,ExpressionUUID->"4822ac3f-8278-45f7-a315-4f9c559b8349"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"$chart", "[", "]"}]], "Input",
 CellLabel->"In[10]:=",
 CellID->1944,ExpressionUUID->"b18b704d-60b3-4f4d-96b7-051d9ad1bbf3"],

