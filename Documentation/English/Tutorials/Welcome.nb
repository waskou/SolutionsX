Cell[CellGroupData[{

Cell["Welcome to SolutionsX", "Title",
 CellID->1349,ExpressionUUID->"f9f35c58-bc68-43fc-a236-4889faf89480"],

Cell["\<\
Welcome[] guides a first session with SolutionsX: where your data should \
live, what your alias is, and which curated entries to copy under it. This \
note walks through the wizard and its by-hand equivalent.\
\>", "Text",
 CellID->1350,ExpressionUUID->"c40e81d3-54a8-4283-959e-db25187884e1"],

Cell["\<\
SolutionsX is installed either as a released paclet or from a clone of the \
repository; both carry the curated data corpus. The xAct suite must be \
installed first.\
\>", "Text",
 CellID->1351,ExpressionUUID->"95fa0a80-3a42-49ec-8455-d40bcb59bfb2"],

Cell[BoxData[
 RowBox[{"PacletInstall", "[", "\"\<VasilDimitrov/SolutionsX\>\"", 
  "]"}]], "Input",
 CellLabel->"In[1]:=",
 CellID->1352,ExpressionUUID->"fa930984-689d-4e0a-bfba-f636722d20fb"],

Cell["A first session starts with the wizard:", "MathCaption",
 CellID->1353,ExpressionUUID->"7bb92925-b942-448f-b64e-107788826380"],

Cell[BoxData[{
 RowBox[{"Needs", "[", "\"\<VasilDimitrov`SolutionsX`\>\"", "]"}], "\n", 
 RowBox[{"Welcome", "[", "]"}]}], "Input",
 CellLabel->"In[2]:=",
 CellID->1354,ExpressionUUID->"f1808b6a-52bf-4265-906e-6b0274375838"],

Cell[TextData[{
 "Welcome[] asks three things. First, where your data should live \[LongDash] \
entries are stored under ",
 Cell[BoxData[
  StyleBox["directory", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "c84c3034-3cd5-4b40-a9cc-8c7a7790d823"],
 "/",
 Cell[BoxData[
  StyleBox["alias", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "c1fe30fc-0062-4720-a0c4-fcfe3c3bfcb3"],
 "/; if you cloned the repository, the best choice is the clone's own Data \
folder. Second, your alias \[LongDash] the name of your personal corpus. Both \
are recorded in the user configuration, so later sessions remember them. \
Third, it offers the curated entries \[LongDash] the package's worked \
examples \[LongDash] individually selectable, to copy under your alias with \
",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CopyData"]], "paclet:VasilDimitrov/SolutionsX/ref/CopyData", 
    "VasilDimitrov Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "954e5089-1c4e-4d6b-bce0-80f5ad82dec9"],
 "."
}], "Text",
 CellID->1355,ExpressionUUID->"d56bf30a-3bf4-47e7-b022-ff0c8a5868fb"],

Cell["\<\
Cancelling a dialog skips it and everything after it; re-running Welcome[] is \
always safe. Without a front end, Welcome[] prints the same steps as commands \
instead of asking.\
\>", "Text",
 CellID->1356,ExpressionUUID->"02f9ec84-2dd2-4adf-b6a5-4ae2f8c0dd14"],

Cell["The same steps by hand:", "MathCaption",
 CellID->1357,ExpressionUUID->"671dc049-9c2d-46af-bb5a-d8a6530e0150"],

Cell[BoxData[
 RowBox[{"SetAlias", "[", "\"\<you\>\"", "]"}]], "Input",
 CellLabel->"In[3]:=",
 CellID->1358,ExpressionUUID->"3df7ab70-cd57-4a00-8db1-38387cf13325"],

Cell[BoxData[
 RowBox[{"CopyData", "[", "\"\<Curated\>\"", "]"}]], "Input",
 CellLabel->"In[4]:=",
 CellID->1359,ExpressionUUID->"14072b77-e269-45da-8834-62150b5e3882"],

Cell[TextData[{
 "From here, ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["NewData"]], "paclet:VasilDimitrov/SolutionsX/ref/NewData", 
    "VasilDimitrov Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "3d92d172-5c98-4017-9d56-a4ba77f2203e"],
 " opens a fresh working notebook, ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["OpenData"]], "paclet:VasilDimitrov/SolutionsX/ref/OpenData", 
    "VasilDimitrov Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "83b5bf33-e010-41b8-876a-8442628fb36a"],
 " opens a copied entry, and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["GetData"]], "paclet:VasilDimitrov/SolutionsX/ref/GetData", 
    "VasilDimitrov Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "0768e8c2-d2e2-481d-b9d7-25453fa9ce46"],
 " followed by ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Load"]], "paclet:VasilDimitrov/SolutionsX/ref/Load", 
    "VasilDimitrov Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "5625d806-90ad-494f-9e37-fec508e0a5a3"],
 " makes a stored entry live. The full storage story is the tech note ",
 ButtonBox["Storing and retrieving",
  BaseStyle->"Link",
  ButtonData->"paclet:VasilDimitrov/SolutionsX/tutorial/StoringAndRetrieving"],
 "."
}], "Text",
 CellID->1360,ExpressionUUID->"ce4b097b-1a99-4565-af15-5f9c0940ac76"],

Cell["\<\
SolutionsXHelp[] opens the SolutionsX guide page in the Documentation Center:\
\
\>", "MathCaption",
 CellID->1361,ExpressionUUID->"dfb481c1-197b-417f-8118-f2e821ab3b29"],

Cell[BoxData[
 RowBox[{"SolutionsXHelp", "[", "]"}]], "Input",
 CellLabel->"In[5]:=",
 CellID->1362,ExpressionUUID->"8feaef56-6b02-4e5f-8653-291fd7191289"]
}, Open  ]],

