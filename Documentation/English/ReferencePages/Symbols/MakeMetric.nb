Cell["MakeMetric", "ObjectName",
 CellID->1038,ExpressionUUID->"a513edec-5416-4d70-8137-8b43c3217dda"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"2578161c-a433-496f-acb1-c3213f1703c3"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["MakeMetric"]], 
     "paclet:VasilDimitrov/SolutionsX/ref/MakeMetric", 
     "VasilDimitrov Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["chart", "TI"], "]", "[", 
   StyleBox["array", "TI"], "]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "360f4794-701d-4037-a924-16b2f3d177e5"],
 "\[LineSeparator]gives the line element of the symmetric matrix ",
 Cell[BoxData[
  StyleBox["array", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "c6df1e34-0307-4744-a1aa-2a12ef7c290c"],
 " in ",
 Cell[BoxData[
  StyleBox["chart", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "976cc616-4461-453a-a2a2-6baf76f9cf8a"],
 ", as a sum of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CircleTimes"]], "paclet:ref/CircleTimes"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "af485dc3-e374-4e8d-ba77-befcec500f37"],
 " of coordinate differentials."
}], "Usage",
 CellID->1039,ExpressionUUID->"fe1ee1a2-6d42-440d-bfd3-95707620dcb7"],

Cell["\<\
MakeMetric[chart][array] gives Sum[array[[i,j]] Diff[x_i] CircleTimes \
Diff[x_j]] over the coordinates of chart.\
\>", "Notes",
 CellID->1040,ExpressionUUID->"fa74d1cb-470b-4c77-9181-d52b495ef532"],

Cell["\<\
array must be square of side the number of coordinates; otherwise \
MakeMetric::invaliddimension is issued and $Failed thrown.\
\>", "Notes",
 CellID->1041,ExpressionUUID->"79bf534a-7c05-406c-adf6-667d7c3ae471"],

Cell["\<\
Only the symmetric part of array survives, since MakeArray symmetrises when \
reading a line element back.\
\>", "Notes",
 CellID->1042,ExpressionUUID->"ad610a8b-5e82-4159-9610-c30e7aaa32d1"],

Cell["MakeMetric is the inverse of MakeArray.", "Notes",
 CellID->1043,ExpressionUUID->"2b8e3e40-09e5-4d3e-95cc-abf016057cb4"]
}, Open  ]],

