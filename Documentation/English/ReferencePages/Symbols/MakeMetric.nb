Cell["MakeMetric", "ObjectName",
 CellID->1052,ExpressionUUID->"63b08b65-fafa-4b38-9cf4-c7919cb79019"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"f8906d68-6689-416a-af49-fc87bfab01e6"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["MakeMetric"]], 
     "paclet:VasilDimitrov/SolutionsX/ref/MakeMetric", 
     "VasilDimitrov Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["chart", "TI"], "]", "[", 
   StyleBox["array", "TI"], "]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "2e961c09-d27a-49cc-9e34-843bbdb2846d"],
 "\[LineSeparator]gives the line element of the symmetric matrix ",
 Cell[BoxData[
  StyleBox["array", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "2adb6820-e297-47fb-86ea-3a355af18004"],
 " in ",
 Cell[BoxData[
  StyleBox["chart", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "8ec2b0a9-9c44-4fe7-b7ef-c660682c9945"],
 ", as a sum of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CircleTimes"]], "paclet:ref/CircleTimes"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "c6b7b3d6-f21b-4ce8-a467-9ea29cdb86b7"],
 " of coordinate differentials."
}], "Usage",
 CellID->1053,ExpressionUUID->"a5312f9f-341a-4171-b79b-0d6d9c852183"],

Cell["\<\
MakeMetric[chart][array] gives Sum[array[[i,j]] Diff[x_i] CircleTimes \
Diff[x_j]] over the coordinates of chart.\
\>", "Notes",
 CellID->1054,ExpressionUUID->"a8ecc083-5dba-4ccc-9631-0095d1bd6415"],

Cell["\<\
array must be square of side the number of coordinates; otherwise \
MakeMetric::invaliddimension is issued and $Failed thrown.\
\>", "Notes",
 CellID->1055,ExpressionUUID->"a899f82c-5c59-4fd9-9c4c-dfdbaaec5a0a"],

Cell["\<\
Only the symmetric part of array survives, since MakeArray symmetrises when \
reading a line element back.\
\>", "Notes",
 CellID->1056,ExpressionUUID->"ab2e675c-7894-4928-9d0a-e8377dfd55d9"],

Cell["MakeMetric is the inverse of MakeArray.", "Notes",
 CellID->1057,ExpressionUUID->"f07210ac-03ea-42ae-9f62-110b27cc4e94"]
}, Open  ]],

