Cell["SetCurator", "ObjectName",
 CellID->128,ExpressionUUID->"1ff13e26-03ca-4759-bd2d-1703ad92aea0"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"5ab94d0e-6871-4c4e-8b18-5038dc834c90"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["SetCurator"]], 
     "paclet:VasilDimitrov/SolutionsX/ref/SetCurator", 
     "VasilDimitrov Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   TemplateBox[{
     Cell[
      TextData["True"]], "paclet:ref/True"},
    "RefLink",
    BaseStyle->{"InlineFormula"}], "]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "65140645-7e2d-4b4c-8382-3bf7e1b4f40f"],
 "\[LineSeparator]marks this user as the curator of the Curated corpus and \
records it in the user configuration file; ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["SetCurator"]], 
    "paclet:VasilDimitrov/SolutionsX/ref/SetCurator", 
    "VasilDimitrov Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "60437a97-20cd-4867-a124-6c6c0cb01759"],
 "[",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["False"]], "paclet:ref/False"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "11e9ede7-365c-43d9-a644-43a4eef47cb3"],
 "] removes the mark.\n",
 Cell["   ", "ModInfo",ExpressionUUID->"3f758c7e-237f-4838-b800-e46305e31ef9"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["SetCurator"]], 
     "paclet:VasilDimitrov/SolutionsX/ref/SetCurator", 
     "VasilDimitrov Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["flag", "TI"], 
   RowBox[{
    RowBox[{",", " ", 
     RowBox[{"Permanent", "->", "False"}]}], "]"}]}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "c62fd6e0-4428-4c71-a064-4bc5f2a5257e"],
 "\[LineSeparator]sets it for this session only."
}], "Usage",
 CellID->129,ExpressionUUID->"783c5248-8a1e-485a-9688-b00ca6da97a2"],

Cell["\<\
SetCurator must be given True or False. Anything else issues \
SetCurator::invalid and throws $Failed.\
\>", "Notes",
 CellID->130,ExpressionUUID->"366846b8-f80d-4eae-9ae0-4569a821e1bd"],

Cell["\<\
By default the mark is recorded in the user configuration file and restored \
by every later session; Permanent -> False sets it for this session only.\
\>", "Notes",
 CellID->131,ExpressionUUID->"4fd33fff-88f4-4c28-94f4-9c480edb72c7"],

Cell[TextData[{
 "The mark unlocks ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CurateData"]], 
    "paclet:VasilDimitrov/SolutionsX/ref/CurateData", 
    "VasilDimitrov Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "018c0f93-7b34-41ff-9125-4bd9b2e79fed"],
 " and working under the Curated alias (SetAlias[\"Curated\"], session-only, \
identity from the configuration). The Data status line shows [curator] while \
it is set."
}], "Notes",
 CellID->132,ExpressionUUID->"cef24d36-58e2-4cad-a9e3-455e136423f3"],

Cell["\<\
The mark is a latch against accidental publication, not access control: \
publishing to the repository requires push rights regardless.\
\>", "Notes",
 CellID->133,ExpressionUUID->"63e15373-779d-4912-9420-c431fe37016c"]
}, Open  ]],

