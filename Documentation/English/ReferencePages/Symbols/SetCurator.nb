Cell[CellGroupData[{

Cell["SetCurator", "ObjectName",
 CellID->125,ExpressionUUID->"9f36d775-9c75-437d-b33e-3c297f51ee32"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"380a0e80-605d-4efb-97e3-affd128abdd3"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["SetCurator"]], 
     "paclet:VasilDimitrov/SolutionsX/ref/SetCurator", 
     "VasilDimitrov Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   TemplateBox[{
     Cell[
      TextData["True"]], "paclet:ref/True"},
    "RefLink",
    BaseStyle->{"InlineFormula"}], "]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "a043982e-55fd-4236-9c2e-0083a618f8b7"],
 "\[LineSeparator]marks this user as the curator of the Curated corpus and \
records it in the user configuration file; ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["SetCurator"]], 
    "paclet:VasilDimitrov/SolutionsX/ref/SetCurator", 
    "VasilDimitrov Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "d2e972bf-5071-4a49-b543-eefc88f7f25a"],
 "[",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["False"]], "paclet:ref/False"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "8e79056c-1e8f-418b-ba6a-fc61b0ab9dc1"],
 "] removes the mark.\n",
 Cell["   ", "ModInfo",ExpressionUUID->"a582547d-20ab-48fe-8c9b-82f6197b7643"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["SetCurator"]], 
     "paclet:VasilDimitrov/SolutionsX/ref/SetCurator", 
     "VasilDimitrov Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["flag", "TI"], 
   RowBox[{
    RowBox[{",", " ", 
     RowBox[{"Permanent", "->", "False"}]}], "]"}]}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "976efdd9-16da-4eda-81e7-67e3400a48b6"],
 "\[LineSeparator]sets it for this session only."
}], "Usage",
 CellID->126,ExpressionUUID->"63504307-f655-4c18-9c73-0857148b3994"],

Cell["\<\
SetCurator must be given True or False. Anything else issues \
SetCurator::invalid and throws $Failed.\
\>", "Notes",
 CellID->127,ExpressionUUID->"b60fae94-c81e-4b8e-9cea-f06b5afb52d3"],

Cell["\<\
By default the mark is recorded in the user configuration file and restored \
by every later session; Permanent -> False sets it for this session only.\
\>", "Notes",
 CellID->128,ExpressionUUID->"75af0572-979b-4304-bfde-e6d3374efc12"],

Cell[TextData[{
 "The mark unlocks ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CurateData"]], 
    "paclet:VasilDimitrov/SolutionsX/ref/CurateData", 
    "VasilDimitrov Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "4e33c346-06cb-4e0c-bd8b-567e8ffa537b"],
 " and working under the Curated alias (SetAlias[\"Curated\"], session-only, \
identity from the configuration). The Data status line shows [curator] while \
it is set."
}], "Notes",
 CellID->129,ExpressionUUID->"29875630-63f0-4233-9644-485b6a902fee"],

Cell["\<\
The mark is a latch against accidental publication, not access control: \
publishing to the repository requires push rights regardless.\
\>", "Notes",
 CellID->130,ExpressionUUID->"4c50bfd4-bee9-485c-891b-1416e2d20553"]
}, Open  ]],

