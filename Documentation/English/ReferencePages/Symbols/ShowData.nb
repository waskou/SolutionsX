Cell[CellGroupData[{

Cell["ShowData", "ObjectName",
 CellID->791,ExpressionUUID->"20637118-1fbc-4c1d-a97c-53346a24b58e"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"5fda6f9c-d4be-45f9-a195-4b6d236fdfc6"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["ShowData"]], "paclet:VasilDimitrov/SolutionsX/ref/ShowData", 
     "VasilDimitrov Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", "]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "faee0ef3-16d1-4659-9b35-ffa2d5e61d7f"],
 "\[LineSeparator]displays an interactive browser of the data tree: one \
button per alias \[LongDash] your own first, marked with a pencil \[LongDash] \
and the entries of the chosen alias with their ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["OpenData"]], "paclet:VasilDimitrov/SolutionsX/ref/OpenData", 
    "VasilDimitrov Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "ff153909-2765-402d-b01b-b6d822609bef"],
 ", CopyName, ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CopyData"]], "paclet:VasilDimitrov/SolutionsX/ref/CopyData", 
    "VasilDimitrov Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "4b0a1b05-c51d-4a44-893a-bbacef8874a8"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DeleteData"]], 
    "paclet:VasilDimitrov/SolutionsX/ref/DeleteData", 
    "VasilDimitrov Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "1401e50a-5c3d-4654-ac69-564887d594a2"],
 " actions.\n",
 Cell["   ", "ModInfo",ExpressionUUID->"615f07ef-d5b0-46d4-9436-00b4adce6302"],
 "Every entry shows the name ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["GetData"]], "paclet:VasilDimitrov/SolutionsX/ref/GetData", 
    "VasilDimitrov Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "7e27902e-24d8-4f92-8b30-99bdffd7ba7d"],
 " takes, and CopyName copies it as a quoted string, ready to paste. The \
search field filters across every alias as you type. Without a front end \
ShowData[] prints the same tree as text."
}], "Usage",
 CellID->792,ExpressionUUID->"facbd040-35c2-49e8-84a4-32149fe0759e"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["ShowData"]], "paclet:VasilDimitrov/SolutionsX/ref/ShowData", 
    "VasilDimitrov Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "0982399a-f385-42ff-9523-b403a2571ec5"],
 "[] displays a browser panel of the data tree: one button per alias \
\[LongDash] your own first, permanently marked with a pencil \[LongDash] and \
the entries of the chosen alias with their ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["OpenData"]], "paclet:VasilDimitrov/SolutionsX/ref/OpenData", 
    "VasilDimitrov Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "bf92739a-d568-4e13-9110-21ac5c50e128"],
 ", CopyName, ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CopyData"]], "paclet:VasilDimitrov/SolutionsX/ref/CopyData", 
    "VasilDimitrov Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "03c6a1ef-810a-421e-a94b-d2097509e1b9"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DeleteData"]], 
    "paclet:VasilDimitrov/SolutionsX/ref/DeleteData", 
    "VasilDimitrov Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "12f06d2a-e34a-406e-ae2b-f21e37533308"],
 " actions."
}], "Notes",
 CellID->793,ExpressionUUID->"1b9160b0-a8b4-4194-b232-3151d7006e73"],

Cell[TextData[{
 "Every entry shows exactly the name ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["GetData"]], "paclet:VasilDimitrov/SolutionsX/ref/GetData", 
    "VasilDimitrov Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "c5e3a308-91c4-403b-bec9-016a62e7faa5"],
 " takes \[LongDash] bare under your own alias, \"",
 Cell[BoxData[
  StyleBox["alias", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "b831fa6e-7616-4b0e-973c-bbfd9f668854"],
 "/",
 Cell[BoxData[
  StyleBox["name", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "4e45cd93-2d8b-460d-a70b-82b112eafd1a"],
 "\" elsewhere \[LongDash] and CopyName copies it as a quoted string, ready \
to paste into ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["GetData"]], "paclet:VasilDimitrov/SolutionsX/ref/GetData", 
    "VasilDimitrov Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "e57ccf7b-10cb-4651-9bf8-b787ba314b39"],
 "."
}], "Notes",
 CellID->794,ExpressionUUID->"215cba60-a5c2-4d84-9ef1-77cb366bb3a8"],

Cell[TextData[{
 "Each button is enabled exactly where the verb itself would act: ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CopyData"]], "paclet:VasilDimitrov/SolutionsX/ref/CopyData", 
    "VasilDimitrov Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "4527e01d-9d00-451a-9d57-d6e6b27b3699"],
 " on foreign entries only, ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DeleteData"]], 
    "paclet:VasilDimitrov/SolutionsX/ref/DeleteData", 
    "VasilDimitrov Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "94caf1fc-70b0-4e84-8de7-c344b7676ad0"],
 " on your own only (with a confirmation the bare verb does not have), and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CurateData"]], 
    "paclet:VasilDimitrov/SolutionsX/ref/CurateData", 
    "VasilDimitrov Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "5801a9a9-7b96-4c10-be5e-568a87471c6c"],
 " appears for curators."
}], "Notes",
 CellID->795,ExpressionUUID->"a7bb24aa-be72-41b8-903c-29b2a6468a31"],

Cell[TextData[{
 "The Curated corpus bundled with the paclet is listed even when the data \
tree has no Curated alias, marked \"(bundled)\"; only ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CopyData"]], "paclet:VasilDimitrov/SolutionsX/ref/CopyData", 
    "VasilDimitrov Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "9d3447e9-fc97-4a0a-8d99-ca50459ef617"],
 " is live on bundled entries."
}], "Notes",
 CellID->796,ExpressionUUID->"58b4b9e1-ecef-4658-b394-f6c5b67e356b"],

Cell["\<\
The search field filters across every alias as you type, on \
whitespace-separated case-insensitive fragments.\
\>", "Notes",
 CellID->797,ExpressionUUID->"0e68b703-8e4e-434e-a269-286d03fe8da3"],

Cell["\<\
Without a front end ShowData[] prints the same tree as text \[LongDash] never \
a silent no-op.\
\>", "Notes",
 CellID->798,ExpressionUUID->"ed775c6a-82d3-4ddd-9265-b4e989d166ed"]
}, Open  ]],

