    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["symbol", "TI"], "]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "a1a8ef56-7ea3-408f-996d-0a417de55c39"],
 "\[LineSeparator]rebinds any symbol removed by an xAct Undef, by \
round-tripping ",
 Cell[BoxData[
  StyleBox["symbol", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "417ac5ec-bd0d-4888-9762-5de1964908f5"],
 " through ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Compress"]], "paclet:ref/Compress"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "d496143d-5656-44b6-bf57-c9c688099e3d"],
 " and replacing Removed[",
 Cell[BoxData[
  StyleBox["name", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "da6bb1d2-4628-423c-9289-73552bce1242"],
 "] by ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Symbol"]], "paclet:ref/Symbol"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "0a35f808-df9b-41ac-9b4b-c9b029fa1373"],
 "[",
 Cell[BoxData[
  StyleBox["name", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "a6335471-ff24-45e6-9b4f-2cbcf8402da6"],
 "]."
}], "Usage",
 CellID->605,ExpressionUUID->"96f537a3-6e12-48f2-a4f5-ee741c982226"],

Cell["\<\
xAct's Undef functions Remove the symbols they undefine, rather than merely \
clearing them. Every reference held elsewhere then reads Removed[\"name\"].\
\>", "Notes",
 CellID->606,ExpressionUUID->"ae65cd63-7dd7-4278-89aa-1b962bb68bf9"],

Cell["\<\
Resurrect[symbol] round-trips symbol through Compress and Uncompress and \
replaces each Removed[\"name\"] by Symbol[\"name\"], rebinding it to a fresh \
symbol of the same name.\
\>", "Notes",
 CellID->607,ExpressionUUID->"0e90a459-05c0-4eec-b238-5339c572f96d"],

Cell["\<\
Revive does this throughout a whole solution, and is called after every \
unload.\
\>", "Notes",
 CellID->608,ExpressionUUID->"3fed5312-6c47-4813-9ee6-7adff8cd4c3b"],

Cell["Resurrect has the attribute HoldFirst.", "Notes",
 CellID->609,ExpressionUUID->"0cd6d76f-76cf-49fc-a134-beabb05a330a"]
}, Open  ]],

