Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"8723475c-96c5-41e1-b24b-0ff20d456104"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["Resurrect"]], "paclet:VasilDimitrov/SolutionsX/ref/Resurrect",
