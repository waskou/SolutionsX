Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"efe4dfbf-da72-4613-b7aa-da202798d3c6"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["Resurrect"]], "paclet:VasilDimitrov/SolutionsX/ref/Resurrect",
      "VasilDimitrov Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["symbol", "TI"], "]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "9bd32c00-47e6-46eb-ab32-f9fb775d5817"],
 "\[LineSeparator]rebinds any symbol removed by an xAct Undef, by \
round-tripping ",
 Cell[BoxData[
  StyleBox["symbol", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "f9073110-99f8-497a-8476-7a1c6e5595a7"],
 " through ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Compress"]], "paclet:ref/Compress"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "fd7168d0-979c-47ac-a109-4f8df13e1047"],
 " and replacing Removed[",
 Cell[BoxData[
  StyleBox["name", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "e75212ce-0138-4a47-9d7e-7cff91ebadb0"],
 "] by ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Symbol"]], "paclet:ref/Symbol"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "f3751d9a-ee69-4c03-9baa-90a723295882"],
 "[",
 Cell[BoxData[
  StyleBox["name", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "66d6133c-b94b-4966-a232-531e044957a4"],
 "]."
}], "Usage",
 CellID->586,ExpressionUUID->"07465c08-c5ab-46bf-8758-1d959dd00ecc"],

Cell["\<\
xAct's Undef functions Remove the symbols they undefine, rather than merely \
clearing them. Every reference held elsewhere then reads Removed[\"name\"].\
\>", "Notes",
 CellID->587,ExpressionUUID->"9b8a100a-4ce3-4eea-865d-e4c1e1b8abb6"],

Cell["\<\
Resurrect[symbol] round-trips symbol through Compress and Uncompress and \
replaces each Removed[\"name\"] by Symbol[\"name\"], rebinding it to a fresh \
symbol of the same name.\
\>", "Notes",
 CellID->588,ExpressionUUID->"c9a8a66a-17e3-4c49-b280-eec9ad577edb"],

Cell["\<\
Revive does this throughout a whole solution, and is called after every \
unload.\
\>", "Notes",
 CellID->589,ExpressionUUID->"b9570bf6-1197-4a9e-bafd-7f9caa2b656f"],

Cell["Resurrect has the attribute HoldFirst.", "Notes",
 CellID->590,ExpressionUUID->"423ca4d1-d164-4997-a4a5-a41e43d534b4"]
}, Open  ]],

