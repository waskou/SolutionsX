 CellID->1236,ExpressionUUID->"ad58e2b2-6586-47eb-8d32-84f8f70a7455"],

Cell["\<\
Gen[sol[$function, key]] gives the rule sending the scalar function key to \
its stored Expression, as a Function of the arguments, ready to use with \
ReplaceAll.\
\>", "Notes",
 CellID->1237,ExpressionUUID->"b48151b6-45d6-45cb-b654-aef59203a4d0"],

Cell["\<\
Gen[sol[$form, key]] gives the rule sending the form's Symbol to its stored \
Expression.\
\>", "Notes",
 CellID->1238,ExpressionUUID->"da85ecc7-ffba-4819-8eaf-59f0dc0f2f7f"],

Cell["\<\
Gen[sol[$rule, key]] gives the stored Expression of the rule entry key, which \
is often a FoldedRule collecting several Gen results in the order they must \
be applied.\
\>", "Notes",
 CellID->1239,ExpressionUUID->"f62881c3-b8a9-4d6b-844a-6d78be3a031b"],

Cell["\<\
Gen gives {} when the entry is absent, so it can be applied unconditionally. \
This is why a theory can write Gen[$self[$rule, $form]] into a Chain before \
any such rule exists, and have it become meaningful only once a solution \
supplies one.\
\>", "Notes",
 CellID->1240,ExpressionUUID->"2f85f7b0-2f41-4434-9d01-7dd29f0e7992"],

Cell["Gen has the attribute HoldFirst.", "Notes",
 CellID->1241,ExpressionUUID->"dd9328d7-b910-4079-950e-556f10092ff4"]
}, Open  ]],

