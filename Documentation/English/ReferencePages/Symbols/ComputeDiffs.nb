Cell[BoxData[
 RowBox[{
  RowBox[{"IncludeTo", "[", 
   RowBox[{
    RowBox[{"sol", "[", "$manifold", "]"}], ",", " ", 
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"Symbol", " ", "->", " ", "M"}], ",", " ", 
      RowBox[{"Dimension", " ", "->", " ", "2"}], ",", " ", 
      RowBox[{"Index", " ", "->", " ", 
       RowBox[{"{", 
        RowBox[{"a", ",", " ", "b", ",", " ", "c", ",", " ", "d"}], "}"}]}], 
      ",", " ", 
      RowBox[{"Name", " ", "->", " ", "\"\<Sphere\>\""}]}], "|>"}]}], "]"}], 
  ";"}]], "Input",
 CellLabel->"In[ ]:=",
 CellID->1223,ExpressionUUID->"c564443a-bd82-455f-879e-44d9db90eba0"],

Cell[BoxData[
 RowBox[{
  RowBox[{"IncludeTo", "[", 
   RowBox[{
    RowBox[{"sol", "[", "$chart", "]"}], ",", " ", 
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"Symbol", " ", "->", " ", "ch"}], ",", " ", 
      RowBox[{"Manifold", " ", "->", " ", "M"}], ",", " ", 
      RowBox[{"CNumbersOf", " ", "->", " ", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "2"}], "}"}]}], ",", " ", 
      RowBox[{"ScalarsOfChart", " ", "->", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"\[Theta]", "[", "]"}], ",", " ", 
         RowBox[{"\[Phi]", "[", "]"}]}], "}"}]}], ",", " ", 
      RowBox[{"Name", " ", "->", " ", "\"\<Polar\>\""}]}], "|>"}]}], "]"}], 
  ";"}]], "Input",
 CellLabel->"In[ ]:=",
 CellID->1224,ExpressionUUID->"8cd3259e-f75f-4710-a4f7-120acc33e233"],

Cell[BoxData[
 RowBox[{
  RowBox[{"IncludeTo", "[", 
   RowBox[{
    RowBox[{"sol", "[", "$metric", "]"}], ",", " ", 
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"Signature", " ", "->", " ", "1"}], ",", " ", 
      RowBox[{"Symbol", " ", "->", " ", 
       RowBox[{"gg", "[", 
        RowBox[{
         RowBox[{"-", "a"}], ",", " ", 
         RowBox[{"-", "b"}]}], "]"}]}], ",", " ", 
      RowBox[{"CovD", " ", "->", " ", "cd"}], ",", " ", 
      RowBox[{"SymbolOfCovD", " ", "->", " ", 
       RowBox[{"{", 
        RowBox[{"\"\<;\>\"", ",", " ", "\"\<\[Del]\>\""}], "}"}]}]}], 
     "|>"}]}], "]"}], ";"}]], "Input",
 CellLabel->"In[ ]:=",
 CellID->1225,ExpressionUUID->"80f41053-49e3-459a-b338-0d29cad28f35"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"sol", "[", 
    RowBox[{"$metric", ",", " ", "gg", ",", " ", "Expression"}], "]"}], " ", 
   "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"Diff", "[", 
      RowBox[{"\[Theta]", "[", "]"}], "]"}], " ", "\[CircleTimes]", " ", 
     RowBox[{"Diff", "[", 
      RowBox[{"\[Theta]", "[", "]"}], "]"}]}], " ", "+", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"Sin", "[", 
       RowBox[{"\[Theta]", "[", "]"}], "]"}], "^", "2"}], " ", 
     RowBox[{
      RowBox[{"Diff", "[", 
       RowBox[{"\[Phi]", "[", "]"}], "]"}], " ", "\[CircleTimes]", " ", 
      RowBox[{"Diff", "[", 
       RowBox[{"\[Phi]", "[", "]"}], "]"}]}]}]}]}], ";"}]], "Input",
 CellLabel->"In[ ]:=",
 CellID->1226,ExpressionUUID->"d643c836-0651-48e5-9d76-6fbcd7564e12"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"sol", "[", 
    RowBox[{
    "$metric", ",", " ", "gg", ",", " ", "$auto", ",", " ", "gg", ",", " ", 
     "Routine", ",", " ", "Chain"}], "]"}], " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"HoldForm", "[", 
       RowBox[{"MakeArray", "[", 
        RowBox[{"$self", "[", 
         RowBox[{"$metric", ",", " ", "gg", ",", " ", "Expression"}], "]"}], 
        "]"}], "]"}], " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "1"}], ",", " ", 
         RowBox[{"-", "1"}]}], "}"}], "}"}]}], ",", " ", 
     RowBox[{
      RowBox[{"HoldForm", "[", 
       RowBox[{"Inverse", "[", 
        RowBox[{"ToArray", "[", 
         RowBox[{"gg", "[", 
          RowBox[{
           RowBox[{"-", "a"}], ",", " ", 
           RowBox[{"-", "b"}]}], "]"}], "]"}], "]"}], "]"}], " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "1"}], "}"}], "}"}]}]}], "}"}]}], 
  ";"}]], "Input",
 CellLabel->"In[ ]:=",
 CellID->1227,ExpressionUUID->"d4ac7049-28b1-4d46-ae92-68cbb3c5b996"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"sol", "[", 
    RowBox[{
    "$metric", ",", " ", "gg", ",", " ", "$auto", ",", " ", "Detgg", ",", " ",
      "Routine", ",", " ", "Chain"}], "]"}], " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"HoldForm", "[", 
      RowBox[{"Det", "[", 
