Cell[BoxData[
 RowBox[{
  RowBox[{"IncludeTo", "[", 
   RowBox[{
    RowBox[{"sol", "[", "$manifold", "]"}], ",", " ", 
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"Symbol", " ", "->", " ", "M"}], ",", " ", 
      RowBox[{"Dimension", " ", "->", " ", "2"}], ",", " ", 
      RowBox[{"Index", " ", "->", " ", 
       RowBox[{"{", 
        RowBox[{"a", ",", " ", "b", ",", " ", "c", ",", " ", "d"}], "}"}]}], 
      ",", " ", 
      RowBox[{"Name", " ", "->", " ", "\"\<Sphere\>\""}]}], "|>"}]}], "]"}], 
  ";"}]], "Input",
 CellLabel->"In[ ]:=",
 CellID->1209,ExpressionUUID->"61240825-4974-4bb3-bca6-57be1489a737"],

Cell[BoxData[
 RowBox[{
  RowBox[{"IncludeTo", "[", 
   RowBox[{
    RowBox[{"sol", "[", "$chart", "]"}], ",", " ", 
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"Symbol", " ", "->", " ", "ch"}], ",", " ", 
      RowBox[{"Manifold", " ", "->", " ", "M"}], ",", " ", 
      RowBox[{"CNumbersOf", " ", "->", " ", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "2"}], "}"}]}], ",", " ", 
      RowBox[{"ScalarsOfChart", " ", "->", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"\[Theta]", "[", "]"}], ",", " ", 
         RowBox[{"\[Phi]", "[", "]"}]}], "}"}]}], ",", " ", 
      RowBox[{"Name", " ", "->", " ", "\"\<Polar\>\""}]}], "|>"}]}], "]"}], 
  ";"}]], "Input",
 CellLabel->"In[ ]:=",
 CellID->1210,ExpressionUUID->"aeb47bfd-4a28-456c-9639-cc992bd81647"],

Cell[BoxData[
 RowBox[{
  RowBox[{"IncludeTo", "[", 
   RowBox[{
    RowBox[{"sol", "[", "$metric", "]"}], ",", " ", 
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"Signature", " ", "->", " ", "1"}], ",", " ", 
      RowBox[{"Symbol", " ", "->", " ", 
       RowBox[{"gg", "[", 
        RowBox[{
         RowBox[{"-", "a"}], ",", " ", 
         RowBox[{"-", "b"}]}], "]"}]}], ",", " ", 
      RowBox[{"CovD", " ", "->", " ", "cd"}], ",", " ", 
      RowBox[{"SymbolOfCovD", " ", "->", " ", 
       RowBox[{"{", 
        RowBox[{"\"\<;\>\"", ",", " ", "\"\<\[Del]\>\""}], "}"}]}]}], 
     "|>"}]}], "]"}], ";"}]], "Input",
 CellLabel->"In[ ]:=",
 CellID->1211,ExpressionUUID->"b02702c5-ed11-4731-bbac-314b18c24d2d"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"sol", "[", 
    RowBox[{"$metric", ",", " ", "gg", ",", " ", "Expression"}], "]"}], " ", 
   "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"Diff", "[", 
      RowBox[{"\[Theta]", "[", "]"}], "]"}], " ", "\[CircleTimes]", " ", 
     RowBox[{"Diff", "[", 
      RowBox[{"\[Theta]", "[", "]"}], "]"}]}], " ", "+", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"Sin", "[", 
       RowBox[{"\[Theta]", "[", "]"}], "]"}], "^", "2"}], " ", 
     RowBox[{
      RowBox[{"Diff", "[", 
       RowBox[{"\[Phi]", "[", "]"}], "]"}], " ", "\[CircleTimes]", " ", 
      RowBox[{"Diff", "[", 
       RowBox[{"\[Phi]", "[", "]"}], "]"}]}]}]}]}], ";"}]], "Input",
 CellLabel->"In[ ]:=",
 CellID->1212,ExpressionUUID->"d1962c01-1e4d-4927-b833-ccba150cb5fb"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"sol", "[", 
    RowBox[{
    "$metric", ",", " ", "gg", ",", " ", "$auto", ",", " ", "gg", ",", " ", 
     "Routine", ",", " ", "Chain"}], "]"}], " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"HoldForm", "[", 
       RowBox[{"MakeArray", "[", 
        RowBox[{"$self", "[", 
         RowBox[{"$metric", ",", " ", "gg", ",", " ", "Expression"}], "]"}], 
        "]"}], "]"}], " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "1"}], ",", " ", 
         RowBox[{"-", "1"}]}], "}"}], "}"}]}], ",", " ", 
     RowBox[{
      RowBox[{"HoldForm", "[", 
       RowBox[{"Inverse", "[", 
        RowBox[{"ToArray", "[", 
         RowBox[{"gg", "[", 
          RowBox[{
           RowBox[{"-", "a"}], ",", " ", 
           RowBox[{"-", "b"}]}], "]"}], "]"}], "]"}], "]"}], " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "1"}], "}"}], "}"}]}]}], "}"}]}], 
  ";"}]], "Input",
 CellLabel->"In[ ]:=",
 CellID->1213,ExpressionUUID->"0da3da9c-39a4-443f-85aa-25b72072d8c4"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"sol", "[", 
