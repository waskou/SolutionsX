          RowBox[{"-", "a"}], ",", " ", 
          RowBox[{"-", "b"}]}], "]"}], "]"}], "]"}], "]"}], " ", "->", " ", 
     RowBox[{"{", "}"}]}], "}"}]}], ";"}]], "Input",
 CellLabel->"In[ ]:=",
 CellID->1228,ExpressionUUID->"07234050-2d02-4b89-809d-c9238ff23147"],

