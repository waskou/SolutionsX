Cell[CellGroupData[{

Cell["ComputeDiffs", "ObjectName",
 CellID->1212,ExpressionUUID->"06da5bdf-62ae-4176-b223-908ab0dbc092"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"ed7da94a-99ff-447d-aa8e-202911ff9cfc"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["ComputeDiffs"]], 
     "paclet:VasilDimitrov/SolutionsX/ref/ComputeDiffs", 
     "VasilDimitrov Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["chart", "TI"], "]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "13ba42e9-6175-4532-844c-e593252bbb25"],
 "\[LineSeparator]installs the rules that canonicalise, and annihilate \
repeated, wedge products of the coordinate differentials of ",
 Cell[BoxData[
  StyleBox["chart", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "074c659d-12a7-400f-813c-6b8d7e1d5af9"],
 "."
}], "Usage",
 CellID->1213,ExpressionUUID->"11784210-28ae-4d80-a45d-81c7d545d189"],

Cell["\<\
ComputeDiffs[chart] defines rules that reorder every wedge product of the \
coordinate differentials of chart into canonical order, and that send to zero \
any wedge in which a differential is repeated.\
\>", "Notes",
 CellID->1214,ExpressionUUID->"efa60ddb-1fb2-447c-832a-8f9aa261ef54"],

Cell["\<\
Including a chart already installs the vanishing rule; ComputeDiffs adds the \
reordering rules as well.\
\>", "Notes",
 CellID->1215,ExpressionUUID->"12385454-21ab-4416-a0b8-d0254d7e1fc1"],

Cell["\<\
The rules are installed from the highest degree downwards, so that longer \
products are matched first.\
\>", "Notes",
 CellID->1216,ExpressionUUID->"596191bb-5cb4-4fac-96d7-9a632eeb4e1d"],

Cell["\<\
The rules are global definitions on Wedge, not properties of the solution, \
and are not removed by Unload.\
\>", "Notes",
 CellID->1217,ExpressionUUID->"6c346db2-560e-42ad-afd3-085885d200b1"]
}, Open  ]],

