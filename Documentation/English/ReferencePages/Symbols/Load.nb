Cell["Load", "ObjectName",
 CellID->488,ExpressionUUID->"c0bb3887-8276-4245-8329-bba0eb6062a1"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"e9e7443a-093d-459e-b731-52556249f391"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["Load"]], "paclet:VasilDimitrov/SolutionsX/ref/Load", 
     "VasilDimitrov Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["sol", "TI"], "]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "3b516682-caed-4609-926c-c8e9702b33d7"],
 "\[LineSeparator]installs the UpValues of ",
 Cell[BoxData[
  StyleBox["sol", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "5020377d-47a7-4d62-a59e-f44c0038e22b"],
 ", then makes the xAct definitions of every entry it holds.\n",
 Cell["   ", "ModInfo",ExpressionUUID->"f3543f98-ffd5-48ab-9af0-d14bac9be86b"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["Load"]], "paclet:VasilDimitrov/SolutionsX/ref/Load", 
     "VasilDimitrov Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["sol", "TI"], "[", 
    StyleBox["object", "TI"], "]", ",", 
    StyleBox["key", "TI"]}], "]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "75514c40-7e11-43e9-b230-0d5f8d4903cc"],
 "\[LineSeparator]loads a single entry; a list of keys is also accepted.\n",
 Cell["   ", "ModInfo",ExpressionUUID->"bfce041a-6aa4-4584-8121-78429b6abfb4"],
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Load"]], "paclet:VasilDimitrov/SolutionsX/ref/Load", 
    "VasilDimitrov Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "bde7d27b-8c20-4384-9eba-264af57f9bbc"],
 " is the step that turns an association returned by ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["GetData"]], "paclet:VasilDimitrov/SolutionsX/ref/GetData", 
    "VasilDimitrov Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "a6177628-4b4c-4789-b64f-cb286e1a3b8c"],
 " into live xAct definitions."
}], "Usage",
 CellID->489,ExpressionUUID->"0e8cab35-74dc-4224-b837-865d35d03d9e"],

Cell["\<\
Load[sol] installs the UpValues on sol and then makes the xAct definition of \
every entry it holds, in the order of $Objects. This is the step that turns \
an association returned by GetData into live definitions.\
\>", "Notes",
 CellID->490,ExpressionUUID->"4de287d3-4f23-4e1f-8866-f5af07f133c4"],

Cell["\<\
Load[sol[object], key] loads a single entry, and a list of keys is also \
accepted.\
\>", "Notes",
 CellID->491,ExpressionUUID->"b2f296f6-e0a8-42ea-8180-ca2a62ecb1e4"],

Cell["\<\
GetData followed by Load is the standard way to reopen stored work, and \
SaveData followed by GetData[] and Load is the usual working rhythm: it \
checkpoints the entry and returns the kernel to exactly what was stored.\
\>", "Notes",
 CellID->492,ExpressionUUID->"73c7a5be-f679-45a6-8fb3-21b0eca339ca"],

Cell["\<\
Only one solution can be loaded at a time. Two entries built on the same \
theory share its symbols, so a second one is normally kept unloaded and read \
as data instead.\
\>", "Notes",
 CellID->493,ExpressionUUID->"8ffac378-2af3-4c1c-9adf-1e865f929f6c"],

Cell["Loading releases the held Expression of each metric.", "Notes",
 CellID->494,ExpressionUUID->"1e1150ae-f1c5-4903-8b9f-9f7a1408e737"],

Cell["Load has the attribute HoldFirst.", "Notes",
 CellID->495,ExpressionUUID->"653f2dcf-2c37-4583-b5ea-ba3749f7bd5c"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Examples", "PrimaryExamplesSection",
 CellTags->"PrimaryExamplesSection",
