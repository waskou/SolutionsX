Cell["Load", "ObjectName",
 CellID->507,ExpressionUUID->"f3044474-e3c1-4fa5-9756-58385bb2e5c9"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"7bc2f7df-4060-4739-9d16-2f5c315f919f"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["Load"]], "paclet:VasilDimitrov/SolutionsX/ref/Load", 
     "VasilDimitrov Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["sol", "TI"], "]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "d63c7993-4977-4074-bd4f-f43e019c9741"],
 "\[LineSeparator]installs the UpValues of ",
 Cell[BoxData[
  StyleBox["sol", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "f7596155-256d-4d62-8fbb-dcee1a47457b"],
 ", then makes the xAct definitions of every entry it holds.\n",
 Cell["   ", "ModInfo",ExpressionUUID->"f3d0fc42-9f9b-4582-a2b1-0f01bf4e2ffb"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["Load"]], "paclet:VasilDimitrov/SolutionsX/ref/Load", 
     "VasilDimitrov Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["sol", "TI"], "[", 
    StyleBox["object", "TI"], "]", ",", 
    StyleBox["key", "TI"]}], "]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "f22821d0-b3a1-4cc6-8e0f-ca5fc03a65c3"],
 "\[LineSeparator]loads a single entry; a list of keys is also accepted.\n",
 Cell["   ", "ModInfo",ExpressionUUID->"75bf991d-3a3f-41e8-8593-76f038d6ad71"],
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Load"]], "paclet:VasilDimitrov/SolutionsX/ref/Load", 
    "VasilDimitrov Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "7b4fa995-15b2-453b-a223-0577be3f1f0d"],
 " is the step that turns an association returned by ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["GetData"]], "paclet:VasilDimitrov/SolutionsX/ref/GetData", 
    "VasilDimitrov Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "d2d30d3f-9650-4343-90d3-91139602e5b2"],
 " into live xAct definitions."
}], "Usage",
 CellID->508,ExpressionUUID->"102611b3-64cb-4ea9-9a0c-bd73862ffa89"],

Cell["\<\
Load[sol] installs the UpValues on sol and then makes the xAct definition of \
every entry it holds, in the order of $Objects. This is the step that turns \
an association returned by GetData into live definitions.\
\>", "Notes",
 CellID->509,ExpressionUUID->"aa5a6e93-2d73-4d74-9ff4-8c14cb99a3dd"],

Cell["\<\
Load[sol[object], key] loads a single entry, and a list of keys is also \
accepted.\
\>", "Notes",
 CellID->510,ExpressionUUID->"c26db192-33a6-493a-b0c3-8c336babbecd"],

Cell["\<\
GetData followed by Load is the standard way to reopen stored work, and \
SaveData followed by GetData[] and Load is the usual working rhythm: it \
checkpoints the entry and returns the kernel to exactly what was stored.\
\>", "Notes",
 CellID->511,ExpressionUUID->"46cf5a00-f323-4dc8-b4ab-d59a70ab6033"],

Cell["\<\
Only one solution can be loaded at a time. Two entries built on the same \
theory share its symbols, so a second one is normally kept unloaded and read \
as data instead.\
\>", "Notes",
 CellID->512,ExpressionUUID->"6eb66197-9918-4157-9b62-a628009a2eb3"],

Cell["Loading releases the held Expression of each metric.", "Notes",
 CellID->513,ExpressionUUID->"bbdc18f7-7fb8-4eb7-a56e-ca5b8c51fb76"],

Cell["Load has the attribute HoldFirst.", "Notes",
 CellID->514,ExpressionUUID->"65d2767b-e477-4b30-9244-489afd6e4318"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Examples", "PrimaryExamplesSection",
 CellTags->"PrimaryExamplesSection",
