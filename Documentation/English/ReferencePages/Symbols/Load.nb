Cell["Basic Examples", "ExampleSection",
 CellID->516,ExpressionUUID->"089f7867-7853-45f8-9cc0-6607caa0f229"],

Cell["\<\
A small solution to work with: one constant, live from the moment it is \
included.\
\>", "ExampleText",
 CellID->517,ExpressionUUID->"0b98dd08-a1dc-4f70-b77c-a67ac2ea6d26"],

Cell[BoxData[
 RowBox[{"Instantiate", "[", "sol", "]"}]], "Input",
 CellLabel->"In[ ]:=",
 CellID->518,ExpressionUUID->"2c3b4629-8c04-41cc-a0c5-2165a61c8c74"],

Cell[BoxData[
 RowBox[{"IncludeTo", "[", 
  RowBox[{
   RowBox[{"sol", "[", "$constant", "]"}], ",", " ", 
   RowBox[{"<|", 
    RowBox[{"Symbol", " ", "->", " ", "aa"}], "|>"}]}], "]"}]], "Input",
 CellLabel->"In[ ]:=",
 CellID->519,ExpressionUUID->"e8aba736-bf0f-4f05-931a-8e2846109fa6"],

Cell["\<\
Unload takes the xAct definition down but keeps the description, so aa stops \
being a constant while the solution still remembers how to make it:\
\>", "ExampleText",
 CellID->520,ExpressionUUID->"6229c6ed-df47-4fb3-9111-65d2d9b91d0c"],

Cell[BoxData[
 RowBox[{"Unload", "[", 
  RowBox[{
   RowBox[{"sol", "[", "$constant", "]"}], ",", " ", "aa"}], "]"}]], "Input",
 CellLabel->"In[ ]:=",
 CellID->521,ExpressionUUID->"b46834f2-2f7a-4acf-bebc-aeaca78289c9"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ConstantSymbolQ", "[", "aa", "]"}]], "Input",
 CellLabel->"In[ ]:=",
 CellID->522,ExpressionUUID->"46eefd5e-f82a-4123-9e96-fd2801402e5e"],

Cell[BoxData["False"], "Output",
 CellLabel->"Out[1]=",
 CellID->523,ExpressionUUID->"b25ce71f-5c59-4015-b31f-e22e3c139b81"]
}, Open  ]],

Cell["\<\
Load replays the stored description \[LongDash] the same call IncludeTo made \
originally \[LongDash] and aa is a constant again:\
\>", "ExampleText",
 CellID->524,ExpressionUUID->"185e7745-163e-472c-bbbe-f3e31032df79"],

Cell[BoxData[
 RowBox[{"Load", "[", 
  RowBox[{
   RowBox[{"sol", "[", "$constant", "]"}], ",", " ", "aa"}], "]"}]], "Input",
 CellLabel->"In[ ]:=",
 CellID->525,ExpressionUUID->"d6a552a6-40c6-4829-beb0-a031e30ed3bb"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ConstantSymbolQ", "[", "aa", "]"}]], "Input",
 CellLabel->"In[ ]:=",
 CellID->526,ExpressionUUID->"37567d0e-470e-4b04-ad99-37913fefb886"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]=",
 CellID->527,ExpressionUUID->"4ff48807-67ab-4b7a-abd6-f6b19df07daf"]
}, Open  ]]
}, Open  ]],

