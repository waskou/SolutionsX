Cell["Basic Examples", "ExampleSection",
 CellID->497,ExpressionUUID->"4ab68428-c35d-45dc-895b-b8dbbb4901a7"],

Cell["\<\
A small solution to work with: one constant, live from the moment it is \
included.\
\>", "ExampleText",
 CellID->498,ExpressionUUID->"9b7d12bb-06c4-4894-889b-5327dc6fdbd7"],

Cell[BoxData[
 RowBox[{"Instantiate", "[", "sol", "]"}]], "Input",
 CellLabel->"In[ ]:=",
 CellID->499,ExpressionUUID->"46b3d1d1-8734-4fc1-8772-1148b888b786"],

Cell[BoxData[
 RowBox[{"IncludeTo", "[", 
  RowBox[{
   RowBox[{"sol", "[", "$constant", "]"}], ",", " ", 
   RowBox[{"<|", 
    RowBox[{"Symbol", " ", "->", " ", "aa"}], "|>"}]}], "]"}]], "Input",
 CellLabel->"In[ ]:=",
 CellID->500,ExpressionUUID->"7e159bfd-d2e2-4087-98fd-9687c38504a9"],

Cell["\<\
Unload takes the xAct definition down but keeps the description, so aa stops \
being a constant while the solution still remembers how to make it:\
\>", "ExampleText",
 CellID->501,ExpressionUUID->"722dcac9-6e0e-45ae-bf8d-0cbfbdb5018f"],

Cell[BoxData[
 RowBox[{"Unload", "[", 
  RowBox[{
   RowBox[{"sol", "[", "$constant", "]"}], ",", " ", "aa"}], "]"}]], "Input",
 CellLabel->"In[ ]:=",
 CellID->502,ExpressionUUID->"61e38e99-a65b-42cf-a85b-5f3988a48158"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ConstantSymbolQ", "[", "aa", "]"}]], "Input",
 CellLabel->"In[ ]:=",
 CellID->503,ExpressionUUID->"0546036d-ae8e-4b6c-81e5-88ccfe35dec5"],

Cell[BoxData["False"], "Output",
 CellLabel->"Out[1]=",
 CellID->504,ExpressionUUID->"b39ef2d8-41d0-47c8-b795-f61ff844fd8b"]
}, Open  ]],

Cell["\<\
Load replays the stored description \[LongDash] the same call IncludeTo made \
originally \[LongDash] and aa is a constant again:\
\>", "ExampleText",
 CellID->505,ExpressionUUID->"2f309366-d15e-44ca-8f09-eedc8c164a0e"],

Cell[BoxData[
 RowBox[{"Load", "[", 
  RowBox[{
   RowBox[{"sol", "[", "$constant", "]"}], ",", " ", "aa"}], "]"}]], "Input",
 CellLabel->"In[ ]:=",
 CellID->506,ExpressionUUID->"7fd5a732-669d-4dfa-b321-95a8d4207b92"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ConstantSymbolQ", "[", "aa", "]"}]], "Input",
 CellLabel->"In[ ]:=",
 CellID->507,ExpressionUUID->"bfa0f3f7-8ec0-459d-8667-d994d916ebdc"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]=",
 CellID->508,ExpressionUUID->"d5769bea-fe54-42c2-ae61-6c6b55e34a6e"]
}, Open  ]]
}, Open  ]],

