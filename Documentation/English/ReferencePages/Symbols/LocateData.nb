Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"9c8b01e6-3470-49c2-a975-9116e8b81115"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["LocateData"]], 
     "paclet:VasilDimitrov/SolutionsX/ref/LocateData", 
     "VasilDimitrov Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", "]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "8428fa69-55c5-41aa-9d88-baf79eadc0c1"],
 "\[LineSeparator]points ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["$DataDirectory"]], 
    "paclet:VasilDimitrov/SolutionsX/ref/$DataDirectory", 
    "VasilDimitrov Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "4ef7a136-9238-4211-b857-ffd090d20b4f"],
 " at the data tree containing the current notebook, for this session only, \
then displays the package load panel and the Data status.\n",
 Cell["   ", "ModInfo",ExpressionUUID->"754fae2b-c5fa-42e5-a9ed-20750afd3af0"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["LocateData"]], 
     "paclet:VasilDimitrov/SolutionsX/ref/LocateData", 
     "VasilDimitrov Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["dir", "TI"], "]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "ffb6f36b-b3d0-455a-9167-937ad00aef01"],
 "\[LineSeparator]does the same for an explicit entry directory path.\n",
 Cell["   ", "ModInfo",ExpressionUUID->"ef38b06c-0396-401e-a378-7bec63339359"],
 "It relocates only when the notebook sits inside a Data entry directory (\
\[Ellipsis]/Data/",
 Cell[BoxData[
  StyleBox["alias", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "21ddc686-7b36-46d4-87ce-3de4bb6ec3de"],
 "/",
 Cell[BoxData[
  StyleBox["name", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "f546bc43-1858-4fa6-857c-23fdd974171f"],
 "/) or at a SolutionsX repository root; anywhere else it leaves the \
configured values untouched and just displays them. It is the display line of \
",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["NewData"]], "paclet:VasilDimitrov/SolutionsX/ref/NewData", 
    "VasilDimitrov Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "352a8ff4-e9f4-4db0-8c49-d181882c2f7e"],
 "'s initialization cell."
}], "Usage",
 CellID->225,ExpressionUUID->"c88f4b02-1f13-45af-a6b6-de85f93f79de"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["LocateData"]], 
    "paclet:VasilDimitrov/SolutionsX/ref/LocateData", 
    "VasilDimitrov Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "7f7d6c9e-74b6-46d3-ad6d-502bfa455925"],
 "[] points ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["$DataDirectory"]], 
    "paclet:VasilDimitrov/SolutionsX/ref/$DataDirectory", 
    "VasilDimitrov Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "4e9985b6-2944-4fbc-9d44-f7cc1366b1f8"],
 " at the data tree containing the current notebook, for this session only, \
then displays the package load panel and the Data status line. It is the \
display line of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["NewData"]], "paclet:VasilDimitrov/SolutionsX/ref/NewData", 
    "VasilDimitrov Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "e06b1e4a-f46d-48a7-bd75-3fcfa0cc2a5a"],
 "'s initialization cell."
}], "Notes",
 CellID->226,ExpressionUUID->"e56fef3e-9a51-485c-bf93-566e654d26a7"],

Cell[TextData[{
 "It relocates only when the notebook's position identifies the tree: inside \
a Data entry directory (",
 Cell[BoxData[
  StyleBox[
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"\[Ellipsis]", "/", "Data"}], "/", "alias"}], "/", "name"}], 
    "/"}], "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "f56814dc-b70a-4934-9eba-e6652b694781"],
 ", where ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["SaveData"]], "paclet:VasilDimitrov/SolutionsX/ref/SaveData", 
    "VasilDimitrov Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "5e2f4cec-c69b-479c-85da-ba02a975aa9d"],
 " puts notebooks), or at a SolutionsX repository root (a PacletInfo.wl \
beside a Data directory). Anywhere else it leaves the configured values \
untouched and just displays them."
}], "Notes",
 CellID->227,ExpressionUUID->"b801bdb9-6e15-41d1-9088-e933b7e63b08"],

Cell[TextData[{
 "The relocation is derived state, never stored: the cell carries no absolute \
paths, so an entry moved or cloned to another machine finds its tree by \
position alone. Identity is untouched \[LongDash] ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["$Alias"]], "paclet:VasilDimitrov/SolutionsX/ref/$Alias", 
    "VasilDimitrov Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "65afb3fc-ed22-4b4a-b54c-fa2a544f363c"],
 " always comes from the user configuration."
}], "Notes",
 CellID->228,ExpressionUUID->"0402f651-bc28-4f8c-82df-9bda4b871a17"],

Cell["\<\
In a front end the package load itself prints nothing; LocateData[] \
reproduces the same panel and status on every evaluation, so re-running the \
initialization cell is idempotent by construction. Headless, loading prints \
verbatim and LocateData[] adds the status line.\
\>", "Notes",
 CellID->229,ExpressionUUID->"dfc95b53-2419-465b-91bd-2527a8edf8df"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["LocateData"]], 
    "paclet:VasilDimitrov/SolutionsX/ref/LocateData", 
    "VasilDimitrov Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "460d638a-28d9-4044-9d0b-2130d5f4434e"],
 "[",
 Cell[BoxData[
  StyleBox["dir", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "805848a7-831c-455a-ae50-ab2ab2a8577f"],
 "] does the same for an explicit entry directory path."
}], "Notes",
 CellID->230,ExpressionUUID->"57a4326e-0623-4a64-8f87-c2c5ca5ea8a7"]
}, Open  ]],

