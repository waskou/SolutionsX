Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"19f433b7-a68d-45fd-a582-a70cf6bff9d9"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["LocateData"]], 
     "paclet:VasilDimitrov/SolutionsX/ref/LocateData", 
     "VasilDimitrov Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", "]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "26d0bb6b-d921-4dff-96a4-37d0716f3a19"],
 "\[LineSeparator]points ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["$DataDirectory"]], 
    "paclet:VasilDimitrov/SolutionsX/ref/$DataDirectory", 
    "VasilDimitrov Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "9a98315a-cb83-475a-8fd4-92b0f47165cc"],
 " at the data tree containing the current notebook, for this session only, \
then displays the package load panel and the Data status.\n",
 Cell["   ", "ModInfo",ExpressionUUID->"158cf032-9bb9-442b-a8b1-5131065e6b54"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["LocateData"]], 
     "paclet:VasilDimitrov/SolutionsX/ref/LocateData", 
     "VasilDimitrov Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["dir", "TI"], "]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "21ab96c1-195f-435b-9ab4-1e82e08495b6"],
 "\[LineSeparator]does the same for an explicit entry directory path.\n",
 Cell["   ", "ModInfo",ExpressionUUID->"9a7589ac-b22f-4eee-bfed-0ab3b809200e"],
 "It relocates only when the notebook sits inside a Data entry directory (\
\[Ellipsis]/Data/",
 Cell[BoxData[
  StyleBox["alias", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "0f926835-d052-4134-b78f-90c188a4d054"],
 "/",
 Cell[BoxData[
  StyleBox["name", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "770f10c5-bea7-43ce-9a01-f81759cc3e50"],
 "/) or at a SolutionsX repository root; anywhere else it leaves the \
configured values untouched and just displays them. It is the display line of \
",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["NewData"]], "paclet:VasilDimitrov/SolutionsX/ref/NewData", 
    "VasilDimitrov Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "034bba6f-19c6-4884-a968-09799602abc9"],
 "'s initialization cell."
}], "Usage",
 CellID->228,ExpressionUUID->"98cfe054-cef4-4d38-bd13-6df2240f315a"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["LocateData"]], 
    "paclet:VasilDimitrov/SolutionsX/ref/LocateData", 
    "VasilDimitrov Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "1b65c753-61b4-49a4-b238-1f7f6e264e0e"],
 "[] points ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["$DataDirectory"]], 
    "paclet:VasilDimitrov/SolutionsX/ref/$DataDirectory", 
    "VasilDimitrov Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "091c0723-309a-40d1-b3a8-9bd7b05a6d32"],
 " at the data tree containing the current notebook, for this session only, \
then displays the package load panel and the Data status line. It is the \
display line of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["NewData"]], "paclet:VasilDimitrov/SolutionsX/ref/NewData", 
    "VasilDimitrov Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "94700b0d-1a61-4974-80f5-5ad94a9370c0"],
 "'s initialization cell."
}], "Notes",
 CellID->229,ExpressionUUID->"f06f752d-012f-4c7a-ae43-22014b5c01bf"],

Cell[TextData[{
 "It relocates only when the notebook's position identifies the tree: inside \
a Data entry directory (",
 Cell[BoxData[
  StyleBox[
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"\[Ellipsis]", "/", "Data"}], "/", "alias"}], "/", "name"}], 
    "/"}], "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "d709b98e-0486-45e9-bc44-4a72c6a94e26"],
 ", where ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["SaveData"]], "paclet:VasilDimitrov/SolutionsX/ref/SaveData", 
    "VasilDimitrov Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "f6deb3b8-4d24-4c41-8671-8c2ef0afda60"],
 " puts notebooks), or at a SolutionsX repository root (a PacletInfo.wl \
beside a Data directory). Anywhere else it leaves the configured values \
untouched and just displays them."
}], "Notes",
 CellID->230,ExpressionUUID->"3389e027-1e06-474f-a7c7-e387aa141f68"],

Cell[TextData[{
 "The relocation is derived state, never stored: the cell carries no absolute \
paths, so an entry moved or cloned to another machine finds its tree by \
position alone. Identity is untouched \[LongDash] ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["$Alias"]], "paclet:VasilDimitrov/SolutionsX/ref/$Alias", 
    "VasilDimitrov Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "ca079813-684e-4133-88cb-be12424b6616"],
 " always comes from the user configuration."
}], "Notes",
 CellID->231,ExpressionUUID->"52058874-71a6-45ab-bba1-b8da49505560"],

Cell["\<\
In a front end the package load itself prints nothing; LocateData[] \
reproduces the same panel and status on every evaluation, so re-running the \
initialization cell is idempotent by construction. Headless, loading prints \
verbatim and LocateData[] adds the status line.\
\>", "Notes",
 CellID->232,ExpressionUUID->"4305bd38-737b-4677-843e-3c3656960e20"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["LocateData"]], 
    "paclet:VasilDimitrov/SolutionsX/ref/LocateData", 
    "VasilDimitrov Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "dda103b5-f765-493f-a268-28093ddc3534"],
 "[",
 Cell[BoxData[
  StyleBox["dir", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "b1087953-bc24-429a-82d7-3f3c72ec3650"],
 "] does the same for an explicit entry directory path."
}], "Notes",
 CellID->233,ExpressionUUID->"08337b69-9e0b-42e7-a8f1-4eb7eee2770e"]
}, Open  ]],

