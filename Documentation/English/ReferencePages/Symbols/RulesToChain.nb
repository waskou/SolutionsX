Cell["RulesToChain", "ObjectName",
 CellID->869,ExpressionUUID->"5bf716ca-330f-4cf3-91bc-22790f092d91"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"ffe26192-16e4-4c04-8bfc-4eb224068dcd"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["RulesToChain"]], 
     "paclet:VasilDimitrov/SolutionsX/ref/RulesToChain", 
     "VasilDimitrov Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["a", "TI"], 
    RowBox[{" ", 
     RowBox[{"->", " "}]}], 
    StyleBox["b", "TI"], 
    RowBox[{" ", 
     RowBox[{"->", " "}]}], 
    StyleBox["c", "TI"]}], "]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "36ef035c-d5f2-41b4-a2d2-9a0a8e40eec4"],
 "\[LineSeparator]gives {",
 Cell[BoxData[
  StyleBox["a", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "4a6c0653-dd39-44c1-945a-20b38f5b7ade"],
 " -> ",
 Cell[BoxData[
  StyleBox["b", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "bbe7c24f-26cb-4aba-bfb7-b57b1da8bbae"],
 ", ",
 Cell[BoxData[
  StyleBox["b", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "60d02e2a-af2a-4f7d-9333-75952d6b91d0"],
 " -> ",
 Cell[BoxData[
  StyleBox["c", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "07013efe-6783-419b-a758-f69a5f58e963"],
 "}, the form ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Compute"]], "paclet:VasilDimitrov/SolutionsX/ref/Compute", 
    "VasilDimitrov Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "795d41d7-d125-4f4b-8afe-615624625fc3"],
 " expects for a raising or lowering ladder."
}], "Usage",
 CellID->870,ExpressionUUID->"3c917201-86c1-466a-b114-0f93111bd576"],

Cell["\<\
RulesToChain[a -> b -> c] gives {a -> b, b -> c}, and so on for longer chains.\
\>", "Notes",
 CellID->871,ExpressionUUID->"69430d90-4e64-493e-a78b-9f1f51d469a9"],

Cell["\<\
It is used to write a raising ladder compactly: the components are computed \
once at the bottom, and each further step raises one more index.\
\>", "Notes",
 CellID->872,ExpressionUUID->"ea348bd7-394d-49c1-a713-6c304c032c62"],

Cell["\<\
RulesToChain is normally applied with Apply, as RulesToChain @@ {...}, \
because the chain is written as a single nested rule.\
\>", "Notes",
 CellID->873,ExpressionUUID->"8b8470fa-cf76-4019-b6fc-de07eeebb2ac"]
}, Open  ]],

