Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"RulesToChain", "[", 
  RowBox[{"x", " ", "->", " ", 
   RowBox[{"y", " ", "->", " ", "z"}]}], "]"}]], "Input",
 CellLabel->"In[ ]:=",
 CellID->867,ExpressionUUID->"270420c2-a8da-4328-8979-193dde402ea8"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"x", "\[Rule]", "y"}], ",", 
   RowBox[{"y", "\[Rule]", "z"}]}], "}"}]], "Output",
 CellLabel->"Out[1]=",
 CellID->868,ExpressionUUID->"33f20a5a-12a8-4f04-9f50-296ed543c60c"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"RulesToChain", " ", "@@", " ", 
  RowBox[{"{", 
   RowBox[{"expr", " ", "->", " ", 
    RowBox[{
     RowBox[{"Permutations", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "1"}], ",", " ", 
        RowBox[{"-", "1"}]}], "}"}], "]"}], " ", "->", " ", 
     RowBox[{"Permutations", "[", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", 
        RowBox[{"-", "1"}]}], "}"}], "]"}]}]}], "}"}]}]], "Input",
 CellLabel->"In[ ]:=",
 CellID->869,ExpressionUUID->"588a3256-7434-4c41-a161-4dd7d5d5c172"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"expr", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "1"}], ",", 
       RowBox[{"-", "1"}]}], "}"}], "}"}]}], ",", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "1"}], ",", 
       RowBox[{"-", "1"}]}], "}"}], "}"}], "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", 
        RowBox[{"-", "1"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "1"}], ",", "1"}], "}"}]}], "}"}]}]}], "}"}]], "Output",
 CellLabel->"Out[1]=",
 CellID->870,ExpressionUUID->"0bd4e30c-9781-43ae-8750-e0e98d70da26"]
