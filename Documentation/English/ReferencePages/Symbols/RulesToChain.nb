Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"RulesToChain", "[", 
  RowBox[{"x", " ", "->", " ", 
   RowBox[{"y", " ", "->", " ", "z"}]}], "]"}]], "Input",
 CellLabel->"In[ ]:=",
 CellID->876,ExpressionUUID->"4d4b32c1-40f5-4b07-90e9-b128978aadfd"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"x", "\[Rule]", "y"}], ",", 
   RowBox[{"y", "\[Rule]", "z"}]}], "}"}]], "Output",
 CellLabel->"Out[1]=",
 CellID->877,ExpressionUUID->"d2e3a87d-daaa-48b9-848b-25c4e1b8f0ad"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"RulesToChain", " ", "@@", " ", 
  RowBox[{"{", 
   RowBox[{"expr", " ", "->", " ", 
    RowBox[{
     RowBox[{"Permutations", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "1"}], ",", " ", 
        RowBox[{"-", "1"}]}], "}"}], "]"}], " ", "->", " ", 
     RowBox[{"Permutations", "[", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", 
        RowBox[{"-", "1"}]}], "}"}], "]"}]}]}], "}"}]}]], "Input",
 CellLabel->"In[ ]:=",
 CellID->878,ExpressionUUID->"4ef90817-f225-4734-9d11-e0f5fc1d01fd"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"expr", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "1"}], ",", 
       RowBox[{"-", "1"}]}], "}"}], "}"}]}], ",", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "1"}], ",", 
       RowBox[{"-", "1"}]}], "}"}], "}"}], "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", 
        RowBox[{"-", "1"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "1"}], ",", "1"}], "}"}]}], "}"}]}]}], "}"}]], "Output",
 CellLabel->"Out[1]=",
 CellID->879,ExpressionUUID->"765c947c-8ef7-4efc-9570-08a43f4085db"]
}, Open  ]]
