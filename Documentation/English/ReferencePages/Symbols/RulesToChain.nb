Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"20f46fa2-ac08-415a-a10c-53366cf5d8e9"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["RulesToChain"]], 
     "paclet:VasilDimitrov/SolutionsX/ref/RulesToChain", 
     "VasilDimitrov Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["a", "TI"], 
    RowBox[{" ", 
     RowBox[{"->", " "}]}], 
    StyleBox["b", "TI"], 
    RowBox[{" ", 
     RowBox[{"->", " "}]}], 
    StyleBox["c", "TI"]}], "]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "ca839cd1-7d2c-4c15-9148-695da24183c8"],
 "\[LineSeparator]gives {",
 Cell[BoxData[
  StyleBox["a", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "f5fa0da5-8a9a-4efa-96a9-ee6d470fb6eb"],
 " -> ",
 Cell[BoxData[
  StyleBox["b", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "44dfaa58-1647-44fa-86be-b3f5e2d0b79b"],
 ", ",
 Cell[BoxData[
  StyleBox["b", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "944957e3-7cdf-42a8-8205-c990b03670e9"],
 " -> ",
 Cell[BoxData[
  StyleBox["c", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "dc51dfd1-f98e-43d2-8db7-1b4b796f0cfd"],
 "}, the form ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Compute"]], "paclet:VasilDimitrov/SolutionsX/ref/Compute", 
    "VasilDimitrov Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "48eb2407-93bc-41b3-8deb-356ff63136df"],
 " expects for a raising or lowering ladder."
}], "Usage",
 CellID->861,ExpressionUUID->"14e3b4e6-0ade-44cd-8ad8-a2fad3b39beb"],

Cell["\<\
RulesToChain[a -> b -> c] gives {a -> b, b -> c}, and so on for longer chains.\
\>", "Notes",
 CellID->862,ExpressionUUID->"72652042-3da2-4ee0-883f-cddc40a02ba8"],

Cell["\<\
It is used to write a raising ladder compactly: the components are computed \
once at the bottom, and each further step raises one more index.\
\>", "Notes",
 CellID->863,ExpressionUUID->"8cf48bc6-d1be-4d88-85b1-a8eca2cdeb7f"],

Cell["\<\
RulesToChain is normally applied with Apply, as RulesToChain @@ {...}, \
because the chain is written as a single nested rule.\
\>", "Notes",
 CellID->864,ExpressionUUID->"3d996456-2ee7-4262-a097-73dc35e22716"]
}, Open  ]],

