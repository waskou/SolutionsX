Cell["\<\
OpenData[name] opens $DataDirectory/$Alias/name/name.nb, the notebook that \
produced the entry.\
\>", "Notes",
 CellID->770,ExpressionUUID->"19b623fb-c47d-47b9-b171-a6695bc7e6e5"],

Cell["\<\
