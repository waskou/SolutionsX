Cell["ResumeAs", "ObjectName",
 CellID->523,ExpressionUUID->"15bfec01-0adf-438a-bda6-2a1c1c7e1b0c"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"5b3ae1fd-916d-4b4a-aacc-087f25d1b6b3"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["ResumeAs"]], "paclet:VasilDimitrov/SolutionsX/ref/ResumeAs", 
     "VasilDimitrov Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["sol", "TI"], "]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "9fc62fe6-51f7-43be-b59c-31791f2f8dd2"],
 "\[LineSeparator]restores the current notebook's entry into ",
 Cell[BoxData[
  StyleBox["sol", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "7b9f8e8d-c38a-4301-a566-185a26af792c"],
 " (",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["GetData"]], "paclet:VasilDimitrov/SolutionsX/ref/GetData", 
    "VasilDimitrov Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "1ac37ad3-f4c1-4044-a38a-954b85801b52"],
 "[] followed by ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Load"]], "paclet:VasilDimitrov/SolutionsX/ref/Load", 
    "VasilDimitrov Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "6c2f7b9d-b3a5-434a-aa0f-e5f74d2e175e"],
 ") when nothing has been loaded in this kernel yet, and rebuilds the Load \
banner of everything loaded so far otherwise.\n",
 Cell["   ", "ModInfo",ExpressionUUID->"faffc29f-cf3a-4385-89e4-91aadf4716a7"],
 "Put it at the top of a notebook section: after a kernel quit it resumes \
from disk; in a full top-to-bottom run it only re-shows the banner, so the \
same notebook supports both workflows."
}], "Usage",
 CellID->524,ExpressionUUID->"c246a4e3-6996-4c58-9f64-5050fc4a96c6"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["ResumeAs"]], "paclet:VasilDimitrov/SolutionsX/ref/ResumeAs", 
    "VasilDimitrov Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "d531c45c-5909-4a13-b472-7b9e99350485"],
 "[",
 Cell[BoxData[
  StyleBox["sol", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "81a0e42c-18fb-4ae5-b4ec-2604b8819450"],
 "] restores the current notebook's entry into ",
 Cell[BoxData[
  StyleBox["sol", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "118f2c3d-edde-413f-9e2b-d916f3c6191a"],
 " \[LongDash] ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["GetData"]], "paclet:VasilDimitrov/SolutionsX/ref/GetData", 
    "VasilDimitrov Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "d118c4ea-5802-4552-86f7-3b1ad9ef359a"],
 "[] followed by ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Load"]], "paclet:VasilDimitrov/SolutionsX/ref/Load", 
    "VasilDimitrov Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "b00c2f65-cbcc-4a6c-8b94-af759e8e7ba4"],
 " \[LongDash] when nothing has been loaded in this kernel yet; on a kernel \
with loaded work it rebuilds the Loaded: panel of everything loaded so far \
instead."
}], "Notes",
 CellID->525,ExpressionUUID->"c5479a7d-242b-4fe3-a545-94520eef16fc"],

Cell["\<\
Put it at the top of every notebook section. After a kernel quit the section \
resumes from disk; in a full top-to-bottom run it only re-shows the banner \
\[LongDash] the same notebook supports both workflows, and quitting the \
kernel between sections is the intended hygiene.\
\>", "Notes",
 CellID->526,ExpressionUUID->"367a1769-b5cf-4bfd-ab3c-6c9903b114a4"],

Cell[TextData[{
 "The decision is state-aware but ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Load"]], "paclet:VasilDimitrov/SolutionsX/ref/Load", 
    "VasilDimitrov Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "b96805df-6433-441a-b98f-7a0765f9acb4"],
 " itself is not: when ResumeAs does load, it replays the stored record \
exactly. Both paths end in the same Load banner."
}], "Notes",
 CellID->527,ExpressionUUID->"74a1d41e-1118-452b-a7cf-b6ca25e0e089"],

Cell["\<\
The liveness record it consults is accumulated by the loader on every \
success; a kernel quit is the only thing that resets it.\
\>", "Notes",
 CellID->528,ExpressionUUID->"f3515572-4647-461f-a889-4d40b756d0c7"],

Cell["\<\
ResumeAs has the attribute HoldFirst: the symbol receives the entry, it does \
not have to hold one already.\
\>", "Notes",
 CellID->529,ExpressionUUID->"36d4c4e0-56df-4446-945c-69ac7f3b1059"]
}, Open  ]],

