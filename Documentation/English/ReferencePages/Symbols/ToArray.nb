          RowBox[{
           RowBox[{"-", "a"}], ",", " ", 
           RowBox[{"-", "b"}]}], "]"}], "]"}], "]"}], "]"}], " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "1"}], "}"}], "}"}]}]}], "}"}]}], 
