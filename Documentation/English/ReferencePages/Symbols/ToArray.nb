Cell[CellGroupData[{

Cell["ToArray", "ObjectName",
 CellID->883,ExpressionUUID->"07c6d518-0e0f-474f-b830-b1db3d75d0d5"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"e833baea-3846-4d29-87e2-8616755f872f"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["ToArray"]], "paclet:VasilDimitrov/SolutionsX/ref/ToArray", 
     "VasilDimitrov Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["expr", "TI"], "]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "b0ad2886-d098-4a64-8817-d9a459c8718d"],
 "\[LineSeparator]gives the explicit component array of ",
 Cell[BoxData[
  StyleBox["expr", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "50bc9a7d-78c2-45bd-84d1-98da0999719b"],
 ", by taking it to bases, tracing dummies and resolving component values.\n\
",
 Cell["   ", "ModInfo",ExpressionUUID->"9958ada4-de34-4665-8427-6199602e87cf"],
 "The option Not -> {",
 Cell[BoxData[
  StyleBox["basis", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "5e337e46-39c0-491a-84f0-9a773fac3e9e"],
 "..} leaves those bases untouched."
}], "Usage",
 CellID->884,ExpressionUUID->"b47802fc-7b1a-422f-83b2-f0b89185b5fb"],

Cell["\<\
ToArray[expr] takes expr to bases, traces basis dummies, splits it into \
components and resolves their values. It is the usual way to get from an \
abstract-index expression to explicit numbers or functions.\
\>", "Notes",
 CellID->885,ExpressionUUID->"951171b8-a2d2-4688-82ed-7d3d6999113f"],

Cell["\<\
The option Not -> {basis, ...} leaves those bases untouched, which is how a \
computation is kept partly abstract.\
\>", "Notes",
 CellID->886,ExpressionUUID->"a3a4ce86-04dd-488d-b1d8-15c1a5dcc645"],

Cell["\<\
ToArray gives back the unevaluated components if their values have not been \
computed; use Compute first.\
\>", "Notes",
 CellID->887,ExpressionUUID->"cd0d9be7-0b11-487b-aee6-0c9c5a08a521"],

Cell["\<\
A symmetry-dependent component resolves through its canonical representative. \
When only part of a tensor has been computed and the representative lies in a \
slot configuration the Chain did not cover, the component comes back \
unevaluated even though its own configuration was computed. The notes of \
Compute describe this.\
\>", "Notes",
 CellID->888,ExpressionUUID->"86711421-a210-44d4-ac7c-1186003f27cf"]
}, Open  ]],

