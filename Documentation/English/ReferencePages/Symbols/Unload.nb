Cell[CellGroupData[{

Cell["Unload", "ObjectName",
 CellID->568,ExpressionUUID->"8b2decd3-2810-45a8-a754-8db1d735d613"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"16e13f3f-3fd8-432b-818d-a88e5c38d6af"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["Unload"]], "paclet:VasilDimitrov/SolutionsX/ref/Unload", 
     "VasilDimitrov Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["sol", "TI"], "]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "022ba98c-f22b-4027-9fda-eaccd1656eea"],
 "\[LineSeparator]undefines every xAct object of ",
 Cell[BoxData[
  StyleBox["sol", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "55fc0051-07c1-4769-b460-17c54b592cf5"],
 ", in reverse order of construction, keeping the stored association.\n",
 Cell["   ", "ModInfo",ExpressionUUID->"ad8a531e-7c0b-49e6-9a55-4d7ec1311248"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["Unload"]], "paclet:VasilDimitrov/SolutionsX/ref/Unload", 
     "VasilDimitrov Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["sol", "TI"], "[", 
    StyleBox["object", "TI"], "]", ",", 
    StyleBox["key", "TI"]}], "]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "6d42ab2b-2df8-4c35-8286-deb089813407"],
 "\[LineSeparator]undefines a single entry; a list of keys is also accepted.\n\
",
 Cell["   ", "ModInfo",ExpressionUUID->"47c84ee7-2fd4-466b-bf8d-fb08ec7340d9"],
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Unload"]], "paclet:VasilDimitrov/SolutionsX/ref/Unload", 
    "VasilDimitrov Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "01960e0f-e874-4c06-9498-6ea9f422a1c9"],
 " does not delete the entry: use ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DropFrom"]], "paclet:VasilDimitrov/SolutionsX/ref/DropFrom", 
    "VasilDimitrov Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "ba301ea6-c04b-41e7-a4f3-677a34d69d55"],
 " for that."
}], "Usage",
 CellID->569,ExpressionUUID->"6bf296c3-b45c-4b58-be6b-3c3eec27ded4"],

Cell["\<\
Unload[sol] takes down the whole solution by peeling the xAct layers off \
starting from the outermost: everything is undefined in reverse order of \
construction, so what was defined last \[LongDash] resting on everything \
before it \[LongDash] goes first, and the manifold goes last. xAct demands \
this order, since it will not undefine an object while something still lives \
on it.\
\>", "Notes",
 CellID->570,ExpressionUUID->"cd787e38-b69b-4a44-b5a2-e00eb1199d0e"],

Cell["\<\
The stored descriptions are untouched throughout, so Load rebuilds the \
solution exactly.\
\>", "Notes",
 CellID->571,ExpressionUUID->"3988ff10-f4f8-4aa9-9677-ddd95c1ba4cb"],

Cell["\<\
Unload[sol[object], key] undefines a single entry, and a list of keys is also \
accepted.\
\>", "Notes",
 CellID->572,ExpressionUUID->"e926e08f-201c-48cc-bd1b-389e289d3fa0"],

Cell["Use DropFrom to forget the entry as well.", "Notes",
 CellID->573,ExpressionUUID->"42d722dd-49ca-4b03-919a-2b43fefc6f24"],

Cell["\<\
Teardown is not always complete. xAct refuses to undefine an object that \
still has visitors, and because each step is quieted the refusal is silent. \
In particular a metric can survive Unload[sol] when a stray \
xAct`xTras`Private`var$nnn is still a visitor of the manifold; VisitorsOf \
shows the blocker. Starting a fresh kernel is the reliable remedy.\
\>", "Notes",
 CellID->574,ExpressionUUID->"05c23b00-35d1-413e-aec0-4149a462a7ee"],

Cell["Unload has the attribute HoldFirst.", "Notes",
 CellID->575,ExpressionUUID->"a65f28de-a180-42e0-87c4-f0a2063102c4"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Examples", "PrimaryExamplesSection",
 CellTags->"PrimaryExamplesSection",
 CellID->576,ExpressionUUID->"5f866a91-2adb-4d2f-889d-d33a238e1a16"],

Cell["Basic Examples", "ExampleSection",
 CellID->577,ExpressionUUID->"0c91148d-3999-4202-87c3-79a45123c0b1"],

Cell["The usual small solution: one constant, live once included.", \
"ExampleText",
 CellID->578,ExpressionUUID->"c452792d-322c-436a-a651-338f72be4e2a"],

Cell[BoxData[
 RowBox[{"Instantiate", "[", "sol", "]"}]], "Input",
 CellLabel->"In[ ]:=",
 CellID->579,ExpressionUUID->"925144c8-b9f7-48c9-b6f1-37d9c3236cd6"],

Cell[BoxData[
 RowBox[{"IncludeTo", "[", 
  RowBox[{
   RowBox[{"sol", "[", "$constant", "]"}], ",", " ", 
   RowBox[{"<|", 
    RowBox[{"Symbol", " ", "->", " ", "aa"}], "|>"}]}], "]"}]], "Input",
 CellLabel->"In[ ]:=",
 CellID->580,ExpressionUUID->"b7429573-1a9f-403a-a90b-bd64edbc18c6"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ConstantSymbolQ", "[", "aa", "]"}]], "Input",
 CellLabel->"In[ ]:=",
 CellID->581,ExpressionUUID->"cb01b73e-e497-4588-9db7-c8eeb2749263"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]=",
 CellID->582,ExpressionUUID->"076b9cae-dca2-4f11-9b2d-a4f58439e672"]
}, Open  ]],

Cell["\<\
Unload undefines the xAct object \[LongDash] aa is not a constant any more:\
\>", "ExampleText",
 CellID->583,ExpressionUUID->"fd3e0cab-e001-4786-bbdc-76bdaeb5cc4e"],

Cell[BoxData[
 RowBox[{"Unload", "[", 
  RowBox[{
   RowBox[{"sol", "[", "$constant", "]"}], ",", " ", "aa"}], "]"}]], "Input",
 CellLabel->"In[ ]:=",
 CellID->584,ExpressionUUID->"7071d873-7e36-4941-9384-a742e3be27ba"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ConstantSymbolQ", "[", "aa", "]"}]], "Input",
 CellLabel->"In[ ]:=",
 CellID->585,ExpressionUUID->"3e429b1f-0290-486a-a265-ca80aa6145e9"],

Cell[BoxData["False"], "Output",
 CellLabel->"Out[1]=",
 CellID->586,ExpressionUUID->"5af40565-1eed-41ce-abc1-d004dd7d1519"]
}, Open  ]],

Cell["\<\
But unlike DropFrom, the description stays. The entry is still in the \
solution, ready for Load to bring it back:\
\>", "ExampleText",
 CellID->587,ExpressionUUID->"4bff8ccd-18c0-4b4e-ac9a-f85032eb44e8"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Keys", "[", 
  RowBox[{"sol", "[", "$constant", "]"}], "]"}]], "Input",
 CellLabel->"In[ ]:=",
 CellID->588,ExpressionUUID->"9cf05b6c-11dd-4806-b721-0860ecff1d30"],

Cell[BoxData[
 RowBox[{"{", "aa", "}"}]], "Output",
 CellLabel->"Out[1]=",
 CellID->589,ExpressionUUID->"801ee821-0e35-45e9-8056-b5ce18073e36"]
}, Open  ]]
}, Open  ]],

