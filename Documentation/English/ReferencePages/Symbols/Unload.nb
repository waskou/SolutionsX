Cell["Unload", "ObjectName",
 CellID->549,ExpressionUUID->"8509058d-e46e-444e-ac51-1f10796f7281"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"e8fc39fe-3d61-4126-8ca8-0a43d474a816"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["Unload"]], "paclet:VasilDimitrov/SolutionsX/ref/Unload", 
     "VasilDimitrov Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["sol", "TI"], "]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "98a9e4b5-6082-4e02-a8b8-7b892afde563"],
 "\[LineSeparator]undefines every xAct object of ",
 Cell[BoxData[
  StyleBox["sol", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "14136611-c253-40a4-b938-ec9f3808e17e"],
 ", in reverse order of construction, keeping the stored association.\n",
 Cell["   ", "ModInfo",ExpressionUUID->"1600571d-84c7-4c44-9f7f-f1f9579e011d"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["Unload"]], "paclet:VasilDimitrov/SolutionsX/ref/Unload", 
     "VasilDimitrov Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["sol", "TI"], "[", 
    StyleBox["object", "TI"], "]", ",", 
    StyleBox["key", "TI"]}], "]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "f0a3fe26-8702-47a0-aae2-bb8c0b493a2e"],
 "\[LineSeparator]undefines a single entry; a list of keys is also accepted.\n\
",
 Cell["   ", "ModInfo",ExpressionUUID->"cee0ede6-0672-42b1-95d1-b80222c4c808"],
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Unload"]], "paclet:VasilDimitrov/SolutionsX/ref/Unload", 
    "VasilDimitrov Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "601b59c2-e71b-4037-b562-36720bff8c2b"],
 " does not delete the entry: use ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DropFrom"]], "paclet:VasilDimitrov/SolutionsX/ref/DropFrom", 
    "VasilDimitrov Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "01dd4d42-eb19-4b8d-9ad5-4085f974779e"],
 " for that."
}], "Usage",
 CellID->550,ExpressionUUID->"32c31692-50fc-4bc8-914e-cf569bc4641a"],

Cell["\<\
Unload[sol] takes down the whole solution by peeling the xAct layers off \
starting from the outermost: everything is undefined in reverse order of \
construction, so what was defined last \[LongDash] resting on everything \
before it \[LongDash] goes first, and the manifold goes last. xAct demands \
this order, since it will not undefine an object while something still lives \
on it.\
\>", "Notes",
 CellID->551,ExpressionUUID->"d84fbf3d-37da-4a4d-a5ba-595026fe203b"],

Cell["\<\
The stored descriptions are untouched throughout, so Load rebuilds the \
solution exactly.\
\>", "Notes",
 CellID->552,ExpressionUUID->"e2620429-b0c9-47b5-bcae-ff69838ada2a"],

Cell["\<\
Unload[sol[object], key] undefines a single entry, and a list of keys is also \
accepted.\
\>", "Notes",
 CellID->553,ExpressionUUID->"f02bf9e0-b3a1-43f4-8dc1-aadfc52ce155"],

Cell["Use DropFrom to forget the entry as well.", "Notes",
 CellID->554,ExpressionUUID->"8014bdc8-289d-4f65-b580-6fc9a13455f7"],

Cell["\<\
Teardown is not always complete. xAct refuses to undefine an object that \
still has visitors, and because each step is quieted the refusal is silent. \
In particular a metric can survive Unload[sol] when a stray \
xAct`xTras`Private`var$nnn is still a visitor of the manifold; VisitorsOf \
shows the blocker. Starting a fresh kernel is the reliable remedy.\
\>", "Notes",
 CellID->555,ExpressionUUID->"dce3dbcd-49ea-45f8-8c0d-ae40f712e833"],

Cell["Unload has the attribute HoldFirst.", "Notes",
 CellID->556,ExpressionUUID->"b9e7db73-44ab-485b-8af3-ba4b8ae7723a"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Examples", "PrimaryExamplesSection",
 CellTags->"PrimaryExamplesSection",
 CellID->557,ExpressionUUID->"8523ac22-52af-4480-8819-b7130c372ca8"],

Cell["Basic Examples", "ExampleSection",
 CellID->558,ExpressionUUID->"58cf61e3-4227-44b1-8587-43f5847cc65f"],

Cell["The usual small solution: one constant, live once included.", \
"ExampleText",
 CellID->559,ExpressionUUID->"468dd4c0-f7f3-45c8-828a-b9ac57d21f1d"],

Cell[BoxData[
 RowBox[{"Instantiate", "[", "sol", "]"}]], "Input",
 CellLabel->"In[ ]:=",
 CellID->560,ExpressionUUID->"248fdb43-4183-433b-afb3-48b13489f595"],

Cell[BoxData[
 RowBox[{"IncludeTo", "[", 
  RowBox[{
   RowBox[{"sol", "[", "$constant", "]"}], ",", " ", 
   RowBox[{"<|", 
    RowBox[{"Symbol", " ", "->", " ", "aa"}], "|>"}]}], "]"}]], "Input",
 CellLabel->"In[ ]:=",
 CellID->561,ExpressionUUID->"09229233-e3d6-49a4-8491-cd73dd750f5c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ConstantSymbolQ", "[", "aa", "]"}]], "Input",
 CellLabel->"In[ ]:=",
 CellID->562,ExpressionUUID->"ca0ac6b7-eca6-4067-a98d-80a4073aec38"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]=",
 CellID->563,ExpressionUUID->"09df9202-74a2-4b46-bc10-414d405b4598"]
}, Open  ]],

Cell["\<\
Unload undefines the xAct object \[LongDash] aa is not a constant any more:\
\>", "ExampleText",
 CellID->564,ExpressionUUID->"c0aeae9e-d62f-4f7b-bf98-a952746a4336"],

Cell[BoxData[
 RowBox[{"Unload", "[", 
  RowBox[{
   RowBox[{"sol", "[", "$constant", "]"}], ",", " ", "aa"}], "]"}]], "Input",
 CellLabel->"In[ ]:=",
 CellID->565,ExpressionUUID->"d9bdaebe-8bc9-41a1-a402-1ac9e4d2eb95"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ConstantSymbolQ", "[", "aa", "]"}]], "Input",
 CellLabel->"In[ ]:=",
 CellID->566,ExpressionUUID->"61395514-8698-41f4-a90a-d35725aa72d0"],

Cell[BoxData["False"], "Output",
 CellLabel->"Out[1]=",
 CellID->567,ExpressionUUID->"0527dec9-7f1c-4fcd-ac06-30e903e347c0"]
}, Open  ]],

Cell["\<\
But unlike DropFrom, the description stays. The entry is still in the \
solution, ready for Load to bring it back:\
\>", "ExampleText",
 CellID->568,ExpressionUUID->"83a0feb3-ee11-4e90-98f9-13b721af8c21"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Keys", "[", 
  RowBox[{"sol", "[", "$constant", "]"}], "]"}]], "Input",
 CellLabel->"In[ ]:=",
 CellID->569,ExpressionUUID->"c7f56ff5-5a4d-4d61-a8ad-7216001879c7"],

Cell[BoxData[
 RowBox[{"{", "aa", "}"}]], "Output",
 CellLabel->"Out[1]=",
 CellID->570,ExpressionUUID->"c11ffc38-e1e1-420c-9948-b05f2fa2aef9"]
}, Open  ]]
}, Open  ]],

