Cell[CellGroupData[{

Cell["MergeWith", "ObjectName",
 CellID->436,ExpressionUUID->"824158a1-d124-4e9a-b246-8af950d5da56"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"45be8288-c595-4dbe-b5d7-23464b38884d"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["MergeWith"]], "paclet:VasilDimitrov/SolutionsX/ref/MergeWith",
      "VasilDimitrov Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["sol", "TI"], ",", 
    StyleBox["assoc", "TI"]}], "]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "d237e4e3-5803-477f-aec1-b112b6a48b56"],
 "\[LineSeparator]includes and loads every entry of the solution association ",
 Cell[BoxData[
  StyleBox["assoc", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "b3d5d7fb-9ee7-4931-b4d4-ab0c778e7f5d"],
 " into ",
 Cell[BoxData[
  StyleBox["sol", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "b992853f-7c48-4bc8-8708-14e018a87638"],
 ".\n",
 Cell["   ", "ModInfo",ExpressionUUID->"6774d72b-1c9c-418d-9e5c-26d6245a1f1b"],
 "It refuses, with a message, if the two share any symbol or any key."
}], "Usage",
 CellID->437,ExpressionUUID->"d880d567-fe49-43d8-8a0c-4aa941ba2a6b"],

Cell["\<\
MergeWith[sol, assoc] includes and loads every entry of the solution \
association assoc into sol.\
\>", "Notes",
 CellID->438,ExpressionUUID->"7bbfe367-74ed-4160-a5a0-be9e0491ea8f"],

Cell["\<\
It refuses, with MergeWith::duplicatesymbols or MergeWith::duplicatekeys, if \
the two share any symbol or any key.\
\>", "Notes",
 CellID->439,ExpressionUUID->"9b98cd98-f455-4622-89ac-224803a152c5"],

Cell["\<\
Within the package MergeWith is called only by Instantiate[sol, assoc], where \
sol has just been emptied and neither refusal can occur. At this stage that \
is the intended route; there is rarely a reason to call MergeWith directly.\
\>", "Notes",
 CellID->440,ExpressionUUID->"916f3825-b0ca-4a9e-9235-e469d62b5321"],

Cell["\<\
The entries merged in are expected to be unloaded, as GetData returns them. \
Merging a solution whose objects are still live makes xAct reject each \
definition as already made.\
\>", "Notes",
 CellID->441,ExpressionUUID->"54fb4068-1859-4d9f-9e44-8f245a88d0e1"],

Cell["MergeWith may be updated in a later version.", "Notes",
 CellID->442,ExpressionUUID->"9ff9ad6a-9958-44d6-92b6-b42502d07732"],

Cell["MergeWith has the attribute HoldFirst.", "Notes",
 CellID->443,ExpressionUUID->"2e60a892-ab27-479f-b795-def6b8954b2f"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Examples", "PrimaryExamplesSection",
 CellTags->"PrimaryExamplesSection",
 CellID->444,ExpressionUUID->"c091f0f9-6b64-420b-a988-80849be19392"],

Cell["Basic Examples", "ExampleSection",
 CellID->445,ExpressionUUID->"5eb94136-235c-41fc-affb-b3c66ca89af9"],

Cell["\<\
MergeWith is the machinery behind Instantiate[sol, assoc] rather than a \
function to reach for on its own. A solution to be merged \[LongDash] here a \
single constant, unloaded, which is the shape GetData returns:\
\>", "ExampleText",
 CellID->446,ExpressionUUID->"3e9b9cff-3b17-4fc4-944d-7f6660fddb6a"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Instantiate", "[", "other", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"IncludeTo", "[", 
   RowBox[{
    RowBox[{"other", "[", "$constant", "]"}], ",", " ", 
    RowBox[{"<|", 
     RowBox[{"Symbol", " ", "->", " ", "bb"}], "|>"}]}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Unload", "[", "other", "]"}], ";"}]}], "Input",
 CellLabel->"In[ ]:=",
 CellID->447,ExpressionUUID->"b30e3a18-2120-4654-af59-71391ad7a7e4"],

Cell["\<\
Instantiate empties sol and merges other in, MergeWith doing the work. The \
entry arrives and its definition is made:\
\>", "ExampleText",
 CellID->448,ExpressionUUID->"666e7140-034b-477a-955e-bb44f6750813"],

Cell[BoxData[
 RowBox[{"Instantiate", "[", 
  RowBox[{"sol", ",", " ", "other"}], "]"}]], "Input",
 CellLabel->"In[ ]:=",
 CellID->449,ExpressionUUID->"dc2fc4e0-7b43-4454-bb26-f127ca2c4272"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Keys", "[", 
    RowBox[{"sol", "[", "$constant", "]"}], "]"}], ",", " ", 
   RowBox[{"ConstantSymbolQ", "[", "bb", "]"}]}], "}"}]], "Input",
 CellLabel->"In[ ]:=",
 CellID->450,ExpressionUUID->"b488f12a-bdef-4404-bc52-5cc55f90abc8"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    InterpretationBox[
     StyleBox["bb",
      ShowAutoStyles->False,
      AutoSpacing->False],
     $CellContext`bb,
     Editable->False], "}"}], ",", "True"}], "}"}]], "Output",
 CellLabel->"Out[1]=",
 CellID->451,ExpressionUUID->"445aa596-bd72-4863-84c4-4e8e4dcb8185"]
}, Open  ]],

Cell["Merging solutions that share a symbol or a key is refused:", \
"ExampleText",
 CellID->452,ExpressionUUID->"428c80bb-9fae-4165-ac62-374d5e9e40c6"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"MergeWith", "[", 
  RowBox[{"sol", ",", " ", "other"}], "]"}]], "Input",
 CellLabel->"In[ ]:=",
 CellID->453,ExpressionUUID->"c7f304d4-d81c-4d84-bad8-39e986f3604a"],

Cell[BoxData[
 TemplateBox[{
  "MergeWith", "duplicatesymbols", "\"Symbols: {bb} already appear in sol\"", 
   2, 1, 1, 0, "Local"},
  "MessageTemplate"]], "Message", "MSG",
 CellLabel->"During evaluation of In[1]:=",
 CellID->454,ExpressionUUID->"9976cb53-fbe3-43c2-b32b-2ff0320dd39a"]
}, Open  ]]
}, Open  ]],

