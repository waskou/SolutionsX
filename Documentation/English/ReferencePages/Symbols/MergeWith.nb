Cell[CellGroupData[{

Cell["MergeWith", "ObjectName",
 CellID->417,ExpressionUUID->"ae4fa8a0-c615-4a95-8305-eecbf3deb57c"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"a61c2bb7-8405-4cd5-abd9-cc1179ae82c7"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["MergeWith"]], "paclet:VasilDimitrov/SolutionsX/ref/MergeWith",
      "VasilDimitrov Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["sol", "TI"], ",", 
    StyleBox["assoc", "TI"]}], "]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "08a8fa31-731e-47ae-a9fb-360ae3ebd6f1"],
 "\[LineSeparator]includes and loads every entry of the solution association ",
 Cell[BoxData[
  StyleBox["assoc", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "375cba94-2bbf-4634-b257-4907ddcb03af"],
 " into ",
 Cell[BoxData[
  StyleBox["sol", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "723f4d5d-ac69-4448-a0b3-ef3b0659986d"],
 ".\n",
 Cell["   ", "ModInfo",ExpressionUUID->"1c290b88-f4d6-42ea-9090-e3dbb3b28d45"],
 "It refuses, with a message, if the two share any symbol or any key."
}], "Usage",
 CellID->418,ExpressionUUID->"4f1e598c-0243-4052-ae57-22f85746c445"],

Cell["\<\
MergeWith[sol, assoc] includes and loads every entry of the solution \
association assoc into sol.\
\>", "Notes",
 CellID->419,ExpressionUUID->"f1a8dc80-0a4b-4472-9446-75e927aaa7c0"],

Cell["\<\
It refuses, with MergeWith::duplicatesymbols or MergeWith::duplicatekeys, if \
the two share any symbol or any key.\
\>", "Notes",
 CellID->420,ExpressionUUID->"2be996c1-111d-43f9-a1eb-1eee4ee1db3d"],

Cell["\<\
Within the package MergeWith is called only by Instantiate[sol, assoc], where \
sol has just been emptied and neither refusal can occur. At this stage that \
is the intended route; there is rarely a reason to call MergeWith directly.\
\>", "Notes",
 CellID->421,ExpressionUUID->"4c30b343-26a8-4d07-85b9-ef29426b1927"],

Cell["\<\
The entries merged in are expected to be unloaded, as GetData returns them. \
Merging a solution whose objects are still live makes xAct reject each \
definition as already made.\
\>", "Notes",
 CellID->422,ExpressionUUID->"2fb8908f-ac42-4abb-9b6d-af3dcbe4f3f6"],

Cell["MergeWith may be updated in a later version.", "Notes",
 CellID->423,ExpressionUUID->"69b6098f-dd0f-4a97-8ea9-df2b1b84e97c"],

Cell["MergeWith has the attribute HoldFirst.", "Notes",
 CellID->424,ExpressionUUID->"94d9a583-a9d2-4a0d-bfe8-cbab3dc609b9"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Examples", "PrimaryExamplesSection",
 CellTags->"PrimaryExamplesSection",
 CellID->425,ExpressionUUID->"e43a4dde-27da-40fe-b9a2-76a153524ace"],

Cell["Basic Examples", "ExampleSection",
 CellID->426,ExpressionUUID->"36cf23f5-cd26-4fdf-9ef5-0e95e4fb6ce5"],

Cell["\<\
MergeWith is the machinery behind Instantiate[sol, assoc] rather than a \
function to reach for on its own. A solution to be merged \[LongDash] here a \
single constant, unloaded, which is the shape GetData returns:\
\>", "ExampleText",
 CellID->427,ExpressionUUID->"37b2620e-37d6-48d9-941c-b2678f47ea63"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Instantiate", "[", "other", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"IncludeTo", "[", 
   RowBox[{
    RowBox[{"other", "[", "$constant", "]"}], ",", " ", 
    RowBox[{"<|", 
     RowBox[{"Symbol", " ", "->", " ", "bb"}], "|>"}]}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Unload", "[", "other", "]"}], ";"}]}], "Input",
 CellLabel->"In[ ]:=",
 CellID->428,ExpressionUUID->"b0c76378-fb4b-4ba8-95ee-60862451f2ff"],

Cell["\<\
Instantiate empties sol and merges other in, MergeWith doing the work. The \
entry arrives and its definition is made:\
\>", "ExampleText",
 CellID->429,ExpressionUUID->"7ae3a0d6-a5a7-4464-9032-e8b7db59a12b"],

Cell[BoxData[
 RowBox[{"Instantiate", "[", 
  RowBox[{"sol", ",", " ", "other"}], "]"}]], "Input",
 CellLabel->"In[ ]:=",
 CellID->430,ExpressionUUID->"f5f2fb0c-0b5e-46f6-8d74-32848bd7fcb0"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Keys", "[", 
    RowBox[{"sol", "[", "$constant", "]"}], "]"}], ",", " ", 
   RowBox[{"ConstantSymbolQ", "[", "bb", "]"}]}], "}"}]], "Input",
 CellLabel->"In[ ]:=",
 CellID->431,ExpressionUUID->"74aa4716-313a-46a6-97e0-0c81230cf86f"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    InterpretationBox[
     StyleBox["bb",
      ShowAutoStyles->False,
      AutoSpacing->False],
     $CellContext`bb,
     Editable->False], "}"}], ",", "True"}], "}"}]], "Output",
 CellLabel->"Out[1]=",
 CellID->432,ExpressionUUID->"6871a068-a18c-4a9b-ac1c-9ebbec427c43"]
}, Open  ]],

Cell["Merging solutions that share a symbol or a key is refused:", \
"ExampleText",
 CellID->433,ExpressionUUID->"6261d91e-c6ba-4292-8828-36e2acc043a1"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"MergeWith", "[", 
  RowBox[{"sol", ",", " ", "other"}], "]"}]], "Input",
 CellLabel->"In[ ]:=",
 CellID->434,ExpressionUUID->"8b76e1df-d134-47e6-8a95-097c0fe0141a"],

Cell[BoxData[
 TemplateBox[{
  "MergeWith", "duplicatesymbols", "\"Symbols: {bb} already appear in sol\"", 
   2, 1, 1, 0, "Local"},
  "MessageTemplate"]], "Message", "MSG",
 CellLabel->"During evaluation of In[1]:=",
 CellID->435,ExpressionUUID->"12476747-a030-42a3-a54a-c76fbc8d61ac"]
}, Open  ]]
}, Open  ]],

