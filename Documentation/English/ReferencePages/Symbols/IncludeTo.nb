Cell[CellGroupData[{

Cell["IncludeTo", "ObjectName",
 CellID->312,ExpressionUUID->"987ff20c-29c9-4226-b134-8d3e3ade8fdd"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"c96c393d-0daf-43ff-9c6f-e660201334be"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["IncludeTo"]], "paclet:VasilDimitrov/SolutionsX/ref/IncludeTo",
      "VasilDimitrov Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["sol", "TI"], "[", 
    StyleBox["object", "TI"], "]", ",", 
    StyleBox["assoc", "TI"]}], "]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "5c671f66-a822-46ec-8c13-454a32211542"],
 "\[LineSeparator]validates ",
 Cell[BoxData[
  StyleBox["assoc", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "39d0152e-472c-4ef2-aade-3cfdf6677b89"],
 ", stores it under ",
 Cell[BoxData[
  StyleBox["object", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "4a8259ec-03cf-4232-8a07-6045284552f3"],
 ", and makes the corresponding xAct definition.\n",
 Cell["   ", "ModInfo",ExpressionUUID->"ead5ce55-0fa4-4f22-800a-9046b493a9ab"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["IncludeTo"]], "paclet:VasilDimitrov/SolutionsX/ref/IncludeTo",
      "VasilDimitrov Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["sol", "TI"], "[", 
    StyleBox["object", "TI"], "]", ",", 
    RowBox[{"{", 
     StyleBox["assoc", "TI"], 
     RowBox[{"..", "}"}]}]}], "]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "1075dc4e-47b9-4381-8e5b-d74721bf554e"],
 "\[LineSeparator]does the same for several entries in order.\n",
 Cell["   ", "ModInfo",ExpressionUUID->"19c1249a-6b60-4e31-9829-27a3c4d13906"],
 "The keys of ",
 Cell[BoxData[
  StyleBox["assoc", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "5ba93fd7-7247-4d7a-afec-717377cd5e53"],
 " are those of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Options"]], "paclet:ref/Options"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "ef52bc37-5100-4e15-bf10-156e89426106"],
 "[",
 Cell[BoxData[
  StyleBox["object", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "21e992c6-9422-4c96-ab34-027d668d45d7"],
 "]; missing keys take their default. Any entry already under the same key is \
unloaded first."
}], "Usage",
 CellID->313,ExpressionUUID->"05d5df86-9a92-4119-a47e-d276f45932a1"],

Cell["\<\
IncludeTo[sol[object], assoc] checks the description assoc, stores it in sol, \
and makes the xAct definition it describes.\
\>", "Notes",
 CellID->314,ExpressionUUID->"7816dcc8-1599-4dfb-9cbd-e3866468b52a"],

Cell["\<\
The keys of assoc are those of Options[object]; a key left out takes its \
default. Keys in PropKeysOf[object] become positional arguments of the xAct \
constructor, those in OptKeysOf[object] become options.\
\>", "Notes",
 CellID->315,ExpressionUUID->"697f047c-63f9-4fd1-8bb2-5ededc3e27a2"],

Cell["\<\
A list of associations is loaded in the order given, which matters: xAct \
requires a manifold before a metric on it, and a chart before components in \
that chart.\
\>", "Notes",
 CellID->316,ExpressionUUID->"8b49281c-8fb7-41ad-9f4a-39c5b852aa3a"],

Cell["\<\
An entry already stored under the same key is unloaded first, so \
re-evaluating a cell is safe.\
\>", "Notes",
 CellID->317,ExpressionUUID->"88fefc6c-e054-44f1-9ea1-c6c59bce3902"],

Cell["\<\
A rejected description surfaces as Throw::nocatch together with \
Hold[Throw[object]]; the message printed just above it names the offending \
key.\
\>", "Notes",
 CellID->318,ExpressionUUID->"fb475c74-ae82-4cb2-874d-873f68795b17"],

Cell["IncludeTo has the attribute HoldFirst.", "Notes",
 CellID->319,ExpressionUUID->"6c42ff28-e286-4698-b215-89615de54591"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Examples", "PrimaryExamplesSection",
 CellTags->"PrimaryExamplesSection",
 CellID->320,ExpressionUUID->"bebf633d-1f8d-4f1c-a6fa-fd0affd851f2"],

Cell["Basic Examples", "ExampleSection",
 CellID->321,ExpressionUUID->"9973f18e-a5a8-41be-984d-b260a28f8047"],

Cell[BoxData[
 RowBox[{"Instantiate", "[", "sol", "]"}]], "Input",
 CellLabel->"In[ ]:=",
 CellID->322,ExpressionUUID->"ad030fb3-c62a-48ac-9e8c-0c5ae9297e18"],

Cell["\<\
Before anything happens, M is just a name. Nothing is known about it.\
\>", "ExampleText",
 CellID->323,ExpressionUUID->"bc11d17a-9b5c-45b2-bfdc-d36e19ebf477"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"ValueQ", "[", "M", "]"}], ",", " ", 
   RowBox[{"OwnValues", "[", "M", "]"}], ",", " ", 
   RowBox[{"DownValues", "[", "M", "]"}], ",", " ", 
   RowBox[{"UpValues", "[", "M", "]"}]}], "}"}]], "Input",
 CellLabel->"In[ ]:=",
 CellID->324,ExpressionUUID->"e6170c59-fff8-4fa9-9dfb-bc56fab6e0ab"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"False", ",", 
   RowBox[{"{", "}"}], ",", 
   RowBox[{"{", "}"}], ",", 
   RowBox[{"{", "}"}]}], "}"}]], "Output",
 CellLabel->"Out[1]=",
 CellID->325,ExpressionUUID->"f707b284-9551-4b63-b3cc-2c1b70dd4c7f"]
}, Open  ]],

Cell["\<\
A solution is put together from objects \[LongDash] manifolds, metrics, \
tensors, and so on. These are the kinds it knows:\
\>", "ExampleText",
 CellID->326,ExpressionUUID->"fef25b56-4c12-41c4-a3ab-9e09502f8745"],

Cell[CellGroupData[{

Cell[BoxData["$Objects"], "Input",
 CellLabel->"In[ ]:=",
 CellID->327,ExpressionUUID->"6680d949-3248-4b80-aa55-85f020fb4b06"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
  "$manifold", ",", "$parameter", ",", "$metric", ",", "$frame", ",", 
   "$spinStructure", ",", "$spinConnection", ",", "$bundle", ",", "$covd", 
   ",", "$chart", ",", "$basis", ",", "$form", ",", "$tensor", ",", "$spinor",
    ",", "$function", ",", "$constant", ",", "$assumption", ",", "$rule", ",",
    "$set"}], "}"}]], "Output",
 CellLabel->"Out[1]=",
 CellID->328,ExpressionUUID->"d1bed54a-3821-423b-b65a-90b5c0b0c6c1"]
}, Open  ]],

Cell["\<\
To include a manifold, you describe the one you want. A description is a set \
of named choices, and for a manifold these are the choices there are:\
\>", "ExampleText",
 CellID->329,ExpressionUUID->"5993d659-a930-4a14-be6c-7dce45100a4e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Keys", "@", 
  RowBox[{"$manifold", "[", "]"}]}]], "Input",
 CellLabel->"In[ ]:=",
 CellID->330,ExpressionUUID->"9f06bc9a-7b4a-4605-afbe-cdd97a57116e"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
  "Symbol", ",", "Dimension", ",", "Index", ",", "Name", ",", "Master", ",", 
   "PrintAs", ",", "ProtectNewSymbol", ",", "DefInfo"}], "}"}]], "Output",
 CellLabel->"Out[1]=",
 CellID->331,ExpressionUUID->"569e26b2-4bda-4499-ac7b-60f98bac712b"]
}, Open  ]],

Cell["\<\
Each choice also knows what a sensible answer looks like \[LongDash] the \
whole form at once, every key with the pattern its value has to match:\
\>", "ExampleText",
 CellID->332,ExpressionUUID->"d633e8f0-df33-4297-b332-39e06f067653"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"$manifold", "[", "]"}]], "Input",
 CellLabel->"In[ ]:=",
 CellID->333,ExpressionUUID->"3f6fdb9d-eaf4-4927-8bf6-f3021a562cbe"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"Symbol", "\[Rule]", "_Symbol"}], ",", 
   RowBox[{"Dimension", "\[Rule]", 
    RowBox[{
     RowBox[{"_Integer", "?", "Positive"}], "|", 
     InterpretationBox[
      StyleBox["d",
       ShowAutoStyles->False,
       AutoSpacing->False],
      xAct`Invar`dim,
      Editable->False]}]}], ",", 
   RowBox[{"Index", "\[Rule]", 
    RowBox[{"{", "__Symbol", "}"}]}], ",", 
   RowBox[{"Name", "\[Rule]", 
    RowBox[{"_String", "|", "name"}]}], ",", 
   RowBox[{"Master", "\[Rule]", "_Symbol"}], ",", 
   RowBox[{"PrintAs", "\[Rule]", 
    RowBox[{"_String", "|", "Identity"}]}], ",", 
   RowBox[{"ProtectNewSymbol", "\[RuleDelayed]", 
    RowBox[{"ScreenDollarIndices", "[", 
     RowBox[{"True", "|", "False"}], "]"}]}], ",", 
   RowBox[{"DefInfo", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"_String", ",", "_String"}], "}"}]}]}], 
  "\[RightAssociation]"}]], "Output",
 CellLabel->"Out[1]=",
 CellID->334,ExpressionUUID->"c97d9d52-5449-4d5b-bd48-4a3379f941e2"]
}, Open  ]],

Cell["\<\
In practice you answer only what you care about. Four choices are enough \
here; the rest have defaults.\
\>", "ExampleText",
 CellID->335,ExpressionUUID->"e0eb316b-5979-45cc-b8ad-572a026ba5d4"],

Cell[BoxData[
 RowBox[{"IncludeTo", "[", 
  RowBox[{
   RowBox[{"sol", "[", "$manifold", "]"}], ",", " ", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"Symbol", " ", "->", " ", "M"}], ",", " ", 
     RowBox[{"Dimension", " ", "->", " ", "2"}], ",", " ", 
     RowBox[{"Index", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"a", ",", " ", "b", ",", " ", "c", ",", " ", "d"}], "}"}]}], 
     ",", " ", 
     RowBox[{"Name", " ", "->", " ", "\"\<Sphere\>\""}]}], "|>"}]}], 
  "]"}]], "Input",
 CellLabel->"In[ ]:=",
 CellID->336,ExpressionUUID->"b60223ab-23c2-47bd-9b0e-90b8eb03a8aa"],

Cell["What got stored is the full description, defaults filled in:", \
"ExampleText",
 CellID->337,ExpressionUUID->"95ffb4a3-658e-4fef-b54f-fe8584694a7f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"sol", "[", "$manifold", "]"}]], "Input",
 CellLabel->"In[ ]:=",
 CellID->338,ExpressionUUID->"e8242f22-86db-4f64-aa5e-2f646458b029"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{"M", "\[Rule]", 
   RowBox[{"\[LeftAssociation]", 
    RowBox[{
     RowBox[{"Symbol", "\[Rule]", "M"}], ",", 
     RowBox[{"Dimension", "\[Rule]", "2"}], ",", 
     RowBox[{"Index", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"a", ",", "b", ",", "c", ",", "d"}], "}"}]}], ",", 
     RowBox[{"Name", "\[Rule]", "\<\"Sphere\"\>"}], ",", 
     RowBox[{"Master", "\[Rule]", "Null"}], ",", 
     RowBox[{"PrintAs", "\[Rule]", "Identity"}], ",", 
     RowBox[{"ProtectNewSymbol", "\[RuleDelayed]", 
      RowBox[{"ScreenDollarIndices", "[", "$ProtectNewSymbols", "]"}]}], ",", 
     
     RowBox[{"DefInfo", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"\<\"manifold\"\>", ",", "\<\"\"\>"}], "}"}]}]}], 
    "\[RightAssociation]"}]}], "\[RightAssociation]"}]], "Output",
 CellLabel->"Out[1]=",
 CellID->339,ExpressionUUID->"979ae692-c6fe-4c18-9750-020ab5dfa294"]
}, Open  ]],

Cell["\<\
A description that does not make sense is refused, not repaired. Here the \
dimension is a string:\
\>", "ExampleText",
 CellID->340,ExpressionUUID->"20d7ee45-0f91-4ba1-87ea-ee0720b27037"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"IncludeTo", "[", 
  RowBox[{
   RowBox[{"sol", "[", "$manifold", "]"}], ",", " ", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"Symbol", " ", "->", " ", "MM"}], ",", " ", 
     RowBox[{"Dimension", " ", "->", " ", "\"\<two\>\""}], ",", " ", 
     RowBox[{"Index", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"p", ",", " ", "q", ",", " ", "r", ",", " ", "s"}], "}"}]}]}], 
    "|>"}]}], "]"}]], "Input",
 CellLabel->"In[ ]:=",
 CellID->341,ExpressionUUID->"998f26ae-6820-4e1a-8ea0-92fa697aa0a2"],

Cell[BoxData[
 TemplateBox[{
  "ValidateObject", "badval", 
   "\"The value for key Dimension (two) does not match the expected pattern: \
_Integer?Positive | dim.\"", 2, 1, 1, 0, "Local"},
  "MessageTemplate"]], "Message", "MSG",
 CellLabel->"During evaluation of In[1]:=",
 CellID->342,ExpressionUUID->"91de7f2d-0b1a-41c5-9d28-7ed71f732cda"]
}, Open  ]],

Cell["\<\
So is one with an essential piece missing \[LongDash] without indices there \
is no manifold to make:\
\>", "ExampleText",
 CellID->343,ExpressionUUID->"7e0f3afa-616c-4032-9d81-7879a5428a1c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"IncludeTo", "[", 
  RowBox[{
   RowBox[{"sol", "[", "$manifold", "]"}], ",", " ", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"Symbol", " ", "->", " ", "MM"}], ",", " ", 
     RowBox[{"Dimension", " ", "->", " ", "2"}]}], "|>"}]}], "]"}]], "Input",
 CellLabel->"In[ ]:=",
 CellID->344,ExpressionUUID->"aba9d442-03ce-4372-8c22-13e995041a9b"],

Cell[BoxData[
 TemplateBox[{
  "ValidateObject", "badval", 
   "\"The value for key Index ({__Symbol}) does not match the expected \
pattern: {__Symbol}.\"", 2, 1, 1, 0, "Local"},
  "MessageTemplate"]], "Message", "MSG",
 CellLabel->"During evaluation of In[1]:=",
 CellID->345,ExpressionUUID->"4be50329-3db6-4e94-a788-7864ba3ce0d0"]
}, Open  ]],

Cell["And an invented key is refused by name:", "ExampleText",
 CellID->346,ExpressionUUID->"0b53ec14-c105-403c-836b-f6a4703a4fd0"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"IncludeTo", "[", 
  RowBox[{
   RowBox[{"sol", "[", "$manifold", "]"}], ",", " ", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"Symbol", " ", "->", " ", "MM"}], ",", " ", 
     RowBox[{"Dimension", " ", "->", " ", "2"}], ",", " ", 
     RowBox[{"Index", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"p", ",", " ", "q", ",", " ", "r", ",", " ", "s"}], "}"}]}], 
     ",", " ", 
     RowBox[{"Colour", " ", "->", " ", "\"\<red\>\""}]}], "|>"}]}], 
  "]"}]], "Input",
 CellLabel->"In[ ]:=",
 CellID->347,ExpressionUUID->"2347c6ba-b40b-48b9-aa18-3c275dc7c6f6"],

Cell[BoxData[
 TemplateBox[{
  "ValidateObject", "keysmismatch", 
   "\"The keys do not match. Missing keys: {}. Extra keys: {Colour}.\"", 2, 1,
    1, 0, "Local"},
  "MessageTemplate"]], "Message", "MSG",
 CellLabel->"During evaluation of In[1]:=",
 CellID->348,ExpressionUUID->"20711265-44ea-4ae3-a639-1f5eea29f41f"]
}, Open  ]],

Cell["\<\
Storing the description is only half of what happened. IncludeTo also handed \
it to xAct, there and then \[LongDash] which is why M is no longer an empty \
name:\
\>", "ExampleText",
 CellID->349,ExpressionUUID->"83ba5add-d424-4fca-9526-2ac5b7803987"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"UpValues", "[", "M", "]"}]], "Input",
 CellLabel->"In[ ]:=",
 CellID->350,ExpressionUUID->"97f5dfa8-9ad8-477b-aef5-77b93a83e84f"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{
    RowBox[{"HoldPattern", "[", 
     RowBox[{"DefInfo", "[", "M", "]"}], "]"}], "\[RuleDelayed]", 
    RowBox[{"{", 
     RowBox[{"\<\"manifold\"\>", ",", "\<\"\"\>"}], "}"}]}], ",", 
   RowBox[{
    RowBox[{"HoldPattern", "[", 
     RowBox[{"DimOfManifold", "[", "M", "]"}], "]"}], "\[RuleDelayed]", "2"}],
    ",", 
   RowBox[{
    RowBox[{"HoldPattern", "[", 
     RowBox[{"ManifoldQ", "[", "M", "]"}], "]"}], "\[RuleDelayed]", "True"}], 
   ",", 
   RowBox[{
    RowBox[{"HoldPattern", "[", 
     RowBox[{"PrintAs", "[", "M", "]"}], "]"}], 
    "\[RuleDelayed]", "\<\"M\"\>"}], ",", 
   RowBox[{
    RowBox[{"HoldPattern", "[", 
     RowBox[{"ServantsOf", "[", "M", "]"}], "]"}], "\[RuleDelayed]", 
    RowBox[{"{", 
     InterpretationBox[
      StyleBox["\[DoubleStruckCapitalT]M",
       ShowAutoStyles->False,
       AutoSpacing->False],
      $CellContext`TangentM,
      Editable->False], "}"}]}], ",", 
   RowBox[{
    RowBox[{"HoldPattern", "[", 
     RowBox[{"SplittingsOfManifold", "[", "M", "]"}], "]"}], "\[RuleDelayed]", 
    RowBox[{"{", "}"}]}]}], "}"}]], "Output",
 CellLabel->"Out[1]=",
 CellID->351,ExpressionUUID->"cabf32ef-1e24-412f-aba6-6b283f9c7500"]
}, Open  ]],

Cell["\<\
?M in a notebook shows the same. xAct even built the tangent bundle by itself.\
\>", "ExampleText",
 CellID->352,ExpressionUUID->"0dfbd439-4061-4626-b0ba-48b5a661ddba"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"ManifoldQ", "[", "M", "]"}], ",", " ", 
   RowBox[{"DimOfManifold", "[", "M", "]"}], ",", " ", 
   RowBox[{"ServantsOf", "[", "M", "]"}], ",", " ", 
   RowBox[{"VBundleQ", "[", "TangentM", "]"}]}], "}"}]], "Input",
 CellLabel->"In[ ]:=",
 CellID->353,ExpressionUUID->"aeb230b1-10c3-4b74-9b7e-c50daa142613"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "2", ",", 
   RowBox[{"{", 
    InterpretationBox[
     StyleBox["\[DoubleStruckCapitalT]M",
      ShowAutoStyles->False,
      AutoSpacing->False],
     $CellContext`TangentM,
     Editable->False], "}"}], ",", "True"}], "}"}]], "Output",
 CellLabel->"Out[1]=",
 CellID->354,ExpressionUUID->"b810cd69-7086-421d-be5c-daef3a057612"]
}, Open  ]],

Cell["\<\
Several objects can go in at once, as a list, defined in order. A vector and \
a symmetric tensor on M:\
\>", "ExampleText",
 CellID->355,ExpressionUUID->"80b97716-418e-4889-af3d-5e7ad9050086"],

Cell[BoxData[
 RowBox[{"IncludeTo", "[", 
  RowBox[{
   RowBox[{"sol", "[", "$tensor", "]"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"Symbol", " ", "->", " ", 
        RowBox[{"vv", "[", "a", "]"}]}], ",", " ", 
       RowBox[{"Manifold", " ", "->", " ", "M"}], ",", " ", 
       RowBox[{"Symmetry", " ", "->", " ", "None"}]}], "|>"}], ",", " ", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"Symbol", " ", "->", " ", 
        RowBox[{"hh", "[", 
         RowBox[{
          RowBox[{"-", "a"}], ",", " ", 
          RowBox[{"-", "b"}]}], "]"}]}], ",", " ", 
       RowBox[{"Manifold", " ", "->", " ", "M"}], ",", " ", 
       RowBox[{"Symmetry", " ", "->", " ", 
        RowBox[{"Symmetric", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "a"}], ",", " ", 
           RowBox[{"-", "b"}]}], "}"}], "]"}]}]}], "|>"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[ ]:=",
 CellID->356,ExpressionUUID->"c8cef8af-2856-423c-89de-0cf62ccb281d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Keys", "[", 
  RowBox[{"sol", "[", "$tensor", "]"}], "]"}]], "Input",
 CellLabel->"In[ ]:=",
