Cell[CellGroupData[{

Cell["IncludeTo", "ObjectName",
 CellID->293,ExpressionUUID->"e2d91a23-2a93-4127-8f58-c35273241c19"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"18ade7aa-134e-4510-a763-d822c5dc06c9"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["IncludeTo"]], "paclet:VasilDimitrov/SolutionsX/ref/IncludeTo",
      "VasilDimitrov Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["sol", "TI"], "[", 
    StyleBox["object", "TI"], "]", ",", 
    StyleBox["assoc", "TI"]}], "]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "3292e376-9505-4fb3-8672-645a2f525052"],
 "\[LineSeparator]validates ",
 Cell[BoxData[
  StyleBox["assoc", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "ba7ffea9-2fae-410d-bf0a-99df4ad02a73"],
 ", stores it under ",
 Cell[BoxData[
  StyleBox["object", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "279475ed-c3b5-4d7c-b7aa-d22f938a89bd"],
 ", and makes the corresponding xAct definition.\n",
 Cell["   ", "ModInfo",ExpressionUUID->"55f613bf-a58d-45c6-a92b-1b2514e50d27"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["IncludeTo"]], "paclet:VasilDimitrov/SolutionsX/ref/IncludeTo",
      "VasilDimitrov Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["sol", "TI"], "[", 
    StyleBox["object", "TI"], "]", ",", 
    RowBox[{"{", 
     StyleBox["assoc", "TI"], 
     RowBox[{"..", "}"}]}]}], "]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "3682623a-2bdd-4aea-a0a9-036fc0a99cb9"],
 "\[LineSeparator]does the same for several entries in order.\n",
 Cell["   ", "ModInfo",ExpressionUUID->"4d768955-afb2-4f81-994e-a51532399fd6"],
 "The keys of ",
 Cell[BoxData[
  StyleBox["assoc", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "2f28fb4a-3032-447a-b5a7-08f30c690302"],
 " are those of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Options"]], "paclet:ref/Options"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "fc792f7b-7689-4c0f-b430-e1898d8c02b4"],
 "[",
 Cell[BoxData[
  StyleBox["object", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "688ea0aa-3bca-49af-9c71-03000150c256"],
 "]; missing keys take their default. Any entry already under the same key is \
unloaded first."
}], "Usage",
 CellID->294,ExpressionUUID->"a19f699b-2a89-48f1-9e57-77cd980bbdf7"],

Cell["\<\
IncludeTo[sol[object], assoc] checks the description assoc, stores it in sol, \
and makes the xAct definition it describes.\
\>", "Notes",
 CellID->295,ExpressionUUID->"b7009b46-f1ee-40a4-a9a8-bc9005dd00d1"],

Cell["\<\
The keys of assoc are those of Options[object]; a key left out takes its \
default. Keys in PropKeysOf[object] become positional arguments of the xAct \
constructor, those in OptKeysOf[object] become options.\
\>", "Notes",
 CellID->296,ExpressionUUID->"52544ec7-362a-4011-9617-a11ec340dcd5"],

Cell["\<\
A list of associations is loaded in the order given, which matters: xAct \
requires a manifold before a metric on it, and a chart before components in \
that chart.\
\>", "Notes",
 CellID->297,ExpressionUUID->"f7222ce8-1158-4736-9108-d6720a1356d3"],

Cell["\<\
An entry already stored under the same key is unloaded first, so \
re-evaluating a cell is safe.\
\>", "Notes",
 CellID->298,ExpressionUUID->"9d075383-3fd0-40f5-83c3-a0eb630eefc6"],

Cell["\<\
A rejected description surfaces as Throw::nocatch together with \
Hold[Throw[object]]; the message printed just above it names the offending \
key.\
\>", "Notes",
 CellID->299,ExpressionUUID->"2de2ed22-c651-4953-8690-5bafaf44fa39"],

Cell["IncludeTo has the attribute HoldFirst.", "Notes",
 CellID->300,ExpressionUUID->"9d7bd467-ebf8-4f8d-ae5b-1de0b2f102bb"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Examples", "PrimaryExamplesSection",
 CellTags->"PrimaryExamplesSection",
 CellID->301,ExpressionUUID->"95567daa-d713-4c83-88fa-ca05c0ed7ea0"],

Cell["Basic Examples", "ExampleSection",
 CellID->302,ExpressionUUID->"bd37bc38-e4c5-46b9-856a-96640dcf2cb3"],

Cell[BoxData[
 RowBox[{"Instantiate", "[", "sol", "]"}]], "Input",
 CellLabel->"In[ ]:=",
 CellID->303,ExpressionUUID->"0e549b7f-2bd8-4a61-962e-3a66357674c0"],

Cell["\<\
Before anything happens, M is just a name. Nothing is known about it.\
\>", "ExampleText",
 CellID->304,ExpressionUUID->"380f51dd-9aa1-48b8-ad62-e07dba83e5e4"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"ValueQ", "[", "M", "]"}], ",", " ", 
   RowBox[{"OwnValues", "[", "M", "]"}], ",", " ", 
   RowBox[{"DownValues", "[", "M", "]"}], ",", " ", 
   RowBox[{"UpValues", "[", "M", "]"}]}], "}"}]], "Input",
 CellLabel->"In[ ]:=",
 CellID->305,ExpressionUUID->"aebcfd52-6a59-4d44-86a6-ec3564076499"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"False", ",", 
   RowBox[{"{", "}"}], ",", 
   RowBox[{"{", "}"}], ",", 
   RowBox[{"{", "}"}]}], "}"}]], "Output",
 CellLabel->"Out[1]=",
 CellID->306,ExpressionUUID->"9e3d41f8-5873-4196-896a-6fdd8f5aa3e4"]
}, Open  ]],

Cell["\<\
A solution is put together from objects \[LongDash] manifolds, metrics, \
tensors, and so on. These are the kinds it knows:\
\>", "ExampleText",
 CellID->307,ExpressionUUID->"01566614-d050-4a21-9a8f-5cb1b1be511a"],

Cell[CellGroupData[{

Cell[BoxData["$Objects"], "Input",
 CellLabel->"In[ ]:=",
 CellID->308,ExpressionUUID->"f804b220-496d-4097-94ee-43d97a9a1617"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
  "$manifold", ",", "$parameter", ",", "$metric", ",", "$frame", ",", 
   "$spinStructure", ",", "$spinConnection", ",", "$bundle", ",", "$covd", 
   ",", "$chart", ",", "$basis", ",", "$form", ",", "$tensor", ",", "$spinor",
    ",", "$function", ",", "$constant", ",", "$assumption", ",", "$rule", ",",
    "$set"}], "}"}]], "Output",
 CellLabel->"Out[1]=",
 CellID->309,ExpressionUUID->"9757e756-beb8-4e31-9610-e0ace55b9a69"]
}, Open  ]],

Cell["\<\
To include a manifold, you describe the one you want. A description is a set \
of named choices, and for a manifold these are the choices there are:\
\>", "ExampleText",
 CellID->310,ExpressionUUID->"0ef73aea-6eac-4ddb-94a5-bd77d435c542"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Keys", "@", 
  RowBox[{"$manifold", "[", "]"}]}]], "Input",
 CellLabel->"In[ ]:=",
 CellID->311,ExpressionUUID->"bd5fa9fb-8037-4925-ac8f-d723b5e76d47"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
  "Symbol", ",", "Dimension", ",", "Index", ",", "Name", ",", "Master", ",", 
   "PrintAs", ",", "ProtectNewSymbol", ",", "DefInfo"}], "}"}]], "Output",
 CellLabel->"Out[1]=",
 CellID->312,ExpressionUUID->"04bf97e7-b0e5-4b9e-890f-2ac955c24f37"]
}, Open  ]],

Cell["\<\
Each choice also knows what a sensible answer looks like \[LongDash] the \
whole form at once, every key with the pattern its value has to match:\
\>", "ExampleText",
 CellID->313,ExpressionUUID->"f911745c-a2fd-4e72-872a-6c42b4b3465b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"$manifold", "[", "]"}]], "Input",
 CellLabel->"In[ ]:=",
 CellID->314,ExpressionUUID->"ae7e27ae-3134-455e-8138-b0b385841918"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"Symbol", "\[Rule]", "_Symbol"}], ",", 
   RowBox[{"Dimension", "\[Rule]", 
    RowBox[{
     RowBox[{"_Integer", "?", "Positive"}], "|", 
     InterpretationBox[
      StyleBox["d",
       ShowAutoStyles->False,
       AutoSpacing->False],
      xAct`Invar`dim,
      Editable->False]}]}], ",", 
   RowBox[{"Index", "\[Rule]", 
    RowBox[{"{", "__Symbol", "}"}]}], ",", 
   RowBox[{"Name", "\[Rule]", 
    RowBox[{"_String", "|", "name"}]}], ",", 
   RowBox[{"Master", "\[Rule]", "_Symbol"}], ",", 
   RowBox[{"PrintAs", "\[Rule]", 
    RowBox[{"_String", "|", "Identity"}]}], ",", 
   RowBox[{"ProtectNewSymbol", "\[RuleDelayed]", 
    RowBox[{"ScreenDollarIndices", "[", 
     RowBox[{"True", "|", "False"}], "]"}]}], ",", 
   RowBox[{"DefInfo", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"_String", ",", "_String"}], "}"}]}]}], 
  "\[RightAssociation]"}]], "Output",
 CellLabel->"Out[1]=",
 CellID->315,ExpressionUUID->"d14ad8fb-9481-4477-b747-f97567c9ff0a"]
}, Open  ]],

Cell["\<\
In practice you answer only what you care about. Four choices are enough \
here; the rest have defaults.\
\>", "ExampleText",
 CellID->316,ExpressionUUID->"ee1dce89-75c2-446c-bace-6b29777b22cb"],

Cell[BoxData[
 RowBox[{"IncludeTo", "[", 
  RowBox[{
   RowBox[{"sol", "[", "$manifold", "]"}], ",", " ", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"Symbol", " ", "->", " ", "M"}], ",", " ", 
     RowBox[{"Dimension", " ", "->", " ", "2"}], ",", " ", 
     RowBox[{"Index", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"a", ",", " ", "b", ",", " ", "c", ",", " ", "d"}], "}"}]}], 
     ",", " ", 
     RowBox[{"Name", " ", "->", " ", "\"\<Sphere\>\""}]}], "|>"}]}], 
  "]"}]], "Input",
 CellLabel->"In[ ]:=",
 CellID->317,ExpressionUUID->"e6d14790-6dcc-49eb-83a6-1fe66043806f"],

Cell["What got stored is the full description, defaults filled in:", \
"ExampleText",
 CellID->318,ExpressionUUID->"593dfe74-a84a-4e43-a89a-c3ec0f72d059"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"sol", "[", "$manifold", "]"}]], "Input",
 CellLabel->"In[ ]:=",
 CellID->319,ExpressionUUID->"ab7d7b37-4d4d-4ace-abde-9092357b0b35"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{"M", "\[Rule]", 
   RowBox[{"\[LeftAssociation]", 
    RowBox[{
     RowBox[{"Symbol", "\[Rule]", "M"}], ",", 
     RowBox[{"Dimension", "\[Rule]", "2"}], ",", 
     RowBox[{"Index", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"a", ",", "b", ",", "c", ",", "d"}], "}"}]}], ",", 
     RowBox[{"Name", "\[Rule]", "\<\"Sphere\"\>"}], ",", 
     RowBox[{"Master", "\[Rule]", "Null"}], ",", 
     RowBox[{"PrintAs", "\[Rule]", "Identity"}], ",", 
     RowBox[{"ProtectNewSymbol", "\[RuleDelayed]", 
      RowBox[{"ScreenDollarIndices", "[", "$ProtectNewSymbols", "]"}]}], ",", 
     
     RowBox[{"DefInfo", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"\<\"manifold\"\>", ",", "\<\"\"\>"}], "}"}]}]}], 
    "\[RightAssociation]"}]}], "\[RightAssociation]"}]], "Output",
 CellLabel->"Out[1]=",
 CellID->320,ExpressionUUID->"d6935b69-8c8b-4ba2-8e5f-a0f99b1d2bf1"]
}, Open  ]],

Cell["\<\
A description that does not make sense is refused, not repaired. Here the \
dimension is a string:\
\>", "ExampleText",
 CellID->321,ExpressionUUID->"50aa9680-51c5-4522-b8d7-65db21a7ff22"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"IncludeTo", "[", 
  RowBox[{
   RowBox[{"sol", "[", "$manifold", "]"}], ",", " ", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"Symbol", " ", "->", " ", "MM"}], ",", " ", 
     RowBox[{"Dimension", " ", "->", " ", "\"\<two\>\""}], ",", " ", 
     RowBox[{"Index", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"p", ",", " ", "q", ",", " ", "r", ",", " ", "s"}], "}"}]}]}], 
    "|>"}]}], "]"}]], "Input",
 CellLabel->"In[ ]:=",
 CellID->322,ExpressionUUID->"6218084b-db5f-466b-9b8e-48a9d59ba82f"],

Cell[BoxData[
 TemplateBox[{
  "ValidateObject", "badval", 
   "\"The value for key Dimension (two) does not match the expected pattern: \
_Integer?Positive | dim.\"", 2, 1, 1, 0, "Local"},
  "MessageTemplate"]], "Message", "MSG",
 CellLabel->"During evaluation of In[1]:=",
 CellID->323,ExpressionUUID->"b02ba8b5-3bc5-4bb8-89a2-42066d3b9b06"]
}, Open  ]],

Cell["\<\
So is one with an essential piece missing \[LongDash] without indices there \
is no manifold to make:\
\>", "ExampleText",
 CellID->324,ExpressionUUID->"d2c5fca1-d50a-497e-867a-ce5a17402059"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"IncludeTo", "[", 
  RowBox[{
   RowBox[{"sol", "[", "$manifold", "]"}], ",", " ", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"Symbol", " ", "->", " ", "MM"}], ",", " ", 
     RowBox[{"Dimension", " ", "->", " ", "2"}]}], "|>"}]}], "]"}]], "Input",
 CellLabel->"In[ ]:=",
 CellID->325,ExpressionUUID->"dd9a12e6-3749-492b-9dfc-5f4e5754e1fd"],

Cell[BoxData[
 TemplateBox[{
  "ValidateObject", "badval", 
   "\"The value for key Index ({__Symbol}) does not match the expected \
pattern: {__Symbol}.\"", 2, 1, 1, 0, "Local"},
  "MessageTemplate"]], "Message", "MSG",
 CellLabel->"During evaluation of In[1]:=",
 CellID->326,ExpressionUUID->"c8835577-d0ff-4ce9-85e8-cbe3e09f1d15"]
}, Open  ]],

Cell["And an invented key is refused by name:", "ExampleText",
 CellID->327,ExpressionUUID->"86b3aae3-8bc7-408c-87ed-1331dae8d902"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"IncludeTo", "[", 
  RowBox[{
   RowBox[{"sol", "[", "$manifold", "]"}], ",", " ", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"Symbol", " ", "->", " ", "MM"}], ",", " ", 
     RowBox[{"Dimension", " ", "->", " ", "2"}], ",", " ", 
     RowBox[{"Index", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"p", ",", " ", "q", ",", " ", "r", ",", " ", "s"}], "}"}]}], 
     ",", " ", 
     RowBox[{"Colour", " ", "->", " ", "\"\<red\>\""}]}], "|>"}]}], 
  "]"}]], "Input",
 CellLabel->"In[ ]:=",
 CellID->328,ExpressionUUID->"f7c42f24-1826-4e32-bc11-862f64ba2370"],

Cell[BoxData[
 TemplateBox[{
  "ValidateObject", "keysmismatch", 
   "\"The keys do not match. Missing keys: {}. Extra keys: {Colour}.\"", 2, 1,
    1, 0, "Local"},
  "MessageTemplate"]], "Message", "MSG",
 CellLabel->"During evaluation of In[1]:=",
 CellID->329,ExpressionUUID->"04b0256f-2389-40a4-8205-f5bf59aa0854"]
}, Open  ]],

Cell["\<\
Storing the description is only half of what happened. IncludeTo also handed \
it to xAct, there and then \[LongDash] which is why M is no longer an empty \
name:\
\>", "ExampleText",
 CellID->330,ExpressionUUID->"65791d1a-f332-4ad0-a7c0-9fcf24b1df15"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"UpValues", "[", "M", "]"}]], "Input",
 CellLabel->"In[ ]:=",
 CellID->331,ExpressionUUID->"f86697af-8114-48bd-9bb1-7d2ef2ce0cf5"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{
    RowBox[{"HoldPattern", "[", 
     RowBox[{"DefInfo", "[", "M", "]"}], "]"}], "\[RuleDelayed]", 
    RowBox[{"{", 
     RowBox[{"\<\"manifold\"\>", ",", "\<\"\"\>"}], "}"}]}], ",", 
   RowBox[{
    RowBox[{"HoldPattern", "[", 
     RowBox[{"DimOfManifold", "[", "M", "]"}], "]"}], "\[RuleDelayed]", "2"}],
    ",", 
   RowBox[{
    RowBox[{"HoldPattern", "[", 
     RowBox[{"ManifoldQ", "[", "M", "]"}], "]"}], "\[RuleDelayed]", "True"}], 
   ",", 
   RowBox[{
    RowBox[{"HoldPattern", "[", 
     RowBox[{"PrintAs", "[", "M", "]"}], "]"}], 
    "\[RuleDelayed]", "\<\"M\"\>"}], ",", 
   RowBox[{
    RowBox[{"HoldPattern", "[", 
     RowBox[{"ServantsOf", "[", "M", "]"}], "]"}], "\[RuleDelayed]", 
    RowBox[{"{", 
     InterpretationBox[
      StyleBox["\[DoubleStruckCapitalT]M",
       ShowAutoStyles->False,
       AutoSpacing->False],
      $CellContext`TangentM,
      Editable->False], "}"}]}], ",", 
   RowBox[{
    RowBox[{"HoldPattern", "[", 
     RowBox[{"SplittingsOfManifold", "[", "M", "]"}], "]"}], "\[RuleDelayed]", 
    RowBox[{"{", "}"}]}]}], "}"}]], "Output",
 CellLabel->"Out[1]=",
 CellID->332,ExpressionUUID->"52c4644c-1afd-43f9-811a-f1e51d77940a"]
}, Open  ]],

Cell["\<\
?M in a notebook shows the same. xAct even built the tangent bundle by itself.\
\>", "ExampleText",
 CellID->333,ExpressionUUID->"19981d7e-594d-4a96-90ee-b0afcae30cf2"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"ManifoldQ", "[", "M", "]"}], ",", " ", 
   RowBox[{"DimOfManifold", "[", "M", "]"}], ",", " ", 
   RowBox[{"ServantsOf", "[", "M", "]"}], ",", " ", 
   RowBox[{"VBundleQ", "[", "TangentM", "]"}]}], "}"}]], "Input",
 CellLabel->"In[ ]:=",
 CellID->334,ExpressionUUID->"1d7228a3-25e3-4fcc-8680-cfbd8c3b0f17"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "2", ",", 
   RowBox[{"{", 
    InterpretationBox[
     StyleBox["\[DoubleStruckCapitalT]M",
      ShowAutoStyles->False,
      AutoSpacing->False],
     $CellContext`TangentM,
     Editable->False], "}"}], ",", "True"}], "}"}]], "Output",
 CellLabel->"Out[1]=",
 CellID->335,ExpressionUUID->"66aecfe8-342f-4c83-a898-6ff4e4c4ba5c"]
}, Open  ]],

Cell["\<\
Several objects can go in at once, as a list, defined in order. A vector and \
a symmetric tensor on M:\
\>", "ExampleText",
 CellID->336,ExpressionUUID->"dfc281d3-c64d-437d-92aa-1ad2c3c45031"],

Cell[BoxData[
 RowBox[{"IncludeTo", "[", 
  RowBox[{
   RowBox[{"sol", "[", "$tensor", "]"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"Symbol", " ", "->", " ", 
        RowBox[{"vv", "[", "a", "]"}]}], ",", " ", 
       RowBox[{"Manifold", " ", "->", " ", "M"}], ",", " ", 
       RowBox[{"Symmetry", " ", "->", " ", "None"}]}], "|>"}], ",", " ", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"Symbol", " ", "->", " ", 
        RowBox[{"hh", "[", 
         RowBox[{
          RowBox[{"-", "a"}], ",", " ", 
          RowBox[{"-", "b"}]}], "]"}]}], ",", " ", 
       RowBox[{"Manifold", " ", "->", " ", "M"}], ",", " ", 
       RowBox[{"Symmetry", " ", "->", " ", 
        RowBox[{"Symmetric", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "a"}], ",", " ", 
           RowBox[{"-", "b"}]}], "}"}], "]"}]}]}], "|>"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[ ]:=",
 CellID->337,ExpressionUUID->"33f46a59-bcae-4f56-a611-2c08adec6565"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Keys", "[", 
  RowBox[{"sol", "[", "$tensor", "]"}], "]"}]], "Input",
 CellLabel->"In[ ]:=",
