}], "Usage",
 CellID->712,ExpressionUUID->"06cc35f6-3b94-4c0a-b34b-f9238bb45fcb"],

Cell["\<\
DeleteData[name] removes the entry directory and everything in it, including \
the notebook. There is no confirmation and no undo.\
\>", "Notes",
 CellID->713,ExpressionUUID->"f2a62dd1-8694-4c09-b569-5e7342bd0fe6"],

Cell["\<\
It issues DeleteData::missingname if the entry is not found under the current \
$Alias.\
\>", "Notes",
 CellID->714,ExpressionUUID->"a279396b-ce50-4a4e-a4fc-b79814bed0cb"],

Cell["\<\
SaveData calls DeleteData internally when overwriting an existing entry.\
\>", "Notes",
 CellID->715,ExpressionUUID->"67019d97-a506-44ac-8656-bdc52f225368"]
}, Open  ]],

