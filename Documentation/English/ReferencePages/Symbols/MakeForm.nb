Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"579698bf-dfe9-4afc-ba34-102bcb4e8a9b"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["MakeForm"]], "paclet:VasilDimitrov/SolutionsX/ref/MakeForm", 
     "VasilDimitrov Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["chart", "TI"], "]", "[", 
   StyleBox["array", "TI"], "]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "4b056690-08e9-4cc3-94bf-99b3da300a7d"],
 "\[LineSeparator]gives the differential form of the totally antisymmetric ",
 Cell[BoxData[
  StyleBox["array", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "42233ec9-867d-4a2b-97cb-aa448d1a2009"],
 " in ",
 Cell[BoxData[
  StyleBox["chart", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "6a32422b-d142-43b3-8834-a9dfd523e13d"],
 ", as a sum of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Wedge"]], "paclet:ref/Wedge"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "129775bf-0f2d-4659-aca9-a7c5bd77c42f"],
 " of coordinate differentials."
}], "Usage",
 CellID->1089,ExpressionUUID->"9da8a48d-0edc-46f7-8a2b-4f22dfea765e"],

Cell["\<\
MakeForm[chart][array] gives the degree-n form whose components are array, \
where n is the depth of array, as a sum of wedges of coordinate differentials \
divided by n!.\
\>", "Notes",
 CellID->1090,ExpressionUUID->"20c3efb3-79f4-49c4-85a8-cf52a40b0511"],

Cell["\<\
array must be cubical of side the number of coordinates of chart.\
\>", "Notes",
 CellID->1091,ExpressionUUID->"03e3420f-3e75-4eda-8cf4-e22a49d1ddd9"],

Cell["\<\
Only the antisymmetric part of array survives, since MakeArray \
antisymmetrises when reading a form back.\
\>", "Notes",
 CellID->1092,ExpressionUUID->"cbd9452c-63ea-4fa9-a4e7-7614770c44ff"],

Cell["MakeForm is the inverse of MakeArray.", "Notes",
 CellID->1093,ExpressionUUID->"224e4296-48d2-4813-9f49-b294317b7c23"]
}, Open  ]],

