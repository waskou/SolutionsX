Cell["MakeForm", "ObjectName",
 CellID->1074,ExpressionUUID->"e7fc2fe4-c1d2-4ad4-8889-958d996c8d8f"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"c4ed6be1-6dcd-437c-8380-38e1b9843bbc"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["MakeForm"]], "paclet:VasilDimitrov/SolutionsX/ref/MakeForm", 
     "VasilDimitrov Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["chart", "TI"], "]", "[", 
   StyleBox["array", "TI"], "]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "e58e54b0-c086-4aba-b7e0-3a6ddadc3778"],
 "\[LineSeparator]gives the differential form of the totally antisymmetric ",
 Cell[BoxData[
  StyleBox["array", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "0514392c-f190-4382-a058-2553077dfbf1"],
 " in ",
 Cell[BoxData[
  StyleBox["chart", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "7578ea4b-112f-4b18-8b5a-2bdaf7a26d42"],
 ", as a sum of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Wedge"]], "paclet:ref/Wedge"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "7498256b-b069-4861-b8bc-e771ab3b7363"],
 " of coordinate differentials."
}], "Usage",
 CellID->1075,ExpressionUUID->"3146f9f0-9251-441e-bb33-5f3698928984"],

Cell["\<\
MakeForm[chart][array] gives the degree-n form whose components are array, \
where n is the depth of array, as a sum of wedges of coordinate differentials \
divided by n!.\
\>", "Notes",
 CellID->1076,ExpressionUUID->"aa4b9a4c-7aeb-4978-8cfb-8edddb4dcfd0"],

Cell["\<\
array must be cubical of side the number of coordinates of chart.\
\>", "Notes",
 CellID->1077,ExpressionUUID->"966a23dc-64b0-497f-a1d1-5e52bbc9b746"],

Cell["\<\
Only the antisymmetric part of array survives, since MakeArray \
antisymmetrises when reading a form back.\
\>", "Notes",
 CellID->1078,ExpressionUUID->"30d38acc-e5a3-4eb0-8d67-34cf1aba49fc"],

Cell["MakeForm is the inverse of MakeArray.", "Notes",
 CellID->1079,ExpressionUUID->"7d65d3ae-a16a-4228-91fc-9155e12004c3"]
}, Open  ]],

