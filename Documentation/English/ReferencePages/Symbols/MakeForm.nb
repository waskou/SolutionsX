 RowBox[{
  RowBox[{"IncludeTo", "[", 
   RowBox[{
    RowBox[{"sol", "[", "$chart", "]"}], ",", " ", 
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"Symbol", " ", "->", " ", "ch"}], ",", " ", 
      RowBox[{"Manifold", " ", "->", " ", "M"}], ",", " ", 
