Cell[CellGroupData[{

Cell["DropFrom", "ObjectName",
 CellID->381,ExpressionUUID->"9bea19af-a444-41c3-8380-7e93279cf7e9"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"db0bd692-710a-45dd-9ff6-8698c970007a"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["DropFrom"]], "paclet:VasilDimitrov/SolutionsX/ref/DropFrom", 
     "VasilDimitrov Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["sol", "TI"], "[", 
    StyleBox["object", "TI"], "]", ",", 
    StyleBox["key", "TI"]}], "]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "71e3c26d-3509-40af-8838-d366abbc9371"],
 "\[LineSeparator]undefines the entry and removes it from ",
 Cell[BoxData[
  StyleBox["sol", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "d2b2c2db-8cf1-476d-a01a-24e7edd4ee46"],
 "; a list of keys is also accepted.\n",
 Cell["   ", "ModInfo",ExpressionUUID->"729d023a-d3d1-4e6c-8f6e-0587df97dd0b"],
 "Unlike ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Unload"]], "paclet:VasilDimitrov/SolutionsX/ref/Unload", 
    "VasilDimitrov Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "e9a96085-0cde-4512-abac-fe92c9048069"],
 ", ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DropFrom"]], "paclet:VasilDimitrov/SolutionsX/ref/DropFrom", 
    "VasilDimitrov Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "d3232b02-6ca9-488b-bdf2-23cfe0fd359c"],
 " forgets the stored association as well."
}], "Usage",
 CellID->382,ExpressionUUID->"c62d2357-99c6-43c7-be8f-73000ca06b64"],

Cell["\<\
DropFrom[sol[object], key] undefines the xAct object and forgets the stored \
description. Unload does only the first of these, which is why an unloaded \
entry can be loaded again and a dropped one cannot.\
\>", "Notes",
 CellID->383,ExpressionUUID->"8a933eba-2e2c-412f-8497-735d812fac91"],

Cell["\<\
A list of keys is also accepted, and is processed in the order given.\
\>", "Notes",
 CellID->384,ExpressionUUID->"40271f16-ae41-4c9a-b08d-65daf989a52f"],

Cell["\<\
Entries are matched by name rather than by symbol: the teardown Removes the \
symbol, and Revive replaces it throughout the solution with a fresh one of \
the same name.\
\>", "Notes",
 CellID->385,ExpressionUUID->"51eddbe1-2d31-4477-9b68-cc1b35b6d7da"],

Cell["\<\
Dropping a $manifold or a $bundle takes its visitors down with it, since xAct \
will not undefine a host while anything still lives on it. The visitors' own \
entries in sol survive, and a later Load would try to rebuild them on a \
manifold that is gone.\
\>", "Notes",
 CellID->386,ExpressionUUID->"c9900e48-ecd7-47bb-8029-c38ad72eb236"],

Cell["DropFrom has the attribute HoldFirst.", "Notes",
 CellID->387,ExpressionUUID->"aa6c5bf5-3888-4dc1-bae3-cbf669d3251f"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Examples", "PrimaryExamplesSection",
 CellTags->"PrimaryExamplesSection",
 CellID->388,ExpressionUUID->"a5289e92-5fe1-48a7-88cc-f730373061db"],

Cell["Basic Examples", "ExampleSection",
 CellID->389,ExpressionUUID->"8b19794c-5658-4be7-9598-f4c082c976e2"],

Cell["\<\
Start from where the IncludeTo page ends: a manifold carrying a vector vv and \
a symmetric tensor hh.\
\>", "ExampleText",
 CellID->390,ExpressionUUID->"d5757e6a-19b7-4ebf-b7ab-5750067a1fcf"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Instantiate", "[", "sol", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"IncludeTo", "[", 
   RowBox[{
    RowBox[{"sol", "[", "$manifold", "]"}], ",", " ", 
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"Symbol", " ", "->", " ", "M"}], ",", " ", 
      RowBox[{"Dimension", " ", "->", " ", "2"}], ",", " ", 
      RowBox[{"Index", " ", "->", " ", 
       RowBox[{"{", 
        RowBox[{"a", ",", " ", "b", ",", " ", "c", ",", " ", "d"}], "}"}]}], 
      ",", " ", 
      RowBox[{"Name", " ", "->", " ", "\"\<Sphere\>\""}]}], "|>"}]}], "]"}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"IncludeTo", "[", 
   RowBox[{
    RowBox[{"sol", "[", "$tensor", "]"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"Symbol", " ", "->", " ", 
         RowBox[{"vv", "[", "a", "]"}]}], ",", " ", 
        RowBox[{"Manifold", " ", "->", " ", "M"}], ",", " ", 
        RowBox[{"Symmetry", " ", "->", " ", "None"}]}], "|>"}], ",", " ", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"Symbol", " ", "->", " ", 
         RowBox[{"hh", "[", 
          RowBox[{
           RowBox[{"-", "a"}], ",", " ", 
           RowBox[{"-", "b"}]}], "]"}]}], ",", " ", 
        RowBox[{"Manifold", " ", "->", " ", "M"}], ",", " ", 
        RowBox[{"Symmetry", " ", "->", " ", 
         RowBox[{"Symmetric", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "a"}], ",", " ", 
            RowBox[{"-", "b"}]}], "}"}], "]"}]}]}], "|>"}]}], "}"}]}], "]"}], 
  ";"}]}], "Input",
 CellLabel->"In[ ]:=",
 CellID->391,ExpressionUUID->"5e491c1d-f6a7-4362-bde9-095584aa9c13"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Keys", "[", 
    RowBox[{"sol", "[", "$manifold", "]"}], "]"}], ",", " ", 
   RowBox[{"Keys", "[", 
    RowBox[{"sol", "[", "$tensor", "]"}], "]"}]}], "}"}]], "Input",
 CellLabel->"In[ ]:=",
 CellID->392,ExpressionUUID->"862b88a3-3704-4a40-aafe-ec1a3c2197e6"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", "M", "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"vv", ",", "hh"}], "}"}]}], "}"}]], "Output",
 CellLabel->"Out[1]=",
 CellID->393,ExpressionUUID->"3fa699b5-2d47-42b3-91cf-2c231090d988"]
}, Open  ]],

Cell["\<\
DropFrom is how an entry leaves for good: the xAct object is undefined, and \
the description is forgotten too.\
\>", "ExampleText",
 CellID->394,ExpressionUUID->"442aa2d9-7fa6-4187-8674-87b93c2782f9"],

Cell[BoxData[
 RowBox[{"DropFrom", "[", 
  RowBox[{
   RowBox[{"sol", "[", "$tensor", "]"}], ",", " ", "hh"}], "]"}]], "Input",
 CellLabel->"In[ ]:=",
 CellID->395,ExpressionUUID->"0958950b-6490-48dc-a2f6-9d1e60d9ddd9"],

Cell["\<\
hh is a plain name again, exactly as it was before IncludeTo, and the \
solution no longer remembers it:\
\>", "ExampleText",
 CellID->396,ExpressionUUID->"c900251d-ac4e-4a93-b05c-43f36a21f0c5"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"xTensorQ", "[", "hh", "]"}], ",", " ", 
   RowBox[{"UpValues", "[", "hh", "]"}]}], "}"}]], "Input",
 CellLabel->"In[ ]:=",
 CellID->397,ExpressionUUID->"e0751bd6-1918-4c94-a9fd-f293e8a6fcf8"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"False", ",", 
   RowBox[{"{", "}"}]}], "}"}]], "Output",
 CellLabel->"Out[1]=",
 CellID->398,ExpressionUUID->"5135c7f5-60e6-4317-802d-d5d4daa1ff80"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Keys", "[", 
  RowBox[{"sol", "[", "$tensor", "]"}], "]"}]], "Input",
 CellLabel->"In[ ]:=",
 CellID->399,ExpressionUUID->"0cd1a99b-49e4-4bf4-be4e-14d37a584898"],

Cell[BoxData[
 RowBox[{"{", "vv", "}"}]], "Output",
 CellLabel->"Out[1]=",
 CellID->400,ExpressionUUID->"2a7151e8-6341-45ff-9658-2c3d75b7aae3"]
}, Open  ]],

Cell["\<\
Unload is the gentler operation. It takes the definition down but keeps the \
description, so the entry can come back:\
\>", "ExampleText",
 CellID->401,ExpressionUUID->"438e0ae9-b0aa-4481-98d2-cc350a51b7ba"],

Cell[BoxData[
 RowBox[{"Unload", "[", 
  RowBox[{
   RowBox[{"sol", "[", "$tensor", "]"}], ",", " ", "vv"}], "]"}]], "Input",
 CellLabel->"In[ ]:=",
 CellID->402,ExpressionUUID->"fd9d51f9-1e6e-4f8c-b684-aa87bd7f29c5"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"xTensorQ", "[", "vv", "]"}], ",", " ", 
   RowBox[{"Keys", "[", 
    RowBox[{"sol", "[", "$tensor", "]"}], "]"}]}], "}"}]], "Input",
 CellLabel->"In[ ]:=",
 CellID->403,ExpressionUUID->"ce50b6cf-26e4-4080-adf1-c94acc40b481"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"False", ",", 
   RowBox[{"{", "vv", "}"}]}], "}"}]], "Output",
 CellLabel->"Out[1]=",
 CellID->404,ExpressionUUID->"a1042b33-15b0-49e9-8aca-b2a1e2dd1f76"]
}, Open  ]],

Cell[BoxData[
 RowBox[{"Load", "[", 
  RowBox[{
   RowBox[{"sol", "[", "$tensor", "]"}], ",", " ", "vv"}], "]"}]], "Input",
 CellLabel->"In[ ]:=",
 CellID->405,ExpressionUUID->"c6e7b24e-8171-4ae2-8cf6-c8b6bcc3f4b5"],

Cell["\<\
The manifold is a different story: vv lives on it, and xAct refuses to \
undefine a host while anything is still attached.\
\>", "ExampleText",
 CellID->406,ExpressionUUID->"38bb341a-ac60-43ab-9b10-2411cf5c7860"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"VisitorsOf", "[", "M", "]"}]], "Input",
 CellLabel->"In[ ]:=",
 CellID->407,ExpressionUUID->"5226856b-9668-4618-a9e8-9342ba7bf7eb"],

Cell[BoxData[
 RowBox[{"{", "vv", "}"}]], "Output",
 CellLabel->"Out[1]=",
 CellID->408,ExpressionUUID->"3d382802-15d5-4a09-bf8e-d11f7237b6c1"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"UndefManifold", "[", "M", "]"}]], "Input",
 CellLabel->"In[ ]:=",
 CellID->409,ExpressionUUID->"a547a19d-48ba-4dff-bc85-e73bc9a2e9f3"],

Cell[BoxData[
 TemplateBox[{
  "General", "noundef", 
   "\"Symbol M cannot be undefined because it has visitors.\"", 2, 1, 1, 0, 
   "Local"},
  "MessageTemplate"]], "Message", "MSG",
 CellLabel->"During evaluation of In[1]:=",
 CellID->410,ExpressionUUID->"7295627e-eacc-4e63-b799-ce5fca09dce2"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ManifoldQ", "[", "M", "]"}]], "Input",
 CellLabel->"In[ ]:=",
 CellID->411,ExpressionUUID->"1aa4aa02-dc22-486c-bac9-db9e4987fd1d"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]=",
 CellID->412,ExpressionUUID->"52ed1eba-0a53-4f5d-acee-315b5c21a86b"]
}, Open  ]],

Cell["\<\
DropFrom gets past the refusal the only way there is \[LongDash] by taking \
the visitors down first. The manifold goes, and vv goes with it.\
\>", "ExampleText",
 CellID->413,ExpressionUUID->"51d764cb-a294-49f6-9de3-612f168c7b2a"],

Cell[BoxData[
 RowBox[{"DropFrom", "[", 
  RowBox[{
   RowBox[{"sol", "[", "$manifold", "]"}], ",", " ", "M"}], "]"}]], "Input",
 CellLabel->"In[ ]:=",
 CellID->414,ExpressionUUID->"2a0cca7e-9263-4cf8-bb61-0640694be886"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"ManifoldQ", "[", "M", "]"}], ",", " ", 
   RowBox[{"xTensorQ", "[", "vv", "]"}], ",", " ", 
   RowBox[{"Keys", "[", 
    RowBox[{"sol", "[", "$manifold", "]"}], "]"}]}], "}"}]], "Input",
 CellLabel->"In[ ]:=",
 CellID->415,ExpressionUUID->"2191a6a5-8077-481c-af4c-9ec1e8794ee2"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"False", ",", "False", ",", 
   RowBox[{"{", "}"}]}], "}"}]], "Output",
 CellLabel->"Out[1]=",
 CellID->416,ExpressionUUID->"94262cb1-2e27-4750-b86a-9cd67761f600"]
}, Open  ]],

Cell["\<\
One thing the cascade does not do is forget vv's description. It is still on \
record, and a later Load would try to rebuild vv on a manifold that is no \
longer there.\
\>", "ExampleText",
 CellID->417,ExpressionUUID->"a40bddca-db63-41e9-862f-4e5375ced81c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Keys", "[", 
  RowBox[{"sol", "[", "$tensor", "]"}], "]"}]], "Input",
 CellLabel->"In[ ]:=",
 CellID->418,ExpressionUUID->"eefa7fe4-d704-4d50-9b5d-b0195c5cc5e9"],

Cell[BoxData[
 RowBox[{"{", "vv", "}"}]], "Output",
 CellLabel->"Out[1]=",
 CellID->419,ExpressionUUID->"0da0f816-3a34-47de-9b52-e5aac50b8311"]
}, Open  ]]
}, Open  ]],

