Cell["DropFrom", "ObjectName",
 CellID->362,ExpressionUUID->"cfac37df-1da1-472f-942b-88b12ab436a5"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"9bc52f05-42b0-4822-8d87-2699a12599a8"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["DropFrom"]], "paclet:VasilDimitrov/SolutionsX/ref/DropFrom", 
     "VasilDimitrov Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["sol", "TI"], "[", 
    StyleBox["object", "TI"], "]", ",", 
    StyleBox["key", "TI"]}], "]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "48d2e578-817d-4d71-82a1-e9a948aac22e"],
 "\[LineSeparator]undefines the entry and removes it from ",
 Cell[BoxData[
  StyleBox["sol", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "fa5decaf-7436-4a4b-8cb4-25ed989b5031"],
 "; a list of keys is also accepted.\n",
 Cell["   ", "ModInfo",ExpressionUUID->"82c8b872-ab4f-447c-ba9b-809dc32e898a"],
 "Unlike ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Unload"]], "paclet:VasilDimitrov/SolutionsX/ref/Unload", 
    "VasilDimitrov Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "e7f23e75-0f98-4832-ab77-a14ece00edd9"],
 ", ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DropFrom"]], "paclet:VasilDimitrov/SolutionsX/ref/DropFrom", 
    "VasilDimitrov Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "177e99a3-d83f-4847-a73c-a7aac5e17c9d"],
 " forgets the stored association as well."
}], "Usage",
 CellID->363,ExpressionUUID->"e3454f6a-4e01-42ae-a7fe-a0f5726bf6f1"],

Cell["\<\
DropFrom[sol[object], key] undefines the xAct object and forgets the stored \
description. Unload does only the first of these, which is why an unloaded \
entry can be loaded again and a dropped one cannot.\
\>", "Notes",
 CellID->364,ExpressionUUID->"9d47add6-2750-4cd6-a9a4-11a85897ceca"],

Cell["\<\
A list of keys is also accepted, and is processed in the order given.\
\>", "Notes",
 CellID->365,ExpressionUUID->"f30562e6-e401-4a82-906a-d7352303581d"],

Cell["\<\
Entries are matched by name rather than by symbol: the teardown Removes the \
symbol, and Revive replaces it throughout the solution with a fresh one of \
the same name.\
\>", "Notes",
 CellID->366,ExpressionUUID->"8dedd891-a41f-4754-9ea4-8c8c81e5affa"],

Cell["\<\
Dropping a $manifold or a $bundle takes its visitors down with it, since xAct \
will not undefine a host while anything still lives on it. The visitors' own \
entries in sol survive, and a later Load would try to rebuild them on a \
manifold that is gone.\
\>", "Notes",
 CellID->367,ExpressionUUID->"69da3bb8-b324-4644-a3c2-760df1e78712"],

Cell["DropFrom has the attribute HoldFirst.", "Notes",
 CellID->368,ExpressionUUID->"41233f82-ce39-41f0-9f0f-410495f6e2e1"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Examples", "PrimaryExamplesSection",
 CellTags->"PrimaryExamplesSection",
 CellID->369,ExpressionUUID->"72be3063-83ae-424c-8bbd-721c8ae76680"],

Cell["Basic Examples", "ExampleSection",
 CellID->370,ExpressionUUID->"245184bf-7067-478f-89a7-0ce403078709"],

Cell["\<\
Start from where the IncludeTo page ends: a manifold carrying a vector vv and \
a symmetric tensor hh.\
\>", "ExampleText",
 CellID->371,ExpressionUUID->"aaee66c3-03a4-48a6-926b-9d8d6bddbc99"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Instantiate", "[", "sol", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"IncludeTo", "[", 
   RowBox[{
    RowBox[{"sol", "[", "$manifold", "]"}], ",", " ", 
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"Symbol", " ", "->", " ", "M"}], ",", " ", 
      RowBox[{"Dimension", " ", "->", " ", "2"}], ",", " ", 
      RowBox[{"Index", " ", "->", " ", 
       RowBox[{"{", 
        RowBox[{"a", ",", " ", "b", ",", " ", "c", ",", " ", "d"}], "}"}]}], 
      ",", " ", 
      RowBox[{"Name", " ", "->", " ", "\"\<Sphere\>\""}]}], "|>"}]}], "]"}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"IncludeTo", "[", 
   RowBox[{
    RowBox[{"sol", "[", "$tensor", "]"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"Symbol", " ", "->", " ", 
         RowBox[{"vv", "[", "a", "]"}]}], ",", " ", 
        RowBox[{"Manifold", " ", "->", " ", "M"}], ",", " ", 
        RowBox[{"Symmetry", " ", "->", " ", "None"}]}], "|>"}], ",", " ", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"Symbol", " ", "->", " ", 
         RowBox[{"hh", "[", 
          RowBox[{
           RowBox[{"-", "a"}], ",", " ", 
           RowBox[{"-", "b"}]}], "]"}]}], ",", " ", 
        RowBox[{"Manifold", " ", "->", " ", "M"}], ",", " ", 
        RowBox[{"Symmetry", " ", "->", " ", 
         RowBox[{"Symmetric", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "a"}], ",", " ", 
            RowBox[{"-", "b"}]}], "}"}], "]"}]}]}], "|>"}]}], "}"}]}], "]"}], 
  ";"}]}], "Input",
 CellLabel->"In[ ]:=",
 CellID->372,ExpressionUUID->"9d05d4be-504e-494e-9e90-801ccf0ea5c7"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Keys", "[", 
    RowBox[{"sol", "[", "$manifold", "]"}], "]"}], ",", " ", 
   RowBox[{"Keys", "[", 
    RowBox[{"sol", "[", "$tensor", "]"}], "]"}]}], "}"}]], "Input",
 CellLabel->"In[ ]:=",
 CellID->373,ExpressionUUID->"9bd4e88c-7202-4b94-b614-d65542545dd4"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", "M", "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"vv", ",", "hh"}], "}"}]}], "}"}]], "Output",
 CellLabel->"Out[1]=",
 CellID->374,ExpressionUUID->"0515ed94-ad80-4e3e-8f73-8388810f466b"]
}, Open  ]],

Cell["\<\
DropFrom is how an entry leaves for good: the xAct object is undefined, and \
the description is forgotten too.\
\>", "ExampleText",
 CellID->375,ExpressionUUID->"c1b53201-313d-4251-8d8d-0b0fea8835b3"],

Cell[BoxData[
 RowBox[{"DropFrom", "[", 
  RowBox[{
   RowBox[{"sol", "[", "$tensor", "]"}], ",", " ", "hh"}], "]"}]], "Input",
 CellLabel->"In[ ]:=",
 CellID->376,ExpressionUUID->"64bcf8b4-4a54-4e64-9efd-30d491ef0efd"],

Cell["\<\
hh is a plain name again, exactly as it was before IncludeTo, and the \
solution no longer remembers it:\
\>", "ExampleText",
 CellID->377,ExpressionUUID->"bde2663e-bbe2-4cff-b683-8e58bd51ef9b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"xTensorQ", "[", "hh", "]"}], ",", " ", 
   RowBox[{"UpValues", "[", "hh", "]"}]}], "}"}]], "Input",
 CellLabel->"In[ ]:=",
 CellID->378,ExpressionUUID->"a477d808-7902-4128-99ce-a6ebfb81f847"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"False", ",", 
   RowBox[{"{", "}"}]}], "}"}]], "Output",
 CellLabel->"Out[1]=",
 CellID->379,ExpressionUUID->"6ef17df3-855e-43a7-b69d-00afa03ca5e4"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Keys", "[", 
  RowBox[{"sol", "[", "$tensor", "]"}], "]"}]], "Input",
 CellLabel->"In[ ]:=",
 CellID->380,ExpressionUUID->"c16d6108-8d1c-4e33-9f58-c8d535311a86"],

Cell[BoxData[
 RowBox[{"{", "vv", "}"}]], "Output",
 CellLabel->"Out[1]=",
 CellID->381,ExpressionUUID->"3a9fbec7-812f-4eb7-8ec8-41533ffbc45d"]
}, Open  ]],

Cell["\<\
Unload is the gentler operation. It takes the definition down but keeps the \
description, so the entry can come back:\
\>", "ExampleText",
 CellID->382,ExpressionUUID->"d790ff0c-5149-4b8c-8b5e-62986cfb7588"],

Cell[BoxData[
 RowBox[{"Unload", "[", 
  RowBox[{
   RowBox[{"sol", "[", "$tensor", "]"}], ",", " ", "vv"}], "]"}]], "Input",
 CellLabel->"In[ ]:=",
 CellID->383,ExpressionUUID->"826ad14c-a145-4bd1-a4d4-5490531e6c71"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"xTensorQ", "[", "vv", "]"}], ",", " ", 
   RowBox[{"Keys", "[", 
    RowBox[{"sol", "[", "$tensor", "]"}], "]"}]}], "}"}]], "Input",
 CellLabel->"In[ ]:=",
 CellID->384,ExpressionUUID->"ff8d4a90-7419-4b7b-a7b3-c49cacfeda28"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"False", ",", 
   RowBox[{"{", "vv", "}"}]}], "}"}]], "Output",
 CellLabel->"Out[1]=",
 CellID->385,ExpressionUUID->"fd1c98e5-f34b-41a8-83f1-2ca903f9f807"]
}, Open  ]],

Cell[BoxData[
 RowBox[{"Load", "[", 
  RowBox[{
   RowBox[{"sol", "[", "$tensor", "]"}], ",", " ", "vv"}], "]"}]], "Input",
 CellLabel->"In[ ]:=",
 CellID->386,ExpressionUUID->"d3d66575-70ab-4a4c-8514-fd145858e1f9"],

Cell["\<\
The manifold is a different story: vv lives on it, and xAct refuses to \
undefine a host while anything is still attached.\
\>", "ExampleText",
 CellID->387,ExpressionUUID->"6811350a-3f29-4bd6-88b0-bc79f11ee9ed"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"VisitorsOf", "[", "M", "]"}]], "Input",
 CellLabel->"In[ ]:=",
 CellID->388,ExpressionUUID->"32f8588f-c4c8-4cfe-b45c-33d358bc4c16"],

Cell[BoxData[
 RowBox[{"{", "vv", "}"}]], "Output",
 CellLabel->"Out[1]=",
 CellID->389,ExpressionUUID->"b7272bce-7d65-4daa-9744-e26ea84ca215"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"UndefManifold", "[", "M", "]"}]], "Input",
 CellLabel->"In[ ]:=",
 CellID->390,ExpressionUUID->"dd87b6d3-4814-49ec-aa93-c803fac01cfe"],

Cell[BoxData[
 TemplateBox[{
  "General", "noundef", 
   "\"Symbol M cannot be undefined because it has visitors.\"", 2, 1, 1, 0, 
   "Local"},
  "MessageTemplate"]], "Message", "MSG",
 CellLabel->"During evaluation of In[1]:=",
 CellID->391,ExpressionUUID->"900e7231-3e9a-4726-923e-ce29fb928171"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ManifoldQ", "[", "M", "]"}]], "Input",
 CellLabel->"In[ ]:=",
 CellID->392,ExpressionUUID->"068624c3-14eb-4474-bf4f-7f300de0c87e"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]=",
 CellID->393,ExpressionUUID->"0e24371c-f7f1-4254-92fe-4782eef3cb24"]
}, Open  ]],

Cell["\<\
DropFrom gets past the refusal the only way there is \[LongDash] by taking \
the visitors down first. The manifold goes, and vv goes with it.\
\>", "ExampleText",
 CellID->394,ExpressionUUID->"c35d02cb-eccd-4ae6-bcd4-e6f87465489a"],

Cell[BoxData[
 RowBox[{"DropFrom", "[", 
  RowBox[{
   RowBox[{"sol", "[", "$manifold", "]"}], ",", " ", "M"}], "]"}]], "Input",
 CellLabel->"In[ ]:=",
 CellID->395,ExpressionUUID->"c94d3c71-6012-4008-8b30-01704e32363f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"ManifoldQ", "[", "M", "]"}], ",", " ", 
   RowBox[{"xTensorQ", "[", "vv", "]"}], ",", " ", 
   RowBox[{"Keys", "[", 
    RowBox[{"sol", "[", "$manifold", "]"}], "]"}]}], "}"}]], "Input",
 CellLabel->"In[ ]:=",
 CellID->396,ExpressionUUID->"f2bee4f5-b210-4d47-b4d0-c5114a4b1599"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"False", ",", "False", ",", 
   RowBox[{"{", "}"}]}], "}"}]], "Output",
 CellLabel->"Out[1]=",
 CellID->397,ExpressionUUID->"c3d321e5-fad5-438f-bae3-70a27157d7a7"]
}, Open  ]],

Cell["\<\
One thing the cascade does not do is forget vv's description. It is still on \
record, and a later Load would try to rebuild vv on a manifold that is no \
longer there.\
\>", "ExampleText",
 CellID->398,ExpressionUUID->"e2e3e0ea-c2e8-45d1-a987-1e191a0a69d0"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Keys", "[", 
  RowBox[{"sol", "[", "$tensor", "]"}], "]"}]], "Input",
 CellLabel->"In[ ]:=",
 CellID->399,ExpressionUUID->"cfd1ae14-4b45-40b9-8923-f4faa61fc570"],

Cell[BoxData[
 RowBox[{"{", "vv", "}"}]], "Output",
 CellLabel->"Out[1]=",
 CellID->400,ExpressionUUID->"3c24f16d-4108-4449-99e0-843caf83804b"]
}, Open  ]]
}, Open  ]],

