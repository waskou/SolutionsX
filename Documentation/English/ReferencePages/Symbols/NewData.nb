\>", "ExampleText",
 CellID->210,ExpressionUUID->"f141651d-5d8d-4b39-8fe6-e6f5b486b4c5"],

Cell["Basic Examples", "ExampleSection",
 CellID->211,ExpressionUUID->"3e0bfb35-1641-4895-ad56-ec115a0021a2"],

Cell[BoxData[
 RowBox[{"NewData", "[", "]"}]], "Input",
 CellLabel->"In[ ]:=",
 CellID->212,ExpressionUUID->"239a3aff-6b98-4899-91cd-d56343ab7a30"]
}, Open  ]],

