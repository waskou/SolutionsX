Cell[BoxData[
 RowBox[{
  RowBox[{"IncludeTo", "[", 
   RowBox[{
    RowBox[{"sol", "[", "$manifold", "]"}], ",", " ", 
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"Symbol", " ", "->", " ", "M"}], ",", " ", 
      RowBox[{"Dimension", " ", "->", " ", "2"}], ",", " ", 
      RowBox[{"Index", " ", "->", " ", 
       RowBox[{"{", 
        RowBox[{"a", ",", " ", "b", ",", " ", "c", ",", " ", "d"}], "}"}]}], 
      ",", " ", 
      RowBox[{"Name", " ", "->", " ", "\"\<Sphere\>\""}]}], "|>"}]}], "]"}], 
  ";"}]], "Input",
 CellLabel->"In[ ]:=",
 CellID->1125,ExpressionUUID->"306e1e48-2f6b-4dcf-8545-356ebbaae41d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"IncludeTo", "[", 
   RowBox[{
    RowBox[{"sol", "[", "$chart", "]"}], ",", " ", 
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"Symbol", " ", "->", " ", "ch"}], ",", " ", 
      RowBox[{"Manifold", " ", "->", " ", "M"}], ",", " ", 
      RowBox[{"CNumbersOf", " ", "->", " ", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "2"}], "}"}]}], ",", " ", 
      RowBox[{"ScalarsOfChart", " ", "->", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"\[Theta]", "[", "]"}], ",", " ", 
         RowBox[{"\[Phi]", "[", "]"}]}], "}"}]}], ",", " ", 
      RowBox[{"Name", " ", "->", " ", "\"\<Polar\>\""}]}], "|>"}]}], "]"}], 
  ";"}]], "Input",
 CellLabel->"In[ ]:=",
 CellID->1126,ExpressionUUID->"daa8dbbf-3651-4be2-baf5-2a1619ca6a87"],

Cell[BoxData[
 RowBox[{
  RowBox[{"IncludeTo", "[", 
   RowBox[{
    RowBox[{"sol", "[", "$metric", "]"}], ",", " ", 
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"Signature", " ", "->", " ", "1"}], ",", " ", 
      RowBox[{"Symbol", " ", "->", " ", 
       RowBox[{"gg", "[", 
        RowBox[{
         RowBox[{"-", "a"}], ",", " ", 
         RowBox[{"-", "b"}]}], "]"}]}], ",", " ", 
      RowBox[{"CovD", " ", "->", " ", "cd"}], ",", " ", 
      RowBox[{"SymbolOfCovD", " ", "->", " ", 
       RowBox[{"{", 
        RowBox[{"\"\<;\>\"", ",", " ", "\"\<\[Del]\>\""}], "}"}]}]}], 
     "|>"}]}], "]"}], ";"}]], "Input",
 CellLabel->"In[ ]:=",
 CellID->1127,ExpressionUUID->"3ec2e985-cd2e-4dfe-be93-21b2f073e8cb"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"sol", "[", 
    RowBox[{"$metric", ",", " ", "gg", ",", " ", "Expression"}], "]"}], " ", 
   "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"Diff", "[", 
      RowBox[{"\[Theta]", "[", "]"}], "]"}], " ", "\[CircleTimes]", " ", 
     RowBox[{"Diff", "[", 
      RowBox[{"\[Theta]", "[", "]"}], "]"}]}], " ", "+", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"Sin", "[", 
       RowBox[{"\[Theta]", "[", "]"}], "]"}], "^", "2"}], " ", 
     RowBox[{
      RowBox[{"Diff", "[", 
       RowBox[{"\[Phi]", "[", "]"}], "]"}], " ", "\[CircleTimes]", " ", 
      RowBox[{"Diff", "[", 
       RowBox[{"\[Phi]", "[", "]"}], "]"}]}]}]}]}], ";"}]], "Input",
 CellLabel->"In[ ]:=",
 CellID->1128,ExpressionUUID->"11c6e08d-7cc6-4644-ab83-b5c97e20d12e"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"sol", "[", 
    RowBox[{
    "$metric", ",", " ", "gg", ",", " ", "$auto", ",", " ", "gg", ",", " ", 
     "Routine", ",", " ", "Chain"}], "]"}], " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"HoldForm", "[", 
       RowBox[{"MakeArray", "[", 
        RowBox[{"$self", "[", 
         RowBox[{"$metric", ",", " ", "gg", ",", " ", "Expression"}], "]"}], 
        "]"}], "]"}], " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "1"}], ",", " ", 
         RowBox[{"-", "1"}]}], "}"}], "}"}]}], ",", " ", 
     RowBox[{
      RowBox[{"HoldForm", "[", 
       RowBox[{"Inverse", "[", 
        RowBox[{"ToArray", "[", 
         RowBox[{"gg", "[", 
          RowBox[{
           RowBox[{"-", "a"}], ",", " ", 
           RowBox[{"-", "b"}]}], "]"}], "]"}], "]"}], "]"}], " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "1"}], "}"}], "}"}]}]}], "}"}]}], 
  ";"}]], "Input",
 CellLabel->"In[ ]:=",
 CellID->1129,ExpressionUUID->"a3fec7ef-fdda-43ac-b7b6-1b5f82720e53"],

Cell[BoxData[
 RowBox[{
