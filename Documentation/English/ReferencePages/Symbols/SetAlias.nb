Cell[CellGroupData[{

Cell["SetAlias", "ObjectName",
 CellID->102,ExpressionUUID->"98b9dcde-2dfe-432c-8bdb-a4a5d17c28a5"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"9e358ce0-48d3-4996-b0a7-19dba2ecdbca"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["SetAlias"]], "paclet:VasilDimitrov/SolutionsX/ref/SetAlias", 
     "VasilDimitrov Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["\"\<alias\>\"", "TI"], "]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "6588e25b-9e15-4ba5-a3a8-f33e99fe7296"],
 "\[LineSeparator]sets ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["$Alias"]], "paclet:VasilDimitrov/SolutionsX/ref/$Alias", 
    "VasilDimitrov Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "c7293259-3c07-4f67-9dfc-18ecbe16de9d"],
 ", refreshes the argument completions, and records the alias in the user \
configuration file so later sessions restore it.\n",
 Cell["   ", "ModInfo",ExpressionUUID->"5bb4d50a-8ca2-4e51-a974-ced68c4cb405"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["SetAlias"]], "paclet:VasilDimitrov/SolutionsX/ref/SetAlias", 
     "VasilDimitrov Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["\"\<alias\>\"", "TI"], 
   RowBox[{
    RowBox[{",", " ", 
     RowBox[{"Permanent", "->", "False"}]}], "]"}]}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "7d19575a-aa76-46f0-abed-8933d4ac1994"],
 "\[LineSeparator]sets it for this session only."
}], "Usage",
 CellID->103,ExpressionUUID->"79588df1-a92e-4fb2-af66-48b96f311e7b"],

Cell["\<\
SetAlias must be given a string. Anything else issues SetAlias::invalid and \
throws $Failed.\
\>", "Notes",
 CellID->104,ExpressionUUID->"8dbd2e08-d809-4d1e-bdc9-34d8e56b9328"],

Cell["\<\
By default the alias is recorded in the user configuration file (under \
$UserBaseDirectory/ApplicationData/SolutionsX/), so it is set once and \
restored by every later session. Permanent -> False sets it for this session \
only.\
\>", "Notes",
 CellID->105,ExpressionUUID->"f0b86cc6-61ae-4c2a-8e10-fc0b12cc2e6a"],

Cell["\<\
SetAlias also refreshes the argument completions of GetData, DeleteData, \
OpenData, CopyData and CurateData: your own entries complete from a bare \
letter, other aliases complete as alias/name.\
\>", "Notes",
 CellID->106,ExpressionUUID->"f316cbfb-0add-4cfe-a624-57683cff581c"],

Cell[TextData[{
 "SetAlias[\"Curated\"] (any capitalization; the canonical spelling is used) \
is the curator's door into the published corpus: it requires the Curator mark \
(",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["SetCurator"]], 
    "paclet:VasilDimitrov/SolutionsX/ref/SetCurator", 
    "VasilDimitrov Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "33c3607c-cb7d-4380-8e28-37d75191c1d1"],
 "), is always session-only -- Curated is a role, never an identity -- and \
derives the identity behind the role from the configuration, refusing without \
one. Saves made under the role stamp that identity as the record's Author."
}], "Notes",
 CellID->107,ExpressionUUID->"beeb179b-7cdd-4fab-b860-3f8d224877e0"]
}, Open  ]],

