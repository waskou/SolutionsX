Cell[CellGroupData[{

Cell["CopyData", "ObjectName",
 CellID->734,ExpressionUUID->"c14b6fa3-3465-41a7-9ae0-8b1b2bc37035"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"62b9090c-95c0-4723-a677-97dc29cdae00"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["CopyData"]], "paclet:VasilDimitrov/SolutionsX/ref/CopyData", 
     "VasilDimitrov Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["\"\<alias/name\>\"", "TI"], "]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "872eb8e7-ffa7-4a47-b6f7-a2dd342d7dc6"],
 "\[LineSeparator]copies the entry ",
 Cell[BoxData[
  StyleBox["name", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "ae4d9af7-68de-4522-84c0-d68c51434fa4"],
 " of another alias into your own alias, notebook and all; the source is \
never touched.\n",
 Cell["   ", "ModInfo",ExpressionUUID->"b9a4541b-7de5-4b47-aa8c-239039924028"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["CopyData"]], "paclet:VasilDimitrov/SolutionsX/ref/CopyData", 
     "VasilDimitrov Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["\"\<alias\>\"", "TI"], "]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "4a4460ab-241d-46c7-b8e0-3d54715250a7"],
 "\[LineSeparator]copies every entry of that alias into yours, one by one."
}], "Usage",
 CellID->735,ExpressionUUID->"06beeb34-3ef2-4cf4-88df-4605a4c56095"],

Cell["\<\
CopyData[\"alias/name\"] copies one entry -- the record and its notebook, the \
whole entry directory -- into $DataDirectory/$Alias/name. The source is never \
touched.\
\>", "Notes",
 CellID->736,ExpressionUUID->"70a58a49-0e06-4036-9549-599bd6c23776"],

Cell["\<\
CopyData[\"alias\"] copies every entry of that alias, one by one, echoing \
each.\
\>", "Notes",
 CellID->737,ExpressionUUID->"7b4805e6-685e-4765-ab75-6a328f9bcf19"],

Cell["\<\
Names you already have are collected and confirmed one by one. Overwrite -> \
Automatic (the default) asks in a front end -- per entry, with overwrite-all \
and skip-all -- and skips duplicates when there is no front end; Overwrite -> \
False always skips; Overwrite -> True replaces silently.\
\>", "Notes",
 CellID->738,ExpressionUUID->"fe4ee0b2-9a52-46e5-8ee6-90bd4892780b"],

Cell["A whole entry directory is replaced or kept, never merged.", "Notes",
 CellID->739,ExpressionUUID->"962e2c82-113c-428b-bf6d-981302d1f628"],

Cell[TextData[{
 "A slashless argument can only be an alias: entry names always contain \
\"__\" (they are computed by ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["SaveData"]], "paclet:VasilDimitrov/SolutionsX/ref/SaveData", 
    "VasilDimitrov Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "1fb0a426-d238-43cb-8bd1-6ee1dd9ede6c"],
 "), and a bare entry name is refused -- bare names resolve to your own \
alias, and copying from yourself is meaningless."
}], "Notes",
 CellID->740,ExpressionUUID->"b74cceed-e6db-4de1-8c7e-28c02d8131b8"],

Cell[TextData[{
 "CopyData copies into your own alias, so it refuses until ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["$Alias"]], "paclet:VasilDimitrov/SolutionsX/ref/$Alias", 
    "VasilDimitrov Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "f5370f34-0def-4602-a1ac-6365c8fafe2a"],
 " is set."
}], "Notes",
 CellID->741,ExpressionUUID->"aa20aaea-f904-491a-95e5-fecc7af782b4"],

Cell[TextData[{
 "The stored $info of a copied entry travels verbatim: provenance (Author) \
stays with the original author. Your alias appears as LastEdit on your next \
",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["SaveData"]], "paclet:VasilDimitrov/SolutionsX/ref/SaveData", 
    "VasilDimitrov Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "d4925a08-00d4-4732-afa8-ce70d9988b5d"],
 "."
}], "Notes",
 CellID->742,ExpressionUUID->"0a06e6ca-970b-453e-a376-ef3f38fd3407"],

Cell["CopyData returns nothing: the echoes are the record.", "Notes",
 CellID->743,ExpressionUUID->"0e2d0cb6-bb43-425b-b630-acce5d49f865"]
}, Open  ]],

