Cell["ToBases", "ObjectName",
 CellID->937,ExpressionUUID->"72e21059-7023-4f53-b6e8-d1469ae4e9d5"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"0e85f2da-7a22-41f0-af91-b6e6b03ef334"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["ToBases"]], "paclet:VasilDimitrov/SolutionsX/ref/ToBases", 
     "VasilDimitrov Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["expr", "TI"], "]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "1c3cc9b5-62df-49b0-9d92-67bba0611d2d"],
 "\[LineSeparator]rewrites every abstract index of ",
 Cell[BoxData[
  StyleBox["expr", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "3ccb891b-de32-46b8-94c0-130ed00a8fba"],
 " in the basis belonging to its vector bundle.\n",
 Cell["   ", "ModInfo",ExpressionUUID->"184b19e9-1201-4fdf-ab09-667fdf9e83fb"],
 "The option Not -> {",
 Cell[BoxData[
  StyleBox["basis", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "9c97a393-e0bc-44f3-a7f4-50d7ecf91b45"],
 "..} leaves those bases untouched."
}], "Usage",
 CellID->938,ExpressionUUID->"9f568552-f73d-43d2-bab6-c2096a9f57d5"],

Cell["\<\
ToBases[expr] replaces each abstract index of expr by the same index paired \
with the basis belonging to its vector bundle, as found by BasisOfVBundle.\
\>", "Notes",
 CellID->939,ExpressionUUID->"b6692d5e-299e-47d5-a0b2-cbcef8011532"],

Cell["\<\
It is the first step of ToArray, and is useful on its own for seeing which \
basis a computation will be carried out in.\
\>", "Notes",
 CellID->940,ExpressionUUID->"c3d86759-b4ee-4c18-92a0-05801c56aa65"],

Cell["The option Not -> {basis, ...} leaves those bases untouched.", "Notes",
 CellID->941,ExpressionUUID->"0fc3bddb-f216-4682-ba4a-a0469c783d5b"],

Cell["Indices whose bundle has no basis are left alone.", "Notes",
 CellID->942,ExpressionUUID->"75b67b95-c23e-459c-afff-668eb58aae95"]
}, Open  ]],

