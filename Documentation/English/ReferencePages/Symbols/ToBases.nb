Cell[CellGroupData[{

Cell["ToBases", "ObjectName",
 CellID->925,ExpressionUUID->"8719c9f8-92e1-423e-a71b-6a05626cb413"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"b36e2a2c-8788-4926-803c-7701e5410ac4"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["ToBases"]], "paclet:VasilDimitrov/SolutionsX/ref/ToBases", 
     "VasilDimitrov Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["expr", "TI"], "]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "98ae4cd4-0085-4f42-94db-70376d34e53b"],
 "\[LineSeparator]rewrites every abstract index of ",
 Cell[BoxData[
  StyleBox["expr", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "bcc40361-dbe8-4cf3-bd07-a991945c074f"],
 " in the basis belonging to its vector bundle.\n",
 Cell["   ", "ModInfo",ExpressionUUID->"5fa1800b-68c0-482a-9814-15da1a39e3e9"],
 "The option Not -> {",
 Cell[BoxData[
  StyleBox["basis", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "ef256d4b-b234-463c-8f48-bd485ab9e890"],
 "..} leaves those bases untouched."
}], "Usage",
 CellID->926,ExpressionUUID->"475b3a39-1416-43ff-911e-9cf0432cbe8e"],

Cell["\<\
ToBases[expr] replaces each abstract index of expr by the same index paired \
with the basis belonging to its vector bundle, as found by BasisOfVBundle.\
\>", "Notes",
 CellID->927,ExpressionUUID->"c2d73565-d9f2-414d-be8e-02eb0f3e513c"],

Cell["\<\
It is the first step of ToArray, and is useful on its own for seeing which \
basis a computation will be carried out in.\
\>", "Notes",
 CellID->928,ExpressionUUID->"74038f3c-4521-4e9f-bcb5-6a3efb8614c8"],

Cell["The option Not -> {basis, ...} leaves those bases untouched.", "Notes",
 CellID->929,ExpressionUUID->"869bb948-5f1b-4c5c-aa05-73d922c8c14c"],

Cell["Indices whose bundle has no basis are left alone.", "Notes",
 CellID->930,ExpressionUUID->"b62af7db-11c4-48d1-93da-ad16247648cf"]
}, Open  ]],

