Cell[BoxData[
 RowBox[{
  RowBox[{"IncludeTo", "[", 
   RowBox[{
    RowBox[{"sol", "[", "$manifold", "]"}], ",", " ", 
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"Symbol", " ", "->", " ", "M"}], ",", " ", 
      RowBox[{"Dimension", " ", "->", " ", "2"}], ",", " ", 
      RowBox[{"Index", " ", "->", " ", 
       RowBox[{"{", 
        RowBox[{"a", ",", " ", "b", ",", " ", "c", ",", " ", "d"}], "}"}]}], 
      ",", " ", 
      RowBox[{"Name", " ", "->", " ", "\"\<Sphere\>\""}]}], "|>"}]}], "]"}], 
  ";"}]], "Input",
 CellLabel->"In[ ]:=",
 CellID->936,ExpressionUUID->"dbc805f8-6f51-4091-bc10-45442c227656"],

Cell[BoxData[
 RowBox[{
  RowBox[{"IncludeTo", "[", 
   RowBox[{
    RowBox[{"sol", "[", "$chart", "]"}], ",", " ", 
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"Symbol", " ", "->", " ", "ch"}], ",", " ", 
      RowBox[{"Manifold", " ", "->", " ", "M"}], ",", " ", 
      RowBox[{"CNumbersOf", " ", "->", " ", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "2"}], "}"}]}], ",", " ", 
      RowBox[{"ScalarsOfChart", " ", "->", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"\[Theta]", "[", "]"}], ",", " ", 
         RowBox[{"\[Phi]", "[", "]"}]}], "}"}]}], ",", " ", 
      RowBox[{"Name", " ", "->", " ", "\"\<Polar\>\""}]}], "|>"}]}], "]"}], 
  ";"}]], "Input",
 CellLabel->"In[ ]:=",
 CellID->937,ExpressionUUID->"fcf852c1-d197-47db-be27-3fc0021fcdb7"],

Cell[BoxData[
 RowBox[{
  RowBox[{"IncludeTo", "[", 
   RowBox[{
    RowBox[{"sol", "[", "$metric", "]"}], ",", " ", 
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"Signature", " ", "->", " ", "1"}], ",", " ", 
      RowBox[{"Symbol", " ", "->", " ", 
       RowBox[{"gg", "[", 
        RowBox[{
         RowBox[{"-", "a"}], ",", " ", 
         RowBox[{"-", "b"}]}], "]"}]}], ",", " ", 
      RowBox[{"CovD", " ", "->", " ", "cd"}], ",", " ", 
      RowBox[{"SymbolOfCovD", " ", "->", " ", 
       RowBox[{"{", 
        RowBox[{"\"\<;\>\"", ",", " ", "\"\<\[Del]\>\""}], "}"}]}]}], 
     "|>"}]}], "]"}], ";"}]], "Input",
 CellLabel->"In[ ]:=",
 CellID->938,ExpressionUUID->"71cf959a-ec3b-4c78-a746-dee230791fc0"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"sol", "[", 
    RowBox[{"$metric", ",", " ", "gg", ",", " ", "Expression"}], "]"}], " ", 
   "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"Diff", "[", 
      RowBox[{"\[Theta]", "[", "]"}], "]"}], " ", "\[CircleTimes]", " ", 
     RowBox[{"Diff", "[", 
      RowBox[{"\[Theta]", "[", "]"}], "]"}]}], " ", "+", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"Sin", "[", 
       RowBox[{"\[Theta]", "[", "]"}], "]"}], "^", "2"}], " ", 
     RowBox[{
      RowBox[{"Diff", "[", 
       RowBox[{"\[Phi]", "[", "]"}], "]"}], " ", "\[CircleTimes]", " ", 
      RowBox[{"Diff", "[", 
       RowBox[{"\[Phi]", "[", "]"}], "]"}]}]}]}]}], ";"}]], "Input",
 CellLabel->"In[ ]:=",
 CellID->939,ExpressionUUID->"afd8ce26-fa96-4ff4-bc61-993734aa204a"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"sol", "[", 
    RowBox[{
    "$metric", ",", " ", "gg", ",", " ", "$auto", ",", " ", "gg", ",", " ", 
     "Routine", ",", " ", "Chain"}], "]"}], " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"HoldForm", "[", 
       RowBox[{"MakeArray", "[", 
        RowBox[{"$self", "[", 
         RowBox[{"$metric", ",", " ", "gg", ",", " ", "Expression"}], "]"}], 
        "]"}], "]"}], " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "1"}], ",", " ", 
         RowBox[{"-", "1"}]}], "}"}], "}"}]}], ",", " ", 
     RowBox[{
      RowBox[{"HoldForm", "[", 
       RowBox[{"Inverse", "[", 
        RowBox[{"ToArray", "[", 
         RowBox[{"gg", "[", 
          RowBox[{
           RowBox[{"-", "a"}], ",", " ", 
           RowBox[{"-", "b"}]}], "]"}], "]"}], "]"}], "]"}], " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "1"}], "}"}], "}"}]}]}], "}"}]}], 
  ";"}]], "Input",
 CellLabel->"In[ ]:=",
 CellID->940,ExpressionUUID->"0175aae9-04fa-457a-9e82-1e7b7f72c4a4"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"sol", "[", 
    RowBox[{
    "$metric", ",", " ", "gg", ",", " ", "$auto", ",", " ", "Detgg", ",", " ",
      "Routine", ",", " ", "Chain"}], "]"}], " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"HoldForm", "[", 
      RowBox[{"Det", "[", 
       RowBox[{"ToArray", "[", 
        RowBox[{"gg", "[", 
         RowBox[{
          RowBox[{"-", "a"}], ",", " ", 
          RowBox[{"-", "b"}]}], "]"}], "]"}], "]"}], "]"}], " ", "->", " ", 
     RowBox[{"{", "}"}]}], "}"}]}], ";"}]], "Input",
 CellLabel->"In[ ]:=",
 CellID->941,ExpressionUUID->"efa43e37-db41-481f-9d6a-030d1e3ac2be"],

