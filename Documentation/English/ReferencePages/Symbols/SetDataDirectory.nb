Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"f2acd261-ad54-4744-a8a6-9f77b795a743"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["SetDataDirectory"]], 
     "paclet:VasilDimitrov/SolutionsX/ref/SetDataDirectory", 
     "VasilDimitrov Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["\"\<path\>\"", "TI"], "]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "f46b9a26-7c4c-41fd-ba10-fdf8ee9ba53e"],
 "\[LineSeparator]sets ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["$DataDirectory"]], 
    "paclet:VasilDimitrov/SolutionsX/ref/$DataDirectory", 
    "VasilDimitrov Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "57b2747b-8bfa-4be7-a354-20328e27c081"],
 ", refreshes the argument completions, and records the path in the user \
configuration file so later sessions restore it.\n",
 Cell["   ", "ModInfo",ExpressionUUID->"8ac9a1f7-3450-4844-816a-4a794d6912a6"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["SetDataDirectory"]], 
     "paclet:VasilDimitrov/SolutionsX/ref/SetDataDirectory", 
     "VasilDimitrov Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["\"\<path\>\"", "TI"], 
   RowBox[{
    RowBox[{",", " ", 
     RowBox[{"Permanent", "->", "False"}]}], "]"}]}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "0c95a7ec-6441-4600-bc53-7705faeb69be"],
 "\[LineSeparator]sets it for this session only."
}], "Usage",
 CellID->175,ExpressionUUID->"f624d6ff-4b71-492b-801c-c923129a9d15"],

Cell["\<\
SetDataDirectory must be given a string path. Anything else issues \
SetDataDirectory::invalid and throws $Failed.\
\>", "Notes",
 CellID->176,ExpressionUUID->"f926b33b-b1f8-4460-a13c-f8b5550ccaae"],

Cell["\<\
By default the path is recorded in the user configuration file and restored \
by every later session; Permanent -> False sets it for this session only. \
Notebook initialization cells use the session-only form, so opening a \
notebook from another data tree never rewrites your configuration.\
\>", "Notes",
 CellID->177,ExpressionUUID->"ffb4b6b1-3204-41bf-8664-a2443ce1ad3c"],

Cell["The directory need not exist yet; SaveData creates it.", "Notes",
 CellID->178,ExpressionUUID->"c1c021b0-9939-4f1d-8aed-1cd346b57b79"]
}, Open  ]],

