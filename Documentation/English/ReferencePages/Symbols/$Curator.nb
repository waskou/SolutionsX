Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"18c92ae9-ed73-4d8f-b512-d2a9f87ba7a4"],
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["$Curator"]], "paclet:VasilDimitrov/SolutionsX/ref/$Curator", 
    "VasilDimitrov Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "a4972ee1-31a0-43e6-8093-f0e47f34fe85"],
 "\[LineSeparator]is True when this user curates the published Curated \
corpus: it unlocks working under the Curated alias and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CurateData"]], 
    "paclet:VasilDimitrov/SolutionsX/ref/CurateData", 
    "VasilDimitrov Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "e0704f56-13fb-45a1-a88a-8601440e1a4b"],
 ". Set it with ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["SetCurator"]], 
    "paclet:VasilDimitrov/SolutionsX/ref/SetCurator", 
    "VasilDimitrov Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "62f37c6f-211d-4de7-99dc-ed820280590e"],
 "; it persists in the user configuration file."
}], "Usage",
 CellID->152,ExpressionUUID->"c1655903-4d24-4bf0-b95e-bd068432550a"],

Cell[TextData[{
 "$Curator gates the two doors into Data/Curated: ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CurateData"]], 
    "paclet:VasilDimitrov/SolutionsX/ref/CurateData", 
    "VasilDimitrov Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "6352a7b4-f50d-47c8-86b6-65313f38c7c9"],
 ", and working under the Curated alias via ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["SetAlias"]], "paclet:VasilDimitrov/SolutionsX/ref/SetAlias", 
    "VasilDimitrov Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "86c6d556-de23-49d3-a768-74be1b7ee6e2"],
 ". It is False unless set."
}], "Notes",
 CellID->153,ExpressionUUID->"1da752bc-c08c-49dc-914f-425694741ed4"],

Cell[TextData[{
 "$Curator is Protected; set it with ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["SetCurator"]], 
    "paclet:VasilDimitrov/SolutionsX/ref/SetCurator", 
    "VasilDimitrov Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "1b71f6b7-1db2-4f44-9555-3285b644d686"],
 ", which records it in the user configuration file. The Data status line \
shows [curator] while it is True."
}], "Notes",
 CellID->154,ExpressionUUID->"f20d70e4-5929-440c-81d4-2c6a34bdc2c6"]
}, Open  ]],

