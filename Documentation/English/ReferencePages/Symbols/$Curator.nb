Cell["$Curator", "ObjectName",
 CellID->154,ExpressionUUID->"1c5b8d2d-fbc5-49df-ba23-aa8fe0cdcaae"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"30fa65c8-0cf1-4dc7-ae8f-119a7abaa366"],
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["$Curator"]], "paclet:VasilDimitrov/SolutionsX/ref/$Curator", 
    "VasilDimitrov Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "03d5f7a5-a21e-4fdd-acc6-5abce6fd3767"],
 "\[LineSeparator]is True when this user curates the published Curated \
corpus: it unlocks working under the Curated alias and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CurateData"]], 
    "paclet:VasilDimitrov/SolutionsX/ref/CurateData", 
    "VasilDimitrov Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "cda19bc7-40fd-4b41-b09a-ebc38f25e8bd"],
 ". Set it with ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["SetCurator"]], 
    "paclet:VasilDimitrov/SolutionsX/ref/SetCurator", 
    "VasilDimitrov Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "48cdb37e-51c1-48df-84a4-73b8ba8a49ae"],
 "; it persists in the user configuration file."
}], "Usage",
 CellID->155,ExpressionUUID->"0b65d567-066e-4f6a-98c2-748735981b54"],

Cell[TextData[{
 "$Curator gates the two doors into Data/Curated: ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CurateData"]], 
    "paclet:VasilDimitrov/SolutionsX/ref/CurateData", 
    "VasilDimitrov Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "0b5204bf-651e-47d2-ba85-ddc62a7b73a4"],
 ", and working under the Curated alias via ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["SetAlias"]], "paclet:VasilDimitrov/SolutionsX/ref/SetAlias", 
    "VasilDimitrov Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "e41df759-d1a4-48f3-ac42-7c828f18609d"],
 ". It is False unless set."
}], "Notes",
 CellID->156,ExpressionUUID->"98b79cf0-14ec-42ef-8989-1c98a513861a"],

Cell[TextData[{
 "$Curator is Protected; set it with ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["SetCurator"]], 
    "paclet:VasilDimitrov/SolutionsX/ref/SetCurator", 
    "VasilDimitrov Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "34125ce8-b4c2-4139-bfa6-a40da443a0e8"],
 ", which records it in the user configuration file. The Data status line \
shows [curator] while it is True."
}], "Notes",
 CellID->157,ExpressionUUID->"2928d5de-a1d8-46ec-8509-df7b34c868c9"]
}, Open  ]],

