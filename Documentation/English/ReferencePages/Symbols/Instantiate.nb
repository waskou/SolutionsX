  FontFamily->"Source Sans Pro",ExpressionUUID->
  "9347ad87-4e3d-469e-b9e8-46d837b9d47a"],
 "\[LineSeparator]clears ",
 Cell[BoxData[
  StyleBox["sol", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "055083d2-6e9a-450e-9c21-0f7ee5f919d4"],
 " and makes it an empty solution: an association over $Objects, carrying the \
UpValues of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
