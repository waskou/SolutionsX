Cell["Instantiate", "ObjectName",
 CellID->274,ExpressionUUID->"f5c5c5aa-8ce3-48d4-9937-b257a2730307"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"b1e09fa7-58f3-4d71-8673-fcd411c08909"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["Instantiate"]], 
     "paclet:VasilDimitrov/SolutionsX/ref/Instantiate", 
     "VasilDimitrov Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["sol", "TI"], "]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "98a1fa8d-a840-408e-b61a-4dbb7846edb9"],
 "\[LineSeparator]clears ",
 Cell[BoxData[
  StyleBox["sol", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "fa2cd348-cc0e-4804-b24b-31754131abb0"],
 " and makes it an empty solution: an association over $Objects, carrying the \
UpValues of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Load"]], "paclet:VasilDimitrov/SolutionsX/ref/Load", 
