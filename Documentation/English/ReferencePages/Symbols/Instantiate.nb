   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "7483753e-bc80-4f14-98b2-27bf89481570"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["MergeWith"]], "paclet:VasilDimitrov/SolutionsX/ref/MergeWith", 
