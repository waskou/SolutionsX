  FontFamily->"Source Sans Pro",ExpressionUUID->
  "c5858f4a-e4c6-4d59-ab17-099568b2213d"],
 ".\n",
 Cell["   ", "ModInfo",ExpressionUUID->"6608a96a-e923-4db6-ab5e-d9b2c2390004"],
 "It is a list of rules whose keys are ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Map"]], "paclet:ref/Map"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "752d60b2-33e8-48c9-9d63-d9e99f8ac8fa"],
 " or ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["ParallelMap"]], "paclet:ref/ParallelMap"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "db7a5df1-4934-469a-a741-fdef85823206"],
 " and whose values are applied to computed components; the default is {",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Map"]], "paclet:ref/Map"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "38e0b6eb-3e95-489b-b1d2-29034810cb00"],
 " -> ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
