Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"23f169f5-2214-4d49-814a-9edbe2721541"],
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["$Apply"]], "paclet:VasilDimitrov/SolutionsX/ref/$Apply", 
