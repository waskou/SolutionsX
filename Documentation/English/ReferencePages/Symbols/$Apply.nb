  FontFamily->"Source Sans Pro",ExpressionUUID->
  "eecc2628-ccb0-4cfe-9b9a-fcb8d2e1955d"],
 "\[LineSeparator]is the default value of the Apply option of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Compute"]], "paclet:VasilDimitrov/SolutionsX/ref/Compute", 
    "VasilDimitrov Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "1422ab9a-a810-4488-9035-7bcdb20d68d3"],
 ".\n",
 Cell["   ", "ModInfo",ExpressionUUID->"3b3676b7-c72a-4892-aa27-03969efde35c"],
 "It is a list of rules whose keys are ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Map"]], "paclet:ref/Map"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "1eb12f2b-889f-4e94-a406-cb12c4de4fbd"],
 " or ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["ParallelMap"]], "paclet:ref/ParallelMap"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "62d3a603-96ee-43bc-ac37-d58549db90c5"],
 " and whose values are applied to computed components; the default is {",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Map"]], "paclet:ref/Map"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "1f8c4403-bafe-4d90-9084-e751f24e4f8b"],
 " -> ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Together"]], "paclet:ref/Together"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "c938d808-f1f0-46b5-9ca2-7d1edf8139ff"],
 ", ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["ParallelMap"]], "paclet:ref/ParallelMap"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "2e5e297d-2753-46ca-9a41-2b6289df2a19"],
 " -> ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Simplify"]], "paclet:ref/Simplify"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "51c1cff0-9628-40e9-87a7-c1db58fad9f3"],
 "}."
}], "Usage",
 CellID->74,ExpressionUUID->"3256a115-af47-42af-8d53-85004f0676c3"],

Cell["\<\
$Apply is a list of rules whose keys are Map or ParallelMap. Compute applies \
each value to the components it has just computed.\
\>", "Notes",
 CellID->75,ExpressionUUID->"65f50856-0504-46a2-aeeb-a3f65ca072f3"],

Cell["The default is {Map -> Together, ParallelMap -> Simplify}.", "Notes",
 CellID->76,ExpressionUUID->"4dd67c3e-7fa0-45d3-9423-356298ff07d2"],

Cell["\<\
ParallelMap entries only take effect after EnableParallelComputations has \
been called.\
\>", "Notes",
 CellID->77,ExpressionUUID->"dc01f6d2-08a4-4b78-be31-7532c135c5ee"],

Cell["\<\
Setting $Apply to something cheap, such as {Map -> Identity}, is the usual \
way to speed up an exploratory computation.\
\>", "Notes",
 CellID->78,ExpressionUUID->"06bb1636-b3b9-4d23-ad11-4492558779eb"]
}, Open  ]],

