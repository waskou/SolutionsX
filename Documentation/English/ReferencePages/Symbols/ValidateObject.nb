Cell[CellGroupData[{

Cell["ValidateObject", "ObjectName",
 CellID->467,ExpressionUUID->"c05cf1d2-92fc-470d-b075-dea9450f97ae"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"80b0392b-7f28-4d8e-b6cc-8c0644b1fc1d"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["ValidateObject"]], 
     "paclet:VasilDimitrov/SolutionsX/ref/ValidateObject", 
     "VasilDimitrov Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["object", "TI"], ",", 
    StyleBox["expr", "TI"], ",", 
    StyleBox["types", "TI"]}], "]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "a41f2826-ac25-4210-8bc7-6c6e2a0c6db8"],
 "\[LineSeparator]checks the association ",
 Cell[BoxData[
  StyleBox["expr", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "e36f411a-6f4a-464c-b8fb-40e12d41c137"],
 " against the template of ",
 Cell[BoxData[
  StyleBox["object", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "333c5945-86cd-45a5-a427-3b7b2a55b404"],
 ", and returns it unchanged if it passes.\n",
 Cell["   ", "ModInfo",ExpressionUUID->"f4adaa32-e70a-4796-b77f-d078b10f586d"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["ValidateObject"]], 
     "paclet:VasilDimitrov/SolutionsX/ref/ValidateObject", 
     "VasilDimitrov Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{"$solution", ",", 
    StyleBox["sol", "TI"], ",", 
    StyleBox["types", "TI"]}], "]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "9d3c962a-97e4-4e31-a970-e35b6b034790"],
 "\[LineSeparator]checks a whole solution, object type by object type.\n",
 Cell["   ", "ModInfo",ExpressionUUID->"512fe30e-20f7-4f61-85af-3e3517370d6c"],
 Cell[BoxData[
  StyleBox["types", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "d9c074c7-d3cb-4bbf-b8d1-904a8a8cbc2e"],
 " is a list of key selectors, normally {PropKeysOf, OptKeysOf}. Failure \
issues a message and throws ",
 Cell[BoxData[
  StyleBox["object", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "640ca7e2-eb48-49e3-bed4-fb438bda4ba7"],
 "."
}], "Usage",
 CellID->468,ExpressionUUID->"e35162d4-d824-48d9-acb6-b8c15a8f0de6"],

Cell["\<\
ValidateObject[object, expr, types] checks that expr is an association, that \
its keys are exactly those of object, and that every value selected by types \
matches the pattern stored for that key. It returns expr unchanged if all \
three hold; otherwise it issues a message and throws object, which under \
IncludeTo surfaces as Throw::nocatch.\
\>", "Notes",
 CellID->469,ExpressionUUID->"d04fc424-1be6-4c21-a9c7-fa2206eaae35"],

Cell["\<\
types selects which keys are checked by value, normally {PropKeysOf, \
OptKeysOf}.\
\>", "Notes",
 CellID->470,ExpressionUUID->"6f0a119b-4bb7-437d-8350-00c47be5e756"],

Cell["\<\
It reads only the description. No xAct state is consulted, so a tensor may be \
described on a manifold that does not exist; whether a description can \
actually be realised is discovered at load time.\
\>", "Notes",
 CellID->471,ExpressionUUID->"858620d9-c7fa-4a8b-b71d-bd8b97994ae5"],

Cell["\<\
The patterns come from Options[object], so the template and the verifier can \
never disagree. A mismatch reported against a stored solution therefore means \
the templates of the loaded xAct have moved, not that the check is confused.\
\>", "Notes",
 CellID->472,ExpressionUUID->"5c996ec5-4770-4fbe-b1f3-e7779d25ae35"],

Cell["\<\
ValidateObject[$solution, sol, types] validates a whole solution, entry by \
entry.\
\>", "Notes",
 CellID->473,ExpressionUUID->"70fb76fe-c39a-4990-9a6e-8e2db12ea842"],

Cell["\<\
The package runs it itself \[LongDash] the object constructors, MergeWith, \
Load, SaveData and GetData all call it \[LongDash] so calling it directly is \
rarely needed.\
\>", "Notes",
 CellID->474,ExpressionUUID->"272ac357-9ca8-428c-9f11-96ab7fa1ca64"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Examples", "PrimaryExamplesSection",
 CellTags->"PrimaryExamplesSection",
 CellID->475,ExpressionUUID->"2b89c753-20a1-43f5-beee-168cb84ad88d"],

Cell["Basic Examples", "ExampleSection",
 CellID->476,ExpressionUUID->"a09b0049-1b83-4656-bd26-ca8c7932a3b3"],

Cell["\<\
ValidateObject is the gate a description passes on its way into a solution. \
What it checks is the description against the form for its type \[LongDash] \
for a chart, the form asks for these:\
\>", "ExampleText",
 CellID->477,ExpressionUUID->"06a87981-dbfa-4466-9c1f-2a89cba1128e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Keys", "@", 
  RowBox[{"$chart", "[", "]"}]}]], "Input",
 CellLabel->"In[ ]:=",
 CellID->478,ExpressionUUID->"4cbcb56c-f72a-4da8-ab04-d4d8b3523a6e"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
  "Symbol", ",", "Manifold", ",", "CNumbersOf", ",", "ScalarsOfChart", ",", 
   "Name", ",", "ChartColor", ",", "FormatBasis", ",", "ProtectNewSymbol", 
   ",", "Dagger", ",", "MetricInBasis", ",", "epsilonOrientationOfMetric", 
   ",", "ExtendedCoordinateDerivatives", ",", "DefInfo"}], "}"}]], "Output",
 CellLabel->"Out[1]=",
 CellID->479,ExpressionUUID->"7ed814a8-24b6-4f7b-84be-8fb0d5e05bca"]
}, Open  ]],

Cell["\<\
Calling the type as a function builds a description and validates it in one \
step, defaults filled in:\
\>", "ExampleText",
 CellID->480,ExpressionUUID->"52ff4688-5903-4ec1-a5ea-199ad28dcb99"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"$chart", "[", 
  RowBox[{
   RowBox[{"Symbol", " ", "->", " ", "ch"}], ",", " ", 
   RowBox[{"Manifold", " ", "->", " ", "Ghost"}], ",", " ", 
   RowBox[{"CNumbersOf", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"1", ",", " ", "2"}], "}"}]}], ",", " ", 
   RowBox[{"ScalarsOfChart", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"x", "[", "]"}], ",", " ", 
      RowBox[{"y", "[", "]"}]}], "}"}]}], ",", " ", 
   RowBox[{"Name", " ", "->", " ", "\"\<Plane\>\""}]}], "]"}]], "Input",
 CellLabel->"In[ ]:=",
 CellID->481,ExpressionUUID->"af413058-dac4-42c1-9a2f-e8f15feeb3f2"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"Symbol", "\[Rule]", "ch"}], ",", 
   RowBox[{"Manifold", "\[Rule]", "Ghost"}], ",", 
   RowBox[{"CNumbersOf", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"1", ",", "2"}], "}"}]}], ",", 
   RowBox[{"ScalarsOfChart", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"x", "[", "]"}], ",", 
      RowBox[{"y", "[", "]"}]}], "}"}]}], ",", 
   RowBox[{"Name", "\[Rule]", "\<\"Plane\"\>"}], ",", 
   RowBox[{"ChartColor", "\[Rule]", 
    TemplateBox[<|"color" -> RGBColor[1, 0, 0]|>,
     "RGBColorSwatchTemplate"]}], ",", 
   RowBox[{"FormatBasis", "\[Rule]", "Automatic"}], ",", 
   RowBox[{"ProtectNewSymbol", "\[RuleDelayed]", 
    RowBox[{"ScreenDollarIndices", "[", "$ProtectNewSymbols", "]"}]}], ",", 
   RowBox[{"Dagger", "\[Rule]", "Real"}], ",", 
   RowBox[{"MetricInBasis", "\[Rule]", 
    RowBox[{"{", "}"}]}], ",", 
   RowBox[{"epsilonOrientationOfMetric", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"Null", ",", "1"}], "}"}]}], ",", 
   RowBox[{"ExtendedCoordinateDerivatives", "\[Rule]", "True"}], ",", 
   RowBox[{"DefInfo", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"\<\"chart\"\>", ",", "\<\"\"\>"}], "}"}]}]}], 
  "\[RightAssociation]"}]], "Output",
 CellLabel->"Out[1]=",
 CellID->482,ExpressionUUID->"5514de83-39b6-482a-a870-c05d5ae97d8c"]
}, Open  ]],

Cell["\<\
Note what was not required: Ghost does not exist. ValidateObject reads the \
description, never the kernel \[LongDash] whether the chart can actually be \
made is a question for Load.\
\>", "ExampleText",
 CellID->483,ExpressionUUID->"43347e7f-c108-46ae-b4b2-96056ae30e10"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ManifoldQ", "[", "Ghost", "]"}]], "Input",
 CellLabel->"In[ ]:=",
 CellID->484,ExpressionUUID->"8d3b958c-3f49-4bc6-8d2e-cf7919ca874d"],

Cell[BoxData["False"], "Output",
 CellLabel->"Out[1]=",
 CellID->485,ExpressionUUID->"fc5c8754-79f5-4394-890f-8ea9cfd054f6"]
}, Open  ]],

Cell["\<\
A value of the wrong shape is caught and named. A tensor is described \
together with its index slots, so a bare TT is not enough:\
\>", "ExampleText",
 CellID->486,ExpressionUUID->"20f48638-ec12-41ff-a800-a7d1fd5126ef"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"$tensor", "[", 
  RowBox[{
   RowBox[{"Symbol", " ", "->", " ", "TT"}], ",", " ", 
   RowBox[{"Manifold", " ", "->", " ", "Ghost"}], ",", " ", 
   RowBox[{"Symmetry", " ", "->", " ", "None"}]}], "]"}]], "Input",
 CellLabel->"In[ ]:=",
 CellID->487,ExpressionUUID->"8ad1c204-6cd4-4f32-a8af-a83e0f1f99d6"],

Cell[BoxData[
 TemplateBox[{
  "ValidateObject", "badval", 
   "\"The value for key Symbol (TT) does not match the expected pattern: \
_Symbol[(_Symbol | -_Symbol)...].\"", 2, 1, 1, 0, "Local"},
  "MessageTemplate"]], "Message", "MSG",
 CellLabel->"During evaluation of In[1]:=",
 CellID->488,ExpressionUUID->"bf4eabb2-7b97-4575-9f78-f1309f46f71c"]
}, Open  ]],

Cell["\<\
The explicit form checks a description built by hand, and insists on the \
exact key set:\
\>", "ExampleText",
 CellID->489,ExpressionUUID->"a5b6eeae-2661-4661-8da2-b03108d71d9b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ValidateObject", "[", 
  RowBox[{"$chart", ",", " ", 
   RowBox[{"<|", 
    RowBox[{"Symbol", " ", "->", " ", "ch"}], "|>"}], ",", " ", 
   RowBox[{"{", "PropKeysOf", "}"}]}], "]"}]], "Input",
 CellLabel->"In[ ]:=",
 CellID->490,ExpressionUUID->"dc569c80-d03d-4e10-a297-eae119a5d176"],

Cell[BoxData[
 TemplateBox[{
  "ValidateObject", "keysmismatch", 
   "\"The keys do not match. Missing keys: {Manifold, CNumbersOf, \
ScalarsOfChart, Name, ChartColor, FormatBasis, ProtectNewSymbol, Dagger, \
MetricInBasis, epsilonOrientationOfMetric, ExtendedCoordinateDerivatives, \
DefInfo}. Extra keys: {}.\"", 2, 1, 1, 0, "Local"},
  "MessageTemplate"]], "Message", "MSG",
 CellLabel->"During evaluation of In[1]:=",
 CellID->491,ExpressionUUID->"ae501bd2-2146-42f6-8f48-3e0242ed949d"]
}, Open  ]]
}, Open  ]],

