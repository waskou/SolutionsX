Cell[CellGroupData[{

Cell["CurateData", "ObjectName",
 CellID->744,ExpressionUUID->"a775f6fc-5476-46ec-820c-ed267280d7e6"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"9094d2ef-a7d3-476e-b4cb-6545ecf9c40b"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["CurateData"]], 
     "paclet:VasilDimitrov/SolutionsX/ref/CurateData", 
     "VasilDimitrov Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["\"\<name\>\"", "TI"], "]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "669a248c-a6ae-42ac-bd3a-4f79328385fa"],
 "\[LineSeparator]publishes the entry ",
 Cell[BoxData[
  StyleBox["name", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "2ad1e1f6-6184-4616-8c15-60e9a8e8c551"],
 " of your own alias into the Curated corpus. Curator-only; enable with ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["SetCurator"]], 
    "paclet:VasilDimitrov/SolutionsX/ref/SetCurator", 
    "VasilDimitrov Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "d93c08e2-6afd-4196-b0ae-d45493430672"],
 "."
}], "Usage",
 CellID->745,ExpressionUUID->"68541556-0e51-457e-9e15-8b49e30ae936"],

Cell[TextData[{
 "CurateData[\"name\"] copies the entry ",
 Cell[BoxData[
  StyleBox["name", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "5c8bb912-7ebc-47a9-afd0-30c6375f7072"],
 " of your own alias into Data/Curated, the published corpus that ships with \
the repository. It requires the Curator mark: enable with ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["SetCurator"]], 
    "paclet:VasilDimitrov/SolutionsX/ref/SetCurator", 
    "VasilDimitrov Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "72f7f92d-7ab7-4582-b9e2-b7a3e623301f"],
 "."
}], "Notes",
 CellID->746,ExpressionUUID->"f626a67d-3f25-4070-b80b-428de86c6801"],

Cell["\<\
Data/Curated is git-tracked: the write is local to your clone until the \
repository owner commits and pushes it. CurateData::tracked restates this on \
every use; Off[CurateData::tracked] silences it once internalized.\
\>", "Notes",
 CellID->747,ExpressionUUID->"99aa0c2d-706a-4a95-8741-e1984e2bb209"],

Cell["\<\
An existing Curated entry of the same name is replaced only after \
confirmation; the Overwrite option works as in CopyData.\
\>", "Notes",
 CellID->748,ExpressionUUID->"d6535aed-ac69-492e-a453-589eb6df1e59"],

Cell["\<\
The copy is verbatim: curation is publication, not authorship, so the stored \
$info -- Author included -- travels unchanged.\
\>", "Notes",
 CellID->749,ExpressionUUID->"0288c72a-9285-4991-b44c-c61b9cce9e75"],

Cell[TextData[{
 "CurateData publishes from your own alias only; fetch someone else's entry \
with ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CopyData"]], "paclet:VasilDimitrov/SolutionsX/ref/CopyData", 
    "VasilDimitrov Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "4887fe3b-dfd2-43ee-8a28-24c2c46e6211"],
 " first. Editing and deleting inside Curated is the curator's ordinary \
workflow under the Curated alias -- see ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["SetAlias"]], "paclet:VasilDimitrov/SolutionsX/ref/SetAlias", 
    "VasilDimitrov Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "c07069b7-dd96-4f3f-af7a-72ffad887dda"],
 "."
}], "Notes",
 CellID->750,ExpressionUUID->"9a98072d-2308-42f3-82f8-3c960b52f04b"],

Cell["\<\
CurateData returns nothing: the ::tracked message and the echo are the record.\
\>", "Notes",
 CellID->751,ExpressionUUID->"f65e393d-f8ea-4fdc-88ff-11ff5cd6ef22"]
}, Open  ]],

