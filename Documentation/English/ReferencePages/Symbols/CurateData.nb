Cell[CellGroupData[{

Cell["CurateData", "ObjectName",
 CellID->763,ExpressionUUID->"96446e29-dd68-4aed-b7f4-95ca132fa91c"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"1360d371-8a10-404a-9333-14bc77959764"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["CurateData"]], 
     "paclet:VasilDimitrov/SolutionsX/ref/CurateData", 
     "VasilDimitrov Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["\"\<name\>\"", "TI"], "]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "4e5fdb7a-c249-4045-8186-cae090a2b449"],
 "\[LineSeparator]publishes the entry ",
 Cell[BoxData[
  StyleBox["name", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "e0375151-63f7-4ee8-bd14-0b2c77af58c9"],
 " of your own alias into the Curated corpus. Curator-only; enable with ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["SetCurator"]], 
    "paclet:VasilDimitrov/SolutionsX/ref/SetCurator", 
    "VasilDimitrov Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "3e793547-ff0f-4910-a19e-7055c8fcc0a4"],
 "."
}], "Usage",
 CellID->764,ExpressionUUID->"23c844b9-18af-46cb-884e-90c7a8cd73fc"],

Cell[TextData[{
 "CurateData[\"name\"] copies the entry ",
 Cell[BoxData[
  StyleBox["name", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "3ff83b1f-22f3-4377-9e02-ac723840baeb"],
 " of your own alias into Data/Curated, the published corpus that ships with \
the repository. It requires the Curator mark: enable with ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["SetCurator"]], 
    "paclet:VasilDimitrov/SolutionsX/ref/SetCurator", 
    "VasilDimitrov Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "2a0b09d4-ec32-4245-ad29-f43cb1e2884f"],
 "."
}], "Notes",
 CellID->765,ExpressionUUID->"41ff2a1d-f43c-4ab5-97e9-732bcb48c210"],

Cell["\<\
Data/Curated is git-tracked: the write is local to your clone until the \
repository owner commits and pushes it. CurateData::tracked restates this on \
every use; Off[CurateData::tracked] silences it once internalized.\
\>", "Notes",
 CellID->766,ExpressionUUID->"64f8c940-e4b5-464a-89e3-796353ea8efe"],

Cell["\<\
An existing Curated entry of the same name is replaced only after \
confirmation; the Overwrite option works as in CopyData.\
\>", "Notes",
 CellID->767,ExpressionUUID->"92f1f519-ee40-4b9a-a075-624aa7b96a69"],

Cell["\<\
The copy is verbatim: curation is publication, not authorship, so the stored \
$info -- Author included -- travels unchanged.\
\>", "Notes",
 CellID->768,ExpressionUUID->"ecfff06e-b45c-4e93-b48e-fdf0075f5016"],

Cell[TextData[{
 "CurateData publishes from your own alias only; fetch someone else's entry \
with ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CopyData"]], "paclet:VasilDimitrov/SolutionsX/ref/CopyData", 
    "VasilDimitrov Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "5bd9f226-57a1-47a6-bb2b-32ed84c32a56"],
 " first. Editing and deleting inside Curated is the curator's ordinary \
workflow under the Curated alias -- see ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["SetAlias"]], "paclet:VasilDimitrov/SolutionsX/ref/SetAlias", 
    "VasilDimitrov Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "ceb7a265-fbb9-412f-a9b8-f7c44ac4ebed"],
 "."
}], "Notes",
 CellID->769,ExpressionUUID->"e8c55930-f010-4b42-a8e5-872b94508e1e"],

Cell["\<\
CurateData returns nothing: the ::tracked message and the echo are the record.\
\>", "Notes",
 CellID->770,ExpressionUUID->"ad7b31a7-72d6-49c8-ab44-69d5a838fd48"]
}, Open  ]],

