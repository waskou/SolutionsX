 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["MakeArray"]], "paclet:VasilDimitrov/SolutionsX/ref/MakeArray",
      "VasilDimitrov Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["expr", "TI"], "]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "5685c6ac-b500-43c1-b48d-563ce087248c"],
 "\[LineSeparator]gives the component array of ",
 Cell[BoxData[
  StyleBox["expr", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "d67e49bb-333c-4080-9624-03b2d6713a3a"],
 ", which may be a line element written with ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CircleTimes"]], "paclet:ref/CircleTimes"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "d8e7dfe5-2640-4513-90e4-51d70244ee6d"],
 " or a differential form written with ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Wedge"]], "paclet:ref/Wedge"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "593605ff-4fe0-489c-be64-519e09bf1495"],
 ".\n",
 Cell["   ", "ModInfo",ExpressionUUID->"b6aded0b-1fd6-495e-93fa-5fe7ffbcbbcd"],
 "The chart is deduced from the Diff's appearing in ",
 Cell[BoxData[
  StyleBox["expr", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "f63921ee-4b2b-4024-8e28-1ea871514f6a"],
 ". It is the inverse of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["MakeMetric"]], 
    "paclet:VasilDimitrov/SolutionsX/ref/MakeMetric", 
    "VasilDimitrov Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
