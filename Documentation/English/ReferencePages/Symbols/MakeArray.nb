  "0fa8abf9-db46-4b0d-8b61-e96439899b7d"],
 " or a differential form written with ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Wedge"]], "paclet:ref/Wedge"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "d7376ca3-80df-4488-8ce7-15582a808735"],
 ".\n",
 Cell["   ", "ModInfo",ExpressionUUID->"8beaea15-3182-48cc-90fa-9eacd131947b"],
 "The chart is deduced from the Diff's appearing in ",
 Cell[BoxData[
  StyleBox["expr", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "02ada011-f88b-4bd0-b610-6c232e0fda6b"],
 ". It is the inverse of ",
 Cell[BoxData[
