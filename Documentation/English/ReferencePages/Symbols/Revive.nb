 CellID->611,ExpressionUUID->"82883360-1d03-487c-a624-23b17561d9b9"],

Cell["\<\
Revive[sol] walks sol, applying Resurrect to every value, and then to every \
symbol of the Global` context and to $Assumptions.\
\>", "Notes",
 CellID->612,ExpressionUUID->"3d0d0282-afa2-4d20-a202-2f77b447a21e"],

Cell["\<\
It is called automatically at the end of each unload, so that a solution is \
not corrupted by its own teardown.\
\>", "Notes",
 CellID->613,ExpressionUUID->"1aaf4297-38f5-441e-886a-c0b8b854d317"],

Cell["Revive has the attribute HoldFirst.", "Notes",
 CellID->614,ExpressionUUID->"300c50af-6ed0-4696-9701-3464483c53d6"]
}, Open  ]],

