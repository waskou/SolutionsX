Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"1d408113-3458-4e27-81f1-443289685059"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["Compute"]], "paclet:VasilDimitrov/SolutionsX/ref/Compute", 
     "VasilDimitrov Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["sol", "TI"], "[", 
    RowBox[{
     StyleBox["object", "TI"], ",", 
     StyleBox["key", "TI"], ",", "$auto", ",", 
     StyleBox["autoKey", "TI"]}], "]"}], "]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "43097949-09df-47b8-a1c5-9462e64bb6be"],
 "\[LineSeparator]computes the components of ",
 Cell[BoxData[
  StyleBox["autoKey", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "7f1ad979-ebd3-4dea-a24b-4763e1e2eda9"],
 " by walking its stored Chain, and stores them under Value.\n",
 Cell["   ", "ModInfo",ExpressionUUID->"6ccb2eeb-7c83-4ba6-9d64-4a027e916a8c"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["Compute"]], "paclet:VasilDimitrov/SolutionsX/ref/Compute", 
     "VasilDimitrov Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["sol", "TI"], "[", 
    RowBox[{
     StyleBox["object", "TI"], ",", 
     StyleBox["key", "TI"]}], "]"}], "]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "ce23ade9-15d2-44d0-aa7d-6e93136d60cb"],
 "\[LineSeparator]does this for every automatic tensor of the entry.\n",
 Cell["   ", "ModInfo",ExpressionUUID->"e1e0ad1a-ac49-4e2d-8314-6a0dba34df9f"],
 "A Chain entry ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["HoldForm"]], "paclet:ref/HoldForm"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "11ad8fef-e39d-4db0-bbc1-afc5278eada1"],
 "[",
 Cell[BoxData[
  StyleBox["expr", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "46c61956-4641-4c45-b468-c1f14660dc6f"],
 "] -> {",
 Cell[BoxData[
  StyleBox["slots", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "9972a005-e4a0-4532-a8df-ee3c6b546abf"],
 "} takes the components from ",
 Cell[BoxData[
  StyleBox["expr", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "8c4ceee1-a837-451d-b7a1-0c9854adf28c"],
 "; an entry {",
 Cell[BoxData[
