Cell["\<\
A Chain entry fills the whole orbit of the configuration it names. Raising a \
single arrangement of Riemanncd therefore also resolves the components whose \
canonical representative carries the raised index in a different slot:\
\>", "ExampleText",
 CellID->849,ExpressionUUID->"924ffb1a-10a4-4071-ac51-9b2c8c64dab3"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"sol", "[", 
    RowBox[{
    "$metric", ",", " ", "gg", ",", " ", "$auto", ",", " ", "Riemanncd", ",", 
     " ", "Routine", ",", " ", "Chain"}], "]"}], " ", "=", " ", 
   RowBox[{"RulesToChain", " ", "@@", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"HoldForm", "[", 
       RowBox[{"ToArray", "[", 
        RowBox[{"ContractMetric", "[", 
         RowBox[{"RiemannToChristoffel", "[", 
          RowBox[{"Riemanncd", "[", 
           RowBox[{
            RowBox[{"-", "a"}], ",", " ", 
            RowBox[{"-", "b"}], ",", " ", 
            RowBox[{"-", "c"}], ",", " ", 
            RowBox[{"-", "d"}]}], "]"}], "]"}], "]"}], "]"}], "]"}], " ", "->",
       " ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "1"}], ",", " ", 
          RowBox[{"-", "1"}], ",", " ", 
          RowBox[{"-", "1"}], ",", " ", 
          RowBox[{"-", "1"}]}], "}"}], "}"}], " ", "->", " ", 
       RowBox[{"{", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "1"}], ",", " ", 
          RowBox[{"-", "1"}], ",", " ", 
          RowBox[{"-", "1"}], ",", " ", "1"}], "}"}], "}"}]}]}], "}"}]}]}], 
  ";"}]], "Input",
 CellLabel->"In[ ]:=",
 CellID->850,ExpressionUUID->"b4699342-6272-481c-adfb-5076aa2548cd"],

