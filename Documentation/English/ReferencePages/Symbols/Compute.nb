Cell["\<\
A Chain computes exactly the configurations it names, and a component \
resolves through its canonical representative. Raising a single arrangement \
therefore leaves unresolved those components whose representative carries the \
raised index in another slot:\
\>", "ExampleText",
 CellID->841,ExpressionUUID->"1c7138fb-ed8e-428d-ac6f-4119ba0f9989"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"sol", "[", 
    RowBox[{
    "$metric", ",", " ", "gg", ",", " ", "$auto", ",", " ", "Riemanncd", ",", 
     " ", "Routine", ",", " ", "Chain"}], "]"}], " ", "=", " ", 
   RowBox[{"RulesToChain", " ", "@@", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"HoldForm", "[", 
       RowBox[{"ToArray", "[", 
        RowBox[{"ContractMetric", "[", 
         RowBox[{"RiemannToChristoffel", "[", 
          RowBox[{"Riemanncd", "[", 
           RowBox[{
            RowBox[{"-", "a"}], ",", " ", 
