Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"e0367a5e-5e60-416d-9cda-3a2e94262054"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["BasisOfVBundle"]], 
     "paclet:VasilDimitrov/SolutionsX/ref/BasisOfVBundle", 
     "VasilDimitrov Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["bundle", "TI"], "]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "8f83daf9-375c-44fb-aefb-d005676812df"],
 "\[LineSeparator]gives the first basis or chart defined over ",
 Cell[BoxData[
  StyleBox["bundle", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "21574ca9-49cc-41a0-8a57-8e57f65bbe87"],
 ", or ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["None"]], "paclet:ref/None"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "82e72431-f85c-4aa6-aed2-f54090c06931"],
 " if there is none.\n",
 Cell["   ", "ModInfo",ExpressionUUID->"708d2654-4414-4a9d-bf4e-ae9db3c318e2"],
 "It issues a message and throws ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["$Failed"]], "paclet:ref/$Failed"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "3767c198-2000-4a74-beca-504fa869ca9a"],
 " if ",
 Cell[BoxData[
  StyleBox["bundle", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "1540962b-f494-4fe9-82b2-7d2e733d9760"],
 " is not a vector bundle."
}], "Usage",
 CellID->976,ExpressionUUID->"731dc8a7-56cb-4f15-b312-4d70f7dc042c"],

Cell["\<\
BasisOfVBundle[bundle] gives the first basis or chart whose vector bundle is \
bundle, or None if there is none.\
\>", "Notes",
 CellID->977,ExpressionUUID->"70b3b56d-e7f5-4920-bb57-056a85d56ef7"],

Cell["\<\
It issues BasisOfVBundle::unknown and throws $Failed if the argument is not a \
vector bundle.\
\>", "Notes",
 CellID->978,ExpressionUUID->"1906b95b-b805-4adf-afc2-e19ea6c230aa"],

Cell["\<\
It is what ToBases uses to decide which basis each index belongs in.\
\>", "Notes",
 CellID->979,ExpressionUUID->"d3fb370f-2a90-41a8-8018-b61635623ca5"]
}, Open  ]],

