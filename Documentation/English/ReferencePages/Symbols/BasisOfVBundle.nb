 CellID->984,ExpressionUUID->"8fe6d2e4-ce4d-449f-9888-e44b2be64237"],

Cell[BoxData[
 RowBox[{
  RowBox[{"IncludeTo", "[", 
   RowBox[{
    RowBox[{"sol", "[", "$manifold", "]"}], ",", " ", 
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"Symbol", " ", "->", " ", "M"}], ",", " ", 
      RowBox[{"Dimension", " ", "->", " ", "2"}], ",", " ", 
      RowBox[{"Index", " ", "->", " ", 
       RowBox[{"{", 
        RowBox[{"a", ",", " ", "b", ",", " ", "c", ",", " ", "d"}], "}"}]}], 
      ",", " ", 
      RowBox[{"Name", " ", "->", " ", "\"\<Sphere\>\""}]}], "|>"}]}], "]"}], 
  ";"}]], "Input",
 CellLabel->"In[ ]:=",
 CellID->985,ExpressionUUID->"5e62ebfd-4e8d-49a0-970d-f9c859c52798"],

Cell[BoxData[
 RowBox[{
  RowBox[{"IncludeTo", "[", 
   RowBox[{
    RowBox[{"sol", "[", "$chart", "]"}], ",", " ", 
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"Symbol", " ", "->", " ", "ch"}], ",", " ", 
      RowBox[{"Manifold", " ", "->", " ", "M"}], ",", " ", 
      RowBox[{"CNumbersOf", " ", "->", " ", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "2"}], "}"}]}], ",", " ", 
      RowBox[{"ScalarsOfChart", " ", "->", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"\[Theta]", "[", "]"}], ",", " ", 
         RowBox[{"\[Phi]", "[", "]"}]}], "}"}]}], ",", " ", 
      RowBox[{"Name", " ", "->", " ", "\"\<Polar\>\""}]}], "|>"}]}], "]"}], 
  ";"}]], "Input",
 CellLabel->"In[ ]:=",
 CellID->986,ExpressionUUID->"33bae738-1af5-4269-ac1b-d6c912391095"],

Cell[BoxData[
 RowBox[{
  RowBox[{"IncludeTo", "[", 
   RowBox[{
    RowBox[{"sol", "[", "$metric", "]"}], ",", " ", 
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"Signature", " ", "->", " ", "1"}], ",", " ", 
      RowBox[{"Symbol", " ", "->", " ", 
       RowBox[{"gg", "[", 
        RowBox[{
         RowBox[{"-", "a"}], ",", " ", 
         RowBox[{"-", "b"}]}], "]"}]}], ",", " ", 
      RowBox[{"CovD", " ", "->", " ", "cd"}], ",", " ", 
      RowBox[{"SymbolOfCovD", " ", "->", " ", 
       RowBox[{"{", 
        RowBox[{"\"\<;\>\"", ",", " ", "\"\<\[Del]\>\""}], "}"}]}]}], 
     "|>"}]}], "]"}], ";"}]], "Input",
 CellLabel->"In[ ]:=",
 CellID->987,ExpressionUUID->"0aa9280a-4e50-4acc-a7f3-07d4eef8449b"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"sol", "[", 
    RowBox[{"$metric", ",", " ", "gg", ",", " ", "Expression"}], "]"}], " ", 
   "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"Diff", "[", 
      RowBox[{"\[Theta]", "[", "]"}], "]"}], " ", "\[CircleTimes]", " ", 
     RowBox[{"Diff", "[", 
      RowBox[{"\[Theta]", "[", "]"}], "]"}]}], " ", "+", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"Sin", "[", 
       RowBox[{"\[Theta]", "[", "]"}], "]"}], "^", "2"}], " ", 
     RowBox[{
      RowBox[{"Diff", "[", 
       RowBox[{"\[Phi]", "[", "]"}], "]"}], " ", "\[CircleTimes]", " ", 
      RowBox[{"Diff", "[", 
       RowBox[{"\[Phi]", "[", "]"}], "]"}]}]}]}]}], ";"}]], "Input",
 CellLabel->"In[ ]:=",
 CellID->988,ExpressionUUID->"ac747a62-e8f1-4267-bfa6-f86d07154150"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"sol", "[", 
    RowBox[{
    "$metric", ",", " ", "gg", ",", " ", "$auto", ",", " ", "gg", ",", " ", 
     "Routine", ",", " ", "Chain"}], "]"}], " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"HoldForm", "[", 
       RowBox[{"MakeArray", "[", 
        RowBox[{"$self", "[", 
         RowBox[{"$metric", ",", " ", "gg", ",", " ", "Expression"}], "]"}], 
        "]"}], "]"}], " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "1"}], ",", " ", 
         RowBox[{"-", "1"}]}], "}"}], "}"}]}], ",", " ", 
     RowBox[{
      RowBox[{"HoldForm", "[", 
       RowBox[{"Inverse", "[", 
        RowBox[{"ToArray", "[", 
         RowBox[{"gg", "[", 
          RowBox[{
           RowBox[{"-", "a"}], ",", " ", 
           RowBox[{"-", "b"}]}], "]"}], "]"}], "]"}], "]"}], " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "1"}], "}"}], "}"}]}]}], "}"}]}], 
  ";"}]], "Input",
 CellLabel->"In[ ]:=",
 CellID->989,ExpressionUUID->"eb899030-96de-4443-9cd9-cc39023f305f"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"sol", "[", 
    RowBox[{
    "$metric", ",", " ", "gg", ",", " ", "$auto", ",", " ", "Detgg", ",", " ",
      "Routine", ",", " ", "Chain"}], "]"}], " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"HoldForm", "[", 
      RowBox[{"Det", "[", 
       RowBox[{"ToArray", "[", 
        RowBox[{"gg", "[", 
         RowBox[{
          RowBox[{"-", "a"}], ",", " ", 
          RowBox[{"-", "b"}]}], "]"}], "]"}], "]"}], "]"}], " ", "->", " ", 
     RowBox[{"{", "}"}]}], "}"}]}], ";"}]], "Input",
 CellLabel->"In[ ]:=",
 CellID->990,ExpressionUUID->"82d806cd-aa24-47fd-b304-adcbbc8938c2"],

Cell[BoxData[
 RowBox[{
