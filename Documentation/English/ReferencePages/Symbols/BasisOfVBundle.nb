Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"510994e2-c8df-458c-b575-347ca25b4650"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["BasisOfVBundle"]], 
     "paclet:VasilDimitrov/SolutionsX/ref/BasisOfVBundle", 
     "VasilDimitrov Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["bundle", "TI"], "]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "c63f84ec-121e-4c44-8b5d-fdb279f72596"],
 "\[LineSeparator]gives the first basis or chart defined over ",
 Cell[BoxData[
  StyleBox["bundle", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "21967876-5448-476f-a368-f9ecbb8576b9"],
 ", or ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["None"]], "paclet:ref/None"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "ef0fed82-3f82-4f8a-af26-e834fed9c41d"],
 " if there is none.\n",
 Cell["   ", "ModInfo",ExpressionUUID->"2fb03473-e78c-482d-a026-de42582b9348"],
 "It issues a message and throws ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["$Failed"]], "paclet:ref/$Failed"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "226befaf-3cbc-4bb2-bf6b-be91fcc7e753"],
 " if ",
 Cell[BoxData[
  StyleBox["bundle", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "651d1695-e55e-4f97-9186-eb783f18bd76"],
 " is not a vector bundle."
}], "Usage",
 CellID->964,ExpressionUUID->"1711e164-fdc1-4c1c-b11f-68f55375f711"],

Cell["\<\
BasisOfVBundle[bundle] gives the first basis or chart whose vector bundle is \
bundle, or None if there is none.\
\>", "Notes",
 CellID->965,ExpressionUUID->"c8f12b11-0c58-4b9a-9e86-4eb365404fcf"],

Cell["\<\
It issues BasisOfVBundle::unknown and throws $Failed if the argument is not a \
vector bundle.\
\>", "Notes",
 CellID->966,ExpressionUUID->"d640d99e-a9fa-4ec5-974e-33c30abad09f"],

Cell["\<\
It is what ToBases uses to decide which basis each index belongs in.\
\>", "Notes",
 CellID->967,ExpressionUUID->"70f76377-6cad-47af-81ef-522fe7b753fc"]
}, Open  ]],

