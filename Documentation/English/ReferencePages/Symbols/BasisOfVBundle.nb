    "$metric", ",", " ", "gg", ",", " ", "$auto", ",", " ", "Detgg", ",", " ",
      "Routine", ",", " ", "Chain"}], "]"}], " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"HoldForm", "[", 
      RowBox[{"Det", "[", 
       RowBox[{"ToArray", "[", 
        RowBox[{"gg", "[", 
         RowBox[{
          RowBox[{"-", "a"}], ",", " ", 
          RowBox[{"-", "b"}]}], "]"}], "]"}], "]"}], "]"}], " ", "->", " ", 
     RowBox[{"{", "}"}]}], "}"}]}], ";"}]], "Input",
